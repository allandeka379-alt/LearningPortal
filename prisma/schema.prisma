// =====================================================================================================================
// IDENTITY & ACCOUNTS (§5, §20, §21, §22, §29, §33, §39, §43)
// =====================================================================================================================

/// An account: the authentication identity shared by every role (§33). One person = one User, whatever roles they
/// hold (a teacher who is also a parent has roles [TEACHER, PARENT]).
/// Login identifiers: a unique email, a unique phone, or (for students without their own email/phone, §23, §52) a
/// unique loginUsername + password, issued by a school roster import or chosen at a family-phone sign-up. Siblings who
/// share a parent's phone each get a username account with that phone as the non-unique contactPhoneE164.
/// Invariants (raw SQL CHECKs): an email, a phone, or a username with a password unless status = DELETED;
/// emailNormalized is lower-cased and trimmed; phone columns match E.164; loginUsername is lower-case; SCHOOL_ADMIN
/// never appears in roles; status = DELETED <=> deletedAt IS NOT NULL; a DELETED row holds no identifier or contact;
/// a *VerifiedAt timestamp implies the identifier is present.
/// Role extension rows (Student / Parent / Teacher) exist iff the matching role is in `roles` (service-enforced in the
/// same transaction that grants the role).
/// Deletion (ARCHITECTURE §4.13, §5.13): never hard-deleted by the application; accounts.deleteUser anonymises this row
/// and deletes/blanks every user-identifying artifact listed there (sessions, links, AI conversations and solver
/// images, answer attachments, share cards, testimonials, personal flashcards, channel identities...).
model User {
  id                    String          @id @default(uuid(7)) @db.Uuid
  /// Lower-cased, trimmed email used for login and uniqueness. Provider-specific tricks (gmail dots, +tags) are NOT
  /// stripped: that would merge distinct mailboxes. NULL for phone-only accounts and after anonymisation.
  emailNormalized       String?         @unique @db.VarChar(254)
  /// E.164 phone number, e.g. "+263771234567" (Zimbabwe default prefix applied at input). A LOGIN identifier, so
  /// unique; NULL for email-only / username accounts.
  phoneE164             String?         @unique @db.VarChar(16)
  /// Login username for accounts without their own email/phone, lower-case [a-z0-9][a-z0-9._-]{2,31} (CHECK), e.g.
  /// "hhs.tmoyo27". Always paired with a password. Distinct from Profile.username, the PUBLIC leaderboard handle,
  /// which is never a login key.
  loginUsername         String?         @unique @db.VarChar(32)
  /// Shared contact phone (E.164, NOT unique), e.g. a parent's phone used by several siblings: notifications, username
  /// reminders and guardian OTP only. Never a login key.
  contactPhoneE164      String?         @db.VarChar(16)
  /// School whose roster import created the account. Password resets for such username accounts go through an ACTIVE
  /// SCHOOL_ADMIN of this school and write AuditLog.
  provisionedBySchoolId String?         @db.Uuid
  emailVerifiedAt       DateTime?       @db.Timestamptz(3)
  phoneVerifiedAt       DateTime?       @db.Timestamptz(3)
  /// Argon2id PHC string (ARCHITECTURE §5.1). NULL for OTP-only and Google-only accounts.
  passwordHash          String?
  /// Sessions created before this instant are revoked on next use (password change / reset).
  passwordUpdatedAt     DateTime?       @db.Timestamptz(3)
  /// The password was set by someone else (school roster import, school-admin reset): after signing in with it the user
  /// must choose their own at /change-password before any other page or action works (guards read it from the session
  /// user). Cleared by the user's own password change or a forgot-password reset.
  passwordMustChange    Boolean         @default(false)
  /// Platform-level roles (see enum Role). Effective session roles = roles + SCHOOL_ADMIN when the user has an ACTIVE
  /// SchoolMember(SCHOOL_ADMIN). GIN-indexed (raw SQL) for staff lists.
  roles                 Role[]          @default([])
  status                UserStatus      @default(ACTIVE)
  /// Staff-entered reason for SUSPENDED (no PII; shown to admins only).
  statusReason          String?         @db.VarChar(500)
  statusChangedAt       DateTime?       @db.Timestamptz(3)
  /// Consecutive failed password logins; reset on success. Drives lockedUntil (plus IP/identifier rate limits).
  failedLoginCount      Int             @default(0)
  lockedUntil           DateTime?       @db.Timestamptz(3)
  lastLoginAt           DateTime?       @db.Timestamptz(3)
  /// Last authenticated activity on any channel, written at most once per hour from the session touch. Used for
  /// admin display and all-role MAU (§35, nightly scan; students' exact DAU comes from DailyActivity). Deliberately
  /// unindexed so the hourly touch stays a HOT update.
  lastActiveAt          DateTime?       @db.Timestamptz(3)
  /// Acquisition channel for funnel analytics (§35): web, native/API or WhatsApp-first sign-up (§30).
  signupChannel         ActivityChannel @default(WEB)
  /// Dev-seed demo account (§50, CLAUDE.md rule 6). Excluded from analytics and never created in production.
  isDemo                Boolean         @default(false)
  /// Set when anonymised (status DELETED).
  deletedAt             DateTime?       @db.Timestamptz(3)
  createdAt             DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @db.Timestamptz(3)

  provisionedBySchool School? @relation("UserProvisionedBySchool", fields: [provisionedBySchoolId], references: [id], onDelete: SetNull)

  // --- role extensions & auth ---
  profile              Profile?
  student              Student?           @relation("StudentUser")
  parent               Parent?
  teacher              Teacher?           @relation("TeacherUser")
  sessions             Session[]
  oauthAccounts        OAuthAccount[]
  verificationCodes    VerificationCode[]
  privacyRequests      PrivacyRequest[]   @relation("PrivacyRequestUser")
  privacyRequestsMade  PrivacyRequest[]   @relation("PrivacyRequestRequestedBy")
  pushSubscriptions    PushSubscription[]
  studentsConsentedFor Student[]          @relation("StudentGuardianConsentBy")
  teachersVerified     Teacher[]          @relation("TeacherVerifiedBy")

  // --- parent links ---
  parentLinksAsParent  ParentStudentLink[] @relation("ParentLinkParent")
  parentLinksAsStudent ParentStudentLink[] @relation("ParentLinkStudent")
  parentLinksRevoked   ParentStudentLink[] @relation("ParentLinkRevokedBy")

  // --- schools & classes ---
  schoolMemberships      SchoolMember[] @relation("SchoolMemberUser")
  schoolMembersInvited   SchoolMember[] @relation("SchoolMemberInvitedBy")
  schoolMembersRemoved   SchoolMember[] @relation("SchoolMemberRemovedBy")
  schoolsVerified        School[]       @relation("SchoolVerifiedBy")
  schoolsCreated         School[]       @relation("SchoolCreatedBy")
  classesCreated         Class[]        @relation("ClassCreatedBy")
  classTeaching          ClassTeacher[]
  classMemberships       ClassMember[]  @relation("ClassMemberUser")
  classMembersRemoved    ClassMember[]  @relation("ClassMemberRemovedBy")
  invitationsSent        Invitation[]   @relation("InvitationInvitedBy")
  invitationsAccepted    Invitation[]   @relation("InvitationAcceptedBy")
  announcementsAuthored  Announcement[]
  notifications          Notification[]
  schoolReportsRequested SchoolReport[]

  // --- billing & growth ---
  subscriptionsHeld        Subscription[]     @relation("SubscriptionHolder")
  subscriptionsPaid        Subscription[]     @relation("SubscriptionPayer")
  subscriptionsCreated     Subscription[]     @relation("SubscriptionCreatedBy")
  paymentsMade             Payment[]          @relation("PaymentPayer")
  paymentsReceived         Payment[]          @relation("PaymentBeneficiary")
  paymentsRefunded         Payment[]          @relation("PaymentRefundedBy")
  paymentEventsRecorded    PaymentEvent[]
  entitlementGrants        EntitlementGrant[] @relation("EntitlementGrantUser")
  entitlementGrantsGranted EntitlementGrant[] @relation("EntitlementGrantGrantedBy")
  entitlementGrantsRevoked EntitlementGrant[] @relation("EntitlementGrantRevokedBy")
  promoCodesCreated        PromoCode[]
  promoRedemptions         PromoRedemption[]
  referralCode             ReferralCode?
  referralsMade            Referral[]         @relation("ReferralReferrer")
  referredBy               Referral?          @relation("ReferralReferred")

  // --- AI ---
  aiConversations           AiConversation[]
  aiUsageDaily              AiUsageDaily[]
  aiGenerationJobsRequested AiGenerationJob[] @relation("AiGenerationJobRequestedBy")
  aiGenerationJobsCancelled AiGenerationJob[] @relation("AiGenerationJobCancelledBy")

  // --- channels & infra ---
  channelIdentities           ChannelIdentity[]
  auditLogsAsActor            AuditLog[]               @relation("AuditLogActor")
  auditLogsAsTarget           AuditLog[]               @relation("AuditLogTarget")
  settingsUpdated             Setting[]
  // Back-relations (CURRICULUM & CONTENT slice)
  syllabiCreated              Syllabus[]               @relation("SyllabusCreatedBy")
  syllabiPublished            Syllabus[]               @relation("SyllabusPublishedBy")
  examSessionsConfirmed       ExamSession[]            @relation("ExamSessionConfirmedBy")
  mediaUploads                MediaAsset[]             @relation("MediaAssetUploadedBy")
  contentImports              ContentImport[]          @relation("ContentImportCreatedBy")
  lessonsCreated              Lesson[]                 @relation("LessonCreatedBy")
  lessonsReviewed             Lesson[]                 @relation("LessonReviewedBy")
  lessonsApproved             Lesson[]                 @relation("LessonApprovedBy")
  questionsCreated            Question[]               @relation("QuestionCreatedBy")
  questionsReviewed           Question[]               @relation("QuestionReviewedBy")
  questionsApproved           Question[]               @relation("QuestionApprovedBy")
  /// Tutor-private questions this user owns (§22 independent tutors).
  questionsOwned              Question[]               @relation("QuestionOwner")
  personalFlashcards          Flashcard[]              @relation("FlashcardOwner")
  flashcardsCreated           Flashcard[]              @relation("FlashcardCreatedBy")
  flashcardsReviewed          Flashcard[]              @relation("FlashcardReviewedBy")
  flashcardsApproved          Flashcard[]              @relation("FlashcardApprovedBy")
  assessmentsCreated          Assessment[]             @relation("AssessmentCreatedBy")
  assessmentsReviewed         Assessment[]             @relation("AssessmentReviewedBy")
  assessmentsApproved         Assessment[]             @relation("AssessmentApprovedBy")
  /// Tutor-private tests this user owns (§22 independent tutors).
  assessmentsOwned            Assessment[]             @relation("AssessmentOwner")
  studyPacksCreated           StudyPack[]              @relation("StudyPackCreatedBy")
  studyPacksReviewed          StudyPack[]              @relation("StudyPackReviewedBy")
  studyPacksApproved          StudyPack[]              @relation("StudyPackApprovedBy")
  studyPlanTemplatesCreated   StudyPlanTemplate[]      @relation("StudyPlanTemplateCreatedBy")
  studyPlanTemplatesReviewed  StudyPlanTemplate[]      @relation("StudyPlanTemplateReviewedBy")
  studyPlanTemplatesApproved  StudyPlanTemplate[]      @relation("StudyPlanTemplateApprovedBy")
  contentRevisionsAuthored    ContentRevision[]        @relation("ContentRevisionAuthor")
  contentRevisionsApproved    ContentRevision[]        @relation("ContentRevisionApprovedBy")
  contentFlagsRaised          ContentFlag[]            @relation("ContentFlagFlaggedBy")
  contentFlagsAssigned        ContentFlag[]            @relation("ContentFlagAssignedTo")
  contentFlagsResolved        ContentFlag[]            @relation("ContentFlagResolvedBy")
  testimonials                Testimonial[]            @relation("TestimonialUser")
  testimonialConsentsRecorded Testimonial[]            @relation("TestimonialConsentRecordedBy")
  // Back-relations (LEARNING & ENGAGEMENT slice)
  subjectEnrollments          SubjectEnrollment[]
  assessmentAttempts          AssessmentAttempt[]
  /// Answers this user marked or re-marked as a teacher/reviewer (QuestionAttemptMarking.markedBy).
  questionMarkingsMade        QuestionAttemptMarking[]
  lessonProgress              LessonProgress[]
  flashcardStates             FlashcardState[]
  studyPlans                  StudyPlan[]
  studySessions               StudySession[]
  dailyActivities             DailyActivity[]
  learnerStats                LearnerStats?
  xpEvents                    XpEvent[]
  achievements                UserAchievement[]
  leaderboardEntries          LeaderboardEntry[]
  assignmentsCreated          Assignment[]
  assignmentProgress          AssignmentProgress[]
  shareableResults            ShareableResult[]

  /// Admin user lists filtered by status, newest first (§36 Users); sign-up counts per day (§35).
  @@index([status, createdAt])
  /// Admin user lists in their default order (createdAt DESC, id DESC; status <> DELETED, role and name filters): a
  /// backward walk that stops after one page instead of sorting every user (perf_indexes migration).
  @@index([createdAt, id])
  /// Sign-up funnel by channel (§35).
  @@index([signupChannel, createdAt])
  /// "Forgot my username": accounts sharing this contact phone (a handful at most).
  @@index([contactPhoneE164])
  /// Accounts a school provisioned (roster management, §23); covers the FK.
  @@index([provisionedBySchoolId])
  /// Staff lists: WHERE roles && ARRAY['ADMIN','SUPER_ADMIN']::"Role"[] (GIN on the enum array).
  @@index([roles], type: Gin)
}

/// Personal details and preferences of any user (§5 profile side, §20, §29, §43). 1:1 with User (userId PK).
/// Data minimisation for minors (ARCHITECTURE §5.12): no date of birth, gender, address or photo requirement;
/// birthYear is optional and coarse. Names are NULL only after anonymisation (registration requires firstName).
model Profile {
  userId                   String             @id @db.Uuid
  firstName                String?            @db.VarChar(100)
  /// Optional (surname is not required, §5.12).
  lastName                 String?            @db.VarChar(100)
  /// Name shown in-app (defaults to firstName). Leaderboards use leaderboardDisplay instead.
  displayName              String?            @db.VarChar(100)
  /// Public handle, lower-case [a-z0-9_]{3,30} (CHECK). Auto-generated at registration (e.g. "swiftkudu482") so the
  /// default leaderboard identity never exposes a real name (§20).
  username                 String?            @unique @db.VarChar(30)
  /// Avatar image (MediaAsset purpose AVATAR, re-encoded, EXIF stripped). Optional.
  avatarAssetId            String?            @db.Uuid
  /// Country of residence (§53 multi-country): phone defaults, pricing currency, public-page localisation.
  countryId                String?            @db.Uuid
  /// IANA time zone for day boundaries (streaks, daily goals, quiet hours). Africa/Harare = CAT, UTC+2, no DST.
  timezone                 String             @default("Africa/Harare") @db.VarChar(64)
  /// BCP-47 UI locale. Content language is per content item, not this.
  locale                   String             @default("en") @db.VarChar(16)
  /// Preferred ISO 4217 currency for price display (USD / ZWG / ZAR...). NULL = Country.defaultCurrency.
  preferredCurrency        String?            @db.Char(3)
  /// Optional coarse age signal (never full DOB). Used only for age-appropriate defaults; isMinor is authoritative.
  birthYear                Int?               @db.SmallInt
  // --- accessibility & low-bandwidth preferences (§29, §43) ---
  fontScale                FontScale          @default(DEFAULT)
  /// NULL = follow the OS prefers-reduced-motion setting.
  reducedMotion            Boolean?
  highContrast             Boolean            @default(false)
  theme                    ThemePreference    @default(SYSTEM)
  /// Low-bandwidth mode (§29): images load on tap, no prefetching, smaller page sizes.
  dataSaver                Boolean            @default(false)
  /// Service-worker offline lesson cache (ARCHITECTURE §3.13). Users of shared phones can turn it off.
  offlineCacheEnabled      Boolean            @default(true)
  // --- privacy (§20) ---
  /// Leaderboards are opt-in (default false); non-opted-in users never appear on any board. Raw SQL partial index
  /// "Profile_leaderboard_optin_idx" (userId) WHERE leaderboardOptIn drives the hourly snapshot cursor.
  leaderboardOptIn         Boolean            @default(false)
  leaderboardDisplay       LeaderboardDisplay @default(USERNAME)
  /// Marketing consent per channel: timestamp of opt-in, NULL = no consent (withdrawal sets NULL and writes AuditLog).
  /// Transactional messages (OTP, receipts, security) do not need marketing consent.
  marketingEmailOptInAt    DateTime?          @db.Timestamptz(3)
  marketingSmsOptInAt      DateTime?          @db.Timestamptz(3)
  marketingWhatsappOptInAt DateTime?          @db.Timestamptz(3)
  /// Terms of service / privacy notice acceptance (legal text is versioned in the repo).
  termsAcceptedAt          DateTime?          @db.Timestamptz(3)
  termsVersion             String?            @db.VarChar(32)
  privacyNoticeVersion     String?            @db.VarChar(32)
  /// Per-category, per-channel notification preferences (Zod-validated). Missing keys = platform defaults from
  /// Setting `notifications.defaults`. Shape:
  /// { version: 1,
  ///   categories?: { [category in NotificationCategory]?: { inApp?: boolean, email?: boolean, sms?: boolean,
  ///                                                         push?: boolean, whatsapp?: boolean } },
  ///   quietHours?: { start: "HH:MM", end: "HH:MM" } /* local time, Profile.timezone */,
  ///   dailyReminderTime?: "HH:MM", parentDigest?: "OFF" | "WEEKLY" | "MONTHLY" }
  notificationPrefs        Json?
  createdAt                DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarAsset MediaAsset? @relation(fields: [avatarAssetId], references: [id], onDelete: SetNull)
  country     Country?    @relation(fields: [countryId], references: [id], onDelete: Restrict)

  /// Covers the avatarAssetId FK.
  @@index([avatarAssetId])
  /// Users per country (§35, §53); covers the countryId FK.
  @@index([countryId])
}

/// Student role extension (§5 onboarding). 1:1 with User. Holds the student's PRIMARY track and onboarding state.
/// Per-subject choices (subjects, pinned syllabus version, per-subject target exam / ability / target grade) live in
/// SubjectEnrollment (learning slice); the ability / target fields here are the onboarding answers copied into each
/// new enrolment as defaults. A student may still enrol in subjects of another qualification (e.g. ZIMSEC + IGCSE).
/// Invariants: onboardingCompletedAt set => countryId, examBoardId, qualificationId set (CHECK);
/// qualificationId belongs to examBoardId, targetExamSessionId belongs to qualificationId, yearGroupId belongs to
/// countryId (composite FKs, raw SQL, need matching uniques on the curriculum tables);
/// isMinor => guardianConsentStatus <> NOT_REQUIRED (CHECK); consent GRANTED by method PARENT_ACCOUNT names a parent
/// with an ACTIVE ParentStudentLink to this student at the time it is granted (trigger).
/// schoolId grants NO access: authorisation always uses SchoolMember.
model Student {
  userId                     String                 @id @db.Uuid
  countryId                  String?                @db.Uuid
  examBoardId                String?                @db.Uuid
  /// Level (§5 "O-Level / A-Level") resolved to the board's qualification (ZIMSEC O-Level, Cambridge IGCSE...).
  qualificationId            String?                @db.Uuid
  /// Year/form (§5): "Form 4", "Lower Sixth"... (country-specific YearGroup lookup, curriculum slice).
  yearGroupId                String?                @db.Uuid
  /// Self-reported current ability (§5). Default for new SubjectEnrollment rows.
  abilityLevel               AbilityLevel?
  /// Optional overall target grade (§5): a label valid in the qualification's GradeScheme ("A", "B", "A*", "1"...).
  targetGrade                String?                @db.VarChar(8)
  /// Target examination session (§5 "November 2027") driving the dashboard countdown (§17). Per-subject sessions
  /// live on SubjectEnrollment.
  targetExamSessionId        String?                @db.Uuid
  /// Primary school for display and B2B lead analytics: mirrors the ACTIVE SchoolMember(STUDENT) row when there is
  /// one, otherwise self-declared and unverified. SCHOOL-scope leaderboards and every access check use SchoolMember.
  schoolId                   String?                @db.Uuid
  /// Free-text school name when the school is not in the directory yet (B2B lead signal; never shown publicly).
  declaredSchoolName         String?                @db.VarChar(200)
  onboardingStep             OnboardingStep         @default(COUNTRY)
  /// Wizard answers not yet committed to rows (resumability). Shape:
  /// { version: 1, subjectIds?: string[], targetExamSessionIds?: { [subjectId: string]: string },
  ///   wantsDiagnostic?: boolean }
  onboardingData             Json?
  onboardingCompletedAt      DateTime?              @db.Timestamptz(3)
  /// First diagnostic finished (§46, §52); per-subject diagnostics are on SubjectEnrollment.
  diagnosticCompletedAt      DateTime?              @db.Timestamptz(3)
  diagnosticSkippedAt        DateTime?              @db.Timestamptz(3)
  /// Under 18 (asked in onboarding). Defaults to true: treat as a minor until the student says otherwise.
  isMinor                    Boolean                @default(true)
  guardianConsentStatus      GuardianConsentStatus  @default(PENDING)
  guardianConsentAt          DateTime?              @db.Timestamptz(3)
  guardianConsentMethod      GuardianConsentMethod?
  /// Linked parent account that gave consent (method PARENT_ACCOUNT).
  guardianConsentByUserId    String?                @db.Uuid
  /// Pointer to consent evidence (signed form id, OTP verification id). Never the guardian's contact details.
  guardianConsentEvidenceRef String?                @db.VarChar(255)
  /// Exam access arrangement (§43): extra time in percent (1-100, CHECK) applied when a timed attempt starts
  /// (AssessmentAttempt.timeLimitSeconds = base x (1 + pct/100), recorded in config.extraTimePercent). Set only by
  /// staff or an ACTIVE SCHOOL_ADMIN of the student's school; every change writes AuditLog. NULL = none.
  examExtraTimePercent       Int?                   @db.SmallInt
  createdAt                  DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime               @updatedAt @db.Timestamptz(3)

  user              User           @relation("StudentUser", fields: [userId], references: [id], onDelete: Cascade)
  country           Country?       @relation(fields: [countryId], references: [id], onDelete: Restrict)
  examBoard         ExamBoard?     @relation(fields: [examBoardId], references: [id], onDelete: Restrict)
  qualification     Qualification? @relation(fields: [qualificationId], references: [id], onDelete: Restrict)
  yearGroup         YearGroup?     @relation(fields: [yearGroupId], references: [id], onDelete: Restrict)
  targetExamSession ExamSession?   @relation(fields: [targetExamSessionId], references: [id], onDelete: Restrict)
  school            School?        @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  guardianConsentBy User?          @relation("StudentGuardianConsentBy", fields: [guardianConsentByUserId], references: [id], onDelete: SetNull)

  /// Students per country (§35, §53); covers the FK.
  @@index([countryId])
  /// Covers the FK.
  @@index([examBoardId])
  /// Students per qualification and form (§35 analytics, admin Students list); covers the qualificationId FK.
  @@index([qualificationId, yearGroupId])
  /// Covers the FK.
  @@index([yearGroupId])
  /// Countdown reminders per exam session; covers the FK.
  @@index([targetExamSessionId])
  /// "Students who named this school" (B2B leads, school-picker counts); covers the FK.
  @@index([schoolId])
  /// Covers the FK.
  @@index([guardianConsentByUserId])
}

/// Parent / guardian / sponsor role extension (§21). 1:1 with User. Children are reached only through ACTIVE
/// ParentStudentLink rows.
model Parent {
  userId                String    @id @db.Uuid
  /// Parent onboarding (link a child, optional payment) finished.
  onboardingCompletedAt DateTime? @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Teacher role extension (§22). 1:1 with User. A teacher may work in schools (SchoolMember role TEACHER) and/or as an
/// independent tutor (classes with schoolId NULL).
model Teacher {
  userId                String    @id @db.Uuid
  /// Optional honorific shown to students ("Mr", "Mrs", "Ms", "Dr"). Free text, voluntary.
  title                 String?   @db.VarChar(32)
  /// Short public-to-class bio (plain text).
  bio                   String?   @db.VarChar(1000)
  /// Staff verification of an independent tutor (school teachers are vouched for by their school admin).
  verifiedAt            DateTime? @db.Timestamptz(3)
  verifiedById          String?   @db.Uuid
  onboardingCompletedAt DateTime? @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user       User  @relation("TeacherUser", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("TeacherVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  /// Covers the FK.
  @@index([verifiedById])
}

/// One EPISODE of a link between a parent/guardian and a student (§21), with the basis of consent and per-link
/// visibility flags. Flows: (a) student generates an invite code (studentUserId set, parentUserId NULL) and the parent
/// redeems it -> ACTIVE, basis STUDENT_CODE (sharing the code is the consent); (b) parent generates a code
/// (parentUserId set) and the student enters it -> ACTIVE, basis STUDENT_APPROVAL; (c) parent requests by the
/// student's phone/email -> PENDING, student approves (STUDENT_APPROVAL); (d) school roster / staff -> SCHOOL_RECORD /
/// ADMIN_VERIFIED.
/// Episodes: REVOKED and DECLINED are terminal (trigger); re-linking inserts a new row, so stale consent can never
/// re-activate a link. At most one open (PENDING/ACTIVE) row per pair (partial unique, raw SQL).
/// Invariants (CHECK): at least one side set; parent <> student; ACTIVE => both sides, activatedAt and consentBasis
/// set, and studentConsentAt set unless the basis is SCHOOL_RECORD / ADMIN_VERIFIED; consent timestamps belong to this
/// episode (>= createdAt); canViewAiConversations => ACTIVE, aiConversationsConsentAt >= studentConsentAt and a
/// student-consent basis (explicit, separate student consent; default FALSE, §21 "do not expose private student AI
/// conversations unless explicitly designed and consented to").
/// The invite code is shown once; only its HMAC is stored and it is nulled when consumed or expired.
model ParentStudentLink {
  id                       String                  @id @default(uuid(7)) @db.Uuid
  parentUserId             String?                 @db.Uuid
  studentUserId            String?                 @db.Uuid
  status                   ParentLinkStatus        @default(PENDING)
  relationship             GuardianRelationship    @default(PARENT)
  initiatedBy              ParentLinkInitiator
  /// Why this link may be ACTIVE (CHECKs above).
  consentBasis             ParentLinkConsentBasis?
  /// HMAC-SHA256(SESSION_SECRET, code) hex of the 8-character invite code. NULL once consumed/expired.
  inviteCodeHash           String?                 @unique @db.Char(64)
  inviteExpiresAt          DateTime?               @db.Timestamptz(3)
  /// When the student consented to this parent seeing their §21 data.
  studentConsentAt         DateTime?               @db.Timestamptz(3)
  activatedAt              DateTime?               @db.Timestamptz(3)
  // --- what the parent may see (§21). Subjects and exam countdown are always visible on an ACTIVE link. ---
  /// Progress, mastery, weak areas.
  canViewProgress          Boolean                 @default(true)
  /// Study time, streaks, attendance/study activity.
  canViewStudyActivity     Boolean                 @default(true)
  /// Test, quiz and mock exam results.
  canViewTestResults       Boolean                 @default(true)
  /// AI tutor/solver conversations. FALSE unless the student explicitly opts in (aiConversationsConsentAt) AND the
  /// platform switch Setting `privacy.parentAiAccess.enabled` is on (default off pending legal review).
  canViewAiConversations   Boolean                 @default(false)
  aiConversationsConsentAt DateTime?               @db.Timestamptz(3)
  revokedAt                DateTime?               @db.Timestamptz(3)
  revokedById              String?                 @db.Uuid
  revokeReason             String?                 @db.VarChar(255)
  createdAt                DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                @updatedAt @db.Timestamptz(3)

  parent    User? @relation("ParentLinkParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  student   User? @relation("ParentLinkStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  revokedBy User? @relation("ParentLinkRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  /// Parent's children list (status = ACTIVE); covers the parentUserId FK. One OPEN episode per pair is a partial
  /// unique (raw SQL).
  @@index([parentUserId, status])
  /// Student's "who can see my progress" list and the parent-access check; covers the studentUserId FK.
  @@index([studentUserId, status])
  /// Covers the FK.
  @@index([revokedById])
}

/// A login session (§33, §39). The raw token (32 random bytes, cookie `__Host-dz_session` or bearer `dz_...`) is never
/// stored: tokenHash = SHA-256(token) hex. Sliding idle expiry in expiresAt; staff sessions also get an absolute
/// lifetime. Rotated on login and role change. lastSeenAt is written at most every 5 minutes.
model Session {
  id                String      @id @default(uuid(7)) @db.Uuid
  /// SHA-256(token) as 64 lower-case hex chars.
  tokenHash         String      @unique @db.Char(64)
  userId            String      @db.Uuid
  kind              SessionKind @default(WEB)
  authMethod        AuthMethod
  /// Device list label / API token name ("Chrome on Android", "Tablet app").
  label             String?     @db.VarChar(100)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  lastSeenAt        DateTime    @default(now()) @db.Timestamptz(3)
  /// Sliding idle expiry (students/parents/teachers 30 days; staff 12 h).
  expiresAt         DateTime    @db.Timestamptz(3)
  /// Hard cap regardless of activity (staff: 7 days). NULL = none.
  absoluteExpiresAt DateTime?   @db.Timestamptz(3)
  /// Last re-authentication (step-up within 15 min for refunds, role grants, settings).
  reauthenticatedAt DateTime?   @db.Timestamptz(3)
  revokedAt         DateTime?   @db.Timestamptz(3)
  /// e.g. "logout", "logout_all", "password_changed", "role_changed", "suspended", "rotated".
  revokedReason     String?     @db.VarChar(64)
  /// Truncated User-Agent for the device list.
  userAgent         String?     @db.VarChar(512)
  /// HMAC-SHA256(SESSION_SECRET, client IP) hex: lets support correlate sessions without storing IPs.
  ipHash            String?     @db.Char(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Device list (a handful of rows, sorted by lastSeenAt in memory) / "log out everywhere"; covers the userId FK.
  /// lastSeenAt and the sliding expiresAt are deliberately unindexed so the 5-minute session touch stays a HOT
  /// update; maintenance.purge finds expired sessions with a nightly sequential scan.
  @@index([userId])
}

/// A federated identity linked to a user (§33 "Google login where appropriate"). provider is a code key ("google";
/// later "apple", "microsoft") so adding one needs no migration. Only identity claims are kept, never tokens.
/// Auto-link on first Google login only when both sides have the same VERIFIED email (ARCHITECTURE §5.1).
model OAuthAccount {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @db.Uuid
  provider          String    @db.VarChar(32)
  /// Provider subject ("sub" claim). Stable per provider.
  providerAccountId String    @db.VarChar(255)
  /// Email claimed by the provider at last login (lower-cased), for support display.
  emailNormalized   String?   @db.VarChar(254)
  emailVerified     Boolean   @default(false)
  lastLoginAt       DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Login lookup.
  @@unique([provider, providerAccountId])
  /// One account per provider per user; covers the userId FK.
  @@unique([userId, provider])
}

/// One-time codes (OTP) for verification, passwordless login, reset, linking and step-up (§33, §39).
/// codeHash = HMAC-SHA256(SESSION_SECRET, purpose + target + code) hex; the code is never stored. 10 min TTL, 5 verify
/// attempts (attempts <= maxAttempts, CHECK). Issuing a new code for (target, purpose) consumes older live ones.
/// Send-rate limits (3 / 15 min per target, 20 / h per IP) are enforced through RateLimitBucket, not this table.
model VerificationCode {
  id          String              @id @default(uuid(7)) @db.Uuid
  purpose     VerificationPurpose
  channel     VerificationChannel
  /// Normalised destination: lower-cased email or E.164 phone (WhatsApp wa_id normalised to E.164).
  target      String              @db.VarChar(254)
  /// Known account (NULL for LOGIN_OTP to an unknown number before sign-up, or GUARDIAN_CONSENT to a guardian).
  userId      String?             @db.Uuid
  codeHash    String              @db.Char(64)
  attempts    Int                 @default(0) @db.SmallInt
  maxAttempts Int                 @default(5) @db.SmallInt
  /// Purpose-specific context (Zod-validated). Shape by purpose:
  /// PARENT_LINK { linkId: string } | CHANNEL_LINK { channel: "WHATSAPP"|"SMS"|"TELEGRAM", externalId: string } |
  /// GUARDIAN_CONSENT { studentUserId: string } | STEP_UP { sessionId: string } | others: {}
  context     Json?
  /// HMAC of the requesting IP (abuse investigation).
  ipHash      String?             @db.Char(64)
  expiresAt   DateTime            @db.Timestamptz(3)
  consumedAt  DateTime?           @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Verify: latest live code for (target, purpose); resend cooldown checks.
  @@index([target, purpose, createdAt])
  /// Covers the userId FK.
  @@index([userId])
  /// maintenance.purge (24 h after expiry).
  @@index([expiresAt])
}

/// Data-subject requests (§20 privacy, §39): JSON export and account deletion with a 14-day grace period
/// (ARCHITECTURE §5.13). The deletion job (accounts.deleteUser, full list in ARCHITECTURE §4.13) anonymises the User
/// and Profile; deletes sessions, OAuth links, codes, push subscriptions, parent links, channel identities, AI
/// conversations and messages, notifications, share cards; marks solver images, answer attachments and the avatar
/// DELETED (storage objects removed by a worker); unpublishes and blanks testimonials; archives and blanks personal
/// flashcards. One open DELETION request per user (partial unique, raw SQL).
model PrivacyRequest {
  id               String               @id @default(uuid(7)) @db.Uuid
  userId           String               @db.Uuid
  /// Who asked: the user, or staff acting on a verified request (then AuditLog has the reason).
  requestedById    String?              @db.Uuid
  kind             PrivacyRequestKind
  status           PrivacyRequestStatus @default(REQUESTED)
  /// EXPORT: now. DELETION: requested + 14 days (cancellable until then).
  scheduledFor     DateTime             @db.Timestamptz(3)
  completedAt      DateTime?            @db.Timestamptz(3)
  cancelledAt      DateTime?            @db.Timestamptz(3)
  failureReason    String?              @db.VarChar(500)
  /// EXPORT: object key of the JSON archive in the PRIVATE bucket; delivered via a short-lived signed URL.
  exportStorageKey String?              @db.VarChar(512)
  exportExpiresAt  DateTime?            @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)

  user        User  @relation("PrivacyRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  requestedBy User? @relation("PrivacyRequestRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  /// "My requests"; covers the userId FK.
  @@index([userId, createdAt])
  /// Worker: due requests.
  @@index([status, scheduledFor])
  /// Covers the FK.
  @@index([requestedById])
}

/// Web Push subscription of a browser/device (NotificationChannel PUSH). Removed when the push service returns 404/410.
model PushSubscription {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  /// Push service endpoint URL (unique per browser installation).
  endpoint   String    @unique
  /// Client public key (base64url) and auth secret from the PushSubscription JSON.
  p256dh     String    @db.VarChar(255)
  auth       String    @db.VarChar(255)
  userAgent  String?   @db.VarChar(512)
  lastUsedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Fan-out to a user's devices; covers the FK.
  @@index([userId])
}

// =====================================================================================================================
// ORGANISATIONS: schools, classes, announcements, notifications (§22, §23, §53)
// =====================================================================================================================

/// A school (§23; B2B and B2B2C customer, §53). Not tied to Zimbabwe: country, region and district are generic.
/// Never deleted: status CLOSED.
model School {
  id           String       @id @default(uuid(7)) @db.Uuid
  name         String       @db.VarChar(200)
  /// URL-safe identifier, unique platform-wide (CHECK format).
  slug         String       @unique @db.VarChar(120)
  countryId    String       @db.Uuid
  /// Province / region / state (Zimbabwe: province, e.g. "Harare Metropolitan").
  region       String?      @db.VarChar(100)
  district     String?      @db.VarChar(100)
  town         String?      @db.VarChar(100)
  type         SchoolType
  status       SchoolStatus @default(PENDING_VERIFICATION)
  /// Official identifier (ministry/EMIS number or exam-centre number), unique per country when present.
  officialCode String?      @db.VarChar(32)
  /// School-level contact for billing/admin (organisational, not a student's PII).
  contactEmail String?      @db.VarChar(254)
  contactPhone String?      @db.VarChar(16)
  website      String?      @db.VarChar(255)
  logoAssetId  String?      @db.Uuid
  /// Day boundaries for school analytics (defaults to the country's zone at creation).
  timezone     String       @default("Africa/Harare") @db.VarChar(64)
  /// School policy (Zod-validated). Shape:
  /// { version: 1, passMarkPercent?: number /* §23 pass rate; default from GradeScheme */,
  ///   allowStudentJoinRequests?: boolean, studentAiAccess?: "PLAN" | "HINTS_ONLY" | "DISABLED",
  ///   defaultAssignmentAiHelp?: "NONE" | "HINTS_ONLY" | "FULL", reportRecipientUserIds?: string[] }
  settings     Json?
  verifiedAt   DateTime?    @db.Timestamptz(3)
  verifiedById String?      @db.Uuid
  createdById  String?      @db.Uuid
  /// Dev-seed demo school (§50).
  isDemo       Boolean      @default(false)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  country           Country            @relation(fields: [countryId], references: [id], onDelete: Restrict)
  logoAsset         MediaAsset?        @relation(fields: [logoAssetId], references: [id], onDelete: SetNull)
  verifiedBy        User?              @relation("SchoolVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  createdBy         User?              @relation("SchoolCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members           SchoolMember[]
  subjects          SchoolSubject[]
  classes           Class[]
  invitations       Invitation[]
  announcements     Announcement[]
  students          Student[]
  subscriptions     Subscription[]
  payments          Payment[]
  entitlementGrants EntitlementGrant[]
  auditLogs         AuditLog[]
  reports           SchoolReport[]
  /// Username accounts created by this school's roster imports.
  provisionedUsers  User[]             @relation("UserProvisionedBySchool")
  // Back-relations (CURRICULUM & CONTENT slice)
  /// School-private, teacher-authored questions and tests (§22).
  questions         Question[]         @relation("QuestionSchool")
  assessments       Assessment[]       @relation("AssessmentSchool")

  /// De-duplication against official registers.
  @@unique([countryId, officialCode])
  /// Admin "Schools" filters by geography (§36); school directory in onboarding; covers the countryId FK.
  @@index([countryId, region, district])
  @@index([status])
  /// Covers the FKs.
  @@index([logoAssetId])
  @@index([verifiedById])
  @@index([createdById])
}

/// A user's role in a school (§22, §23). The ONLY source of school-scoped authority: SCHOOL_ADMIN is represented here,
/// and a teacher sees school data only through an ACTIVE TEACHER membership. A person can hold several roles in one
/// school (unique per role). studentNumber is the school's own admission number (STUDENT rows only, CHECK).
model SchoolMember {
  id            String             @id @default(uuid(7)) @db.Uuid
  schoolId      String             @db.Uuid
  userId        String             @db.Uuid
  role          SchoolMemberRole
  status        SchoolMemberStatus @default(INVITED)
  source        MembershipSource   @default(ADDED_BY_STAFF)
  studentNumber String?            @db.VarChar(32)
  invitedById   String?            @db.Uuid
  invitedAt     DateTime?          @db.Timestamptz(3)
  joinedAt      DateTime?          @db.Timestamptz(3)
  removedAt     DateTime?          @db.Timestamptz(3)
  removedById   String?            @db.Uuid
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)

  school    School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user      User   @relation("SchoolMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?  @relation("SchoolMemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  removedBy User?  @relation("SchoolMemberRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)

  /// One row per (school, user, role); covers the schoolId FK.
  @@unique([schoolId, userId, role])
  /// Admission numbers are unique within a school (roster import upserts on it).
  @@unique([schoolId, studentNumber])
  /// "My schools" + effective SCHOOL_ADMIN resolution at session load; covers the userId FK.
  @@index([userId, status])
  /// School rosters: teachers / students / admins by status (§23 manage teachers, manage students).
  @@index([schoolId, role, status])
  /// Covers the FKs.
  @@index([invitedById])
  @@index([removedById])
}

/// Subjects a school offers / has assigned (§23 "assign subjects"). Drives class creation choices, roster-import
/// enrolment defaults and school analytics filters.
model SchoolSubject {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @db.Uuid
  subjectId String   @db.Uuid
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  /// Covers the schoolId FK.
  @@unique([schoolId, subjectId])
  /// Schools offering a subject (§35); covers the subjectId FK.
  @@index([subjectId])
}

/// A teaching group (§22). schoolId is NULL for an independent tutor's class (whose private tests/questions use
/// Assessment/Question.ownerUserId). A school class can never move to another school (trigger: schoolId immutable
/// once set). Archived, never deleted (assignments and results keep referring to it). joinCode is a short shareable
/// code (CHECK format), rotatable, unique platform-wide.
model Class {
  id                   String    @id @default(uuid(7)) @db.Uuid
  schoolId             String?   @db.Uuid
  name                 String    @db.VarChar(120)
  description          String?   @db.VarChar(1000)
  subjectId            String?   @db.Uuid
  qualificationId      String?   @db.Uuid
  yearGroupId          String?   @db.Uuid
  /// e.g. "2026" or "2026/27" (academic calendars differ by country).
  academicYear         String    @db.VarChar(16)
  /// Upper-case [A-Z0-9]{6,10}; NULL when joining by code is switched off.
  joinCode             String?   @unique @db.VarChar(10)
  /// Code joins land in ClassMember PENDING until a teacher approves.
  joinRequiresApproval Boolean   @default(false)
  createdById          String    @db.Uuid
  archivedAt           DateTime? @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)

  school        School?        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  subject       Subject?       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  qualification Qualification? @relation(fields: [qualificationId], references: [id], onDelete: Restrict)
  yearGroup     YearGroup?     @relation(fields: [yearGroupId], references: [id], onDelete: Restrict)
  createdBy     User           @relation("ClassCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  teachers      ClassTeacher[]
  members       ClassMember[]
  invitations   Invitation[]
  announcements Announcement[]
  // Back-relations (LEARNING & ENGAGEMENT slice)
  assignments   Assignment[]

  /// School's classes per academic year (§23 create classes); covers the schoolId FK.
  @@index([schoolId, academicYear])
  /// Tutor's own classes (school-less); covers the FK.
  @@index([createdById])
  /// Covers the FKs; "classes for this subject" in school analytics.
  @@index([subjectId])
  @@index([qualificationId])
  @@index([yearGroupId])
}

/// Teachers of a class (§22). Authorization rule: a teacher sees a student's data only while both are ACTIVE in a
/// shared class (ClassTeacher.removedAt IS NULL and ClassMember.status = ACTIVE). At most one current LEAD per class
/// (partial unique, raw SQL). A current teacher of a SCHOOL class must hold an ACTIVE TEACHER or SCHOOL_ADMIN
/// SchoolMember row in that school (trigger); removing that membership ends the teacher's ClassTeacher rows in the
/// school (and a removed STUDENT membership ends the student's ClassMember rows) in the same transaction (trigger).
model ClassTeacher {
  id        String           @id @default(uuid(7)) @db.Uuid
  classId   String           @db.Uuid
  userId    String           @db.Uuid
  role      ClassTeacherRole @default(LEAD)
  addedAt   DateTime         @default(now()) @db.Timestamptz(3)
  removedAt DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Covers the classId FK.
  @@unique([classId, userId])
  /// "My classes" for a teacher and the teacher->student authorization join; covers the userId FK.
  @@index([userId, removedAt])
}

/// Students in a class (§22 "add students"). Rejoining reactivates the same row.
model ClassMember {
  id          String            @id @default(uuid(7)) @db.Uuid
  classId     String            @db.Uuid
  userId      String            @db.Uuid
  status      ClassMemberStatus @default(ACTIVE)
  source      MembershipSource  @default(JOIN_CODE)
  joinedAt    DateTime          @default(now()) @db.Timestamptz(3)
  removedAt   DateTime?         @db.Timestamptz(3)
  removedById String?           @db.Uuid
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  class     Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user      User  @relation("ClassMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  removedBy User? @relation("ClassMemberRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)

  /// Class roster / drill-down (§22); covers the classId FK.
  @@unique([classId, userId])
  /// Student's classes (assignments inbox, class leaderboards); covers the userId FK.
  @@index([userId, status])
  /// Covers the FK.
  @@index([removedById])
}

/// Out-of-band invitation delivered by email/SMS/WhatsApp to someone who may not have an account yet
/// (/invite/[token]): school staff and students, class members, and platform staff (staff never self-register).
/// Accepting creates/activates the SchoolMember / ClassMember row or grants platformRole. Only tokenHash is stored.
/// Invariants (CHECK): SCHOOL_MEMBER => schoolId & schoolRole; CLASS_MEMBER => classId; STAFF_ROLE => platformRole and
/// no school/class; platformRole never SCHOOL_ADMIN / STUDENT / PARENT.
model Invitation {
  id               String              @id @default(uuid(7)) @db.Uuid
  kind             InvitationKind
  schoolId         String?             @db.Uuid
  classId          String?             @db.Uuid
  schoolRole       SchoolMemberRole?
  platformRole     Role?
  channel          VerificationChannel
  /// Normalised email or E.164 phone of the invitee (needed to deliver and to match at sign-up). Nulled on accept.
  target           String?             @db.VarChar(254)
  /// SHA-256 hex of the URL token (32 random bytes).
  tokenHash        String              @unique @db.Char(64)
  invitedById      String?             @db.Uuid
  expiresAt        DateTime            @db.Timestamptz(3)
  lastSentAt       DateTime?           @db.Timestamptz(3)
  sendCount        Int                 @default(1) @db.SmallInt
  acceptedAt       DateTime?           @db.Timestamptz(3)
  acceptedByUserId String?             @db.Uuid
  revokedAt        DateTime?           @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)

  school     School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class      Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)
  invitedBy  User?   @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User?   @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  /// School admin's pending invitations; covers the schoolId FK.
  @@index([schoolId, createdAt])
  /// Covers the classId FK.
  @@index([classId])
  /// Match pending invitations when the invitee verifies this email/phone at sign-up.
  @@index([target, kind])
  /// Covers the FKs.
  @@index([invitedById])
  @@index([acceptedByUserId])
}

/// Announcement (§22 "send announcements", §25). GLOBAL (staff; optionally one country), SCHOOL (school admin) or
/// CLASS (class teacher). Body is markdown rendered with the strict pipeline profile at write time. Publishing
/// enqueues a `notifications.fanout` job (dedupe `fanout:{announcementId}`) that creates Notification rows in chunks.
/// Invariants (CHECK): GLOBAL => no school/class; SCHOOL => schoolId only; CLASS => classId only (the class's school is
/// reachable through Class); countryId only for GLOBAL.
model Announcement {
  id            String            @id @default(uuid(7)) @db.Uuid
  scope         AnnouncementScope
  schoolId      String?           @db.Uuid
  classId       String?           @db.Uuid
  /// GLOBAL announcements narrowed to one country (§53).
  countryId     String?           @db.Uuid
  authorId      String            @db.Uuid
  title         String            @db.VarChar(200)
  /// Markdown source (strict profile: no media, no raw HTML).
  body          String
  /// Sanitised HTML rendered at write time.
  bodyHtml      String
  /// Recipients' roles within the scope; empty = everyone in scope.
  audienceRoles Role[]            @default([])
  pinned        Boolean           @default(false)
  /// Also notify by push/email/WhatsApp (respecting preferences), not just in-app.
  notify        Boolean           @default(true)
  /// NULL = draft; future = scheduled.
  publishedAt   DateTime?         @db.Timestamptz(3)
  expiresAt     DateTime?         @db.Timestamptz(3)
  /// Fan-out finished.
  fannedOutAt   DateTime?         @db.Timestamptz(3)
  archivedAt    DateTime?         @db.Timestamptz(3)
  /// Dev-seed demo data (§50). Never true in production data (trigger, raw SQL).
  isDemo        Boolean           @default(false)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  school        School?        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class         Class?         @relation(fields: [classId], references: [id], onDelete: Cascade)
  country       Country?       @relation(fields: [countryId], references: [id], onDelete: Restrict)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  notifications Notification[]

  /// Global feed (and admin list).
  @@index([scope, publishedAt])
  /// School feed; covers the schoolId FK.
  @@index([schoolId, publishedAt])
  /// Class feed; covers the classId FK.
  @@index([classId, publishedAt])
  /// "My announcements" (teacher, §22); covers the authorId FK.
  @@index([authorId, createdAt])
  /// Covers the FK.
  @@index([countryId])
}

/// In-app inbox item for one user. Created directly by services or by fan-out jobs; delivery to other channels is a
/// `notifications.send` job per channel (dedupe `send:{notificationId}:{channel}`). `type` is a code-registered key
/// ("assignment.published", "parent_link.requested", "payment.succeeded", "subscription.expiring", "streak.reminder",
/// "flashcards.due", "ai.marking_ready", "announcement"...). Purged after the retention window (Setting).
model Notification {
  id             String                @id @default(uuid(7)) @db.Uuid
  userId         String                @db.Uuid
  type           String                @db.VarChar(64)
  category       NotificationCategory
  title          String                @db.VarChar(200)
  /// Plain text (no HTML); links go in data.
  body           String                @db.VarChar(2000)
  /// Type-specific payload (Zod schema per type). Common shape: { href?: string /* in-app path */,
  ///   entityType?: string, entityId?: string, [key: string]: unknown }. Never contains secrets; only data the recipient may already see.
  data           Json?
  /// Channels this notification was routed to after applying preferences and quiet hours.
  channels       NotificationChannel[] @default([IN_APP])
  /// Per-channel delivery results written by notifications.send. Shape:
  /// { [channel in "EMAIL"|"SMS"|"PUSH"|"WHATSAPP"]?: { status: "SENT"|"FAILED"|"SKIPPED", at: string,
  ///   providerRef?: string, error?: string } }
  deliveries     Json?
  /// Idempotency for fan-out and reminders, e.g. "announcement:{id}", "remind:2026-10-05". Unique per user.
  dedupeKey      String?               @db.VarChar(128)
  announcementId String?               @db.Uuid
  readAt         DateTime?             @db.Timestamptz(3)
  expiresAt      DateTime?             @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement    Announcement?    @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  channelMessages ChannelMessage[]

  /// Fan-out idempotency.
  @@unique([userId, dedupeKey])
  /// Unread badge and unread list (readAt IS NULL ... ORDER BY createdAt DESC); covers the userId FK.
  @@index([userId, readAt, createdAt])
  /// Full inbox, newest first (cursor pagination).
  @@index([userId, createdAt])
  /// Covers the FK (retracting an announcement's notifications).
  @@index([announcementId])
  /// Retention purge by age (append-mostly table; BRIN is tiny).
  @@index([createdAt], type: Brin)
}

/// A generated school report (§23 "generate reports": average score by subject, pass rate, topic performance,
/// engagement, teacher performance, readiness) for one period: the durable record of what was produced, for whom, by
/// whom and where the file is, so a term report emailed as a link can be re-downloaded and audited. The file is a
/// PRIVATE MediaAsset (purpose REPORT_EXPORT) readable by the school's ACTIVE SCHOOL_ADMINs; it is deleted after the
/// retention window (status EXPIRED, mediaAssetId NULL) while this row stays. Scheduled reports have no requester.
/// Invariants (CHECKs): periodEnd >= periodStart; READY => mediaAssetId and generatedAt.
model SchoolReport {
  id            String             @id @default(uuid(7)) @db.Uuid
  schoolId      String             @db.Uuid
  /// Code-registered report key, e.g. "term_summary", "subject_performance", "teacher_activity", "exam_readiness".
  kind          String             @db.VarChar(64)
  periodStart   DateTime           @db.Date
  periodEnd     DateTime           @db.Date
  /// Filters used (Zod per kind). Shape: { classIds?: string[], subjectIds?: string[], yearGroupIds?: string[],
  ///   format: "PDF" | "CSV" | "XLSX" }
  parameters    Json
  status        SchoolReportStatus @default(QUEUED)
  mediaAssetId  String?            @db.Uuid
  /// School admin who asked for it; NULL for scheduled reports (School.settings.reportRecipientUserIds).
  requestedById String?            @db.Uuid
  /// Queue row that generated it.
  jobId         String?            @db.Uuid
  generatedAt   DateTime?          @db.Timestamptz(3)
  /// When the file is deleted (status -> EXPIRED).
  expiresAt     DateTime?          @db.Timestamptz(3)
  error         String?            @db.VarChar(1000)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)

  school      School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  mediaAsset  MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  requestedBy User?       @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  job         Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// The school's reports, newest first; covers the schoolId FK.
  @@index([schoolId, createdAt])
  /// Covers the FKs.
  @@index([mediaAssetId])
  @@index([requestedById])
  @@index([jobId])
}

// =====================================================================================================================
// BILLING (§24, §31, §32, §46, §53)
// =====================================================================================================================

/// A subscription plan (§31): FREE / FULL_ACCESS (and the retired STUDENT / PREMIUM / SCHOOL, kept inactive for
/// history) are seed DATA, not code. Prices are PlanPrice rows; a ONE_OFF price is bought once (Payment purpose
/// PLAN_PURCHASE -> EntitlementGrant source PURCHASE), a renewable price through a Subscription.
/// entitlements is the plan's feature/limit map consumed by the pure resolver `resolveEntitlements` in
/// src/server/billing/entitlements.ts (ARCHITECTURE §7.6); keys are validated against that registry.
/// Plan changes apply to current subscribers immediately; to grandfather, create a new plan code.
/// Exactly one plan may have isDefault = true (the FREE fallback; partial unique, raw SQL).
model Plan {
  id           String       @id @default(uuid(7)) @db.Uuid
  /// Stable admin-chosen code, upper-case [A-Z][A-Z0-9_]{1,31} (CHECK), e.g. "FREE", "STUDENT", "PREMIUM", "SCHOOL".
  code         String       @unique @db.VarChar(32)
  name         String       @db.VarChar(100)
  tagline      String?      @db.VarChar(200)
  /// Markdown description for /pricing (CMS-managed, rule 5).
  description  String?
  /// Pricing-page bullet points (admin-managed copy; never hard-coded in components).
  highlights   String[]     @default([])
  audience     PlanAudience
  /// Feature flags + numeric limits (Zod-validated; keys from the entitlement registry). Shape:
  /// { version: 1,
  ///   lessonAccess: "FREE_ONLY" | "ALL",
  ///   aiModelTier: "FAST" | "STANDARD" | "DEEP"          /* highest routing tier allowed */,
  ///   features: { "lessons.full"?: boolean, "practice.unlimited"?: boolean, "daily_quiz"?: boolean,
  ///               "mock_exams"?: boolean, "flashcards"?: boolean, "study_plan"?: boolean, "ai_tutor"?: boolean,
  ///               "ai_solver"?: boolean, "ai_deep"?: boolean, "analytics.advanced"?: boolean,
  ///               "personalised_learning"?: boolean, "teacher_dashboard"?: boolean, "assignments"?: boolean,
  ///               "school_analytics"?: boolean, "whatsapp"?: boolean },
  ///   limits:   { "practice.questionsPerDay"?: number | null   /* null = unlimited */,
  ///               "lessons.freePerSubject"?: number | null, "mock_exams.perMonth"?: number | null,
  ///               "ai.messagesPerDay"?: number, "ai.solverImagesPerDay"?: number, "ai.deepMessagesPerDay"?: number,
  ///               "ai.maxTurnsPerConversation"?: number, "ai.marking.perDay"?: number,
  ///               "flashcards.personalMax"?: number | null, "seats.included"?: number } }
  /// Combination rule (resolver): features = union of all sources; limits = maximum (null beats any number).
  entitlements Json
  /// Free trial length for new subscribers (0 = none).
  trialDays    Int          @default(0) @db.SmallInt
  /// Listed on /pricing. Non-public plans can be assigned by staff (pilots, partner deals).
  isPublic     Boolean      @default(true)
  /// Inactive plans cannot be bought; existing subscriptions keep working until they end.
  isActive     Boolean      @default(true)
  /// The fallback plan for users without any paid source (FREE).
  isDefault    Boolean      @default(false)
  sortOrder    Int          @default(0)
  /// Dev-seed demo data (§50). Never true in production data (trigger, raw SQL).
  isDemo       Boolean      @default(false)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  prices             PlanPrice[]
  subscriptions      Subscription[]
  entitlementGrants  EntitlementGrant[]
  promoCodePlans     PromoCodePlan[]
  promoCodesGranting PromoCode[]        @relation("PromoCodeGrantPlan")

  /// /pricing and /schools listing.
  @@index([isActive, isPublic, audience, sortOrder])
}

/// A price for a Plan (subscription) or a StudyPack (one-off purchase, §24) in one currency and interval. Prices are
/// NEVER edited in place (trigger, raw SQL): every price-defining column is frozen; a change = new row + deactivate
/// the old one (isActive / validTo / label / sortOrder remain editable). Payments and subscriptions point at the
/// exact price they used, so history is exact.
/// Invariants (CHECK): exactly one of planId / studyPackId; amountMinor >= 0; currency ISO 4217 upper-case;
/// TERM => periodDays; study-pack prices are ONE_OFF; perSeat only for plans; validTo > validFrom.
model PlanPrice {
  id            String          @id @default(uuid(7)) @db.Uuid
  planId        String?         @db.Uuid
  studyPackId   String?         @db.Uuid
  /// Country-specific price (§53); NULL = available in every country.
  countryId     String?         @db.Uuid
  /// ISO 4217, e.g. "USD", "ZWG", "ZAR".
  currency      String          @db.Char(3)
  /// Price in minor units (cents). For perSeat prices: per seat per period.
  amountMinor   Int
  interval      BillingInterval
  /// e.g. 3 + MONTH = quarterly.
  intervalCount Int             @default(1) @db.SmallInt
  /// Explicit period length in days: required for TERM; for ONE_OFF the access window (NULL = no expiry).
  periodDays    Int?            @db.SmallInt
  /// School seat pricing (§53 B2B): amountMinor x seats.
  perSeat       Boolean         @default(false)
  minSeats      Int?
  /// Admin label, e.g. "Term 1 2027", "Launch price".
  label         String?         @db.VarChar(100)
  isActive      Boolean         @default(true)
  validFrom     DateTime        @default(now()) @db.Timestamptz(3)
  validTo       DateTime?       @db.Timestamptz(3)
  sortOrder     Int             @default(0)
  /// Dev-seed demo price (§50). Never true in production data (trigger, raw SQL).
  isDemo        Boolean         @default(false)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  plan          Plan?          @relation(fields: [planId], references: [id], onDelete: Restrict)
  studyPack     StudyPack?     @relation(fields: [studyPackId], references: [id], onDelete: Restrict)
  country       Country?       @relation(fields: [countryId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]
  payments      Payment[]

  /// Price selection for a plan in a currency (/pricing, checkout); covers the planId FK.
  @@index([planId, isActive, currency])
  /// Study pack price lookup (§24); covers the studyPackId FK.
  @@index([studyPackId, isActive, currency])
  /// Covers the FK.
  @@index([countryId])
}

/// A subscription held by EITHER a user (B2C; payer may differ, e.g. a parent paying for a child) OR a school (B2B /
/// B2B2C with seats) — XOR CHECK (raw SQL). Mobile money has no reliable recurring debit, so subscriptions are
/// prepaid periods: each SUCCESSFUL payment extends currentPeriodEnd (ARCHITECTURE §7.5); providers with recurring
/// billing (Stripe) set autoRenew + providerSubscriptionRef.
/// At most one TRIALING/ACTIVE/PAST_DUE subscription per holder (partial uniques, raw SQL); plan.audience matches the
/// holder type: INDIVIDUAL for a user, SCHOOL for a school (trigger). School seat consumption = active
/// EntitlementGrant(SCHOOL_SEAT) rows <= seats (service, under SELECT ... FOR UPDATE on this row).
model Subscription {
  id                      String             @id @default(uuid(7)) @db.Uuid
  planId                  String             @db.Uuid
  /// Price used for the current period / next renewal.
  planPriceId             String?            @db.Uuid
  /// B2C holder (the beneficiary student).
  holderUserId            String?            @db.Uuid
  /// B2B holder.
  schoolId                String?            @db.Uuid
  /// Default payer for renewals when different from the holder (parent/sponsor; school bursar).
  payerUserId             String?            @db.Uuid
  status                  SubscriptionStatus @default(PENDING)
  source                  SubscriptionSource @default(CHECKOUT)
  /// Purchased seats (school subscriptions only, CHECK).
  seats                   Int?
  startedAt               DateTime?          @db.Timestamptz(3)
  currentPeriodStart      DateTime?          @db.Timestamptz(3)
  /// Access ends at currentPeriodEnd + grace (Setting `billing.graceDays`).
  currentPeriodEnd        DateTime?          @db.Timestamptz(3)
  trialEndsAt             DateTime?          @db.Timestamptz(3)
  /// Stop at period end (status stays ACTIVE until then, then EXPIRED).
  cancelAtPeriodEnd       Boolean            @default(false)
  cancelledAt             DateTime?          @db.Timestamptz(3)
  cancelReason            String?            @db.VarChar(500)
  /// When access actually ended (EXPIRED / CANCELLED).
  endedAt                 DateTime?          @db.Timestamptz(3)
  autoRenew               Boolean            @default(false)
  /// Provider key ("stripe"...) when the provider manages recurring billing; NULL for prepaid periods.
  provider                String?            @db.VarChar(32)
  providerSubscriptionRef String?            @db.VarChar(255)
  /// Staff member who created it (source ADMIN / SCHOOL_CONTRACT).
  createdById             String?            @db.Uuid
  /// Staff notes, e.g. contract/invoice reference for a school deal.
  notes                   String?            @db.VarChar(2000)
  /// Provider-specific extras (redacted). Shape: { [key: string]: string | number | boolean }
  metadata                Json?
  createdAt               DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime           @updatedAt @db.Timestamptz(3)

  plan       Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  planPrice  PlanPrice?         @relation(fields: [planPriceId], references: [id], onDelete: Restrict)
  holder     User?              @relation("SubscriptionHolder", fields: [holderUserId], references: [id], onDelete: Restrict)
  school     School?            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  payer      User?              @relation("SubscriptionPayer", fields: [payerUserId], references: [id], onDelete: SetNull)
  createdBy  User?              @relation("SubscriptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  payments   Payment[]
  seatGrants EntitlementGrant[]

  /// Provider webhook lookup.
  @@unique([provider, providerSubscriptionRef])
  /// Entitlement resolution and "my subscription"; covers the holderUserId FK.
  @@index([holderUserId, status])
  /// School billing page and seat checks; covers the schoolId FK.
  @@index([schoolId, status])
  /// "Subscriptions I pay for" (parent billing page); covers the FK.
  @@index([payerUserId])
  /// Paid students per plan (§35 conversion, admin Subscriptions); covers the planId FK.
  @@index([planId, status])
  /// Covers the FK.
  @@index([planPriceId])
  /// billing.lifecycle job: expiries, renewal reminders (7 days / 1 day before end).
  @@index([status, currentPeriodEnd])
  /// Covers the FK.
  @@index([createdById])
}

/// One payment attempt (§32). Provider-agnostic: provider is a code key ("sandbox", "paynow", "stripe"...), so adding a
/// provider needs no migration. Amount and currency always come from OUR row (never the provider's) and are frozen
/// after insert (trigger, raw SQL). State machine in pure code (ARCHITECTURE §7.2): a verified provider "paid" event
/// may move FAILED/CANCELLED to SUCCESSFUL; nothing else leaves a terminal state. Fulfilment (period extension,
/// EntitlementGrant) happens once, recorded by fulfilledAt under SELECT ... FOR UPDATE.
/// Invariants (CHECK): exactly one of beneficiaryUserId / schoolId; purpose-specific references present; status
/// timestamps present; amountMinor > 0 (a 100% discount is not a payment: use a FREE_DAYS promo); 0 <=
/// refundedAmountMinor <= amountMinor; REFUNDED => fully refunded. PLAN_PURCHASE => planPriceId + beneficiaryUserId,
/// no subscription and no study pack.
/// Invariants (trigger Payment_guard): money and party columns frozen after insert; fulfilledAt, paidAt, receiptNumber,
/// servicePeriodStart/End and payerFingerprint are write-once; refundedAmountMinor never decreases; legal status
/// transitions only. A SUBSCRIPTION/SEATS payment's subscription belongs to the same beneficiary user / school
/// (trigger Payment_subscription_guard).
/// Retention: statutory accounting period (assume 6 years); users with payments are anonymised, never deleted.
model Payment {
  id                  String         @id @default(uuid(7)) @db.Uuid
  purpose             PaymentPurpose
  status              PaymentStatus  @default(PENDING)
  provider            String         @db.VarChar(32)
  /// Payment method key within the provider: "ecocash", "onemoney", "zimswitch", "card", "bank_transfer"...
  method              String?        @db.VarChar(32)
  /// Provider's transaction reference (unique per provider once known).
  providerReference   String?        @db.VarChar(255)
  /// Provider status-poll URL (Paynow). Server-side only; never sent to clients.
  providerPollUrl     String?        @db.VarChar(1024)
  /// Who initiated and pays (student, parent/sponsor, or school admin for school purchases).
  payerUserId         String         @db.Uuid
  /// B2C beneficiary (whose subscription/pack); NULL for school purchases.
  beneficiaryUserId   String?        @db.Uuid
  /// B2B beneficiary.
  schoolId            String?        @db.Uuid
  subscriptionId      String?        @db.Uuid
  studyPackId         String?        @db.Uuid
  planPriceId         String?        @db.Uuid
  promoCodeId         String?        @db.Uuid
  /// Amount charged, minor units, after discount.
  amountMinor         Int
  currency            String         @db.Char(3)
  /// Price before discount (= amountMinor + discountMinor, CHECK).
  listAmountMinor     Int?
  discountMinor       Int            @default(0)
  /// Seats bought (SEATS / per-seat subscription) or 1.
  quantity            Int            @default(1)
  /// Client Idempotency-Key (double tap / flaky network retry returns the same Payment); unique per payer.
  idempotencyKey      String         @db.VarChar(64)
  /// Human-readable receipt number assigned on SUCCESSFUL (e.g. "R-2026-000123").
  receiptNumber       String?        @unique @db.VarChar(32)
  /// Service period this payment bought (subscriptions) — the period ledger used for revenue recognition.
  servicePeriodStart  DateTime?      @db.Timestamptz(3)
  servicePeriodEnd    DateTime?      @db.Timestamptz(3)
  /// PENDING payments not confirmed by this time are CANCELLED by payments.reconcile (default 24 h).
  expiresAt           DateTime?      @db.Timestamptz(3)
  paidAt              DateTime?      @db.Timestamptz(3)
  failedAt            DateTime?      @db.Timestamptz(3)
  cancelledAt         DateTime?      @db.Timestamptz(3)
  /// Order fulfilled (subscription extended / grant issued). Set exactly once.
  fulfilledAt         DateTime?      @db.Timestamptz(3)
  /// Normalised failure code ("declined", "insufficient_funds", "expired", "amount_mismatch", "user_cancelled"...).
  failureCode         String?        @db.VarChar(64)
  failureReason       String?        @db.VarChar(500)
  refundedAmountMinor Int            @default(0)
  refundedAt          DateTime?      @db.Timestamptz(3)
  refundReason        String?        @db.VarChar(500)
  refundedById        String?        @db.Uuid
  /// HMAC of the paying wallet number / card fingerprint (never the raw value): duplicate-payer checks for referral
  /// rewards and fraud review (ARCHITECTURE §7.6).
  payerFingerprint    String?        @db.Char(64)
  /// Redacted provider details for display/support. Shape: { maskedMsisdn?: string /* "+263 77* *** 567" */,
  ///   cardBrand?: string, cardLast4?: string, providerStatus?: string, instructions?: string }
  metadata            Json?
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)

  payer              User              @relation("PaymentPayer", fields: [payerUserId], references: [id], onDelete: Restrict)
  beneficiary        User?             @relation("PaymentBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Restrict)
  school             School?           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  subscription       Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  studyPack          StudyPack?        @relation(fields: [studyPackId], references: [id], onDelete: Restrict)
  planPrice          PlanPrice?        @relation(fields: [planPriceId], references: [id], onDelete: Restrict)
  promoCode          PromoCode?        @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  refundedBy         User?             @relation("PaymentRefundedBy", fields: [refundedById], references: [id], onDelete: SetNull)
  events             PaymentEvent[]
  entitlementGrant   EntitlementGrant?
  promoRedemption    PromoRedemption?
  qualifiedReferrals Referral[]

  /// Idempotent checkout; "my payments" (payer prefix); covers the payerUserId FK.
  @@unique([payerUserId, idempotencyKey])
  /// Webhook/poll lookup by provider reference.
  @@unique([provider, providerReference])
  /// Beneficiary payment history (student billing page); covers the FK.
  @@index([beneficiaryUserId, createdAt])
  /// School billing history; covers the FK.
  @@index([schoolId, createdAt])
  /// Subscription payment ledger; covers the FK.
  @@index([subscriptionId, createdAt])
  /// Covers the FKs.
  @@index([studyPackId])
  @@index([planPriceId])
  @@index([promoCodeId])
  @@index([refundedById])
  /// Admin Payments list filtered by status, newest first (§36).
  @@index([status, createdAt])
  /// Admin Payments list unfiltered or filtered by provider / date range / currency, newest first, and its keyset
  /// cursor (createdAt DESC, id DESC) without sorting the payment history (perf_indexes migration).
  @@index([createdAt, id])
  /// Duplicate-payer checks (referrals, fraud).
  @@index([payerFingerprint])
}

/// Raw, redacted log of every provider callback, poll result, return-URL hit, manual action and reconciliation line
/// (§32 "proper transaction records"). Append-only (trigger): only processedAt / paymentId (once, NULL -> value) and
/// processingError may be updated; rows are deleted only by the retention purge after 6 years.
/// Idempotency: unique (provider, providerEventId) among AUTHENTIC rows only (partial unique WHERE signatureValid, raw
/// SQL; insert with ON CONFLICT ... WHERE "signatureValid" DO NOTHING). Paynow sends no event id, so the adapter uses a
/// synthetic id = sha256(reference + status + provider reference): an unsigned forgery with a guessed id is stored for
/// investigation but can never claim the key and suppress the genuine signed webhook or poll. Rows with
/// signatureValid = false are never processed. paymentId is NULL when the reference matched no payment.
model PaymentEvent {
  id              String             @id @default(uuid(7)) @db.Uuid
  paymentId       String?            @db.Uuid
  provider        String             @db.VarChar(32)
  providerEventId String             @db.VarChar(255)
  source          PaymentEventSource
  /// Provider event type ("payment.succeeded", "paynow.status_update"...).
  eventType       String             @db.VarChar(64)
  /// Status as reported by the provider (raw string).
  providerStatus  String?            @db.VarChar(64)
  /// Our state-machine target derived from this event (NULL = informational).
  mappedStatus    PaymentStatus?
  /// Amount/currency reported by the provider, compared with the Payment row (mismatch => manual review).
  amountMinor     Int?
  currency        String?            @db.Char(3)
  /// Authenticity verified: webhook signature/hash checked, or the data came from our own server-side poll, a
  /// reconciliation file or a staff action. RETURN_URL hits are always false (they only trigger a poll).
  signatureValid  Boolean
  /// Raw payload with secrets/PII redacted (card data never present; phone numbers masked).
  payload         Json
  processedAt     DateTime?          @db.Timestamptz(3)
  processingError String?
  /// Staff member for MANUAL events.
  recordedById    String?            @db.Uuid
  /// Receipt time.
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)

  payment    Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  recordedBy User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  /// Lookup of all rows for a provider event id (incl. rejected forgeries). Idempotency is the partial unique
  /// PaymentEvent_provider_event_valid_key (raw SQL).
  @@index([provider, providerEventId])
  /// Payment timeline in admin; covers the paymentId FK.
  @@index([paymentId, createdAt])
  /// Covers the FK.
  @@index([recordedById])
  /// Time-range scans for reconciliation and retention (append-only table).
  @@index([createdAt], type: Brin)
}

/// Time-boxed (or open-ended) access grant from a non-subscription source (ARCHITECTURE §7.6): study pack purchase
/// (§24), one-off plan purchase (PURCHASE: lifetime "Full access"), referral reward (§46), promo free days, admin grant,
/// compensation, and school SEATS allocated to students (B2B2C, §53).
/// What is granted: a whole plan's entitlements (planId), a study pack's scope + feature keys (studyPackId), and/or an
/// explicit feature map (features). Held by a user or a school (XOR, CHECK).
/// Invariants (CHECK): STUDY_PACK => studyPackId; SCHOOL_SEAT => userId + subscriptionId (the funding school
/// subscription; the grant is valid only while that subscription is live); ADMIN / COMPENSATION => grantedById and a
/// non-blank reason; endsAt > startsAt. paymentId unique => a payment fulfils at most one grant (double-fulfilment
/// guard). One active seat per (subscription, user) (partial unique, raw SQL). PURCHASE => userId + planId + paymentId;
/// one unrevoked open-ended PURCHASE grant per (user, plan) (partial unique, raw SQL).
/// Invariants (trigger EntitlementGrant_link_guard): a paymentId names a SUCCESSFUL payment for the same beneficiary
/// user / school (and the same study pack); a PURCHASE grant names a PLAN_PURCHASE payment for that plan's price (and
/// only PURCHASE grants name one); a SCHOOL_SEAT grant is funded by a SCHOOL-held subscription.
model EntitlementGrant {
  id             String            @id @default(uuid(7)) @db.Uuid
  userId         String?           @db.Uuid
  schoolId       String?           @db.Uuid
  source         EntitlementSource
  planId         String?           @db.Uuid
  studyPackId    String?           @db.Uuid
  /// Explicit grant (Zod-validated, same key registry as Plan.entitlements). Shape:
  /// { features?: { [featureKey: string]: boolean }, limits?: { [limitKey: string]: number | null },
  ///   scope?: { subjectIds?: string[], qualificationIds?: string[] } /* restrict to these subjects */ }
  features       Json?
  /// SCHOOL_SEAT: the school subscription funding the seat.
  subscriptionId String?           @db.Uuid
  paymentId      String?           @unique @db.Uuid
  startsAt       DateTime          @default(now()) @db.Timestamptz(3)
  /// NULL = open-ended (seats: bounded by the funding subscription; packs with no expiry).
  endsAt         DateTime?         @db.Timestamptz(3)
  revokedAt      DateTime?         @db.Timestamptz(3)
  revokedById    String?           @db.Uuid
  revokeReason   String?           @db.VarChar(500)
  grantedById    String?           @db.Uuid
  /// Staff-visible reason (ADMIN / COMPENSATION).
  reason         String?           @db.VarChar(500)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  user              User?            @relation("EntitlementGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  school            School?          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  plan              Plan?            @relation(fields: [planId], references: [id], onDelete: Restrict)
  studyPack         StudyPack?       @relation(fields: [studyPackId], references: [id], onDelete: Restrict)
  subscription      Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  payment           Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  revokedBy         User?            @relation("EntitlementGrantRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  /// Restrict: staff attribution of free access must survive (users are anonymised, never hard-deleted).
  grantedBy         User?            @relation("EntitlementGrantGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  promoRedemption   PromoRedemption?
  referrerRewardFor Referral?        @relation("ReferralReferrerReward")
  refereeRewardFor  Referral?        @relation("ReferralRefereeReward")

  /// Entitlement resolution: a user's live grants (revokedAt IS NULL AND startsAt <= now AND (endsAt IS NULL OR
  /// endsAt > now)); covers the userId FK.
  @@index([userId, endsAt])
  /// School-held grants; covers the FK.
  @@index([schoolId, endsAt])
  /// Seat counting per school subscription; covers the FK.
  @@index([subscriptionId, revokedAt])
  /// Covers the FKs.
  @@index([planId])
  @@index([studyPackId])
  @@index([revokedById])
  @@index([grantedById])
}

/// A promo code (§31 admin-configurable; ARCHITECTURE §7.6). Codes are stored upper-case (CHECK) and matched
/// case-insensitively by upper-casing input. redeemedCount counts APPLIED redemptions and is incremented under
/// SELECT ... FOR UPDATE; redeemedCount <= maxRedemptions (CHECK).
/// Invariants (CHECK): PERCENT => percentOff 1..99; FIXED_AMOUNT => amountOffMinor > 0 and currency (checkout rejects a
/// fixed discount >= the list price); FREE_DAYS => freeDays > 0 and grantPlanId. A full (100%) discount is always
/// FREE_DAYS: it grants via EntitlementGrant(source PROMO) with no Payment, because a Payment is never zero.
model PromoCode {
  id                  String            @id @default(uuid(7)) @db.Uuid
  code                String            @unique @db.VarChar(32)
  /// Internal description (campaign, partner).
  description         String?           @db.VarChar(500)
  discountType        PromoDiscountType
  percentOff          Int?              @db.SmallInt
  amountOffMinor      Int?
  currency            String?           @db.Char(3)
  freeDays            Int?              @db.SmallInt
  grantPlanId         String?           @db.Uuid
  /// Restrict to individual or school purchases; NULL = any.
  audience            PlanAudience?
  /// Also valid on study pack purchases.
  appliesToStudyPacks Boolean           @default(false)
  /// Only for users without any previous SUCCESSFUL payment.
  newCustomersOnly    Boolean           @default(false)
  /// NULL = unlimited.
  maxRedemptions      Int?
  redeemedCount       Int               @default(0)
  validFrom           DateTime          @default(now()) @db.Timestamptz(3)
  validTo             DateTime?         @db.Timestamptz(3)
  isActive            Boolean           @default(true)
  /// Dev-seed demo code (§50). Never true in production data (trigger, raw SQL).
  isDemo              Boolean           @default(false)
  createdById         String?           @db.Uuid
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)

  grantPlan   Plan?             @relation("PromoCodeGrantPlan", fields: [grantPlanId], references: [id], onDelete: Restrict)
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  plans       PromoCodePlan[]
  redemptions PromoRedemption[]
  payments    Payment[]

  /// Covers the FKs.
  @@index([grantPlanId])
  @@index([createdById])
}

/// Plans a promo code applies to. No rows = applies to every plan (of the code's audience).
model PromoCodePlan {
  id          String   @id @default(uuid(7)) @db.Uuid
  promoCodeId String   @db.Uuid
  planId      String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)

  /// Covers the promoCodeId FK.
  @@unique([promoCodeId, planId])
  /// Covers the FK.
  @@index([planId])
}

/// One user's use of a promo code: reserved at checkout, applied on payment success (or immediately for FREE_DAYS),
/// released when the checkout fails. One per (code, user).
model PromoRedemption {
  id            String                @id @default(uuid(7)) @db.Uuid
  promoCodeId   String                @db.Uuid
  userId        String                @db.Uuid
  status        PromoRedemptionStatus @default(RESERVED)
  paymentId     String?               @unique @db.Uuid
  /// FREE_DAYS grant.
  grantId       String?               @unique @db.Uuid
  discountMinor Int?
  currency      String?               @db.Char(3)
  appliedAt     DateTime?             @db.Timestamptz(3)
  releasedAt    DateTime?             @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)

  promoCode PromoCode         @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment   Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  grant     EntitlementGrant? @relation(fields: [grantId], references: [id], onDelete: SetNull)

  /// One redemption per user per code; covers the promoCodeId FK.
  @@unique([promoCodeId, userId])
  /// Covers the FK.
  @@index([userId])
}

/// A user's personal referral code (§46). Upper-case (CHECK). Regenerating replaces `code` on the same row.
model ReferralCode {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @unique @db.Uuid
  code       String    @unique @db.VarChar(32)
  isActive   Boolean   @default(true)
  disabledAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals Referral[]

  /// Target of Referral's composite FK (keeps the denormalised referrerUserId honest).
  @@unique([id, userId])
}

/// Attribution of a sign-up to a referral code (§46 "referral codes, referral rewards"). Each user can be referred
/// once (referredUserId unique). Reward rule and per-referrer caps live in Setting `growth.referral`; the default
/// qualifying event is the referred user's first SUCCESSFUL payment, checked against the same payer fingerprint /
/// phone (ARCHITECTURE §7.6). Rewards are EntitlementGrants (source REFERRAL) for the referrer and optionally the
/// referee. Invariants: referrer <> referred (CHECK); referrerUserId = referralCode.userId (composite FK).
model Referral {
  id                   String         @id @default(uuid(7)) @db.Uuid
  referralCodeId       String         @db.Uuid
  referrerUserId       String         @db.Uuid
  referredUserId       String         @unique @db.Uuid
  status               ReferralStatus @default(PENDING)
  qualifyingPaymentId  String?        @db.Uuid
  qualifiedAt          DateTime?      @db.Timestamptz(3)
  rewardGrantId        String?        @unique @db.Uuid
  refereeRewardGrantId String?        @unique @db.Uuid
  rewardedAt           DateTime?      @db.Timestamptz(3)
  rejectedAt           DateTime?      @db.Timestamptz(3)
  /// "self_referral", "duplicate_payer", "cap_reached", "fraud"...
  rejectReason         String?        @db.VarChar(64)
  /// HMAC of the sign-up IP (abuse heuristics only).
  signupIpHash         String?        @db.Char(64)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)

  referralCode       ReferralCode      @relation(fields: [referralCodeId, referrerUserId], references: [id, userId], onDelete: Cascade)
  referrer           User              @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred           User              @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)
  qualifyingPayment  Payment?          @relation(fields: [qualifyingPaymentId], references: [id], onDelete: SetNull)
  rewardGrant        EntitlementGrant? @relation("ReferralReferrerReward", fields: [rewardGrantId], references: [id], onDelete: SetNull)
  refereeRewardGrant EntitlementGrant? @relation("ReferralRefereeReward", fields: [refereeRewardGrantId], references: [id], onDelete: SetNull)

  /// Covers the composite FK (leading referralCodeId).
  @@index([referralCodeId, referrerUserId])
  /// "My referrals" and the per-referrer reward cap; covers the referrerUserId FK.
  @@index([referrerUserId, status, createdAt])
  /// Covers the FK.
  @@index([qualifyingPaymentId])
}

// =====================================================================================================================
// AI (§14, §15, §40, §41)
// Model routing lives in Setting `ai.routing` (task -> tier -> model, effort, max_tokens, cacheable); prices in
// `ai.pricing`; global switches in `ai.enabled` / `ai.features`; global caps in `ai.quotas` / `ai.dailyBudgetMicros`.
// Per-plan quotas live in Plan.entitlements.limits ("ai.messagesPerDay"...). See notes §AI configuration.
// =====================================================================================================================

/// An AI tutor or solver conversation. PRIVATE to the student: never shown to teachers, school admins or admins
/// (ARCHITECTURE §5.2, §5.3); parents only through ParentStudentLink.canViewAiConversations with explicit student
/// consent; SUPER_ADMIN break-glass only with a reason, step-up auth and an AuditLog entry. Deleted (not anonymised)
/// on account deletion. Model/tier are sticky per conversation (prompt-cache prefixes are model-scoped).
/// Enforced in the DATABASE, not only in services: ROW LEVEL SECURITY (FORCE) on AiConversation and AiMessage (raw SQL)
/// shows a row only when the transaction has set app.user_id to the owner (src/server/ai sets it with
/// set_config(..., true)), app.ai_scope = 'parent' for a consenting ACTIVE parent link, or app.ai_scope = 'system' /
/// 'break_glass' (workers; audited break-glass). Any other query (a careless include from Subject/Topic/Question, an
/// admin screen) returns nothing. No teacher-owned model has a relation to this table (assignmentId is a plain id).
model AiConversation {
  id                String               @id @default(uuid(7)) @db.Uuid
  userId            String               @db.Uuid
  mode              AiConversationMode
  status            AiConversationStatus @default(ACTIVE)
  /// Where it happens (web, app/API, WhatsApp micro-explanations).
  channel           ActivityChannel      @default(WEB)
  /// Context the student opened the tutor from (§14 "knows ... subject, current topic").
  subjectId         String?              @db.Uuid
  topicId           String?              @db.Uuid
  /// Bank question the student asked about (practice review "explain my mistake").
  questionId        String?              @db.Uuid
  /// Teacher assignment the help is for. Plain id, deliberately NOT a relation (no navigable path from a teacher-owned
  /// Assignment to private conversations) and not indexed (nothing may list conversations by assignment).
  assignmentId      String?              @db.Uuid
  /// Assignment.aiHelp snapshotted at conversation start; the tutor enforces it on every turn (ARCHITECTURE §6.4).
  /// NULL = not assignment work (plan rules only).
  aiHelp            AssignmentAiHelp?
  title             String?              @db.VarChar(200)
  /// Sticky routing decision for the conversation.
  modelTier         AiModelTier?
  model             String?              @db.VarChar(64)
  promptVersion     String?              @db.VarChar(32)
  /// Compact, PII-free learning context frozen at start so the cached prompt prefix stays stable (§14, §40
  /// "don't send unnecessary context"). Shape: { version: 1, board: string, qualification: string,
  ///   subject?: string, topic?: string, masteryBand?: "WEAK"|"DEVELOPING"|"COMPETENT"|"STRONG"|"MASTERED",
  ///   recentMistakes?: { topic: string, summary: string }[] /* max 3 */, targetGrade?: string,
  ///   daysToExam?: number, builtAt: string }
  contextSnapshot   Json?
  /// FAST-tier rolling summary of turns older than the last 8 (context cap).
  summary           String?
  /// Messages created at or before this instant are covered by `summary`.
  summarizedThrough DateTime?            @db.Timestamptz(3)
  // --- counters (denormalised from AiMessage for limits and the history list) ---
  messageCount      Int                  @default(0)
  /// USER turns, checked against Plan limit "ai.maxTurnsPerConversation" (§40 conversation limits).
  userMessageCount  Int                  @default(0)
  inputTokens       Int                  @default(0)
  outputTokens      Int                  @default(0)
  cacheReadTokens   Int                  @default(0)
  cacheWriteTokens  Int                  @default(0)
  /// USD micro-dollars (1e-6 USD).
  costMicros        Int                  @default(0)
  lastMessageAt     DateTime?            @db.Timestamptz(3)
  archivedAt        DateTime?            @db.Timestamptz(3)
  /// Safeguarding/abuse signal (refusal category, disclosure detected); enables break-glass review.
  safetyFlaggedAt   DateTime?            @db.Timestamptz(3)
  safetyCategory    String?              @db.VarChar(64)
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject  Subject?    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic    Topic?      @relation(fields: [topicId], references: [id], onDelete: Restrict)
  question Question?   @relation(fields: [questionId], references: [id], onDelete: Restrict)
  messages AiMessage[]

  /// Conversation history list (owner only), most recently active first; covers the userId FK. Kept despite the
  /// per-turn lastMessageAt write (~50k/day): it is the main tutor UI query and the table is small.
  @@index([userId, status, lastMessageAt])
  /// Covers the FKs (AI usage by subject/topic analytics run under app.ai_scope = 'system').
  @@index([subjectId])
  @@index([topicId])
  @@index([questionId])
}

/// One turn in an AI conversation, with full metering (§40 token tracking). Content of messages older than 12 months
/// is purged (content = '', contentPurgedAt set) while metering columns are kept (ARCHITECTURE §5.13).
/// Row level security: visible only through a visible AiConversation (policy, raw SQL). Nothing references AiMessage
/// by FK (keeps the monthly-partition path open; ChannelMessage.aiMessageId is a plain id).
/// Invariants (CHECK): token/cost counters >= 0; hintLevel 0..4; userRating in (-1, 1).
model AiMessage {
  id                String          @id @default(uuid(7)) @db.Uuid
  conversationId    String          @db.Uuid
  role              AiMessageRole
  status            AiMessageStatus @default(COMPLETE)
  /// Classified or button-selected intent ("Teach me" vs "Give me the answer", §15).
  intent            AiIntent?
  /// Hint-ladder level reached by this assistant turn (ARCHITECTURE §6.4: 0 restate .. 4 full solution).
  hintLevel         Int?            @db.SmallInt
  /// Markdown text (rendered with the strict pipeline profile).
  content           String
  contentPurgedAt   DateTime?       @db.Timestamptz(3)
  /// Solver photo (MediaAsset purpose SOLVER_UPLOAD, OWNER_ONLY, 30-day retention). One image per message (§6.3).
  /// On account deletion the asset is marked DELETED before the messages are deleted (no orphaned photos).
  attachmentAssetId String?         @db.Uuid
  // --- metering (assistant turns; USER turns carry zeros) ---
  model             String?         @db.VarChar(64)
  tier              AiModelTier?
  promptVersion     String?         @db.VarChar(32)
  /// The refusal fallback model served this turn.
  servedByFallback  Boolean         @default(false)
  inputTokens       Int             @default(0)
  outputTokens      Int             @default(0)
  cacheReadTokens   Int             @default(0)
  cacheWriteTokens  Int             @default(0)
  /// USD micro-dollars, computed from Setting `ai.pricing` at call time.
  costMicros        Int             @default(0)
  latencyMs         Int?
  /// Raw provider stop_reason ("end_turn", "max_tokens", "refusal"...).
  stopReason        String?         @db.VarChar(32)
  /// Served from AiResponseCache (zero tokens; still counts as a message for quota).
  cached            Boolean         @default(false)
  /// Provenance only: the AiResponseCache row that served this turn. Plain id, deliberately not an FK: purging an
  /// expired popular entry must not rewrite thousands of old messages (SET NULL) or erase the provenance.
  cacheEntryId      String?         @db.Uuid
  /// Client-generated id for retry idempotency (no double charge on a flaky network).
  clientMessageId   String?         @db.VarChar(64)
  /// Student feedback: 1 helpful, -1 not helpful (evaluation sets, ARCHITECTURE §6.9).
  userRating        Int?            @db.SmallInt
  ratedAt           DateTime?       @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)

  conversation    AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachmentAsset MediaAsset?    @relation(fields: [attachmentAssetId], references: [id], onDelete: SetNull)

  /// Retry idempotency.
  @@unique([conversationId, clientMessageId])
  /// Conversation transcript in order; covers the conversationId FK.
  @@index([conversationId, createdAt])
  /// 12-month content purge and AI usage range scans (append-mostly table).
  @@index([createdAt], type: Brin)
  /// Covers the FK.
  @@index([attachmentAssetId])
}

/// Per-user, per-local-day, per-feature AI usage: the quota ledger (§40 usage limits, admin-configurable quotas).
/// Upserted on (userId, date, feature): `reservedRequests` is incremented BEFORE the model call (atomic check against
/// the plan limit) and settled after it. date is the user's local date (Profile.timezone).
model AiUsageDaily {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  date             DateTime  @db.Date
  feature          AiFeature
  requests         Int       @default(0)
  /// In-flight reservations not yet settled.
  reservedRequests Int       @default(0)
  cacheHits        Int       @default(0)
  /// DEEP-tier requests (separate daily DEEP cap; "Think harder" counts 2).
  deepRequests     Int       @default(0)
  /// Solver images uploaded.
  images           Int       @default(0)
  inputTokens      Int       @default(0)
  outputTokens     Int       @default(0)
  cacheReadTokens  Int       @default(0)
  cacheWriteTokens Int       @default(0)
  costMicros       Int       @default(0)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Quota check / upsert target; covers the userId FK.
  @@unique([userId, date, feature])
  /// Admin AI spend dashboards by day and feature (§35 AI usage, /admin/ai). NOT the spend guard (AiSpendDaily).
  @@index([date, feature])
}

/// The platform's global daily AI spend counter (§40; ARCHITECTURE §6.3 step 10 "global daily spend counter"): the
/// spend guard trips the kill switch when SUM(costMicros) for today passes Setting `ai.dailyBudgetMicros`.
/// Sharded to avoid a hot row: the metering transaction increments shard = hash(userId) % 16 for today (CAT date);
/// the guard sums at most 16 rows (cached 30 s). BigInt micro-dollars cannot overflow.
model AiSpendDaily {
  /// Calendar day in Africa/Harare (platform day).
  date       DateTime @db.Date
  /// 0..15 (CHECK).
  shard      Int      @db.SmallInt
  costMicros BigInt   @default(0)
  requests   Int      @default(0)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@id([date, shard])
}

/// Response cache for generic, student-independent explanations (ARCHITECTURE §6.3 step 6).
/// cacheKey = sha256(normalised question + subjectId + qualificationId + mode + model + promptVersion) hex.
/// Never stores student-specific context, and never the student's own words: only the hashed key and the generic
/// response are kept (admins review cached answers by subject and response). Expired rows are purged daily; content
/// corrections invalidate by subject. AiMessage.cacheEntryId points here as a plain id (no FK).
model AiResponseCache {
  id            String    @id @default(uuid(7)) @db.Uuid
  cacheKey      String    @unique @db.Char(64)
  feature       AiFeature
  model         String    @db.VarChar(64)
  promptVersion String    @db.VarChar(32)
  subjectId     String?   @db.Uuid
  response      String
  inputTokens   Int       @default(0)
  outputTokens  Int       @default(0)
  /// Cost of producing the entry (savings = hitCount x costMicros).
  costMicros    Int       @default(0)
  hitCount      Int       @default(0)
  lastHitAt     DateTime? @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  invalidatedAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  /// Purge of expired entries.
  @@index([expiresAt])
  /// Invalidate by subject after a content correction; covers the FK.
  @@index([subjectId])
}

/// An admin content-generation run (§41). Created QUEUED by an authorised CONTENT_EDITOR+ with a cost estimate and
/// per-editor daily budget check; executed by the `ai.generate` worker job (Job row). Output rows (Lesson, Question,
/// Flashcard, Assessment, StudyPack, StudyPlanTemplate; mapping on AiGenerationKind) are created as DRAFT with
/// aiGenerated = true and generationJobId -> this row; AI never publishes: the DB refuses an AI row inserted in any
/// status but DRAFT, an aiGenerated flag flipped back to false, and APPROVED/PUBLISHED without a human approver and
/// approval time (CHECKs + content_workflow_guard trigger).
model AiGenerationJob {
  id                  String             @id @default(uuid(7)) @db.Uuid
  requestedById       String             @db.Uuid
  kind                AiGenerationKind
  status              AiGenerationStatus @default(QUEUED)
  syllabusId          String?            @db.Uuid
  subjectId           String?            @db.Uuid
  topicId             String?            @db.Uuid
  /// Generation request (Zod-validated per kind). Shape: { version: 1, count?: number,
  ///   difficulty?: "EASY"|"MEDIUM"|"HARD"|"MIXED", questionTypes?: string[] /* QuestionType */,
  ///   learningObjectiveIds?: string[], language?: string, marksPerQuestion?: number, instructions?: string }
  params              Json
  itemsRequested      Int?
  itemsCreated        Int                @default(0)
  model               String?            @db.VarChar(64)
  tier                AiModelTier?
  promptVersion       String?            @db.VarChar(32)
  /// Message Batches API id when run as a batch (50% cheaper).
  providerBatchId     String?            @db.VarChar(128)
  estimatedCostMicros Int?
  inputTokens         Int                @default(0)
  outputTokens        Int                @default(0)
  cacheReadTokens     Int                @default(0)
  cacheWriteTokens    Int                @default(0)
  costMicros          Int                @default(0)
  /// Result summary. Shape: { created: { entityType: string, id: string }[], nearDuplicatesFlagged: number,
  ///   rejected: { index: number, reason: string }[], warnings: string[] }
  outputSummary       Json?
  error               String?
  /// Queue row executing it.
  jobId               String?            @db.Uuid
  startedAt           DateTime?          @db.Timestamptz(3)
  completedAt         DateTime?          @db.Timestamptz(3)
  cancelledAt         DateTime?          @db.Timestamptz(3)
  cancelledById       String?            @db.Uuid
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)

  requestedBy        User                @relation("AiGenerationJobRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  cancelledBy        User?               @relation("AiGenerationJobCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  syllabus           Syllabus?           @relation(fields: [syllabusId], references: [id], onDelete: Restrict)
  subject            Subject?            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic              Topic?              @relation(fields: [topicId], references: [id], onDelete: Restrict)
  job                Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  // Back-relations (CURRICULUM & CONTENT slice)
  /// Content drafted by this job (always DRAFT + aiGenerated, §41).
  lessons            Lesson[]            @relation("LessonGenerationJob")
  questions          Question[]          @relation("QuestionGenerationJob")
  flashcards         Flashcard[]         @relation("FlashcardGenerationJob")
  assessments        Assessment[]        @relation("AssessmentGenerationJob")
  studyPacks         StudyPack[]         @relation("StudyPackGenerationJob")
  studyPlanTemplates StudyPlanTemplate[] @relation("StudyPlanTemplateGenerationJob")

  /// Per-editor history and daily budget check; covers the FK.
  @@index([requestedById, createdAt])
  /// Admin queue view.
  @@index([status, createdAt])
  /// Covers the FKs.
  @@index([syllabusId])
  @@index([subjectId])
  @@index([topicId])
  @@index([jobId])
  @@index([cancelledById])
}

// =====================================================================================================================
// CHANNELS: WhatsApp-ready messaging layer (§30, ARCHITECTURE §8)
// =====================================================================================================================

/// An external messaging identity (WhatsApp number, SMS number, Telegram chat). Created on first inbound message even
/// before linking (userId NULL: only HELP / LINK / a sample question are served). Linking requires an OTP
/// (VerificationCode purpose CHANNEL_LINK). The 24-hour customer-care window is computed from lastInboundAt.
/// Retention: an UNLINKED identity (possibly a minor's phone number with no account) is deleted by maintenance.purge
/// 90 days after its last inbound message (its messages keep metadata with identityId NULL); linked identities are
/// deleted with the account.
/// Invariants (CHECK): verifiedAt => userId; WhatsApp/SMS externalId is E.164.
model ChannelIdentity {
  id             String      @id @default(uuid(7)) @db.Uuid
  userId         String?     @db.Uuid
  channel        ChannelType
  /// E.164 for WhatsApp/SMS (wa_id normalised with "+"); chat id for Telegram.
  externalId     String      @db.VarChar(64)
  verifiedAt     DateTime?   @db.Timestamptz(3)
  linkedAt       DateTime?   @db.Timestamptz(3)
  /// Opt-in to proactive (template) messages; STOP sets optedOutAt and suppresses everything but replies.
  optedInAt      DateTime?   @db.Timestamptz(3)
  optedOutAt     DateTime?   @db.Timestamptz(3)
  lastInboundAt  DateTime?   @db.Timestamptz(3)
  lastOutboundAt DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  user              User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          ChannelMessage[]
  conversationState ChannelConversationState?

  /// Inbound webhook lookup by sender.
  @@unique([channel, externalId])
  /// One identity per channel per user; covers the userId FK.
  @@unique([userId, channel])
}

/// Every inbound and outbound channel message. Webhook dedupe: unique (channel, externalMessageId) — duplicates from
/// the provider are ignored on insert. Status callbacks (sent / delivered / read / failed) update outbound rows.
/// Privacy (§21, §30): AI tutoring over WhatsApp ("Explain photosynthesis") is private AI conversation content, so it
/// must not sit in this support-visible table: the inbound handler, in the transaction that creates the AiMessage,
/// sets contentClass = AI_PRIVATE, aiMessageId and body = payload = NULL; AI replies are stored the same way and the
/// sender reads the text from AiMessage (system scope). OTP sends never store the code (contentClass OTP).
/// Bodies and payloads of STANDARD rows are purged after 90 days (both NULL, bodyPurgedAt set); metadata is kept for
/// billing and dedupe.
/// Invariants (CHECK): INBOUND => externalMessageId present; non-STANDARD => body and payload NULL; aiMessageId only
/// on AI_PRIVATE rows.
model ChannelMessage {
  id                String               @id @default(uuid(7)) @db.Uuid
  identityId        String?              @db.Uuid
  channel           ChannelType
  direction         MessageDirection
  status            ChannelMessageStatus
  contentClass      ChannelContentClass  @default(STANDARD)
  /// The AiMessage holding this message's text (AI_PRIVATE only). Plain id, not an FK: AiMessage stays unreferenced
  /// (partition path) and its row-level security is the only way to read the text.
  aiMessageId       String?              @db.Uuid
  /// Provider message id (wamid...). NULL for outbound rows until the provider accepts them.
  externalMessageId String?              @db.VarChar(128)
  /// "text", "template", "interactive", "image", "button_reply"...
  messageType       String               @default("text") @db.VarChar(32)
  /// Approved template name for proactive messages outside the 24 h window.
  templateName      String?              @db.VarChar(128)
  body              String?
  bodyPurgedAt      DateTime?            @db.Timestamptz(3)
  /// Provider payload, redacted (Zod-validated per provider). Shape (WhatsApp): { type: string,
  ///   interactive?: object, buttons?: { id: string, title: string }[], mediaId?: string, context?: object }
  payload           Json?
  error             String?              @db.VarChar(1000)
  /// Meta conversation pricing category ("service", "utility", "marketing", "authentication") for cost reports.
  pricingCategory   String?              @db.VarChar(32)
  /// Outbound message generated from a notification.
  notificationId    String?              @db.Uuid
  /// Outbound reply to this inbound message.
  inReplyToId       String?              @db.Uuid
  sentAt            DateTime?            @db.Timestamptz(3)
  deliveredAt       DateTime?            @db.Timestamptz(3)
  readAt            DateTime?            @db.Timestamptz(3)
  failedAt          DateTime?            @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)

  identity     ChannelIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)
  notification Notification?    @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  inReplyTo    ChannelMessage?  @relation("ChannelMessageReply", fields: [inReplyToId], references: [id], onDelete: SetNull)
  replies      ChannelMessage[] @relation("ChannelMessageReply")

  /// Webhook dedupe and status-callback lookup.
  @@unique([channel, externalMessageId])
  /// Conversation history per identity (support, rate checks); covers the identityId FK.
  @@index([identityId, createdAt])
  /// Admin "failed / queued messages" view.
  @@index([status, createdAt])
  /// Covers the FKs.
  @@index([notificationId])
  @@index([inReplyToId])
  /// 90-day body purge and range scans (append-mostly table).
  @@index([createdAt], type: Brin)
}

/// Command state of one channel identity (ARCHITECTURE §8 step 6). One row per identity (identityId PK).
/// The awaited answer slot is ONE composite reference to QuestionAttempt's primary key (pendingAttemptId,
/// pendingPosition): it stays valid when QuestionAttempt is partitioned, and its ON DELETE SET NULL clears both columns
/// together. Invariant (CHECK): both set or both NULL. An AWAITING_ANSWER state without a slot, or past expiresAt, is
/// treated as IDLE.
model ChannelConversationState {
  identityId       String                       @id @db.Uuid
  state            ChannelConversationStateKind @default(IDLE)
  /// Attempt (DAILY_QUESTION / PRACTICE, channel WHATSAPP) whose answer is awaited.
  pendingAttemptId String?                      @db.Uuid
  /// The question slot (QuestionAttempt.position) within pendingAttemptId awaiting an answer.
  pendingPosition  Int?                         @db.SmallInt
  /// State-specific data (Zod-validated). Shape: { lastCommand?: string, optionKeys?: string[] /* "A".."D" mapping */,
  ///   linkTarget?: string /* masked */, locale?: string }
  context          Json?
  expiresAt        DateTime?                    @db.Timestamptz(3)
  createdAt        DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                     @updatedAt @db.Timestamptz(3)

  identity               ChannelIdentity  @relation(fields: [identityId], references: [id], onDelete: Cascade)
  /// Composite FK (pendingAttemptId, pendingPosition) -> QuestionAttempt PK. Deliberately the only reference: a second
  /// single-column FK to AssessmentAttempt would null pendingAttemptId alone on delete and break the pair.
  pendingQuestionAttempt QuestionAttempt? @relation(fields: [pendingAttemptId, pendingPosition], references: [attemptId, position], onDelete: SetNull)

  /// Covers the composite FK.
  @@index([pendingAttemptId, pendingPosition])
}

// =====================================================================================================================
// INFRASTRUCTURE: audit, jobs, rate limits, settings, analytics rollups (§35, §38, §39, §40)
// =====================================================================================================================

/// Append-only audit trail of privileged actions (§39; ARCHITECTURE §5.10): staff role grants/revokes, staff logins,
/// content publish/archive, syllabus publish, plan/price/promo changes, manual grants, refunds, settings and kill
/// switches, imports, school membership changes, exports, deletions, admin views of a student's record, break-glass.
/// The app DB role has INSERT + SELECT only (REQUIRED deploy step, raw SQL section D, asserted at boot) and a trigger
/// blocks UPDATE/DELETE except (a) the FK-driven SET NULL of targetUserId / schoolId once that user / school row is
/// really gone and (b) the retention purge of rows older than 2 years (6 years for payment-related entities). The
/// actor reference is Restrict: "who did it" can never be erased (users are anonymised, never hard-deleted).
/// Break-glass and admin student-record views must carry a non-blank reason and an actor (CHECK).
/// before/after/metadata are PII-redacted and never contain secrets.
model AuditLog {
  id           String         @id @default(uuid(7)) @db.Uuid
  actorUserId  String?        @db.Uuid
  actorKind    AuditActorKind @default(USER)
  /// Actor's effective roles at the time (incl. SCHOOL_ADMIN when acting in a school).
  actorRoles   Role[]         @default([])
  /// Dotted action key from the code registry, e.g. "role.grant", "content.publish", "payment.refund",
  /// "student.view", "ai_conversation.break_glass", "setting.update", "consent.withdraw".
  action       String         @db.VarChar(100)
  /// Target entity type and id (model name / key; ids may be non-uuid keys such as Setting keys).
  entityType   String         @db.VarChar(64)
  entityId     String?        @db.VarChar(128)
  /// School context (school-admin actions; school-scoped audit view for SCHOOL_ADMIN).
  schoolId     String?        @db.Uuid
  /// Person whose data was viewed/changed (supports "who accessed my data" and data-subject requests).
  targetUserId String?        @db.Uuid
  /// Redacted snapshots / diff. Shape: arbitrary JSON object with PII and secret fields removed by lib/audit.
  before       Json?
  after        Json?
  /// Extra context. Shape: { [key: string]: string | number | boolean | null | string[] }
  metadata     Json?
  /// Required for break-glass and admin student-record views.
  reason       String?        @db.VarChar(500)
  requestId    String?        @db.VarChar(64)
  ipHash       String?        @db.Char(64)
  userAgent    String?        @db.VarChar(512)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  actor  User?   @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  target User?   @relation("AuditLogTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  /// Entity history ("who changed this plan / question / setting").
  @@index([entityType, entityId, createdAt])
  /// Actor timeline; covers the actorUserId FK.
  @@index([actorUserId, createdAt])
  /// Data-subject access history; covers the targetUserId FK.
  @@index([targetUserId, createdAt])
  /// School-scoped audit view; covers the schoolId FK.
  @@index([schoolId, createdAt])
  /// Filter by action type (e.g. all refunds, all break-glass).
  @@index([action, createdAt])
  /// Retention purge (2 years) and time-range investigations (append-only table).
  @@index([createdAt], type: Brin)
}

/// Postgres-backed job queue (ARCHITECTURE §3.7). Enqueued in the same transaction as the domain write (outbox).
/// Claim: UPDATE ... WHERE id IN (SELECT id FROM "Job" WHERE queue = $1 AND status = 'PENDING' AND "runAt" <= now()
/// ORDER BY priority, "runAt" LIMIT $n FOR UPDATE SKIP LOCKED). Lower priority value runs first. dedupeKey is unique
/// while the job is PENDING or RUNNING (partial unique index, raw SQL), so enqueue uses INSERT ... ON CONFLICT DO
/// NOTHING. Handlers are idempotent. Finished jobs are purged after 7 days.
model Job {
  id          String    @id @default(uuid(7)) @db.Uuid
  /// payments | notifications | ai | rollups | search | imports | default (isolation: per-queue concurrency).
  queue       String    @default("default") @db.VarChar(32)
  /// Handler key, e.g. "notifications.fanout", "ai.generate", "payments.reconcile".
  type        String    @db.VarChar(100)
  /// Handler input (Zod schema per type). Carries ids only, never PII or secrets.
  payload     Json      @default("{}")
  status      JobStatus @default(PENDING)
  priority    Int       @default(0) @db.SmallInt
  runAt       DateTime  @default(now()) @db.Timestamptz(3)
  attempts    Int       @default(0) @db.SmallInt
  maxAttempts Int       @default(5) @db.SmallInt
  /// Lease start; RUNNING rows older than the lease (5 min) are reclaimed.
  lockedAt    DateTime? @db.Timestamptz(3)
  /// Worker instance id (hostname:pid).
  lockedBy    String?   @db.VarChar(128)
  lastError   String?
  /// e.g. "rollup:{userId}:{subjectId}", "metrics:2026-10-05", "fanout:{announcementId}".
  dedupeKey   String?   @db.VarChar(255)
  /// Small handler result for admin display. Shape: { [key: string]: unknown }
  result      Json?
  completedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  aiGenerationJobs AiGenerationJob[]
  schoolReports    SchoolReport[]

  /// Queue monitoring (depth / oldest pending per queue, dead letters) and the generic claim scan. The hot claim path
  /// uses the partial index Job_claim_idx (raw SQL).
  @@index([status, queue, runAt, priority])
  /// maintenance.purge of finished jobs older than 7 days.
  @@index([status, completedAt])
}

/// Shared rate-limit counters (§38, §39; ARCHITECTURE §5.5) so limits hold across web instances.
/// key = "<limiter>:<subject>" where subject is a hash, never raw PII (e.g. "otp_send_target:<hmac>",
/// "login:<hmac(ip)>:<hmac(identifier)>", "ai_msg:<userId>"). Fixed window with a sliding approximation:
/// estimate = prevCount * (1 - elapsed/window) + count. One atomic upsert per hit:
/// INSERT ... ON CONFLICT (key) DO UPDATE SET (rolls the window when windowStart is stale) ... RETURNING.
/// Not used for money: the AI global daily spend guard reads AiSpendDaily (BigInt shards).
model RateLimitBucket {
  key           String   @id @db.VarChar(255)
  windowStart   DateTime @db.Timestamptz(3)
  windowSeconds Int
  count         Int      @default(0)
  /// Count of the previous window (sliding-window approximation).
  prevCount     Int      @default(0)
  /// windowStart + 2 x window; purged after.
  expiresAt     DateTime @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  /// maintenance.purge.
  @@index([expiresAt])
}

/// Runtime configuration editable by SUPER_ADMIN (§36 Settings, §40 admin-configurable quotas): AI routing, pricing,
/// quotas, kill switches, rate limits, feature flags, FX rates, helplines. Values are Zod-validated per key in
/// src/server/lib/settings.ts; code ships defaults used to seed. NEVER holds secrets (env only). Every change writes an
/// AuditLog entry; `version` provides optimistic concurrency. Cached in-process for 30 s.
model Setting {
  /// Dotted key, e.g. "ai.routing", "ai.quotas", "ai.pricing", "ai.enabled", "ai.features", "ai.dailyBudgetMicros"
  /// (compared with SUM(AiSpendDaily.costMicros) for today),
  /// "ai.marking.minConfidence", "rateLimits", "billing.graceDays", "fx.ZWG_USD", "growth.referral",
  /// "privacy.parentAiAccess.enabled", "notifications.defaults", "safety.helplines", "learning.defaults".
  key         String   @id @db.VarChar(128)
  /// Key-specific JSON (shapes documented in the notes, §AI configuration and §Settings registry).
  value       Json
  description String?  @db.VarChar(500)
  version     Int      @default(1)
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  /// Covers the FK.
  @@index([updatedById])
}

/// Daily analytics rollup (§35, §23 school analytics) computed by the `analytics.dailyMetrics` worker job from domain
/// tables — real values only, never estimates (§50). One row per (date, metric, dimension); recomputation upserts.
/// metric: code-registered key, e.g. "users.dau", "users.mau", "users.signups", "students.active", "students.paid",
/// "attempts.questions", "attempts.avgScorePct", "study.minutes", "retention.d7", "conversion.paid",
/// "revenue.minor", "ai.costMicros", "ai.requests", "mock.avgScorePct", "subject.attempts", "topic.difficulty".
/// dimension: "" for platform totals, otherwise "kind:value" pairs joined by "|" in a fixed order, e.g.
/// "subject:<uuid>", "topic:<uuid>", "currency:USD", "plan:STUDENT", "feature:TUTOR|tier:FAST", "country:ZW",
/// "school:<uuid>", "school:<uuid>|subject:<uuid>", "teacher:<uuid>".
model DailyMetric {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Calendar day (Africa/Harare for platform metrics; school timezone for school dimensions).
  date      DateTime @db.Date
  metric    String   @db.VarChar(64)
  dimension String   @default("") @db.VarChar(128)
  /// Counts, sums (minor units / micro-dollars, exact up to 2^53) and ratios (0..1).
  value     Float
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// Upsert target; one value per metric/dimension/day.
  @@unique([date, metric, dimension])
  /// Time series for one metric (admin charts), optionally narrowed by dimension prefix.
  @@index([metric, dimension, date])
  /// One metric over a date range across all dimensions (analytics/admin.ts sumByDimension, difficult topics).
  @@index([metric, date])
}
