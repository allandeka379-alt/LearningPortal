// =====================================================================================================================
// Single Prisma schema for the platform (Prisma 7, PostgreSQL 18). Scope: docs/PRODUCT_SPEC.md (cited as §N).
//
// Sections (each was designed as a slice; design notes live in .scratch/design/slice-*-notes.md):
//   1. CURRICULUM & CONTENT   Country -> ExamBoard -> Qualification -> Subject -> Syllabus (one row per version) ->
//                             Topic tree -> LearningObjective; lessons, question bank, flashcards, assessment
//                             definitions, study packs, media, licensing, revisions, flags, search, daily question.
//   2. LEARNING & ENGAGEMENT  enrolments, attempts and answers, mastery and progress rollups, flashcard scheduling,
//                             study plans and sessions, streaks/XP/badges/leaderboards, assignments, sharing.
//   3. PLATFORM               identity, schools and classes, notifications, billing and entitlements, AI metering,
//                             WhatsApp channel, audit, jobs, rate limits, settings, analytics rollups.
//
// Conventions: uuid(7) primary keys (@db.Uuid); 1:1 extension tables keyed by userId; Timestamptz(3) timestamps;
// money as Int minor units + Char(3) currency; every FK covered by an index whose leading column(s) are FK columns
// (composite FKs: a selective leading column, or the FK's column set in another order; verified on the final DDL).
// Deliberate exceptions: pure join tables, per-key state/rollup tables (TopicMastery, SubjectProgress, LessonProgress,
// FlashcardState, DailyActivity, UserAchievement, AssignmentProgress, QuestionStats, LearnerStats, AiSpendDaily) and
// the hot answer table QuestionAttempt (PK (attemptId, position), partition-ready) use their natural key as the primary
// key; QuestionAttempt.topicId is a denormalised copy with no FK.
//
// Raw SQL companion (REQUIRED): .scratch/design/raw-sql.sql holds what Prisma cannot express: CHECK constraints,
// partial and NULLS NOT DISTINCT unique indexes, expression/trigram indexes, the generated tsvector column, triggers
// (content workflow and immutability, tenancy, consent, billing guards), row-level security on AiConversation /
// AiMessage, storage parameters and grants. Fold it into the initial migration (`prisma migrate dev --create-only`):
// section A at the very top, the in-place edit in section B, section C appended; section D is a REQUIRED deploy step.
// Partial indexes deliberately stay in raw SQL (the `partialIndexes` preview feature is NOT enabled): Prisma Migrate
// ignores partial and expression indexes, CHECKs, triggers, policies and functions, so they never show up as drift.
// Plain-column GIN/BRIN indexes are declared here. Architecture overview: docs/ARCHITECTURE.md §4.
// =====================================================================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection URL lives in prisma.config.ts (Prisma 7), not here.
datasource db {
  provider = "postgresql"
}

// #####################################################################################################################
// ===== CURRICULUM & CONTENT =====
// #####################################################################################################################

// =====================================================================================================================
// SLICE: CURRICULUM & CONTENT  (Country -> ExamBoard -> Qualification -> Subject -> Syllabus(version) -> Topic tree
//        -> LearningObjective; lessons, question bank, flashcards, assessment definitions, study packs, media,
//        licensing, revisions, flags, search, daily question, marketing CMS data)
//
// Cross-slice targets referenced by contract name (back-relations added by the integrator):
//   User, AiGenerationJob, School  (PLATFORM slice)
// Raw SQL that Prisma cannot express (partial unique indexes, CHECK constraints, generated tsvector column,
// NULLS NOT DISTINCT, triggers, pg_trgm extension) is listed in slice-curriculum-notes.md §"Raw SQL".
// =====================================================================================================================

// ---------------------------------------------------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------------------------------------------------

/// Editorial workflow for platform content (§41, §42, CLAUDE.md rule 7). Students only ever see PUBLISHED.
/// AI-generated content always starts as DRAFT; nothing is auto-published.
enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

/// The 11 question types of §9. Multi-select MCQ is MULTIPLE_CHOICE with payload.selectMode = "multiple".
enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  NUMERICAL
  STRUCTURED
  ESSAY
  CALCULATION
  MATCHING
  FILL_IN_THE_BLANK
  DIAGRAM_LABELLING
  EXTENDED_RESPONSE
}

/// How a question (or question part) is marked (§9 "automatically marked and manually/AI-assisted marked").
enum MarkingMode {
  /// Deterministic marking from answerSpec / options (pure function, unit tested).
  AUTO
  /// AI proposes marks against answerSpec.markScheme; result is labelled as AI-estimated and may be overridden.
  AI_ASSISTED
  /// Teacher/self marking against the mark scheme; no automatic score.
  MANUAL
}

/// Catalogue visibility for countries, boards, qualifications and subjects. Lets the catalogue list a subject honestly
/// as "coming soon" instead of showing an empty page (§50 no fake completeness).
enum CatalogueStatus {
  /// Not shown anywhere outside admin.
  HIDDEN
  /// Listed (onboarding, public pages) but not yet enrollable/usable; UI shows an honest "coming soon" state.
  COMING_SOON
  /// Listed and enrollable.
  AVAILABLE
  /// No longer offered for new enrolments; existing enrolments keep working.
  RETIRED
}

/// Lifecycle of one syllabus VERSION (§26). Every status except DRAFT means "published": the structure (topics,
/// objectives, components, routes) is frozen and a change requires a new version row.
enum SyllabusStatus {
  /// Being built; editable; invisible to students.
  DRAFT
  /// Published, examinable from a future date (effectiveFrom in the future). Students targeting later sessions may pin it.
  UPCOMING
  /// Published; the default version for new enrolments. Exactly one CURRENT per subject (partial unique index, raw SQL).
  CURRENT
  /// Published; replaced by a newer CURRENT version but still examined / still pinned by students.
  SUPERSEDED
  /// No longer examined. Pinned students keep read access to their history and content (§26); no new enrolments.
  ARCHIVED
}

/// Structural role of a Topic node. Depth varies by board, so code branches on kind, never on depth:
/// SECTION nodes group topics (e.g. a Cambridge 9709 component "Pure Mathematics 1", or "Theme A");
/// TOPIC nodes are what dashboards/mastery list ("Algebra 82%"); SUBTOPIC nodes (any depth below a TOPIC) are the
/// fine-grained tagging targets ("Quadratic equations").
enum TopicKind {
  SECTION
  TOPIC
  SUBTOPIC
}

/// Kind of examination component (paper). The platform can only simulate WRITTEN / MULTIPLE_CHOICE (and partly
/// ALTERNATIVE_TO_PRACTICAL) papers; mock-exam assembly branches on this.
enum SyllabusComponentKind {
  WRITTEN
  MULTIPLE_CHOICE
  PRACTICAL
  ALTERNATIVE_TO_PRACTICAL
  COURSEWORK
  ORAL
  LISTENING
  PROJECT
}

/// Board-agnostic "skill tested" (§9), based on revised Bloom's taxonomy. Board-specific assessment objectives
/// (Cambridge AO1/AO2/AO3, ZIMSEC objectives) are described in Syllabus.assessmentOverview and map onto these.
enum CognitiveSkill {
  RECALL
  UNDERSTANDING
  APPLICATION
  ANALYSIS
  EVALUATION
  CREATION
}

/// Visibility of an exam session in onboarding/countdowns (§17). Whether a date is official is ExamSession.isProvisional.
enum ExamSessionStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED
}

/// Kind of lesson-like page (§8, §24 "notes, exam tips", §44 "articles, study guides").
enum LessonKind {
  LESSON
  REVISION_NOTES
  WORKED_EXAMPLES
  EXAM_TIPS
  /// Public SEO study guide (original content only; never premium lesson content, §44).
  STUDY_GUIDE
  /// Public SEO article.
  ARTICLE
}

/// Flashcard content type (§18).
enum FlashcardType {
  DEFINITION
  FORMULA
  VOCABULARY
  CONCEPT
  DATE
  FACT
}

/// Assessment definition kind (§12, §13, §46). Ad-hoc practice sessions are NOT assessments: they exist only as
/// AssessmentAttempt rows (learning slice) with a practice AttemptMode and no assessmentId.
enum AssessmentKind {
  QUIZ
  TOPIC_TEST
  CHAPTER_TEST
  SUBJECT_TEST
  MOCK_EXAM
  DIAGNOSTIC
  TIMED_EXAM
}

/// How the questions of an assessment are chosen.
enum AssessmentAssembly {
  /// Every attempt gets the same fixed AssessmentItems (comparable mocks, teacher tests, leaderboards).
  FIXED
  /// Each attempt is assembled once at start from AssessmentBlueprintRules (plus any fixed items = "always include").
  BLUEPRINT
  /// Questions are chosen one at a time by the adaptive engine within the blueprint rules (diagnostic tests §46/§52).
  ADAPTIVE
}

/// When marks/explanations are revealed to the student.
enum AssessmentFeedbackTiming {
  /// After every question (quizzes, practice-style tests; §10).
  IMMEDIATE
  /// After the whole attempt is submitted (exam mode §13).
  AFTER_SUBMIT
  /// After the assignment/assessment window closes (teacher tests; window lives on Assignment in the learning slice).
  AFTER_CLOSE
}

/// Who may access a content item. Replaces a bare isFreePreview flag: isFreePreview == (accessTier != PREMIUM).
/// Entitlement checks (src/server/billing/entitlements.ts) decide what FREE/PREMIUM mean per plan; PUBLIC content may
/// appear on SEO pages without login (§44: premium content is never exposed for SEO).
enum ContentAccessTier {
  PUBLIC
  FREE
  PREMIUM
}

/// Per-item copyright status (§27). Publishing is blocked while UNVERIFIED (CHECKs, raw SQL); LICENSED requires a
/// sourceId and OPEN_LICENSE a sourceId or licenceCode (CHECKs), so every cleared item names what permits its use.
enum CopyrightStatus {
  /// Original work owned by the platform (staff- or AI-authored for the platform).
  OWNED
  /// Used under a licence agreement recorded on ContentSource (sourceId required).
  LICENSED
  PUBLIC_DOMAIN
  /// Open licence (e.g. CC-BY-4.0) recorded in licenceCode / ContentSource (one of them required).
  OPEN_LICENSE
  /// Provenance not yet cleared; cannot be published.
  UNVERIFIED
}

/// Type of a content source (§27).
enum ContentSourceType {
  ORIGINAL
  LICENSED
  PUBLIC_DOMAIN
  OPEN_LICENSE
  /// Official syllabus documents/structures, used only where legally usable (structure + short objective statements).
  OFFICIAL_SYLLABUS
  /// Drafted by the platform's AI generation pipeline (ARCHITECTURE §6.6); model/prompt version live on
  /// AiGenerationJob. Items still carry copyrightStatus OWNED only after human review.
  AI_GENERATED
}

/// Why a media file exists. Drives validation (alt text required for CONTENT_IMAGE/DIAGRAM, §43) and retention.
enum MediaPurpose {
  CONTENT_IMAGE
  DIAGRAM
  /// Audio for language listening content.
  CONTENT_AUDIO
  /// Board logos, testimonial photos, study-pack covers.
  MARKETING_IMAGE
  /// School branding uploaded by SCHOOL_ADMIN (ARCHITECTURE §3.11). Public-read.
  SCHOOL_LOGO
  AVATAR
  /// Student photo of a question for the AI solver (§15). OWNER_ONLY (part of the private AI conversation); 30-day
  /// retention.
  SOLVER_UPLOAD
  /// CSV/XLSX/JSON file for bulk import (§25). PRIVATE.
  IMPORT_FILE
  /// Photo of working / drawn diagram attached to an answer (§13 "extended written answers"). PRIVATE; linked through
  /// QuestionAttemptAttachment; deleted with the account.
  ANSWER_ATTACHMENT
  /// Generated school report file (§23 "generate reports"), referenced by SchoolReport. PRIVATE.
  REPORT_EXPORT
}

/// Delivery policy for a media file. Which purposes may use which visibility is a CHECK (raw SQL).
enum MediaVisibility {
  /// CDN-cacheable, no auth (public SEO pages, logos, PUBLIC/FREE content images). Never UNVERIFIED copyright (CHECK).
  PUBLIC
  /// Served via short-lived signed URLs to signed-in users (premium content images, avatars).
  AUTHENTICATED
  /// Signed URLs only for the uploader and readers the owning service authorises (staff for import files; the class
  /// teacher or content reviewer for answer attachments; the school's admins for report exports).
  PRIVATE
  /// Only the uploader, workers and SUPER_ADMIN break-glass (audited) can read: solver uploads, which belong to the
  /// private AI conversation (ARCHITECTURE §5.2).
  OWNER_ONLY
}

/// Upload pipeline state ("validate uploads (type sniffing, size limits)", CLAUDE.md rule 12).
enum MediaStatus {
  /// Row created, upload in progress / not yet sniffed.
  PENDING
  /// Sniffed, size-checked, variants generated; usable.
  READY
  /// Failed validation (wrong type, too large, malware scan). Never served.
  REJECTED
  /// Soft-deleted; storage object removed by a worker.
  DELETED
}

/// Polymorphic target type used by ContentRevision, ContentFlag, ContentMediaUsage, SearchDocument, ContentImport.
/// Each consumer narrows the allowed values in its Zod schema.
enum ContentEntityType {
  SUBJECT
  SYLLABUS
  TOPIC
  LESSON
  QUESTION
  FLASHCARD
  ASSESSMENT
  STUDY_PACK
  MEDIA_ASSET
  STUDY_PLAN_TEMPLATE
}

/// Reason a content item was flagged (§42), plus typo/formatting and copyright concerns (§27 takedowns).
enum ContentFlagReason {
  INCORRECT_ANSWER
  AMBIGUOUS
  INCORRECT_MARKING
  WRONG_TOPIC
  WRONG_DIFFICULTY
  TYPO_OR_FORMATTING
  COPYRIGHT_CONCERN
  OTHER
}

/// Triage state of a ContentFlag.
enum ContentFlagStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

/// Who raised a ContentFlag (drives triage priority).
enum ContentFlagSource {
  EDITOR
  STUDENT
  TEACHER
  /// Automatic detection, e.g. QuestionStats shows a distractor chosen far more often than the key.
  SYSTEM
}

/// File format of a bulk import (§25).
enum ContentImportFormat {
  CSV
  XLSX
  JSON
}

/// Bulk import lifecycle (§25). Validation is a dry run; IMPORTING writes DRAFT content only.
enum ContentImportStatus {
  UPLOADED
  VALIDATING
  VALIDATED
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}

// ---------------------------------------------------------------------------------------------------------------------
// Geography & catalogue lookups (admin-extensible tables, §53: a new country/board needs zero schema change)
// ---------------------------------------------------------------------------------------------------------------------

/// A country the platform serves (§53: Zimbabwe first; Zambia, Botswana, Malawi, South Africa later).
/// Root of the curriculum hierarchy for onboarding (§5 "Country (Zimbabwe)"). Boards are linked via ExamBoardCountry
/// because international boards (Cambridge) are offered in many countries.
model Country {
  id              String          @id @default(uuid(7)) @db.Uuid
  /// ISO 3166-1 alpha-2, e.g. "ZW", "ZM", "BW".
  isoCode         String          @unique @db.Char(2)
  name            String
  slug            String          @unique
  /// Default ISO 4217 currency for pricing display, e.g. "USD" (ZW), "ZMW", "BWP".
  defaultCurrency String          @db.Char(3)
  /// IANA timezone used for "today" (daily question, streak day boundaries), e.g. "Africa/Harare".
  timezone        String
  /// BCP-47 default locale, e.g. "en-ZW".
  defaultLocale   String          @db.VarChar(16)
  /// International dialling prefix for phone auth, e.g. "+263".
  dialCode        String?         @db.VarChar(8)
  catalogueStatus CatalogueStatus @default(HIDDEN)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  homeExamBoards ExamBoard[]
  examBoardLinks ExamBoardCountry[]
  yearGroups     YearGroup[]
  // Back-relations (PLATFORM slice)
  profiles       Profile[]
  students       Student[]
  schools        School[]
  announcements  Announcement[]
  planPrices     PlanPrice[]
}

/// An examination board (ZIMSEC, Cambridge International, ECZ, BEC...). Slug is the first URL segment of public
/// curriculum pages: /{board.slug}/{qualification.slug}/{subject.slug}(/{topic.slug}) (§44).
model ExamBoard {
  id              String          @id @default(uuid(7)) @db.Uuid
  /// URL segment, e.g. "zimsec", "cambridge".
  slug            String          @unique
  /// Short stable code, e.g. "ZIMSEC", "CAIE".
  code            String          @unique @db.VarChar(32)
  /// Full name, e.g. "Zimbabwe School Examinations Council".
  name            String
  /// Display name, e.g. "ZIMSEC", "Cambridge".
  shortName       String
  description     String?
  /// Original public intro (markdown) for the board's SEO landing page.
  publicSummary   String?
  websiteUrl      String?
  /// Country where the board is based (Cambridge: GB). Availability is ExamBoardCountry, not this.
  homeCountryId   String?         @db.Uuid
  logoMediaId     String?         @db.Uuid
  catalogueStatus CatalogueStatus @default(HIDDEN)
  sortOrder       Int             @default(0)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  homeCountry    Country?           @relation(fields: [homeCountryId], references: [id], onDelete: SetNull)
  logoMedia      MediaAsset?        @relation(fields: [logoMediaId], references: [id], onDelete: SetNull)
  countryLinks   ExamBoardCountry[]
  qualifications Qualification[]
  /// Board-level public articles / study guides (§44), e.g. "How ZIMSEC grading works".
  lessons        Lesson[]
  // Back-relations (PLATFORM slice)
  students       Student[]

  @@index([homeCountryId])
  @@index([logoMediaId])
}

/// Which boards are offered in which country (onboarding step "Examination board" is filtered by the chosen country).
/// Pure join table: composite PK (no surrogate id), see notes.
model ExamBoardCountry {
  countryId   String   @db.Uuid
  examBoardId String   @db.Uuid
  isActive    Boolean  @default(true)
  /// Order of boards in this country's onboarding list.
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  country   Country   @relation(fields: [countryId], references: [id], onDelete: Restrict)
  examBoard ExamBoard @relation(fields: [examBoardId], references: [id], onDelete: Restrict)

  @@id([countryId, examBoardId])
  @@index([examBoardId])
}

/// Cross-board level classification used to group qualifications in onboarding (§5 "Level"):
/// "O-Level" groups ZIMSEC O-Level + Cambridge IGCSE (+ Cambridge O Level); "A-Level" groups ZIMSEC A-Level +
/// Cambridge International AS & A Level. A table, not an enum, so new countries' levels (e.g. "Grade 12 / School
/// Certificate", "BGCSE") need no schema change.
model QualificationLevel {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// e.g. "o-level", "a-level".
  slug        String   @unique
  /// e.g. "O-Level".
  name        String
  shortName   String?  @db.VarChar(32)
  /// e.g. "Ordinary Level and equivalents (IGCSE), typically Forms 3-4".
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  qualifications Qualification[]
  yearGroups     YearGroup[]
}

/// A qualification offered by a board: ZIMSEC O-Level, ZIMSEC A-Level, Cambridge IGCSE, Cambridge International
/// AS & A Level (ONE qualification: AS vs full A Level is a SyllabusRoute, not a separate subject).
/// slug is the second URL segment: /zimsec/o-level, /cambridge/igcse, /cambridge/as-a-level.
model Qualification {
  id              String          @id @default(uuid(7)) @db.Uuid
  examBoardId     String          @db.Uuid
  /// Cross-board grouping for onboarding (O-Level / A-Level / ...).
  levelId         String          @db.Uuid
  /// URL segment, unique per board, e.g. "o-level", "igcse", "as-a-level".
  slug            String
  /// Short code, e.g. "IGCSE", "AS-A".
  code            String?         @db.VarChar(32)
  /// e.g. "Cambridge IGCSE", "ZIMSEC Ordinary Level".
  name            String
  /// e.g. "IGCSE", "O-Level".
  shortName       String
  description     String?
  publicSummary   String?
  catalogueStatus CatalogueStatus @default(HIDDEN)
  sortOrder       Int             @default(0)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  examBoard       ExamBoard          @relation(fields: [examBoardId], references: [id], onDelete: Restrict)
  level           QualificationLevel @relation(fields: [levelId], references: [id], onDelete: Restrict)
  subjects        Subject[]
  gradeSchemes    GradeScheme[]
  examSessions    ExamSession[]
  studyPackScopes StudyPackScope[]
  dailyQuestions  DailyQuestion[]
  /// Qualification-level public articles / study guides (§44), e.g. "How to prepare for ZIMSEC O-Level exams".
  lessons         Lesson[]
  // Back-relations (PLATFORM slice)
  students        Student[]
  classes         Class[]

  @@unique([examBoardId, slug])
  @@index([levelId])
}

/// A school year within a country's system, offered in onboarding as "Year/form" (§5): Zimbabwe Form 1-4,
/// Lower Sixth, Upper Sixth; Zambia Grade 8-12. Referenced by Student (platform slice).
model YearGroup {
  id             String   @id @default(uuid(7)) @db.Uuid
  countryId      String   @db.Uuid
  /// Stable code, unique per country, e.g. "F4", "L6", "G12".
  code           String   @db.VarChar(16)
  /// Display name, e.g. "Form 4", "Lower Sixth".
  name           String
  /// Order within the country (1 = youngest).
  ordinal        Int
  /// Level most students in this year study; onboarding pre-selects it.
  typicalLevelId String?  @db.Uuid
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  country      Country             @relation(fields: [countryId], references: [id], onDelete: Restrict)
  typicalLevel QualificationLevel? @relation(fields: [typicalLevelId], references: [id], onDelete: SetNull)
  // Back-relations (PLATFORM slice)
  students     Student[]
  classes      Class[]

  @@unique([countryId, code])
  @@index([typicalLevelId])
}

/// Admin-extensible subject grouping (§4): Mathematics, Sciences, Commercials, Humanities, Languages,
/// Technical / Practical. Global (not per board) so "Sciences" groups ZIMSEC and Cambridge subjects alike.
model SubjectCategory {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  /// UI icon identifier from the app's fixed icon set (not a colour, not content).
  iconKey     String?  @db.VarChar(64)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  subjects Subject[]
}

/// A subject as offered under one qualification (ZIMSEC O-Level Mathematics and Cambridge IGCSE Mathematics are
/// different rows because their syllabuses differ, §3). Third URL segment: /zimsec/o-level/mathematics.
/// The curriculum itself lives in versioned Syllabus rows; a subject never holds topics directly.
model Subject {
  id              String          @id @default(uuid(7)) @db.Uuid
  qualificationId String          @db.Uuid
  categoryId      String          @db.Uuid
  /// URL segment, unique per qualification, e.g. "mathematics", "additional-mathematics".
  slug            String
  name            String
  shortName       String?         @db.VarChar(64)
  /// Official board subject code, e.g. "4004" (ZIMSEC), "0580" (Cambridge). Versions may override in Syllabus.code.
  officialCode    String?         @db.VarChar(16)
  description     String?
  /// Original public SEO summary (markdown). Never premium lesson content (§44).
  publicSummary   String?
  metaTitle       String?
  metaDescription String?
  /// BCP-47 language the subject is taught/examined in ("en", "sn" Shona, "nd" Ndebele, "fr"). Drives search config.
  languageCode    String          @default("en") @db.VarChar(10)
  iconKey         String?         @db.VarChar(64)
  catalogueStatus CatalogueStatus @default(HIDDEN)
  /// Whether a public SEO page is rendered for this subject.
  isPublic        Boolean         @default(true)
  sortOrder       Int             @default(0)
  /// Provenance of the subject definition (§27, e.g. the board's official subject list).
  sourceId        String?         @db.Uuid
  /// Dev-seed demo data (§50). Never true in production data.
  isDemo          Boolean         @default(false)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  qualification        Qualification        @relation(fields: [qualificationId], references: [id], onDelete: Restrict)
  category             SubjectCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  source               ContentSource?       @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  syllabi              Syllabus[]
  lessons              Lesson[]
  questions            Question[]
  flashcards           Flashcard[]
  assessments          Assessment[]
  examTimetableEntries ExamTimetableEntry[]
  studyPackScopes      StudyPackScope[]
  dailyQuestions       DailyQuestion[]
  contentImports       ContentImport[]
  studyPlanTemplates   StudyPlanTemplate[]
  // Back-relations (LEARNING & ENGAGEMENT slice)
  enrollments          SubjectEnrollment[]
  assessmentAttempts   AssessmentAttempt[]
  studyPlanItems       StudyPlanItem[]
  studySessions        StudySession[]
  assignments          Assignment[]
  // Back-relations (PLATFORM slice)
  schoolSubjects       SchoolSubject[]
  classes              Class[]
  aiConversations      AiConversation[]
  aiResponseCaches     AiResponseCache[]
  aiGenerationJobs     AiGenerationJob[]

  @@unique([qualificationId, slug])
  @@index([categoryId])
  @@index([sourceId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Versioned curriculum: Syllabus (one row per version) -> components/routes -> Topic tree -> LearningObjective
// ---------------------------------------------------------------------------------------------------------------------

/// ONE ROW PER SYLLABUS VERSION (§26, CLAUDE.md rule 8). Once status leaves DRAFT the version is immutable: a change
/// creates a new row (supersedesId -> previous) whose topic tree is cloned with Topic.originTopicId lineage so content
/// tags can be carried over. Students pin a version via SubjectEnrollment.syllabusId (learning slice) and keep it.
/// Invariants: exactly one CURRENT per subject (partial unique, raw SQL); effectiveTo > effectiveFrom (CHECK);
/// non-DRAFT => publishedAt set (CHECK); non-DRAFT => copyright cleared and sourceId set (CHECK, §27); structural
/// children frozen when non-DRAFT (triggers, raw SQL); enrolments may pin only published, non-ARCHIVED versions and a
/// PUBLISHED assessment / plan template may not reference a DRAFT version (triggers).
model Syllabus {
  id                  String          @id @default(uuid(7)) @db.Uuid
  subjectId           String          @db.Uuid
  /// Official syllabus code for this version, e.g. "0580", "9709", "4004".
  code                String?         @db.VarChar(16)
  /// e.g. "Cambridge IGCSE Mathematics 0580".
  title               String
  /// Human version label, unique per subject, e.g. "2025-2027", "2028-2030", "2024 revision".
  versionLabel        String          @db.VarChar(64)
  status              SyllabusStatus  @default(DRAFT)
  /// First day this version applies to examinations (first exam series covered).
  effectiveFrom       DateTime        @db.Date
  /// Last day this version applies (null = open-ended). Enrolment picks the version whose range contains the
  /// student's ExamSession.startsOn.
  effectiveTo         DateTime?       @db.Date
  /// Previous version this one replaces (lineage).
  supersedesId        String?         @db.Uuid
  /// Original summary of the syllabus (markdown), for the subject page.
  overview            String?
  /// Papers, weightings and the board's assessment objectives, summarised in original words (markdown).
  assessmentOverview  String?
  /// Link to the board's official syllabus document (link only; never re-hosted, §27).
  officialDocumentUrl String?
  /// Grade-estimate scheme override for this version (else route/qualification default).
  gradeSchemeId       String?         @db.Uuid
  /// Usually a ContentSource of type OFFICIAL_SYLLABUS (§27).
  sourceId            String?         @db.Uuid
  copyrightStatus     CopyrightStatus @default(UNVERIFIED)
  /// Notes on what may legally be reproduced from the official document.
  sourceNotes         String?
  isDemo              Boolean         @default(false)
  createdById         String?         @db.Uuid
  publishedById       String?         @db.Uuid
  publishedAt         DateTime?       @db.Timestamptz(3)
  archivedAt          DateTime?       @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)

  subject            Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  supersedes         Syllabus?           @relation("SyllabusLineage", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy       Syllabus[]          @relation("SyllabusLineage")
  gradeScheme        GradeScheme?        @relation(fields: [gradeSchemeId], references: [id], onDelete: SetNull)
  source             ContentSource?      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  createdBy          User?               @relation("SyllabusCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  publishedBy        User?               @relation("SyllabusPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  components         SyllabusComponent[]
  routes             SyllabusRoute[]
  topics             Topic[]
  questionTopics     QuestionTopic[]
  assessments        Assessment[]
  studyPackScopes    StudyPackScope[]
  contentImports     ContentImport[]
  studyPlanTemplates StudyPlanTemplate[]
  // Back-relations (LEARNING & ENGAGEMENT slice)
  /// Enrolments pinned to this version (§26).
  enrollments        SubjectEnrollment[]
  /// Mastery rows of topics in this version (composite FK keeps TopicMastery.subjectId honest).
  topicMasteries     TopicMastery[]
  // Back-relations (PLATFORM slice)
  aiGenerationJobs   AiGenerationJob[]

  @@unique([subjectId, versionLabel])
  /// Target of the composite FK QuestionTopic(syllabusId, subjectId): keeps the denormalised subjectId consistent.
  @@unique([id, subjectId])
  @@index([subjectId, status, effectiveFrom])
  @@index([supersedesId])
  @@index([gradeSchemeId])
  @@index([sourceId])
  @@index([createdById])
  @@index([publishedById])
}

/// An examination component (paper) of a syllabus version: "Paper 1 (non-calculator)", "Paper 4 Mechanics",
/// "Paper 6 Alternative to Practical". Feeds mock-exam structure (§12), exam timetable and §9 "paper".
model SyllabusComponent {
  id                String                @id @default(uuid(7)) @db.Uuid
  syllabusId        String                @db.Uuid
  /// Board's component code, unique per version, e.g. "1", "P3", "42".
  code              String                @db.VarChar(16)
  name              String
  kind              SyllabusComponentKind @default(WRITTEN)
  description       String?
  durationMinutes   Int?
  maxMarks          Int?
  /// Weighting of this component in the final grade, 0-100.
  weightingPercent  Decimal?              @db.Decimal(5, 2)
  /// null = not specified by the board.
  calculatorAllowed Boolean?
  sortOrder         Int                   @default(0)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)

  syllabus           Syllabus                 @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  routeLinks         SyllabusRouteComponent[]
  topicLinks         TopicComponent[]
  assessmentSections AssessmentSection[]
  timetableEntries   ExamTimetableEntry[]

  @@unique([syllabusId, code])
}

/// An assessment route through one syllabus version, so one Subject/Syllabus serves several awards without
/// duplication: Cambridge 9709 "AS Level" vs "A Level"; IGCSE 0580 "Core" vs "Extended". A syllabus with no routes is
/// single-route. Students choose a route on SubjectEnrollment.routeId (learning slice), pinned to the same version
/// by a composite FK onto @@unique([id, syllabusId]).
model SyllabusRoute {
  id            String   @id @default(uuid(7)) @db.Uuid
  syllabusId    String   @db.Uuid
  /// e.g. "AS", "A", "CORE", "EXTENDED".
  code          String   @db.VarChar(16)
  name          String
  description   String?
  /// Grade scheme for this award (AS uses a-e; IGCSE Core is capped at C). Null = syllabus/qualification default.
  gradeSchemeId String?  @db.Uuid
  /// Route pre-selected in onboarding. At most one per syllabus (partial unique, raw SQL).
  isDefault     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  syllabus           Syllabus                 @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  gradeScheme        GradeScheme?             @relation(fields: [gradeSchemeId], references: [id], onDelete: SetNull)
  componentLinks     SyllabusRouteComponent[]
  assessments        Assessment[]
  studyPlanTemplates StudyPlanTemplate[]
  // Back-relations (LEARNING & ENGAGEMENT slice)
  enrollments        SubjectEnrollment[]

  @@unique([syllabusId, code])
  /// Target of SubjectEnrollment's composite (routeId, syllabusId) FK.
  @@unique([id, syllabusId])
  @@index([gradeSchemeId])
}

/// Which components make up a route (9709 AS = P1 + one of P2/P4/P5; A Level = P1 + P3 + two of P4/P5/P6).
/// Route and component must belong to the same syllabus (service-enforced).
model SyllabusRouteComponent {
  routeId      String  @db.Uuid
  componentId  String  @db.Uuid
  /// false = optional component (candidate picks within choiceGroup).
  isCompulsory Boolean @default(true)
  /// Label grouping alternative components, e.g. "AS applied paper".
  choiceGroup  String? @db.VarChar(64)

  route     SyllabusRoute     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  component SyllabusComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@id([routeId, componentId])
  @@index([componentId])
}

/// One node of a syllabus version's curriculum tree: topics AND subtopics (and grouping sections) in a single
/// self-referential table, so ZIMSEC and Cambridge can have different depths (§3, §43 "do not assume identical
/// structures"). Belongs to exactly one syllabus version; a new version clones the tree (originTopicId lineage).
/// Invariants: slug unique per syllabus (stable across versions for SEO); depth = parent.depth + 1 (root depth 0,
/// CHECK on root); path = ancestor ids + own id joined by "/" (subtree = path LIKE '<node.path>/%').
model Topic {
  id                    String    @id @default(uuid(7)) @db.Uuid
  syllabusId            String    @db.Uuid
  parentId              String?   @db.Uuid
  /// The equivalent topic in the previous syllabus version this node was cloned from (null for new topics).
  originTopicId         String?   @db.Uuid
  kind                  TopicKind
  /// 0 for roots.
  depth                 Int
  /// Materialised path of ids from the root to this node, "/"-separated, e.g. "<rootId>/<childId>/<id>".
  path                  String
  /// Order among siblings.
  sortOrder             Int       @default(0)
  /// Official reference number, e.g. "1.2", "E1.1", "C3".
  code                  String?   @db.VarChar(32)
  name                  String
  /// URL segment, unique within the syllabus version; carried over unchanged to new versions where possible.
  slug                  String
  /// Scope/description of the topic (markdown; official wording only where legally usable).
  description           String?
  /// Original public SEO summary (markdown), separate from premium lesson content (§44).
  publicSummary         String?
  metaTitle             String?
  metaDescription       String?
  /// Whether a public SEO page exists for this node.
  isPublic              Boolean   @default(true)
  /// Optional/alternative content (e.g. History depth-study options, Literature set texts).
  isOptional            Boolean   @default(false)
  /// Groups mutually alternative optional topics, e.g. "Depth study (choose one)".
  optionGroup           String?   @db.VarChar(64)
  /// Exam-year applicability within the version (e.g. a set text examined only 2027-2028). Null = all years.
  examYearFrom          Int?
  examYearTo            Int?
  /// Planning estimate of study time for this node (study plan §16, "remaining syllabus").
  estimatedStudyMinutes Int?
  /// Bulk import that created the node (§25), for traceability/rollback.
  importId              String?   @db.Uuid
  /// Stable node key from the version-controlled content source (content/syllabi/..., docs/CONTENT_PIPELINE.md), unique
  /// within the syllabus version. Lets `npm run content:import` update a DRAFT tree in place and map content tags onto
  /// it. Null for nodes authored in the CMS. Editorial column: may be set on a published version (not structural).
  contentKey            String?   @db.VarChar(128)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  syllabus               Syllabus                  @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  /// Composite FK (parentId, syllabusId) -> Topic(id, syllabusId): a parent is always in the same syllabus version.
  parent                 Topic?                    @relation("TopicTree", fields: [parentId, syllabusId], references: [id, syllabusId], onDelete: Cascade)
  children               Topic[]                   @relation("TopicTree")
  originTopic            Topic?                    @relation("TopicLineage", fields: [originTopicId], references: [id], onDelete: SetNull)
  derivedTopics          Topic[]                   @relation("TopicLineage")
  import                 ContentImport?            @relation(fields: [importId], references: [id], onDelete: SetNull)
  objectives             LearningObjective[]
  componentLinks         TopicComponent[]
  lessonTopics           LessonTopic[]
  questionTopics         QuestionTopic[]
  flashcardTopics        FlashcardTopic[]
  assessmentTopics       AssessmentTopic[]
  blueprintRules         AssessmentBlueprintRule[]
  studyPlanTemplateItems StudyPlanTemplateItem[]
  // Back-relations (LEARNING & ENGAGEMENT slice)
  assessmentAttempts     AssessmentAttempt[]
  masteries              TopicMastery[]
  /// Optional topics a student chose (History depth study, Literature set text, §6/§16 scope).
  enrollmentChoices      EnrollmentTopicChoice[]
  studyPlanItems         StudyPlanItem[]
  studySessions          StudySession[]
  assignments            Assignment[]
  // Back-relations (PLATFORM slice)
  aiConversations        AiConversation[]
  aiGenerationJobs       AiGenerationJob[]

  @@unique([syllabusId, slug])
  /// Content-pipeline node keys (NULLs are distinct: CMS-authored nodes have none).
  @@unique([syllabusId, contentKey])
  /// Target of the composite FKs QuestionTopic / EnrollmentTopicChoice (topicId, syllabusId) and Topic(parentId,
  /// syllabusId).
  @@unique([id, syllabusId])
  /// Target of TopicMastery's (topicId, syllabusId, topicKind) FK: the denormalised version and kind cannot drift.
  @@unique([id, syllabusId, kind])
  /// Whole-tree fetch for a version, and subtree prefix filtering within it.
  @@index([syllabusId, path])
  /// Children in order; also covers the (parentId, syllabusId) composite FK's leading column.
  @@index([parentId, sortOrder])
  @@index([originTopicId])
  @@index([importId])
}

/// Which components (papers) examine a topic. No rows for a topic = examinable in every component of its syllabus.
/// Lets AS-only students see only AS topics (route -> components -> topics) and lets mock assembly target a paper.
model TopicComponent {
  topicId     String @db.Uuid
  componentId String @db.Uuid

  topic     Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  component SyllabusComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@id([topicId, componentId])
  @@index([componentId])
}

/// A learning objective of a topic node ("Solve quadratic equations by factorisation"), §3, §9. Version-specific like
/// its topic; originObjectiveId carries lineage to the previous version.
model LearningObjective {
  id                String          @id @default(uuid(7)) @db.Uuid
  topicId           String          @db.Uuid
  originObjectiveId String?         @db.Uuid
  /// Official reference, e.g. "E2.5a".
  code              String?         @db.VarChar(32)
  statement         String
  cognitiveSkill    CognitiveSkill?
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  topic             Topic                     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  originObjective   LearningObjective?        @relation("ObjectiveLineage", fields: [originObjectiveId], references: [id], onDelete: SetNull)
  derivedObjectives LearningObjective[]       @relation("ObjectiveLineage")
  lessonLinks       LessonObjective[]
  questionLinks     QuestionObjective[]
  blueprintRules    AssessmentBlueprintRule[]

  @@index([topicId, sortOrder])
  @@index([originObjectiveId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Grade estimates & exam calendar
// ---------------------------------------------------------------------------------------------------------------------

/// Ordered grade bands used to turn a percentage into a GRADE ESTIMATE (§12). Always presented as an estimate, never as
/// official thresholds (boards set thresholds per series). Resolution order for an attempt:
/// Assessment.gradeScheme -> SyllabusRoute.gradeScheme -> Syllabus.gradeScheme -> qualification default (isDefault).
/// At most one default per qualification (partial unique, raw SQL).
/// Versioning (§26 "do not overwrite historical data"): once any AssessmentAttempt references the scheme its bands are
/// frozen (trigger, raw SQL). Changing boundaries = a new GradeScheme row (version + 1), so a stored grade estimate and
/// pass/fail (AssessmentAttempt.gradeSchemeId / gradeIsPass) always reproduce from the scheme it names.
model GradeScheme {
  id              String   @id @default(uuid(7)) @db.Uuid
  qualificationId String   @db.Uuid
  /// e.g. "IGCSE A*-G (estimate)", "AS a-e (estimate)".
  name            String
  /// Admin-visible version of this scheme's boundaries; a replacement scheme carries the previous version + 1.
  version         Int      @default(1)
  description     String?
  isDefault       Boolean  @default(false)
  /// True unless thresholds are fixed and published by the board (sourceId must then cite it).
  isEstimate      Boolean  @default(true)
  /// Student-facing caveat shown next to every estimated grade.
  disclaimer      String?
  sourceId        String?  @db.Uuid
  sourceNote      String?
  isActive        Boolean  @default(true)
  /// Dev-seed demo data (§50). Never true in production data (trigger, raw SQL).
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  qualification      Qualification       @relation(fields: [qualificationId], references: [id], onDelete: Restrict)
  source             ContentSource?      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  bands              GradeBand[]
  syllabi            Syllabus[]
  routes             SyllabusRoute[]
  assessments        Assessment[]
  // Back-relations (LEARNING & ENGAGEMENT slice)
  /// Attempts whose grade estimate was computed with this scheme (freezes its bands).
  assessmentAttempts AssessmentAttempt[]

  @@index([qualificationId])
  @@index([sourceId])
}

/// One band of a GradeScheme: label + minimum percentage. sortOrder 0 = best grade. A percentage maps to the first band
/// (by sortOrder) whose minPercent <= percentage. CHECK 0 <= minPercent <= 100 (raw SQL). Frozen (no INSERT, UPDATE or
/// DELETE) once the scheme has been used by an attempt (trigger, raw SQL).
model GradeBand {
  id            String  @id @default(uuid(7)) @db.Uuid
  gradeSchemeId String  @db.Uuid
  /// e.g. "A*", "A", "a", "U", "1".
  label         String  @db.VarChar(8)
  minPercent    Decimal @db.Decimal(5, 2)
  sortOrder     Int
  /// Counts as a pass for pass-rate analytics (§23).
  isPass        Boolean
  description   String?

  gradeScheme GradeScheme @relation(fields: [gradeSchemeId], references: [id], onDelete: Cascade)

  @@unique([gradeSchemeId, label])
  @@unique([gradeSchemeId, sortOrder])
}

/// An examination series for a qualification, e.g. "November 2027" (§5 target examination, §17 countdown).
/// Dates are entered by admins and stay isProvisional until confirmed against the board's official timetable.
/// The board is qualification.examBoard (not duplicated).
model ExamSession {
  id              String            @id @default(uuid(7)) @db.Uuid
  qualificationId String            @db.Uuid
  /// e.g. "November 2027".
  name            String
  /// Stable code unique per qualification, e.g. "2027-NOV", "2027-JUN".
  seriesCode      String            @db.VarChar(32)
  year            Int
  /// First exam day of the series; the default countdown target.
  startsOn        DateTime          @db.Date
  endsOn          DateTime          @db.Date
  /// True until an admin confirms the dates against the official timetable.
  isProvisional   Boolean           @default(true)
  confirmedAt     DateTime?         @db.Timestamptz(3)
  confirmedById   String?           @db.Uuid
  /// Official timetable reference (link only).
  sourceUrl       String?
  status          ExamSessionStatus @default(DRAFT)
  notes           String?
  /// Dev-seed demo data (§50): a seeded date must never drive a real §17 countdown (trigger, raw SQL).
  isDemo          Boolean           @default(false)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  qualification        Qualification        @relation(fields: [qualificationId], references: [id], onDelete: Restrict)
  confirmedBy          User?                @relation("ExamSessionConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  timetableEntries     ExamTimetableEntry[]
  // Back-relations (LEARNING & ENGAGEMENT slice)
  /// Enrolments whose per-subject target exam (§5, §17 countdown) is this session.
  targetingEnrollments SubjectEnrollment[]
  // Back-relations (PLATFORM slice)
  /// Students whose onboarding default target exam (§5) is this session.
  targetingStudents    Student[]

  @@unique([qualificationId, seriesCode])
  @@index([status, startsOn])
  @@index([confirmedById])
}

/// Optional per-subject/per-paper date within a session ("Mathematics Paper 1, 3 Nov 2027 09:00"), giving per-subject
/// countdowns and letting the study plan (§16) finish a subject before its first paper.
model ExamTimetableEntry {
  id              String   @id @default(uuid(7)) @db.Uuid
  examSessionId   String   @db.Uuid
  subjectId       String   @db.Uuid
  componentId     String?  @db.Uuid
  /// Display label when no component is linked, e.g. "Paper 2".
  label           String?
  startsAt        DateTime @db.Timestamptz(3)
  durationMinutes Int?
  isProvisional   Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  examSession ExamSession        @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  subject     Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  component   SyllabusComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)

  @@index([examSessionId, startsAt])
  @@index([subjectId, startsAt])
  @@index([componentId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Licensing, media, imports
// ---------------------------------------------------------------------------------------------------------------------

/// Where content comes from and under what terms (§27): our own originals, licensed publishers, open-licensed
/// material, public domain, official syllabus documents. Referenced by content items; items may override licence
/// details. Sources are never deleted (references are Restrict); deactivate instead.
model ContentSource {
  id                   String            @id @default(uuid(7)) @db.Uuid
  name                 String
  slug                 String            @unique
  type                 ContentSourceType
  publisher            String?
  url                  String?
  /// SPDX-style identifier, e.g. "CC-BY-4.0", "CC-BY-SA-4.0", or "PROPRIETARY".
  licenceCode          String?           @db.VarChar(64)
  licenceUrl           String?
  /// Attribution text that must accompany the content when requiresAttribution.
  attributionText      String?
  requiresAttribution  Boolean           @default(false)
  permitsCommercialUse Boolean           @default(false)
  permitsDerivatives   Boolean           @default(false)
  /// Licence allows PDF export (study-pack PDF export is gated on this, §24).
  permitsPdfExport     Boolean           @default(false)
  /// Contract/agreement reference for LICENSED sources.
  agreementReference   String?
  validFrom            DateTime?         @db.Date
  /// Licence expiry; a worker archives content from expired sources.
  validUntil           DateTime?         @db.Date
  notes                String?
  isActive             Boolean           @default(true)
  /// Dev-seed demo data (§50). Never true in production data (trigger, raw SQL).
  isDemo               Boolean           @default(false)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)

  subjects     Subject[]
  syllabi      Syllabus[]
  gradeSchemes GradeScheme[]
  lessons      Lesson[]
  questions    Question[]
  flashcards   Flashcard[]
  assessments  Assessment[]
  mediaAssets  MediaAsset[]

  @@index([type, isActive])
}

/// Any uploaded file (content images/diagrams/audio, marketing images, avatars, solver uploads, answer attachments,
/// import files, school report exports). Bytes live in object storage under storageKey; this row holds validated
/// metadata (sniffed type, size, checksum, owner, status, retention). Every user-supplied file goes through this table:
/// no other column may hold a raw storage key. Invariants (CHECKs, raw SQL): content images/diagrams have non-empty
/// altText (§43); SOLVER_UPLOAD is OWNER_ONLY and IMPORT_FILE / ANSWER_ATTACHMENT / REPORT_EXPORT are PRIVATE; PUBLIC
/// files never have UNVERIFIED copyright (school logos excepted); LICENSED needs sourceId and OPEN_LICENSE a sourceId or
/// licenceCode. Never hard-deleted while referenced (ContentMediaUsage / QuestionAttemptAttachment are Restrict): the
/// row is soft-deleted (status DELETED) and a worker removes the object.
model MediaAsset {
  id               String          @id @default(uuid(7)) @db.Uuid
  /// Object-storage key, e.g. "content/2026/10/<uuid>.webp".
  storageKey       String          @unique
  /// Sniffed MIME type (not the client-declared one).
  mimeType         String          @db.VarChar(127)
  byteSize         Int
  width            Int?
  height           Int?
  /// Duration for audio.
  durationMs       Int?
  /// Hex SHA-256 of the bytes; used for dedupe and integrity checks.
  checksumSha256   String          @db.Char(64)
  /// Sanitised original filename (for admin display only).
  originalFilename String?
  /// Required (non-empty) for CONTENT_IMAGE and DIAGRAM (§43).
  altText          String?
  caption          String?
  /// Extended description for complex diagrams/graphs (screen readers).
  longDescription  String?
  purpose          MediaPurpose
  visibility       MediaVisibility @default(PRIVATE)
  status           MediaStatus     @default(PENDING)
  /// Pre-generated responsive variants. Shape: [{ width: number, format: "webp"|"avif"|"png", storageKey: string,
  /// byteSize: number }]
  variants         Json?
  /// Tiny base64 placeholder for low-bandwidth progressive loading (§29).
  blurDataUrl      String?
  uploadedById     String?         @db.Uuid
  // --- provenance (§27) ---
  sourceId         String?         @db.Uuid
  author           String?
  copyrightStatus  CopyrightStatus @default(UNVERIFIED)
  licenceCode      String?         @db.VarChar(64)
  attribution      String?
  sourceUrl        String?
  isDemo           Boolean         @default(false)
  deletedAt        DateTime?       @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)

  uploadedBy           User?                       @relation("MediaAssetUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  source               ContentSource?              @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  usages               ContentMediaUsage[]
  examBoardLogos       ExamBoard[]
  questionOptions      QuestionOption[]
  studyPackCovers      StudyPack[]
  testimonials         Testimonial[]
  contentImports       ContentImport[]
  // Back-relations (LEARNING & ENGAGEMENT slice)
  answerAttachments    QuestionAttemptAttachment[]
  // Back-relations (PLATFORM slice)
  profileAvatars       Profile[]
  schoolLogos          School[]
  aiMessageAttachments AiMessage[]
  schoolReports        SchoolReport[]

  @@index([uploadedById, createdAt])
  @@index([purpose, status, createdAt])
  @@index([checksumSha256])
  @@index([sourceId])
}

/// Where a media asset is referenced from inside markdown or Json (lesson body, question stem/payload, option,
/// flashcard...). Postgres cannot FK into text/Json, so the content service rewrites these rows on every save.
/// Gives referential integrity (an asset in use cannot be deleted), licensing audits ("where is this licensed image
/// used?") and orphan-upload cleanup.
model ContentMediaUsage {
  entityType   ContentEntityType
  entityId     String            @db.Uuid
  mediaAssetId String            @db.Uuid
  /// Field containing the reference, e.g. "body", "stem", "payload", "workedSolution", "back". "" when not applicable.
  field        String            @default("") @db.VarChar(64)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([entityType, entityId, mediaAssetId, field])
  @@index([mediaAssetId])
}

/// A bulk import run (§25: CSV/Excel/JSON) of topics, questions, lessons or flashcards. Validation is a dry run that
/// records row errors; the import itself only ever creates DRAFT content (rule 7; trigger: a row with importId is
/// inserted as DRAFT). A row whose externalRef matches a live item becomes a DRAFT COPY of it (draftOfId), never an
/// in-place update of published content. An import never asserts copyright: editors clear it per item at review.
/// Imported rows carry importId so a bad batch can be reviewed or archived as a unit.
model ContentImport {
  id           String              @id @default(uuid(7)) @db.Uuid
  /// What is being imported (TOPIC, QUESTION, LESSON, FLASHCARD).
  entityType   ContentEntityType
  format       ContentImportFormat
  status       ContentImportStatus @default(UPLOADED)
  /// The uploaded file (MediaAsset with purpose IMPORT_FILE).
  fileMediaId  String              @db.Uuid
  /// Target subject for content imports.
  subjectId    String?             @db.Uuid
  /// Target syllabus version for topic-tree imports / topic tagging.
  syllabusId   String?             @db.Uuid
  /// Column mapping and options. Shape: { columnMap: Record<string, string>, defaults?: { difficulty?: number,
  /// sourceId?: string, accessTier?: ContentAccessTier } }   (no copyright default, no update-in-place option)
  options      Json?
  totalRows    Int                 @default(0)
  validRows    Int                 @default(0)
  importedRows Int                 @default(0)
  failedRows   Int                 @default(0)
  /// Row-level problems, capped (e.g. first 1000). Shape: [{ row: number, field?: string, code: string,
  /// message: string }]
  errors       Json?
  createdById  String              @db.Uuid
  startedAt    DateTime?           @db.Timestamptz(3)
  completedAt  DateTime?           @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)

  file       MediaAsset  @relation(fields: [fileMediaId], references: [id], onDelete: Restrict)
  subject    Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  syllabus   Syllabus?   @relation(fields: [syllabusId], references: [id], onDelete: SetNull)
  createdBy  User        @relation("ContentImportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  topics     Topic[]
  lessons    Lesson[]
  questions  Question[]
  flashcards Flashcard[]

  @@index([createdById, createdAt])
  @@index([status, createdAt])
  @@index([fileMediaId])
  @@index([subjectId])
  @@index([syllabusId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Lessons (§8)
//
// Common workflow + provenance columns (Lesson, Question, Flashcard, Assessment, StudyPack, StudyPlanTemplate):
//   status / revision / draftOfId / createdById / reviewedById / reviewedAt / reviewNotes / approvedById / approvedAt /
//   publishedAt / archivedAt / aiGenerated / generationJobId   and (content items)  sourceId / author /
//   copyrightStatus / licenceCode / attribution / sourceUrl / publicationDate / isDemo.
// Draft-copy editing: editing a PUBLISHED item creates a sibling row with draftOfId = live id (status DRAFT). Students
// keep seeing the live row. Publishing the draft copies its fields/children onto the live row (under
// set_config('app.content_publish', <live id>, true)), increments live.revision, sets live.aiGenerated :=
// live.aiGenerated OR draft.aiGenerated, copies approvedById/approvedAt from the draft, writes an immutable
// ContentRevision snapshot and deletes the draft row. Ids seen by students never change, so attempts/progress/stats
// stay attached.
// DB-enforced (raw SQL):
//   CHECKs   draft rows are never PUBLISHED/ARCHIVED; PUBLISHED => publishedAt, ARCHIVED => archivedAt;
//            generationJobId => aiGenerated; aiGenerated AND (APPROVED|PUBLISHED) => approvedById AND approvedAt
//            (human approval, §41); platform rows APPROVED|PUBLISHED => approvedAt (no unreviewed platform content);
//            PUBLISHED => copyright not UNVERIFIED; LICENSED => sourceId; OPEN_LICENSE => sourceId or licenceCode.
//   triggers content_workflow_guard: aiGenerated never flips back to false; AI rows and imported rows are inserted as
//            DRAFT; platform status moves only DRAFT->IN_REVIEW->APPROVED->PUBLISHED->ARCHIVED (+ back to DRAFT from
//            IN_REVIEW/APPROVED/ARCHIVED); four-eyes (approver <> creator) when app.four_eyes = 'on'.
//            content_published_immutable: a PUBLISHED row's content columns change only with revision + 1.
//            <T>_revision_snapshot (deferred): a live PUBLISHED row always has its ContentRevision snapshot.
//            content_child_guard: options / parts / sections / items / rules / scopes / template items of a PUBLISHED
//            root change only inside the publish transaction.
// School/tutor-owned questions and tests follow their owner's lighter workflow (no platform approval, may be published
// directly) but keep revisions and snapshots, because attempts reference them. Personal flashcards (ownerUserId) are
// exempt from approval, revision bumps and snapshots: nobody else ever sees them.
// ---------------------------------------------------------------------------------------------------------------------

/// A lesson page (§8): Markdown + LaTeX + content blocks stored as source text, rendered by the server-side content
/// pipeline (ARCHITECTURE §3.10: sanitise, then KaTeX) at SAVE time into bodyHtml. Reusable across boards/versions via
/// LessonTopic tags. Authoring syntax is defined in docs/CONTENT_AUTHORING.md (content blocks such as :::definition,
/// :::exam-tip, :::worked-solution; images as ![alt](asset:<MediaAsset.id>); GFM tables; $..$ / $$..$$ maths) and
/// embedded practice questions as ::question{id="<Question.id>"}; the schema stores source text and is agnostic to the
/// block vocabulary. Lessons are platform content only (no school/tutor lessons).
/// Scope: a home subject for every kind except public ARTICLE / STUDY_GUIDE pages, which may instead be scoped to a
/// qualification or a board, or be general (§44); at most one scope column is set (CHECKs, raw SQL).
model Lesson {
  id               String            @id @default(uuid(7)) @db.Uuid
  /// Home subject (where authored); used for CMS filtering and default URL. Other subjects reach it via LessonTopic.
  /// NULL only for ARTICLE / STUDY_GUIDE pages that are board-, qualification-level or general.
  subjectId        String?           @db.Uuid
  /// Scope of a subject-less article / study guide: one qualification ("How to prepare for ZIMSEC O-Level")...
  qualificationId  String?           @db.Uuid
  /// ...or one board ("How ZIMSEC grading works").
  examBoardId      String?           @db.Uuid
  kind             LessonKind        @default(LESSON)
  title            String
  /// Unique among live rows per home subject, or globally for subject-less pages (partial uniques WHERE draftOfId IS
  /// NULL, raw SQL).
  slug             String
  /// One-paragraph summary for cards and meta fallback.
  summary          String?
  /// Markdown source (see model doc).
  body             String
  /// Sanitised, KaTeX-rendered HTML of body produced at save time (null until first render).
  bodyHtml         String?
  /// Pipeline version that produced bodyHtml; a renderer upgrade bumps the version and a job re-renders stale rows.
  renderVersion    Int?
  /// Hex SHA-256 of the body source that produced bodyHtml (also the offline-cache ETag, §29).
  contentHash      String?           @db.Char(64)
  /// BCP-47 language of this item's text ("en", "sn", "nd", "fr"); defaults from the subject (ARCHITECTURE §3.12).
  languageCode     String            @default("en") @db.VarChar(10)
  estimatedMinutes Int               @default(10)
  accessTier       ContentAccessTier @default(PREMIUM)
  metaTitle        String?
  metaDescription  String?
  /// Stable key for idempotent re-imports (§25). Only live rows carry it (draft copies: null, CHECK).
  externalRef      String?           @unique
  // --- workflow ---
  status           ContentStatus     @default(DRAFT)
  /// Revision number of this row's content. Live rows: the published revision students see (snapshot in
  /// ContentRevision). Draft copies: the revision they will become.
  revision         Int               @default(1)
  /// Set on a draft copy: the live lesson it will replace when published.
  draftOfId        String?           @unique @db.Uuid
  createdById      String?           @db.Uuid
  reviewedById     String?           @db.Uuid
  reviewedAt       DateTime?         @db.Timestamptz(3)
  /// Latest reviewer feedback (full history in AuditLog).
  reviewNotes      String?
  approvedById     String?           @db.Uuid
  approvedAt       DateTime?         @db.Timestamptz(3)
  publishedAt      DateTime?         @db.Timestamptz(3)
  archivedAt       DateTime?         @db.Timestamptz(3)
  aiGenerated      Boolean           @default(false)
  generationJobId  String?           @db.Uuid
  // --- provenance (§27) ---
  sourceId         String?           @db.Uuid
  author           String?
  copyrightStatus  CopyrightStatus   @default(UNVERIFIED)
  licenceCode      String?           @db.VarChar(64)
  attribution      String?
  sourceUrl        String?
  publicationDate  DateTime?         @db.Date
  isDemo           Boolean           @default(false)
  importId         String?           @db.Uuid
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)

  subject                Subject?                @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  qualification          Qualification?          @relation(fields: [qualificationId], references: [id], onDelete: Restrict)
  examBoard              ExamBoard?              @relation(fields: [examBoardId], references: [id], onDelete: Restrict)
  draftOf                Lesson?                 @relation("LessonDraft", fields: [draftOfId], references: [id], onDelete: Cascade)
  pendingDraft           Lesson?                 @relation("LessonDraft")
  createdBy              User?                   @relation("LessonCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy             User?                   @relation("LessonReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedBy             User?                   @relation("LessonApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  generationJob          AiGenerationJob?        @relation("LessonGenerationJob", fields: [generationJobId], references: [id], onDelete: SetNull)
  source                 ContentSource?          @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  import                 ContentImport?          @relation(fields: [importId], references: [id], onDelete: SetNull)
  topics                 LessonTopic[]
  objectives             LessonObjective[]
  practiceLinks          LessonQuestion[]
  relatedQuestions       Question[]              @relation("QuestionRelatedLesson")
  studyPlanTemplateItems StudyPlanTemplateItem[]
  // Back-relations (LEARNING & ENGAGEMENT slice)
  /// LESSON_CHECK attempts (§8 lesson practice questions).
  lessonCheckAttempts    AssessmentAttempt[]
  progress               LessonProgress[]
  studyPlanItems         StudyPlanItem[]
  studySessions          StudySession[]
  assignments            Assignment[]

  @@index([subjectId, status, kind])
  /// Qualification-level SEO articles; covers the FK.
  @@index([qualificationId, status, kind])
  /// Board-level SEO articles; covers the FK.
  @@index([examBoardId, status, kind])
  @@index([status, updatedAt])
  @@index([createdById, createdAt])
  @@index([reviewedById])
  @@index([approvedById])
  @@index([generationJobId])
  @@index([sourceId])
  @@index([importId])
}

/// Tags a lesson to topic nodes (any syllabus/version/board). One primary (home) topic per lesson (partial unique, raw
/// SQL); sortOrder positions the lesson within that topic ("Probability -> Lesson 4", §12).
model LessonTopic {
  lessonId  String   @db.Uuid
  topicId   String   @db.Uuid
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([lessonId, topicId])
  @@index([topicId, sortOrder])
}

/// Learning objectives a lesson covers.
model LessonObjective {
  lessonId    String @db.Uuid
  objectiveId String @db.Uuid

  lesson    Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  objective LearningObjective @relation(fields: [objectiveId], references: [id], onDelete: Restrict)

  @@id([lessonId, objectiveId])
  @@index([objectiveId])
}

/// Practice questions attached to a lesson (§8 "practice questions"), in order. ::question directives in the body must
/// reference a linked question (service-validated), giving an FK for embedded questions. Lessons are platform content,
/// so the question must be a platform question (tenant guard trigger, raw SQL); rows under a PUBLISHED lesson change
/// only inside the publish transaction (content_child_guard).
model LessonQuestion {
  lessonId   String @db.Uuid
  questionId String @db.Uuid
  sortOrder  Int    @default(0)

  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([lessonId, questionId])
  @@index([questionId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Question bank (§9, §10, §42)
// ---------------------------------------------------------------------------------------------------------------------

/// A question in the bank, or a PART of a structured question (parentId set). §9 metadata mapping:
/// board/qualification/level/subject/topic/subtopic -> QuestionTopic (denormalised subjectId/syllabusId) + home
/// subjectId; type; difficulty; marks; estimatedSeconds; year; paperLabel; cognitiveSkill ("skill tested");
/// QuestionObjective ("learning objective"). Only roots (parentId null) are selected into practice/assessments; parts
/// are marked individually and rolled up. Students see PUBLISHED rows only, rendered from this row; attempts store
/// (questionId, revision) and can re-render exactly what was seen from ContentRevision.
/// Tenancy (§22, §39): platform bank = schoolId NULL AND ownerUserId NULL. School-private = schoolId (teachers of that
/// school). Tutor-private = ownerUserId (an independent tutor; visible to members of that tutor's classes through
/// Assignments). At most one owner column is set; the tenant is fixed at insert and parts share their root's tenant
/// (CHECK + trigger). Private questions are never PUBLIC, never daily-eligible and never in SearchDocument; the student
/// practice pool reads only QuestionTopic.isPlatform rows plus the student's own school/tutor pool.
/// CHECKs (raw SQL): difficulty 1-5; marks > 0; partLabel set iff parentId set; plus the common workflow CHECKs.
model Question {
  id                String            @id @default(uuid(7)) @db.Uuid
  /// Home subject (authoring context) for CMS filtering/indexing. Cross-board use goes through QuestionTopic.
  subjectId         String            @db.Uuid
  /// Root question for parts of a STRUCTURED question (parts may nest one more level: (b)(i)).
  parentId          String?           @db.Uuid
  /// Part label shown to students, e.g. "(a)", "(b)(ii)". Required iff parentId is set.
  partLabel         String?           @db.VarChar(16)
  /// Order of the part within its parent.
  partOrder         Int               @default(0)
  type              QuestionType
  markingMode       MarkingMode       @default(AUTO)
  /// Question text (markdown + LaTeX; ::image directives). For a STRUCTURED root: the shared context/preamble.
  stem              String
  /// Type-specific presentation data, validated by Zod per type (null for SHORT_ANSWER/NUMERICAL/ESSAY/... and
  /// STRUCTURED roots). Shapes:
  ///   MULTIPLE_CHOICE: { selectMode: "single"|"multiple", shuffleOptions: boolean }   (options in QuestionOption)
  ///   TRUE_FALSE:      { statementStyle?: "true_false"|"yes_no" }
  ///   MATCHING:        { left: [{ id, content }], right: [{ id, content }], shuffle: boolean }
  ///   FILL_IN_THE_BLANK: { template: string /* markdown with {{blank:<id>}} */,
  ///                      blanks: [{ id, input: "text"|"number"|"select", choices?: string[] }] }
  ///   DIAGRAM_LABELLING: { mediaAssetId: uuid, labels?: [{ id, text }] /* word bank; omit for free text */,
  ///                      hotspots: [{ id, x: number, y: number, w?: number, h?: number }] /* % of image */ }
  ///   NUMERICAL/CALCULATION: { unitHint?: string, answerPrefix?: string }
  ///   ESSAY/EXTENDED_RESPONSE: { wordLimit?: { min?: number, max?: number } }
  payload           Json?
  /// Marking specification ("the answer", §34), validated by Zod per type. Shapes:
  ///   MULTIPLE_CHOICE: { scoring: "all_or_nothing"|"partial" }          (correct keys = QuestionOption.isCorrect)
  ///   TRUE_FALSE:      { correct: boolean, feedbackTrue?: md, feedbackFalse?: md }
  ///   SHORT_ANSWER:    { accepted: [{ value, caseSensitive?: boolean }], patterns?: string[] /* regex */,
  ///                      keywords?: { all?: string[], any?: string[], minAny?: number }, normalise?: string[] }
  ///   NUMERICAL:       { value: number, tolerance?: { kind: "absolute"|"relative", amount: number },
  ///                      sigFigs?: { min?: number, max?: number }, decimalPlaces?: number,
  ///                      units?: { required: boolean, accepted: string[], penaltyMarks?: number } }
  ///   CALCULATION:     NUMERICAL fields + { methodMarks?: [{ id, description, marks }] }  (M/A marks; AI-assisted)
  ///   MATCHING:        { pairs: [{ leftId, rightId }], marksPerPair?: number }
  ///   FILL_IN_THE_BLANK: { blanks: [{ id, accepted: string[], caseSensitive?: boolean, tolerance?: number }] }
  ///   DIAGRAM_LABELLING: { hotspots: [{ hotspotId, labelId?: string, accepted?: string[] }] }
  ///   ESSAY/EXTENDED_RESPONSE: { markScheme: { points: [{ id, description, marks, indicators?: string[] }],
  ///                      levels?: [{ level, minMarks, maxMarks, descriptor }] }, modelAnswer?: md }
  ///   Any type may add { markingNotes?: md } for AI/human markers. STRUCTURED roots: null (parts carry specs).
  answerSpec        Json?
  /// Why the correct answer is correct (§10), markdown.
  explanation       String?
  /// Full step-by-step solution, markdown + LaTeX.
  workedSolution    String?
  /// Ordered hints, each markdown; revealed one at a time (AI tutor uses them too, §14).
  hints             String[]          @default([])
  /// The relevant concept in one or two sentences (§10 "relevant concept").
  conceptSummary    String?
  /// Best lesson for "Study this topic" (§10); otherwise derived from the primary topic.
  relatedLessonId   String?           @db.Uuid
  /// 1 (easiest) .. 5 (hardest).
  difficulty        Int
  /// Marks available. For a STRUCTURED root: total of its parts (service-maintained).
  marks             Int
  estimatedSeconds  Int?
  /// Year of origin (e.g. year a licensed past-paper item was set, or authoring year).
  year              Int?
  /// Paper the question is styled on / belongs to, e.g. "Paper 2" (free text: questions outlive syllabus versions).
  paperLabel        String?           @db.VarChar(32)
  /// §9 "skill tested".
  cognitiveSkill    CognitiveSkill?
  /// Mirrors real exam format/difficulty; adaptive engine introduces these to strong students (§11).
  isExamStyle       Boolean           @default(false)
  /// May be scheduled as a DailyQuestion (short, AUTO-marked, renders on WhatsApp). Used by practice.dailyQuestionFill.
  /// Platform questions only (CHECK).
  isDailyEligible   Boolean           @default(false)
  calculatorAllowed Boolean?
  accessTier        ContentAccessTier @default(PREMIUM)
  /// BCP-47 language of this item's text; defaults from the subject.
  languageCode      String            @default("en") @db.VarChar(10)
  /// Sanitised, KaTeX-rendered HTML of every markdown field, produced at save time by the content pipeline.
  /// Shape: { stem: string, explanation?: string, workedSolution?: string, conceptSummary?: string, hints: string[],
  /// options?: Record<optionKey, string>, payload?: Record<string, string> /* rendered labels/blanks */ }
  renderedHtml      Json?
  /// Pipeline version that produced renderedHtml.
  renderVersion     Int?
  /// Owning school for teacher-authored questions (§22). School questions are visible only to that school and follow
  /// the school's own approval (never enter the platform bank or search).
  schoolId          String?           @db.Uuid
  /// Owning independent tutor (a teacher with school-less classes, §22). Never set together with schoolId.
  ownerUserId       String?           @db.Uuid
  externalRef       String?           @unique
  // --- workflow ---
  status            ContentStatus     @default(DRAFT)
  revision          Int               @default(1)
  draftOfId         String?           @unique @db.Uuid
  createdById       String?           @db.Uuid
  reviewedById      String?           @db.Uuid
  reviewedAt        DateTime?         @db.Timestamptz(3)
  reviewNotes       String?
  approvedById      String?           @db.Uuid
  approvedAt        DateTime?         @db.Timestamptz(3)
  publishedAt       DateTime?         @db.Timestamptz(3)
  archivedAt        DateTime?         @db.Timestamptz(3)
  aiGenerated       Boolean           @default(false)
  generationJobId   String?           @db.Uuid
  // --- provenance (§27) ---
  sourceId          String?           @db.Uuid
  author            String?
  copyrightStatus   CopyrightStatus   @default(UNVERIFIED)
  licenceCode       String?           @db.VarChar(64)
  attribution       String?
  sourceUrl         String?
  publicationDate   DateTime?         @db.Date
  isDemo            Boolean           @default(false)
  importId          String?           @db.Uuid
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  subject         Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  parent          Question?           @relation("QuestionParts", fields: [parentId], references: [id], onDelete: Cascade)
  parts           Question[]          @relation("QuestionParts")
  draftOf         Question?           @relation("QuestionDraft", fields: [draftOfId], references: [id], onDelete: Cascade)
  pendingDraft    Question?           @relation("QuestionDraft")
  relatedLesson   Lesson?             @relation("QuestionRelatedLesson", fields: [relatedLessonId], references: [id], onDelete: SetNull)
  school          School?             @relation("QuestionSchool", fields: [schoolId], references: [id], onDelete: Restrict)
  ownerUser       User?               @relation("QuestionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdBy       User?               @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy      User?               @relation("QuestionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedBy      User?               @relation("QuestionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  generationJob   AiGenerationJob?    @relation("QuestionGenerationJob", fields: [generationJobId], references: [id], onDelete: SetNull)
  source          ContentSource?      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  import          ContentImport?      @relation(fields: [importId], references: [id], onDelete: SetNull)
  options         QuestionOption[]
  topics          QuestionTopic[]
  objectives      QuestionObjective[]
  lessonLinks     LessonQuestion[]
  assessmentItems AssessmentItem[]
  dailyQuestions  DailyQuestion[]
  // Back-relations (LEARNING & ENGAGEMENT slice)
  attempts        QuestionAttempt[]
  stats           QuestionStats?
  // Back-relations (PLATFORM slice)
  aiConversations AiConversation[]

  /// Subject-wide practice pools and CMS filters (status + difficulty band).
  @@index([subjectId, status, difficulty])
  /// Near-duplicate detection for AI drafts and imports (pg_trgm similarity, ARCHITECTURE §6.6).
  @@index([stem(ops: raw("gin_trgm_ops"))], type: Gin)
  /// Editorial queues (e.g. all IN_REVIEW, oldest first).
  @@index([status, updatedAt])
  @@index([parentId, partOrder])
  @@index([schoolId, status])
  /// A tutor's own question bank; covers the FK.
  @@index([ownerUserId, status])
  @@index([relatedLessonId])
  @@index([createdById, createdAt])
  @@index([reviewedById])
  @@index([approvedById])
  @@index([generationJobId])
  @@index([sourceId])
  @@index([importId])
}

/// An answer option of a MULTIPLE_CHOICE question (TRUE_FALSE uses answerSpec). A table rather than Json because:
/// per-option rationale/misconception feedback, option images with FK integrity, and distractor analysis keyed by the
/// stable `key` (attempt responses store keys, which survive revisions; options are updated in place by key on publish).
/// Options of a PUBLISHED question (answer keys!) change only inside the publish transaction (content_child_guard).
model QuestionOption {
  id           String   @id @default(uuid(7)) @db.Uuid
  questionId   String   @db.Uuid
  /// Stable option key, e.g. "A".."E". Never re-used for a different option across revisions.
  key          String   @db.VarChar(8)
  /// Option text (markdown + LaTeX).
  content      String
  isCorrect    Boolean  @default(false)
  /// Shown after answering: why this option is right, or the misconception it reveals.
  rationale    String?
  mediaAssetId String?  @db.Uuid
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@unique([questionId, key])
  @@index([mediaAssetId])
}

/// Tags a question to a topic node of any syllabus version/board (content reuse across ZIMSEC/Cambridge and across
/// versions, decision 4). syllabusId/subjectId are denormalised from the topic for fast filtering and are kept
/// consistent by composite FKs: (topicId, syllabusId) -> Topic(id, syllabusId) and (syllabusId, subjectId) ->
/// Syllabus(id, subjectId). At most one primary tag per (question, syllabus) (partial unique, raw SQL): the primary
/// tag is the topic whose mastery the question counts towards in that syllabus.
/// Tenant safety (§22, §39): isPlatform is set by a BEFORE INSERT trigger from the question's (immutable) tenant, never
/// by the application. The STUDENT practice pool reads platform rows through QuestionTopic_platform_pool_idx
/// (WHERE "isPlatform") and adds school/tutor questions only for the student's own school / tutor classes.
/// Tags are curriculum metadata, not question content: they may be added to a published question (e.g. when a new
/// syllabus version is tagged) without a new revision.
model QuestionTopic {
  questionId String   @db.Uuid
  topicId    String   @db.Uuid
  syllabusId String   @db.Uuid
  subjectId  String   @db.Uuid
  isPrimary  Boolean  @default(false)
  /// Question is platform bank content (schoolId and ownerUserId NULL). Trigger-maintained; never written by the app.
  isPlatform Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topic    Topic    @relation(fields: [topicId, syllabusId], references: [id, syllabusId], onDelete: Restrict)
  syllabus Syllabus @relation(fields: [syllabusId, subjectId], references: [id, subjectId], onDelete: Restrict)

  @@id([questionId, topicId])
  /// Practice by topic subtree: topicId IN (...). Exactly covers the (topicId, syllabusId) composite FK.
  @@index([topicId, syllabusId])
  /// Editor/teacher queries over a version (CMS coverage, school pools). Covers the (syllabusId, subjectId) FK. Student
  /// pools use the partial platform index instead (raw SQL).
  @@index([syllabusId, subjectId])
  /// Subject-wide pools regardless of version (cross-board reuse analytics, CMS coverage reports).
  @@index([subjectId])
}

/// Learning objectives a question assesses (§9 "learning objective").
model QuestionObjective {
  questionId  String @db.Uuid
  objectiveId String @db.Uuid

  question  Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  objective LearningObjective @relation(fields: [objectiveId], references: [id], onDelete: Restrict)

  @@id([questionId, objectiveId])
  @@index([objectiveId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Flashcards (§18 content side; scheduling state is FlashcardState/FlashcardReview in the learning slice)
// ---------------------------------------------------------------------------------------------------------------------

/// A flashcard. Platform cards (ownerUserId null) follow the editorial workflow and are shared once PUBLISHED.
/// Personal cards (ownerUserId set) are created by a student, visible ONLY to that student, never searchable or shared,
/// and skip editorial review: created PUBLISHED, "deleted" by setting ARCHIVED (review history is kept). On account
/// deletion personal cards are archived and their text blanked (FlashcardState is Restrict, so rows stay).
/// subjectId is the AUTHORING (home) subject; platform cards reach other boards/versions through FlashcardTopic, so a
/// student's decks are computed from FlashcardTopic of the pinned syllabus version, never from this column.
model Flashcard {
  id              String            @id @default(uuid(7)) @db.Uuid
  subjectId       String            @db.Uuid
  /// Student who owns a personal card. Null = platform card.
  ownerUserId     String?           @db.Uuid
  cardType        FlashcardType
  /// Prompt side (markdown + LaTeX).
  front           String
  /// Answer side (markdown + LaTeX).
  back            String
  /// Optional extra (mnemonic, example, source sentence), markdown.
  notes           String?
  /// BCP-47 language of this item's text; defaults from the subject.
  languageCode    String            @default("en") @db.VarChar(10)
  /// Sanitised, KaTeX-rendered HTML produced at save time. Shape: { front: string, back: string, notes?: string }
  renderedHtml    Json?
  renderVersion   Int?
  accessTier      ContentAccessTier @default(PREMIUM)
  externalRef     String?           @unique
  // --- workflow ---
  status          ContentStatus     @default(DRAFT)
  revision        Int               @default(1)
  draftOfId       String?           @unique @db.Uuid
  createdById     String?           @db.Uuid
  reviewedById    String?           @db.Uuid
  reviewedAt      DateTime?         @db.Timestamptz(3)
  reviewNotes     String?
  approvedById    String?           @db.Uuid
  approvedAt      DateTime?         @db.Timestamptz(3)
  publishedAt     DateTime?         @db.Timestamptz(3)
  archivedAt      DateTime?         @db.Timestamptz(3)
  aiGenerated     Boolean           @default(false)
  generationJobId String?           @db.Uuid
  // --- provenance (§27) ---
  sourceId        String?           @db.Uuid
  author          String?
  copyrightStatus CopyrightStatus   @default(UNVERIFIED)
  licenceCode     String?           @db.VarChar(64)
  attribution     String?
  sourceUrl       String?
  publicationDate DateTime?         @db.Date
  isDemo          Boolean           @default(false)
  importId        String?           @db.Uuid
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  subject       Subject          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  owner         User?            @relation("FlashcardOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  draftOf       Flashcard?       @relation("FlashcardDraft", fields: [draftOfId], references: [id], onDelete: Cascade)
  pendingDraft  Flashcard?       @relation("FlashcardDraft")
  createdBy     User?            @relation("FlashcardCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy    User?            @relation("FlashcardReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedBy    User?            @relation("FlashcardApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  generationJob AiGenerationJob? @relation("FlashcardGenerationJob", fields: [generationJobId], references: [id], onDelete: SetNull)
  source        ContentSource?   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  import        ContentImport?   @relation(fields: [importId], references: [id], onDelete: SetNull)
  topics        FlashcardTopic[]
  // Back-relations (LEARNING & ENGAGEMENT slice)
  /// Per-learner spaced-repetition state (§18).
  states        FlashcardState[]

  @@index([subjectId, status, cardType])
  // Near-duplicate detection for AI drafts and imports uses the PARTIAL trigram index Flashcard_front_platform_trgm_idx
  // (raw SQL, platform cards only) so student-created personal cards never pay GIN maintenance.
  /// A student's personal deck per subject.
  @@index([ownerUserId, subjectId])
  @@index([status, updatedAt])
  @@index([createdById, createdAt])
  @@index([reviewedById])
  @@index([approvedById])
  @@index([generationJobId])
  @@index([sourceId])
  @@index([importId])
}

/// Tags a flashcard to topic nodes. One primary topic per card (partial unique, raw SQL). Topic decks = cards tagged to
/// a topic subtree.
model FlashcardTopic {
  flashcardId String   @db.Uuid
  topicId     String   @db.Uuid
  isPrimary   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  topic     Topic     @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([flashcardId, topicId])
  @@index([topicId, sortOrder])
}

// ---------------------------------------------------------------------------------------------------------------------
// Assessment definitions (§12, §13, §46). Attempts live in the learning slice (AssessmentAttempt/QuestionAttempt).
// ---------------------------------------------------------------------------------------------------------------------

/// Definition of a quiz / topic test / chapter test / subject test / mock exam / diagnostic / timed exam.
/// Structure: sections (Paper 1, Section A...) holding fixed items and/or blueprint rules. Attempts reference
/// (assessmentId, revision) and copy the section structure they sat into AssessmentAttemptSection; they must NOT FK
/// sections/items/rules, which are replaced when a new revision is published.
/// Tenancy: platform (schoolId and ownerUserId NULL), school-private teacher test (schoolId) or tutor-private test
/// (ownerUserId); at most one owner, fixed at insert, never PUBLIC (CHECK + trigger). Items may only use platform
/// questions or questions of the same tenant, and assignments only platform tests or the class's own tenant's tests
/// (tenant guard triggers, raw SQL).
/// Version pinning: (syllabusId, subjectId) and (routeId, syllabusId) are composite FKs, so a mock cannot name another
/// subject's syllabus or another version's route; a PUBLISHED assessment cannot reference a DRAFT syllabus (trigger).
/// CHECKs (raw SQL): totalMarks > 0; timeLimitSeconds > 0; MOCK_EXAM requires syllabusId; routeId requires syllabusId;
/// plus the workflow CHECKs.
model Assessment {
  id               String                   @id @default(uuid(7)) @db.Uuid
  kind             AssessmentKind
  assembly         AssessmentAssembly       @default(FIXED)
  subjectId        String                   @db.Uuid
  /// Version the assessment is built for (required for MOCK_EXAM: papers come from its components).
  syllabusId       String?                  @db.Uuid
  /// Route the assessment targets (e.g. an AS-only mock). Null = any route. Requires syllabusId (CHECK).
  routeId          String?                  @db.Uuid
  title            String
  description      String?
  /// Exam instructions shown before starting (§13), markdown.
  instructions     String?
  /// Overall time limit; null = untimed. Sections may add per-paper limits.
  timeLimitSeconds Int?
  /// Total marks (sum of item marks, or of rule questionCount x marks for blueprints). Service-maintained.
  totalMarks       Int
  /// Grade-estimate scheme override.
  gradeSchemeId    String?                  @db.Uuid
  feedbackTiming   AssessmentFeedbackTiming @default(AFTER_SUBMIT)
  shuffleQuestions Boolean                  @default(false)
  shuffleOptions   Boolean                  @default(false)
  /// Free navigation/flag/review between questions (§13). False for adaptive diagnostics.
  allowNavigation  Boolean                  @default(true)
  /// Null = unlimited attempts.
  maxAttempts      Int?
  /// PUBLIC/FREE = free topic tests / free diagnostic (§46); PREMIUM = entitlement "mock_exams" etc.
  accessTier       ContentAccessTier        @default(PREMIUM)
  /// Owning school for teacher-created tests (§22).
  schoolId         String?                  @db.Uuid
  /// Owning independent tutor for tests set to school-less classes (§22). Never set together with schoolId.
  ownerUserId      String?                  @db.Uuid
  /// Stable key for idempotent re-imports by the content pipeline (docs/CONTENT_PIPELINE.md): one row per (assessment
  /// key, syllabus version). Only live rows carry it (draft copies: null, CHECK), like Lesson/Question/Flashcard.
  externalRef      String?                  @unique
  // --- workflow ---
  status           ContentStatus            @default(DRAFT)
  revision         Int                      @default(1)
  draftOfId        String?                  @unique @db.Uuid
  createdById      String?                  @db.Uuid
  reviewedById     String?                  @db.Uuid
  reviewedAt       DateTime?                @db.Timestamptz(3)
  reviewNotes      String?
  approvedById     String?                  @db.Uuid
  approvedAt       DateTime?                @db.Timestamptz(3)
  publishedAt      DateTime?                @db.Timestamptz(3)
  archivedAt       DateTime?                @db.Timestamptz(3)
  aiGenerated      Boolean                  @default(false)
  generationJobId  String?                  @db.Uuid
  // --- provenance (§27) ---
  sourceId         String?                  @db.Uuid
  author           String?
  copyrightStatus  CopyrightStatus          @default(UNVERIFIED)
  licenceCode      String?                  @db.VarChar(64)
  attribution      String?
  sourceUrl        String?
  publicationDate  DateTime?                @db.Date
  isDemo           Boolean                  @default(false)
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @db.Timestamptz(3)

  subject                Subject                 @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  /// Composite FK (syllabusId, subjectId): the version belongs to the assessment's subject.
  syllabus               Syllabus?               @relation(fields: [syllabusId, subjectId], references: [id, subjectId], onDelete: Restrict)
  /// Composite FK (routeId, syllabusId): the route belongs to that version. Restrict (SetNull would null syllabusId).
  route                  SyllabusRoute?          @relation(fields: [routeId, syllabusId], references: [id, syllabusId], onDelete: Restrict)
  gradeScheme            GradeScheme?            @relation(fields: [gradeSchemeId], references: [id], onDelete: SetNull)
  school                 School?                 @relation("AssessmentSchool", fields: [schoolId], references: [id], onDelete: Restrict)
  ownerUser              User?                   @relation("AssessmentOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  draftOf                Assessment?             @relation("AssessmentDraft", fields: [draftOfId], references: [id], onDelete: Cascade)
  pendingDraft           Assessment?             @relation("AssessmentDraft")
  createdBy              User?                   @relation("AssessmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy             User?                   @relation("AssessmentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedBy             User?                   @relation("AssessmentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  generationJob          AiGenerationJob?        @relation("AssessmentGenerationJob", fields: [generationJobId], references: [id], onDelete: SetNull)
  source                 ContentSource?          @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  topics                 AssessmentTopic[]
  sections               AssessmentSection[]
  studyPlanTemplateItems StudyPlanTemplateItem[]
  // Back-relations (LEARNING & ENGAGEMENT slice)
  attempts               AssessmentAttempt[]
  studyPlanItems         StudyPlanItem[]
  assignments            Assignment[]

  /// "Mock exams / topic tests for this subject" listings.
  @@index([subjectId, kind, status])
  /// Covers the (syllabusId, subjectId) composite FK.
  @@index([syllabusId, subjectId])
  /// Covers the (routeId, syllabusId) composite FK by its leading column.
  @@index([routeId])
  @@index([gradeSchemeId])
  @@index([schoolId, status])
  /// A tutor's own tests; covers the FK.
  @@index([ownerUserId, status])
  @@index([status, updatedAt])
  @@index([createdById, createdAt])
  @@index([reviewedById])
  @@index([approvedById])
  @@index([generationJobId])
  @@index([sourceId])
}

/// Scope of an assessment: the topic nodes it covers (topic tests for a topic page, diagnostic coverage, weak-area
/// analysis). A SUBJECT_TEST/MOCK_EXAM with no rows covers its whole syllabus. Carried over on syllabus version clones.
model AssessmentTopic {
  assessmentId String @db.Uuid
  topicId      String @db.Uuid

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  topic      Topic      @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([assessmentId, topicId])
  @@index([topicId])
}

/// A section of an assessment ("Paper 1", "Section B: answer any two"). Mirrors a SyllabusComponent for mock exams.
/// At attempt start each section is copied into AssessmentAttemptSection (number = 1-based position by sortOrder,
/// title, time limit, answerCount, maxMarks), which is what timing and scoring use from then on.
model AssessmentSection {
  id               String   @id @default(uuid(7)) @db.Uuid
  assessmentId     String   @db.Uuid
  /// The paper this section simulates (mock exams).
  componentId      String?  @db.Uuid
  title            String
  instructions     String?
  sortOrder        Int      @default(0)
  /// Per-section (per-paper) time limit for multi-paper mocks, enforced per attempt section with its own server
  /// deadline; null = shares the assessment limit.
  timeLimitSeconds Int?
  /// "Answer any N questions" sections (common in essay papers); null = answer all. Only the N best-marked answers
  /// count (QuestionAttempt.isCounted) and the section contributes `marks` to the attempt total.
  answerCount      Int?
  /// Section total marks (service-maintained). Required when answerCount is set: N x per-question marks (CHECK).
  marks            Int?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  assessment Assessment                @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  component  SyllabusComponent?        @relation(fields: [componentId], references: [id], onDelete: SetNull)
  items      AssessmentItem[]
  rules      AssessmentBlueprintRule[]

  @@index([assessmentId, sortOrder])
  @@index([componentId])
}

/// A fixed question in a section, in order. Must reference a root question (parentId null; service-enforced).
/// Always serves the question's current published revision; the attempt records which revision was seen.
/// The question is platform content or belongs to the assessment's own tenant (tenant guard trigger, raw SQL).
model AssessmentItem {
  id         String   @id @default(uuid(7)) @db.Uuid
  sectionId  String   @db.Uuid
  questionId String   @db.Uuid
  sortOrder  Int      @default(0)
  /// Display number override, e.g. "12" or "B3".
  label      String?  @db.VarChar(16)
  /// Marks override (teacher weighting); null = question.marks.
  marks      Int?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  section  AssessmentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question Question          @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([sectionId, questionId])
  /// Impact analysis: which assessments use a flagged question.
  @@index([questionId])
}

/// A rule for assembling questions from the bank (BLUEPRINT/ADAPTIVE assessments): from topic subtree X (or the whole
/// section/assessment scope when null), pick questionCount PUBLISHED root questions with difficulty in
/// [difficultyMin, difficultyMax], optionally of a type/skill. CHECKs (raw SQL): 1 <= min <= max <= 5; count > 0.
model AssessmentBlueprintRule {
  id               String          @id @default(uuid(7)) @db.Uuid
  sectionId        String          @db.Uuid
  topicId          String?         @db.Uuid
  objectiveId      String?         @db.Uuid
  /// Include descendants of topicId (default) or only questions tagged exactly to it.
  includeSubtopics Boolean         @default(true)
  questionType     QuestionType?
  cognitiveSkill   CognitiveSkill?
  difficultyMin    Int             @default(1)
  difficultyMax    Int             @default(5)
  questionCount    Int
  /// Target marks per question (null = any); selected questions' marks are used as-is.
  marksPerQuestion Int?
  /// Only exam-style questions (mock exams).
  examStyleOnly    Boolean         @default(false)
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)

  section   AssessmentSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  topic     Topic?             @relation(fields: [topicId], references: [id], onDelete: Restrict)
  objective LearningObjective? @relation(fields: [objectiveId], references: [id], onDelete: Restrict)

  @@index([sectionId, sortOrder])
  @@index([topicId])
  @@index([objectiveId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Study packs (§24)
// ---------------------------------------------------------------------------------------------------------------------

/// A premium study pack, e.g. "O-Level ZIMSEC Mathematics Complete Study Pack". Dynamic: it grants access to
/// platform content matched by its StudyPackScope rules (always current), not a static file. Price lives in platform
/// billing (PlanPrice/Payment/EntitlementGrant reference studyPackId); this row defines WHAT is unlocked.
/// slug unique among live rows (partial unique WHERE draftOfId IS NULL, raw SQL).
model StudyPack {
  id              String        @id @default(uuid(7)) @db.Uuid
  slug            String
  title           String
  subtitle        String?
  /// Marketing description (markdown), CMS-managed (rule 5: no hard-coded marketing claims).
  description     String?
  coverImageId    String?       @db.Uuid
  /// What the pack unlocks, validated by the SAME Zod schema and key registry as Plan.entitlements
  /// (src/lib/billing/entitlements.ts, ARCHITECTURE §7.6), so a pack can raise limits as well as switch features on
  /// (e.g. AI tutor access with its own daily message limit). Shape: { version: 1, features: { [featureKey]: boolean },
  /// limits: { [limitKey]: number | null } }. Purchase fulfilment copies it into EntitlementGrant.features with
  /// scope.subjectIds / qualificationIds derived from the pack's StudyPackScope rows.
  entitlements    Json
  /// PDF export offered (§24 "where licensing permits"). Service also requires every exported item's source to
  /// permit PDF export.
  allowPdfExport  Boolean       @default(false)
  isFeatured      Boolean       @default(false)
  sortOrder       Int           @default(0)
  metaTitle       String?
  metaDescription String?
  // --- workflow ---
  status          ContentStatus @default(DRAFT)
  revision        Int           @default(1)
  draftOfId       String?       @unique @db.Uuid
  createdById     String?       @db.Uuid
  reviewedById    String?       @db.Uuid
  reviewedAt      DateTime?     @db.Timestamptz(3)
  reviewNotes     String?
  approvedById    String?       @db.Uuid
  approvedAt      DateTime?     @db.Timestamptz(3)
  publishedAt     DateTime?     @db.Timestamptz(3)
  archivedAt      DateTime?     @db.Timestamptz(3)
  aiGenerated     Boolean       @default(false)
  generationJobId String?       @db.Uuid
  isDemo          Boolean       @default(false)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  coverImage        MediaAsset?        @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  draftOf           StudyPack?         @relation("StudyPackDraft", fields: [draftOfId], references: [id], onDelete: Cascade)
  pendingDraft      StudyPack?         @relation("StudyPackDraft")
  createdBy         User?              @relation("StudyPackCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy        User?              @relation("StudyPackReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedBy        User?              @relation("StudyPackApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  generationJob     AiGenerationJob?   @relation("StudyPackGenerationJob", fields: [generationJobId], references: [id], onDelete: SetNull)
  scopes            StudyPackScope[]
  // Back-relations (PLATFORM slice)
  planPrices        PlanPrice[]
  payments          Payment[]
  entitlementGrants EntitlementGrant[]

  @@index([status, sortOrder])
  @@index([coverImageId])
  @@index([createdById, createdAt])
  @@index([reviewedById])
  @@index([approvedById])
  @@index([generationJobId])
}

/// Inclusion rule of a study pack: exactly one of qualificationId (every subject of that qualification), subjectId
/// (that subject, whichever syllabus version the student is pinned to) or syllabusId (that version only).
/// CHECK num_nonnulls(...) = 1 (raw SQL).
model StudyPackScope {
  id              String   @id @default(uuid(7)) @db.Uuid
  studyPackId     String   @db.Uuid
  qualificationId String?  @db.Uuid
  subjectId       String?  @db.Uuid
  syllabusId      String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  studyPack     StudyPack      @relation(fields: [studyPackId], references: [id], onDelete: Cascade)
  qualification Qualification? @relation(fields: [qualificationId], references: [id], onDelete: Restrict)
  subject       Subject?       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  syllabus      Syllabus?      @relation(fields: [syllabusId], references: [id], onDelete: Restrict)

  @@index([studyPackId])
  /// "Which packs cover this qualification/subject/version?" (pack upsell on subject pages, entitlement resolution).
  @@index([qualificationId])
  @@index([subjectId])
  @@index([syllabusId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Study plan templates (§25 CMS "study plans", §41 AI drafts "study plans")
// ---------------------------------------------------------------------------------------------------------------------

/// An editorially authored (or AI-drafted, §41) study-plan template for one syllabus version, e.g. "12-week ZIMSEC
/// O-Level Mathematics revision". Content with the common workflow (DRAFT -> ... -> PUBLISHED, revisions, snapshots).
/// The pure planner (§16) can start a student's StudyPlan from a PUBLISHED template (StudyPlan.templateId), mapping
/// week/day slots onto the student's dates and then adapting as usual; personal plans never edit the template.
/// Invariants: (syllabusId, subjectId) and (routeId, syllabusId) are composite FKs; item topics belong to syllabusId
/// (service); a PUBLISHED template cannot reference a DRAFT syllabus (trigger); workflow CHECKs/triggers as above.
model StudyPlanTemplate {
  id              String            @id @default(uuid(7)) @db.Uuid
  subjectId       String            @db.Uuid
  /// The syllabus version the template's topics belong to (topics are version-specific).
  syllabusId      String            @db.Uuid
  /// Route the template targets (e.g. AS only). Null = any route.
  routeId         String?           @db.Uuid
  title           String            @db.VarChar(200)
  slug            String            @db.VarChar(120)
  /// Markdown description for the CMS and the plan picker.
  description     String?
  /// Planned length; week numbers of items run 1..durationWeeks (CHECK).
  durationWeeks   Int               @db.SmallInt
  /// Suggested study minutes per week (planner scales item targets to the student's availability).
  weeklyMinutes   Int?              @db.SmallInt
  accessTier      ContentAccessTier @default(PREMIUM)
  // --- workflow ---
  status          ContentStatus     @default(DRAFT)
  revision        Int               @default(1)
  draftOfId       String?           @unique @db.Uuid
  createdById     String?           @db.Uuid
  reviewedById    String?           @db.Uuid
  reviewedAt      DateTime?         @db.Timestamptz(3)
  reviewNotes     String?
  approvedById    String?           @db.Uuid
  approvedAt      DateTime?         @db.Timestamptz(3)
  publishedAt     DateTime?         @db.Timestamptz(3)
  archivedAt      DateTime?         @db.Timestamptz(3)
  aiGenerated     Boolean           @default(false)
  generationJobId String?           @db.Uuid
  isDemo          Boolean           @default(false)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  subject       Subject                 @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  syllabus      Syllabus                @relation(fields: [syllabusId, subjectId], references: [id, subjectId], onDelete: Restrict)
  route         SyllabusRoute?          @relation(fields: [routeId, syllabusId], references: [id, syllabusId], onDelete: Restrict)
  draftOf       StudyPlanTemplate?      @relation("StudyPlanTemplateDraft", fields: [draftOfId], references: [id], onDelete: Cascade)
  pendingDraft  StudyPlanTemplate?      @relation("StudyPlanTemplateDraft")
  createdBy     User?                   @relation("StudyPlanTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy    User?                   @relation("StudyPlanTemplateReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedBy    User?                   @relation("StudyPlanTemplateApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  generationJob AiGenerationJob?        @relation("StudyPlanTemplateGenerationJob", fields: [generationJobId], references: [id], onDelete: SetNull)
  items         StudyPlanTemplateItem[]
  // Back-relations (LEARNING & ENGAGEMENT slice)
  /// Student plans started from this template.
  studyPlans    StudyPlan[]

  /// Plan picker / CMS list per subject; covers the subjectId FK.
  @@index([subjectId, status])
  /// Covers the (syllabusId, subjectId) composite FK.
  @@index([syllabusId, subjectId])
  /// Covers the (routeId, syllabusId) composite FK by its leading column.
  @@index([routeId])
  @@index([status, updatedAt])
  @@index([createdById, createdAt])
  @@index([reviewedById])
  @@index([approvedById])
  @@index([generationJobId])
}

/// One slot of a study-plan template: week N (and optionally a weekday), an activity and its target. Mirrors
/// StudyPlanItem without dates. Rows under a PUBLISHED template change only inside the publish transaction.
/// Invariants (CHECKs): 1 <= weekNumber (<= template.durationWeeks, service); dayOfWeek 1..7 (ISO, Monday = 1) or NULL
/// = any day that week; activityType is not DAILY_QUESTION / AI_TUTOR; a LESSON slot names a lesson or topic; targets
/// positive.
model StudyPlanTemplateItem {
  id              String            @id @default(uuid(7)) @db.Uuid
  templateId      String            @db.Uuid
  weekNumber      Int               @db.SmallInt
  dayOfWeek       Int?              @db.SmallInt
  /// Order within the week.
  sortOrder       Int               @db.SmallInt
  activityType    StudyActivityType
  /// Topic of the template's syllabus version (service-checked).
  topicId         String?           @db.Uuid
  lessonId        String?           @db.Uuid
  assessmentId    String?           @db.Uuid
  targetMinutes   Int               @db.SmallInt
  targetQuestions Int?              @db.SmallInt
  /// Short editor note shown as the item's "why this?" text.
  note            String?           @db.VarChar(500)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  template   StudyPlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  topic      Topic?            @relation(fields: [topicId], references: [id], onDelete: Restrict)
  lesson     Lesson?           @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  assessment Assessment?       @relation(fields: [assessmentId], references: [id], onDelete: Restrict)

  /// Template slots in order; covers the templateId FK.
  @@unique([templateId, weekNumber, sortOrder])
  /// Covers the FKs.
  @@index([topicId])
  @@index([lessonId])
  @@index([assessmentId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Revisions, quality control, search
// ---------------------------------------------------------------------------------------------------------------------

/// Immutable snapshot of a content item at a published revision (§26, §42). Written in the same transaction that
/// publishes revision N of a Lesson/Question/Flashcard/Assessment/StudyPack/StudyPlanTemplate; a deferred constraint
/// trigger on each of those tables guarantees that every live PUBLISHED row has the snapshot of its current revision.
/// Attempts store (entityId, revision) and re-render history from here. Append-only (trigger, raw SQL): the only
/// permitted UPDATE is the FK-driven SET NULL of authorId/approvedById after that user row is really gone.
/// Polymorphic: no FK on entityId by design.
model ContentRevision {
  id            String            @id @default(uuid(7)) @db.Uuid
  entityType    ContentEntityType
  entityId      String            @db.Uuid
  revision      Int
  /// Version of the snapshot format (Zod schema version) for forward-compatible parsing.
  schemaVersion Int               @default(1)
  /// Full aggregate as published. Shape per entityType, e.g. QUESTION: { question: {...row columns},
  /// parts: [{...row, options: [...]}], options: [...], topics: [{ topicId, syllabusId, isPrimary }],
  /// objectives: [uuid] }; LESSON: { lesson: {...}, topics: [...], objectives: [...], questions: [...] };
  /// ASSESSMENT: { assessment: {...}, sections: [{ ..., items: [...], rules: [...] }], topics: [...] };
  /// STUDY_PACK: { studyPack: {...}, scopes: [...] }; STUDY_PLAN_TEMPLATE: { template: {...}, items: [...] };
  /// FLASHCARD: { flashcard: {...}, topics: [...] }.
  snapshot      Json
  /// Hex SHA-256 of the canonical snapshot JSON.
  contentHash   String            @db.Char(64)
  /// Editor who authored the changes in this revision.
  authorId      String?           @db.Uuid
  /// Human who approved it (null only for personal/school content outside the platform workflow).
  approvedById  String?           @db.Uuid
  changeNote    String?
  aiGenerated   Boolean           @default(false)
  /// Publication time of this revision.
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)

  author     User? @relation("ContentRevisionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  approvedBy User? @relation("ContentRevisionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([entityType, entityId, revision])
  @@index([authorId])
  @@index([approvedById])
}

/// A quality-control flag on a content item (§42): incorrect answer, ambiguous, incorrect marking, wrong topic, wrong
/// difficulty... Raised by editors (and students/teachers via "Report a problem", or the system). Polymorphic target.
/// One open flag per (target, reporter, reason), and one open SYSTEM flag per (target, reason) so the hourly
/// QuestionStats job can insert with ON CONFLICT DO NOTHING (partial uniques, raw SQL). Resolution may publish a fixed
/// revision.
model ContentFlag {
  id                 String            @id @default(uuid(7)) @db.Uuid
  entityType         ContentEntityType
  entityId           String            @db.Uuid
  /// Revision the reporter saw.
  revision           Int?
  reason             ContentFlagReason
  source             ContentFlagSource
  details            String?
  /// Where it was reported from. Shape: { assessmentAttemptId?: uuid, position?: number /* QuestionAttempt slot */,
  /// channel?: "web"|"whatsapp"|"api", partId?: uuid }. No answer text/PII.
  context            Json?
  status             ContentFlagStatus @default(OPEN)
  flaggedById        String?           @db.Uuid
  assignedToId       String?           @db.Uuid
  resolvedById       String?           @db.Uuid
  resolvedAt         DateTime?         @db.Timestamptz(3)
  resolution         String?
  /// Revision that fixed the issue, if any.
  resolutionRevision Int?
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)

  flaggedBy  User? @relation("ContentFlagFlaggedBy", fields: [flaggedById], references: [id], onDelete: SetNull)
  assignedTo User? @relation("ContentFlagAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("ContentFlagResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  /// Flags on one item (editor sidebar, "has open flags" badge).
  @@index([entityType, entityId, status])
  /// Triage queue, oldest first.
  @@index([status, createdAt])
  @@index([flaggedById, createdAt])
  @@index([assignedToId, status])
  @@index([resolvedById])
}

/// Denormalised search index row (§28): one per searchable entity (lessons, questions, flashcards, assessments,
/// study packs, subjects, topics). Only PUBLISHED PLATFORM content is indexed (ARCHITECTURE §3.9; status CHECK): the
/// `search.index` job upserts on publish/update and deletes on archive; the CMS searches drafts, and teachers search
/// their school/tutor content, with their own scoped queries. School- and tutor-private items, draft copies and
/// personal flashcards are never indexed, so no search query can leak them. Catalogue rows (subjects, topics) are
/// written with status PUBLISHED when their catalogue/syllabus is live. Curriculum context is stored as uuid ARRAYS
/// because reused content belongs to several boards/subjects/versions at once; no FKs (arrays cannot be FK'd) - the
/// indexer is the source of truth and rebuilds on curriculum changes. Board, qualification and level filters are
/// rechecked on the rows found through searchVector / subjectIds / topicIds (their arrays are too unselective to be
/// worth a GIN index). searchVector is a GENERATED tsvector column created by raw SQL; Prisma never writes it.
model SearchDocument {
  id               String                   @id @default(uuid(7)) @db.Uuid
  entityType       ContentEntityType
  entityId         String                   @db.Uuid
  title            String
  /// Breadcrumb, e.g. "ZIMSEC O-Level · Mathematics · Algebra".
  subtitle         String?
  /// Plain-text excerpt (markdown/LaTeX stripped), truncated to ~10k chars. Premium bodies are indexed but snippets
  /// are only shown to entitled users.
  body             String                   @default("")
  /// Denormalised names and synonyms: board, qualification, level, subject, topic names, codes ("0580").
  keywords         String                   @default("")
  /// Canonical URL path of the result.
  path             String
  /// BCP-47 language of the item; picks the text-search config (ARCHITECTURE §3.9, §3.12).
  languageCode     String                   @default("en") @db.VarChar(10)
  accessTier       ContentAccessTier
  /// Always PUBLISHED (CHECK): a guard against an indexer bug writing drafts.
  status           ContentStatus
  examBoardIds     String[]                 @default([]) @db.Uuid
  qualificationIds String[]                 @default([]) @db.Uuid
  levelIds         String[]                 @default([]) @db.Uuid
  subjectIds       String[]                 @default([]) @db.Uuid
  syllabusIds      String[]                 @default([]) @db.Uuid
  topicIds         String[]                 @default([]) @db.Uuid
  /// Editorial/popularity boost added to ts_rank.
  rankBoost        Int                      @default(0)
  /// STORED GENERATED column (raw SQL R1 turns this DEFAULT into GENERATED ALWAYS AS ... STORED in the migration):
  /// title A, keywords+subtitle B, body C, using search_ts_config(languageCode) (english for "en", simple otherwise,
  /// raw SQL R0) plus simple-config title/keywords for exact codes. The string is the expression exactly as Postgres 18
  /// deparses it, so `prisma migrate diff` sees no drift; edit both together. Never read/written by Prisma Client.
  searchVector     Unsupported("tsvector")? @default(dbgenerated("((((setweight(to_tsvector(search_ts_config((\"languageCode\")::text), COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\")) || setweight(to_tsvector(search_ts_config((\"languageCode\")::text), ((COALESCE(keywords, ''::text) || ' '::text) || COALESCE(subtitle, ''::text))), 'B'::\"char\")) || setweight(to_tsvector('simple'::regconfig, COALESCE(keywords, ''::text)), 'B'::\"char\")) || setweight(to_tsvector(search_ts_config((\"languageCode\")::text), COALESCE(body, ''::text)), 'C'::\"char\"))"))
  /// Source row's updatedAt when indexed (staleness detection).
  sourceUpdatedAt  DateTime                 @db.Timestamptz(3)
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @db.Timestamptz(3)

  @@unique([entityType, entityId])
  /// Full-text match.
  @@index([searchVector], type: Gin)
  /// Typo-tolerant title match (pg_trgm similarity / ILIKE); requires CREATE EXTENSION pg_trgm (raw SQL).
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  /// Selective curriculum filters ("search within my subject / this topic / this version").
  @@index([subjectIds], type: Gin)
  @@index([topicIds], type: Gin)
  @@index([syllabusIds], type: Gin)
}

// ---------------------------------------------------------------------------------------------------------------------
// Acquisition & marketing CMS data (§45, §46)
// ---------------------------------------------------------------------------------------------------------------------

/// The daily question (§46, §30 "Give me today's study question") for a calendar day and scope: a qualification
/// (mixed subjects, subjectId null) or one subject. Unique per (date, qualificationId, subjectId) with NULLS NOT
/// DISTINCT (raw SQL). The question must be a PUBLISHED, auto-markable root question (service-enforced) from the
/// platform bank (tenant guard trigger: never a school/tutor question). Student answers are AssessmentAttempt rows in
/// the learning slice.
model DailyQuestion {
  id              String   @id @default(uuid(7)) @db.Uuid
  /// Calendar day in the country's timezone.
  date            DateTime @db.Date
  qualificationId String   @db.Uuid
  subjectId       String?  @db.Uuid
  questionId      String   @db.Uuid
  /// Chosen by the scheduler (vs hand-picked by an editor).
  isAutoSelected  Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  qualification Qualification       @relation(fields: [qualificationId], references: [id], onDelete: Restrict)
  subject       Subject?            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  question      Question            @relation(fields: [questionId], references: [id], onDelete: Restrict)
  // Back-relations (LEARNING & ENGAGEMENT slice)
  attempts      AssessmentAttempt[]

  @@unique([date, qualificationId, subjectId])
  @@index([qualificationId, date])
  @@index([subjectId, date])
  @@index([questionId])
}

/// A real testimonial for the marketing site (§45), CMS-managed. A row cannot exist without recorded consent;
/// minors additionally need guardian consent before publishing (CHECK, raw SQL). Demo rows can never be published
/// (CHECK; rule 6: no fake testimonials). On consent withdrawal or account deletion the row is unpublished and its
/// quote, display name and photo are erased (the quote CHECK allows a blank quote only once consentWithdrawnAt is set).
model Testimonial {
  id                        String    @id @default(uuid(7)) @db.Uuid
  /// Name exactly as consented for display, e.g. "Tariro M.".
  displayName               String
  /// e.g. "Form 4 student, Bulawayo" or "Parent". No school name unless consented.
  descriptor                String?
  quote                     String
  photoMediaId              String?   @db.Uuid
  /// Platform account of the person, if any.
  userId                    String?   @db.Uuid
  consentRecordedAt         DateTime  @db.Timestamptz(3)
  /// How consent was captured, e.g. "in_app_checkbox", "signed_form", "email".
  consentMethod             String    @db.VarChar(64)
  /// Reference to the stored consent evidence (document id / message id).
  consentEvidenceRef        String?
  consentRecordedById       String?   @db.Uuid
  authorIsMinor             Boolean   @default(false)
  guardianConsentRecordedAt DateTime? @db.Timestamptz(3)
  /// Consent withdrawn (or author account deleted): must be unpublished and the text erased (CHECKs, service).
  consentWithdrawnAt        DateTime? @db.Timestamptz(3)
  isPublished               Boolean   @default(false)
  publishedAt               DateTime? @db.Timestamptz(3)
  sortOrder                 Int       @default(0)
  isDemo                    Boolean   @default(false)
  createdAt                 DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime  @updatedAt @db.Timestamptz(3)

  photo             MediaAsset? @relation(fields: [photoMediaId], references: [id], onDelete: SetNull)
  user              User?       @relation("TestimonialUser", fields: [userId], references: [id], onDelete: SetNull)
  consentRecordedBy User?       @relation("TestimonialConsentRecordedBy", fields: [consentRecordedById], references: [id], onDelete: SetNull)

  @@index([isPublished, sortOrder])
  @@index([photoMediaId])
  @@index([userId])
  @@index([consentRecordedById])
}

/// An FAQ entry for /faq and contextual FAQ blocks (/pricing, /schools), CMS-managed (§45).
model FaqItem {
  id          String    @id @default(uuid(7)) @db.Uuid
  question    String
  /// Markdown.
  answer      String
  /// Group key, e.g. "general", "pricing", "schools", "exams". Admin-defined.
  category    String    @db.VarChar(64)
  /// BCP-47 locale of this entry (translations are separate rows).
  locale      String    @default("en") @db.VarChar(16)
  sortOrder   Int       @default(0)
  isPublished Boolean   @default(false)
  publishedAt DateTime? @db.Timestamptz(3)
  /// Dev-seed placeholder (§50); excluded from the public site in production.
  isDemo      Boolean   @default(false)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([isPublished, locale, category, sortOrder])
}

// #####################################################################################################################
// ===== LEARNING & ENGAGEMENT =====
// #####################################################################################################################

// =====================================================================================================================
// LEARNING & ENGAGEMENT slice
// ---------------------------------------------------------------------------------------------------------------------
// Owns: SubjectEnrollment, EnrollmentTopicChoice (helper), AssessmentAttempt, AssessmentAttemptSection (helper),
//       QuestionAttempt, QuestionAttemptMarking (helper), QuestionAttemptAttachment (helper), TopicMastery,
//       SubjectProgress, QuestionStats, LessonProgress, FlashcardState, FlashcardReview, StudyPlan, StudyPlanItem,
//       StudySession, DailyActivity, LearnerStats, XpEvent, Achievement, UserAchievement, LeaderboardEntry,
//       Assignment, AssignmentProgress, ShareableResult.
// References (other slices, by contract name): User, Subject, Syllabus, ExamSession, Topic, Lesson, Question,
//       Flashcard, Assessment, DailyQuestion, Class. Back-relations on those models are added by the integrator
//       (see crossSliceRelations in the notes). Design notes: .scratch/design/slice-learning-notes.md
//
// Slice-local rules (on top of the shared conventions):
//  * Entity / event rows use `id String @id @default(uuid(7))`. Per-key STATE and ROLLUP rows that nothing references
//    by id (TopicMastery, SubjectProgress, LessonProgress, FlashcardState, DailyActivity, UserAchievement,
//    AssignmentProgress, QuestionStats, LearnerStats) use their natural key as the primary key: one index instead of
//    two, and upserts target the PK directly.
//  * Denormalised owner keys are pinned by COMPOSITE foreign keys so they can never drift:
//    QuestionAttempt(attemptId, userId, subjectId) -> AssessmentAttempt(id, userId, subjectId);
//    QuestionAttempt(attemptId, sectionNumber) -> AssessmentAttemptSection(attemptId, sectionNumber);
//    StudyPlanItem(planId, userId) -> StudyPlan(id, userId);
//    TopicMastery / SubjectProgress / FlashcardState (userId, subjectId) -> SubjectEnrollment(userId, subjectId);
//    TopicMastery(topicId, syllabusId, topicKind) -> Topic(id, syllabusId, kind) and
//    TopicMastery(syllabusId, subjectId) -> Syllabus(id, subjectId);
//    EnrollmentTopicChoice(enrollmentId, syllabusId) -> SubjectEnrollment(id, syllabusId) and
//    EnrollmentTopicChoice(topicId, syllabusId) -> Topic(id, syllabusId);
//    FlashcardReview(userId, flashcardId) -> FlashcardState(userId, flashcardId).
//  * Version scoping: every per-topic read for dashboards, parents, teachers, the planner and SubjectProgress filters
//    syllabusId = SubjectEnrollment.syllabusId (the pinned version). Rows of an older version stay as history.
//  * onDelete: Cascade for owned children and for User -> learning rows (users are anonymised, never hard-deleted;
//    a hard delete is only a deliberate erasure, which must take the history with it). Restrict for every reference
//    to curriculum/content, optional or not (content is archived, never deleted). SetNull for optional references to
//    non-content rows (assignments, plan items, attempts, markers).
//  * Columns on the hot tables are declared in alignment-friendly order (uuid, timestamptz, int4/enum, int2, bool,
//    jsonb): Prisma emits columns in declaration order, so this avoids padding on ~600k rows/day.
//  * Indexed columns on per-answer-updated rows are chosen so the per-answer UPDATE does not touch any indexed column
//    (HOT updates): e.g. TopicMastery indexes `band` (changes rarely) but never `score` (changes every answer).
//    No index or index predicate on AssessmentAttempt may reference lastSavedAt, timeSpentSeconds, questionCount,
//    lastPosition or updatedAt (written on every answer save; measured: such an index makes 0 of 1,000 saves HOT).
// =====================================================================================================================

// ---------------------------------------------------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------------------------------------------------

/// Topic mastery band (§11). Derived from TopicMastery.score; stored so weak-topic queries can use an index.
/// The band/score consistency is enforced by a CHECK constraint (raw SQL, see notes).
enum MasteryBand {
  /// score < 40
  WEAK
  /// 40 <= score < 60
  DEVELOPING
  /// 60 <= score < 75
  COMPETENT
  /// 75 <= score < 90
  STRONG
  /// score >= 90
  MASTERED
}

/// What kind of activity an AssessmentAttempt is. Drives engine behaviour (feedback timing, timer, which rows are
/// required). Transport is NOT a mode: a WhatsApp question is PRACTICE or DAILY_QUESTION with channel = WHATSAPP.
/// Assignment work is NOT a mode: it is any mode with assignmentId set.
enum AttemptMode {
  /// Ad-hoc practice session built by the student or recommended (§10). No Assessment row. Instant feedback.
  PRACTICE
  /// Scheduled re-test of a topic (§11 "re-test later"), driven by TopicMastery.nextReviewAt. No Assessment row.
  RETEST
  /// Questions embedded in a lesson (§8 "practice questions"). lessonId required.
  LESSON_CHECK
  /// The daily question (§30, §46). dailyQuestionId required; one per (user, daily question).
  DAILY_QUESTION
  /// Assessment-backed: short quiz.
  QUIZ
  /// Assessment-backed: topic test (§12).
  TOPIC_TEST
  /// Assessment-backed: chapter test (§12).
  CHAPTER_TEST
  /// Assessment-backed: whole-subject test (§12).
  SUBJECT_TEST
  /// Timed examination (§12), either an Assessment or a generated timed paper. deadlineAt required.
  TIMED_EXAM
  /// Mock examination (§12, §13). Assessment-backed, deadlineAt required.
  MOCK_EXAM
  /// Diagnostic test (§46, §52). Its analysis seeds TopicMastery and sets SubjectEnrollment.diagnosticCompletedAt.
  DIAGNOSTIC
}

/// Lifecycle of an AssessmentAttempt.
/// IN_PROGRESS -> SUBMITTED -> (AWAITING_MARKING ->) MARKED; IN_PROGRESS -> ABANDONED | EXPIRED.
enum AttemptStatus {
  /// Open. Answers are being saved. The server timer (deadlineAt) is authoritative for timed modes.
  IN_PROGRESS
  /// Closed by the student, the timer or the system; deterministic marking is running (usually same transaction).
  SUBMITTED
  /// Some answers wait for AI or human marking (§9 "manually/AI-assisted marked"); provisional score shown.
  AWAITING_MARKING
  /// All answers have a mark (NEEDS_REVIEW items keep a provisional mark; see pendingReviewCount).
  MARKED
  /// Discarded by the student, or closed idle with zero answers.
  ABANDONED
  /// A timed attempt whose deadline + grace passed with zero answers (nothing to mark).
  EXPIRED
}

/// Why an attempt was closed.
enum AttemptSubmitReason {
  STUDENT
  /// Server deadline reached (exams.autoSubmit job).
  TIME_EXPIRED
  /// Untimed attempt idle beyond the configured window; answered questions are kept and marked.
  IDLE_TIMEOUT
  /// The teacher closed the assignment.
  ASSIGNMENT_CLOSED
  SYSTEM
}

/// Channel through which learning activity happened (§30). Native app / integrations use API.
enum ActivityChannel {
  WEB
  WHATSAPP
  API
}

/// Marking state of one QuestionAttempt.
enum MarkingStatus {
  /// No final mark yet (unanswered while the attempt is open, or queued for AI marking).
  PENDING
  /// Deterministic marking (MCQ, true/false, numeric, matching, fill-in, labelling).
  AUTO_MARKED
  /// AI-marked with confidence >= threshold; labelled "AI-marked" in the UI.
  AI_MARKED
  /// Marked or overridden by a human (class teacher or content reviewer; who is in QuestionAttemptMarking).
  TEACHER_MARKED
  /// Student self-assessed against the mark scheme (AI not configured, ARCHITECTURE §6.5). Weighted lower in mastery.
  SELF_ASSESSED
  /// AI confidence too low / invalid output / refusal: provisional mark, waiting in a human review queue.
  NEEDS_REVIEW
  /// Attempt closed with no answer: 0 marks, excluded from QuestionStats facility.
  UNANSWERED
}

/// Who produced a marking decision recorded in QuestionAttemptMarking.
enum MarkingSource {
  /// System re-mark (e.g. after an answer-key correction, §42).
  AUTO
  AI
  /// Class teacher (assignment work).
  TEACHER
  /// Content-team reviewer (non-assignment NEEDS_REVIEW queue).
  REVIEWER
  SELF
}

/// SubjectEnrollment lifecycle. Rows are never deleted.
enum EnrollmentStatus {
  ACTIVE
  PAUSED
  /// The student sat the exam / finished the course.
  COMPLETED
  /// The student removed the subject; history and rollups are kept.
  DROPPED
}

/// How a SubjectEnrollment was created.
enum EnrollmentSource {
  /// Student onboarding or "add subject" (§5).
  SELF
  /// School admin / roster import (§23).
  SCHOOL
  /// Created because the student joined a class or received class work (§22).
  CLASS
}

/// Self-reported current ability at onboarding (§5).
enum AbilityLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonProgressStatus {
  IN_PROGRESS
  COMPLETED
}

/// Spaced-repetition card state (Anki-style SM-2 variant, §18).
enum FlashcardSrsState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

/// The four review buttons (§18).
enum FlashcardRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum StudyPlanStatus {
  /// Exactly one ACTIVE plan per user (partial unique index, raw SQL).
  ACTIVE
  /// Replaced by a regenerated plan (inputs changed: subjects, exam date, availability).
  SUPERSEDED
  ARCHIVED
}

/// Type of study activity. Used by StudyPlanItem (planned) and StudySession (actual).
/// DAILY_QUESTION and AI_TUTOR are valid for sessions only (CHECK on StudyPlanItem, raw SQL).
enum StudyActivityType {
  LESSON
  PRACTICE
  /// Topic / chapter / subject test or quiz.
  TEST
  MOCK_EXAM
  DIAGNOSTIC
  FLASHCARDS
  /// Weak-topic or mistakes review / re-test (§11).
  REVIEW
  DAILY_QUESTION
  /// Time spent with the AI tutor counts as study time; the conversation itself is never linked here (§21 privacy).
  AI_TUTOR
}

/// Why the planner scheduled a StudyPlanItem (shown to the student as "why this?").
enum StudyPlanItemReason {
  WEAK_TOPIC
  /// Syllabus coverage: topic not yet started.
  NEW_TOPIC
  /// TopicMastery.nextReviewAt is due (§11 re-test later).
  SPACED_REVIEW
  /// Mock / timed practice as the exam date approaches.
  EXAM_PREPARATION
  FLASHCARDS_DUE
  /// Rescheduled from a missed item.
  CATCH_UP
  DIAGNOSTIC
  ASSIGNMENT_DUE
  /// Keep strong topics warm.
  MAINTENANCE
}

enum StudyPlanItemStatus {
  PENDING
  DONE
  PARTIAL
  SKIPPED
  /// Date passed with no activity (nightly job).
  MISSED
}

/// Why XP was awarded. XP is awarded per completed unit of work (attempt, lesson, goal), never per answer, so the
/// ledger stays ~100k rows/day instead of mirroring QuestionAttempt.
enum XpReason {
  PRACTICE_COMPLETED
  ASSESSMENT_COMPLETED
  MOCK_EXAM_COMPLETED
  DIAGNOSTIC_COMPLETED
  DAILY_QUESTION_ANSWERED
  LESSON_COMPLETED
  FLASHCARD_SESSION_COMPLETED
  DAILY_GOAL_MET
  WEEKLY_GOAL_MET
  STREAK_MILESTONE
  TOPIC_MASTERED
  ACHIEVEMENT_UNLOCKED
  ASSIGNMENT_SUBMITTED
  PLAN_ITEM_COMPLETED
  /// Manual correction by staff (may be negative); audit-logged.
  ADJUSTMENT
}

/// Polymorphic source type of an XpEvent (no FK; sourceId is resolved by type).
enum XpSourceType {
  ASSESSMENT_ATTEMPT
  LESSON
  STUDY_SESSION
  DAILY_ACTIVITY
  LEARNER_STATS
  TOPIC
  ACHIEVEMENT
  ASSIGNMENT
  STUDY_PLAN_ITEM
  ADMIN
}

/// Badge categories (§19).
enum AchievementCategory {
  STREAK
  MASTERY
  PRACTICE
  EXAM
  MILESTONE
}

/// Leaderboard metrics (§20).
enum LeaderboardMetric {
  WEEKLY_XP
  WEEKLY_QUESTIONS
  STREAK
  MOCK_AVERAGE
  SUBJECT_MASTERY
}

/// Leaderboard scope. scopeId is NULL for GLOBAL and otherwise a Country / School / Class / Subject id (no FK).
enum LeaderboardScope {
  GLOBAL
  COUNTRY
  SCHOOL
  CLASS
  SUBJECT
}

enum AssignmentType {
  LESSON
  /// A quiz / test / mock (Assessment), including teacher-built tests (§22 "create tests").
  ASSESSMENT
  /// Generated practice from practiceConfig (topic, count, difficulty).
  PRACTICE
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  /// No more submissions; open attempts are closed (submitReason ASSIGNMENT_CLOSED).
  CLOSED
  ARCHIVED
}

/// How much AI tutor help is allowed while working on the assignment (ARCHITECTURE §6.4).
enum AssignmentAiHelp {
  NONE
  HINTS_ONLY
  FULL
}

/// Which attempt's score counts when maxAttempts > 1.
enum AssignmentScorePolicy {
  FIRST
  BEST
  LATEST
}

enum AssignmentProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  /// Submitted / completed on time.
  SUBMITTED
  /// Submitted after dueAt.
  LATE
  /// Closed without a submission.
  MISSED
  /// Excused by the teacher.
  EXCUSED
}

/// What a public share card shows (§46).
enum ShareableResultKind {
  MOCK_SCORE
  TEST_SCORE
  STREAK
  MASTERY
  ACHIEVEMENT
}

// ---------------------------------------------------------------------------------------------------------------------
// Enrolment
// ---------------------------------------------------------------------------------------------------------------------

/// A student's enrolment in one subject: the per-subject onboarding choices (§5) and the pinned syllabus VERSION
/// (§26: a student studying an older syllabus keeps the correct content).
/// Invariants: one row per (userId, subjectId); syllabusId belongs to subjectId and routeId belongs to syllabusId
/// (composite FKs); only a published, non-DRAFT version can be pinned and an ARCHIVED one never newly (trigger,
/// raw SQL); syllabusId (and with it routeId) only changes through the explicit "move to the new syllabus version"
/// flow, which must advance syllabusPinnedAt (trigger), re-make the optional-topic choices (EnrollmentTopicChoice rows
/// of the old version must be deleted first: their composite FK forbids a version mismatch) and is audited; rows are
/// never deleted (status DROPPED). Every per-subject rollup (TopicMastery, SubjectProgress, FlashcardState) hangs off
/// (userId, subjectId) here, so a learning activity in a subject always happens inside an enrolment (services
/// auto-create one with enrolledVia CLASS or SELF when needed).
/// Topics IN SCOPE for this enrolment (progress denominators, "topics remaining" §6, planner §16) = leaf topics of the
/// pinned version, restricted to the route's components (route -> SyllabusRouteComponent -> TopicComponent; no
/// TopicComponent rows = all components), excluding optional topics not chosen in EnrollmentTopicChoice, and
/// excluding topics whose examYearFrom/examYearTo window does not contain the target ExamSession.year.
model SubjectEnrollment {
  id                    String           @id @default(uuid(7)) @db.Uuid
  userId                String           @db.Uuid
  subjectId             String           @db.Uuid
  /// Pinned syllabus version (Syllabus = one row per version, §26).
  syllabusId            String           @db.Uuid
  /// Chosen award route inside the pinned version (§3, §5): Cambridge 9709 "AS" vs "A", IGCSE 0580 "CORE" vs
  /// "EXTENDED". NULL = the syllabus has no routes, or the default route (SyllabusRoute.isDefault) applies. Topics
  /// in scope = route -> SyllabusRouteComponent -> TopicComponent (curriculum slice).
  routeId               String?          @db.Uuid
  /// Target examination session (§5 "Target examination", e.g. November 2027). Drives the countdown (§17).
  targetExamSessionId   String?          @db.Uuid
  /// The diagnostic attempt whose analysis seeded TopicMastery (§52). Set together with diagnosticCompletedAt.
  diagnosticAttemptId   String?          @unique @db.Uuid
  syllabusPinnedAt      DateTime         @default(now()) @db.Timestamptz(3)
  diagnosticCompletedAt DateTime?        @db.Timestamptz(3)
  statusChangedAt       DateTime?        @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)
  status                EnrollmentStatus @default(ACTIVE)
  enrolledVia           EnrollmentSource @default(SELF)
  /// Self-reported ability (§5). NULL when enrolled by a school/class without asking; the adaptive engine then
  /// starts at INTERMEDIATE difficulty.
  abilityLevel          AbilityLevel?
  /// Optional target grade (§5): a grade label valid in the qualification's GradeScheme ("A", "B", "C", "A*", "1"...).
  targetGrade           String?          @db.VarChar(8)
  /// Optional-paper choices within the chosen route, validated (Zod) against the route's SyllabusRouteComponent
  /// choice groups. The tier/route itself is routeId (FK), and chosen optional TOPICS are EnrollmentTopicChoice rows
  /// (FK-checked), neither is stored here.
  /// Shape: { components?: string[] /* SyllabusComponent.code values, e.g. ["P2","P4"] */ }
  syllabusOptions       Json?

  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject           Subject                 @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  syllabus          Syllabus                @relation(fields: [syllabusId, subjectId], references: [id, subjectId], onDelete: Restrict)
  route             SyllabusRoute?          @relation(fields: [routeId, syllabusId], references: [id, syllabusId], onDelete: Restrict)
  targetExamSession ExamSession?            @relation(fields: [targetExamSessionId], references: [id], onDelete: Restrict)
  diagnosticAttempt AssessmentAttempt?      @relation("EnrollmentDiagnostic", fields: [diagnosticAttemptId], references: [id], onDelete: SetNull)
  topicMasteries    TopicMastery[]
  progress          SubjectProgress?
  topicChoices      EnrollmentTopicChoice[]
  flashcardStates   FlashcardState[]

  /// Student's subjects (dashboard), upsert target; covers the userId FK.
  @@unique([userId, subjectId])
  /// Target of EnrollmentTopicChoice's (enrollmentId, syllabusId) FK: choices always belong to the pinned version.
  @@unique([id, syllabusId])
  /// "Most popular subjects" (§35), students per subject (§23); covers the subjectId FK.
  @@index([subjectId, status])
  /// Students pinned to a syllabus version (needed before retiring a version, §26); covers the composite
  /// (syllabusId, subjectId) FK by its leading column.
  @@index([syllabusId])
  /// Covers the composite (routeId, syllabusId) FK by its leading column; students on a route.
  @@index([routeId])
  /// Countdown reminders per exam session; covers the FK.
  @@index([targetExamSessionId])
}

/// An optional topic the student chose within their pinned syllabus version (§3/§43 boards differ: ZIMSEC History depth
/// studies, Literature set texts, "choose one" options marked Topic.isOptional / optionGroup). Drives which optional
/// topics are in scope for progress, "topics remaining" (§6, §7) and the planner (§16).
/// Invariants: the topic belongs to the enrolment's pinned version (composite FKs on (enrollmentId, syllabusId) and
/// (topicId, syllabusId); onUpdate Restrict, so a version move must delete and re-make choices); the topic is optional
/// and per-optionGroup counts match the syllabus rule (service).
model EnrollmentTopicChoice {
  enrollmentId String   @db.Uuid
  topicId      String   @db.Uuid
  /// The enrolment's pinned version (denormalised; pinned by both composite FKs).
  syllabusId   String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  enrollment SubjectEnrollment @relation(fields: [enrollmentId, syllabusId], references: [id, syllabusId], onDelete: Cascade, onUpdate: Restrict)
  topic      Topic             @relation(fields: [topicId, syllabusId], references: [id, syllabusId], onDelete: Restrict, onUpdate: Restrict)

  /// The enrolment's choices; covers the (enrollmentId, syllabusId) FK by its leading column.
  @@id([enrollmentId, topicId])
  /// "How many students chose this option" (content planning); covers the (topicId, syllabusId) FK.
  @@index([topicId, syllabusId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Attempts and marking (write-heavy hot path)
// ---------------------------------------------------------------------------------------------------------------------

/// ONE attempt model for every assessed activity: ad-hoc practice (§10), re-tests (§11), lesson checks (§8), the
/// daily question (§46, also over WhatsApp §30), quizzes, topic/chapter/subject tests, timed exams and mocks
/// (§12, §13), the diagnostic (§52) and assignment work (§22, assignmentId set).
/// Invariants: every attempt belongs to exactly one subject (QuestionAttempt rows copy userId/subjectId through a
/// composite FK); for timed modes deadlineAt is fixed at start and is authoritative (the client timer is display
/// only); a multi-paper mock may instead be timed per paper (every AssessmentAttemptSection has its own limit and
/// deadline; deferred constraint trigger); answers saved after a deadline are accepted only within the grace window
/// and set lateSync; counters and marks are final once status = MARKED (later human overrides adjust them and are
/// logged in QuestionAttemptMarking). assessmentId and assessmentRevision are set together (revision >= 1).
/// Mode-specific required columns are enforced by CHECK constraints (raw SQL).
/// Hot-row rule: nothing indexed changes on an answer save (see the slice header), so autosaves stay HOT.
model AssessmentAttempt {
  id                 String               @id @default(uuid(7)) @db.Uuid
  userId             String               @db.Uuid
  subjectId          String               @db.Uuid
  /// Definition used (quiz/test/mock/diagnostic). NULL for PRACTICE, RETEST, LESSON_CHECK, DAILY_QUESTION and
  /// generated TIMED_EXAM papers.
  assessmentId       String?              @db.Uuid
  /// Optional topic scope (topic tests, single-topic practice, re-tests).
  topicId            String?              @db.Uuid
  /// Lesson for LESSON_CHECK attempts.
  lessonId           String?              @db.Uuid
  /// Set when the attempt is work for a teacher assignment (§22).
  assignmentId       String?              @db.Uuid
  /// Set for DAILY_QUESTION attempts; unique per (dailyQuestionId, userId).
  dailyQuestionId    String?              @db.Uuid
  startedAt          DateTime             @default(now()) @db.Timestamptz(3)
  /// Server-side deadline = startedAt + timeLimitSeconds (§12, §13). NULL for untimed modes.
  deadlineAt         DateTime?            @db.Timestamptz(3)
  /// Last autosave / answer ("save progress", §12); initialised to the start time. Deliberately NOT indexed: it is
  /// written on every answer. The idle-close sweep scans the small open set through AssessmentAttempt_open_idle_idx
  /// (startedAt, partial, raw SQL) and filters lastSavedAt < cutoff (valid because lastSavedAt >= startedAt, CHECK).
  lastSavedAt        DateTime             @default(now()) @db.Timestamptz(3)
  submittedAt        DateTime?            @db.Timestamptz(3)
  markedAt           DateTime?            @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)
  /// Revision of the Assessment definition used, so the paper layout is reproducible after later edits. Set iff
  /// assessmentId is set (CHECK).
  assessmentRevision Int?
  /// Overall time limit snapshot (seconds) for timed modes, after any extra-time accommodation (Student.
  /// examExtraTimePercent, recorded in config.extraTimePercent). NULL for untimed modes and per-paper-timed mocks.
  timeLimitSeconds   Int?
  /// Active time spent (seconds), from client heartbeats; for timed modes <= submittedAt - startedAt.
  timeSpentSeconds   Int                  @default(0)
  /// Total marks available = Σ over sections of (answerCount set ? AssessmentAttemptSection.maxMarks :
  /// Σ marksAvailable of that section's rows) + Σ marksAvailable of unsectioned rows. Practice: of presented questions.
  totalMarks         Int?
  /// Marks awarded = Σ QuestionAttempt.marksAwarded WHERE isCounted (provisional marks of NEEDS_REVIEW items included
  /// until reviewed). An "answer any N" section contributes only its N best answers.
  marksAwarded       Int?
  mode               AttemptMode
  status             AttemptStatus        @default(IN_PROGRESS)
  submitReason       AttemptSubmitReason?
  channel            ActivityChannel      @default(WEB)
  /// 1-based attempt number for this (user, assessment); 1 for non-assessment modes.
  attemptNumber      Int                  @default(1) @db.SmallInt
  /// Number of question slots in the attempt (exam: fixed at start; practice: grows as questions are presented).
  questionCount      Int                  @default(0) @db.SmallInt
  /// Finalised at submit/close (for IN_PROGRESS attempts count QuestionAttempt rows instead).
  answeredCount      Int                  @default(0) @db.SmallInt
  /// Finalised at submit/close.
  correctCount       Int                  @default(0) @db.SmallInt
  /// QuestionAttempts still PENDING (AI queue) or NEEDS_REVIEW; > 0 means the score is provisional. Drives the
  /// teacher and content-team review queues (partial index WHERE pendingReviewCount > 0, raw SQL), so no index on
  /// QuestionAttempt needs to reference markingStatus.
  pendingReviewCount Int                  @default(0) @db.SmallInt
  /// Last question position viewed (exam navigation resume, §13).
  lastPosition       Int?                 @db.SmallInt
  /// Score percentage 0-100 (exams: of totalMarks with unanswered = 0; practice: of answered questions' marks).
  percentage         Float?
  /// Estimated grade (§12 "grade estimate") from gradeSchemeId, whose bands are frozen once used, so the label is
  /// always reproducible from (gradeSchemeId, percentage).
  gradeEstimate      String?              @db.VarChar(8)
  /// Grade scheme used for gradeEstimate, written at marking (resolution order on GradeScheme).
  gradeSchemeId      String?              @db.Uuid
  /// gradeEstimate is a pass under that scheme (GradeBand.isPass), written at marking: §23 pass-rate analytics read
  /// this column instead of re-deriving pass/fail from current bands or parsing JSON.
  gradeIsPass        Boolean?
  /// True when at least one answer was synced after deadlineAt within the grace window (ARCHITECTURE §3.13).
  lateSync           Boolean              @default(false)
  /// Client Idempotency-Key for the "start attempt" request (offline replay / double tap); unique per user.
  idempotencyKey     String?              @db.VarChar(64)
  /// Requested configuration (Zod-validated). Shape:
  /// { questionCount?: number, difficulty?: "EASY"|"MEDIUM"|"HARD"|"ADAPTIVE", topicIds?: string[],
  ///   includeSubtopics?: boolean, questionTypes?: QuestionType[], feedback: "IMMEDIATE"|"ON_SUBMIT",
  ///   origin: "BUILDER"|"PLAN_ITEM"|"RECOMMENDATION"|"RETEST"|"MISTAKES"|"ASSIGNMENT"|"ONBOARDING"|"WHATSAPP",
  ///   seed?: string, graceSeconds?: number, extraTimePercent?: number /* accommodation applied at start */,
  ///   answerAnyPolicy?: "BEST"|"FIRST" /* which N answers count in "answer any N" sections; default BEST */ }
  config             Json
  /// Results analysis written at marking (§12 "detailed analysis", §52 "performance report"). Per-section marks live
  /// in AssessmentAttemptSection. Shape:
  /// { version: 1,
  ///   byTopic: { topicId: string, marksAwarded: number, marksAvailable: number, percent: number }[]
  ///            /* counted answers only */,
  ///   strongTopicIds: string[], weakTopicIds: string[],
  ///   recommendations: { kind: "LESSON"|"PRACTICE"|"TOPIC_TEST"|"FLASHCARDS", topicId: string,
  ///                      lessonId?: string, assessmentId?: string, questionCount?: number, reason: string }[],
  ///   grade?: { nextGrade?: string, marksToNextGrade?: number },
  ///   time?: { avgSecondsPerMark: number, unansweredCount: number } }
  analysis           Json?

  user                    User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject                 Subject                    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  assessment              Assessment?                @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  topic                   Topic?                     @relation(fields: [topicId], references: [id], onDelete: Restrict)
  lesson                  Lesson?                    @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  dailyQuestion           DailyQuestion?             @relation(fields: [dailyQuestionId], references: [id], onDelete: Restrict)
  assignment              Assignment?                @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  gradeScheme             GradeScheme?               @relation(fields: [gradeSchemeId], references: [id], onDelete: Restrict)
  sections                AssessmentAttemptSection[]
  questionAttempts        QuestionAttempt[]
  studySessions           StudySession[]
  shareableResults        ShareableResult[]
  diagnosticForEnrollment SubjectEnrollment?         @relation("EnrollmentDiagnostic")
  countedForAssignment    AssignmentProgress?        @relation("AssignmentProgressCountedAttempt")

  /// Target of QuestionAttempt's composite FK (keeps the denormalised userId/subjectId on the hot table honest).
  @@unique([id, userId, subjectId])
  /// Offline / double-submit idempotency for "start attempt".
  @@unique([userId, idempotencyKey])
  /// One daily-question attempt per user per day's question; covers the dailyQuestionId FK.
  @@unique([dailyQuestionId, userId])
  /// Learning-history feed and recent attempts (§6, §14, §21 test results); covers the userId FK.
  @@index([userId, startedAt])
  /// Subject dashboard "recent tests" and mock history (§6, §7), diagnostic lookup, FREE-plan daily limits per mode.
  @@index([userId, subjectId, mode, startedAt])
  /// Analytics: mock exam performance and average score by subject (§35, §23), MOCK_AVERAGE leaderboard job;
  /// covers the subjectId FK.
  @@index([subjectId, mode, submittedAt])
  /// "My attempts at this assessment" (attempt limits), teacher-built test results; covers the assessmentId FK.
  @@index([assessmentId, userId])
  /// Teacher assignment results and NEEDS_REVIEW queue per assignment (§22); covers the assignmentId FK.
  @@index([assignmentId, userId])
  /// Covers the topicId FK.
  @@index([topicId])
  /// Covers the lessonId FK.
  @@index([lessonId])
  /// Covers the gradeSchemeId FK (also the "scheme already used?" check that freezes GradeBand rows).
  @@index([gradeSchemeId])
}

/// One paper / section of an assessment-backed attempt, copied from the Assessment revision at attempt start so timing
/// and scoring never read the mutable definition (§12 timer, §13 time remaining, "answer any N" scoring).
/// sectionNumber = 1-based position of the AssessmentSection by sortOrder at that revision.
/// Per-paper timing: startedAt / deadlineAt / submittedAt are per section, so Paper 2 (90 min) and Paper 4 (150 min)
/// of one mock get separate server deadlines and may be sat on different days; the exams.autoSubmit sweep closes a
/// single section through AssessmentAttemptSection_open_deadline_idx (raw SQL).
/// Invariants (CHECKs): deadlineAt => startedAt and timeLimitSeconds, and deadlineAt > startedAt; answerCount => maxMarks;
/// 0 <= marksAwarded <= maxMarks.
model AssessmentAttemptSection {
  attemptId        String    @db.Uuid
  sectionNumber    Int       @db.SmallInt
  title            String    @db.VarChar(200)
  /// Per-section limit snapshot (after any extra-time accommodation); NULL = shares the attempt's overall timer.
  timeLimitSeconds Int?
  /// "Answer any N" snapshot; NULL = answer all.
  answerCount      Int?      @db.SmallInt
  /// Section maximum marks snapshot (required with answerCount: only N answers count).
  maxMarks         Int?
  startedAt        DateTime? @db.Timestamptz(3)
  /// Server-authoritative per-section deadline = startedAt + timeLimitSeconds.
  deadlineAt       DateTime? @db.Timestamptz(3)
  submittedAt      DateTime? @db.Timestamptz(3)
  /// Counted marks of this section (written at marking).
  marksAwarded     Int?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  attempt          AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionAttempts QuestionAttempt[]

  /// Sections of one attempt in order; covers the attemptId FK.
  @@id([attemptId, sectionNumber])
}

/// One row per question PRESENTED within an attempt (§10, §12, §13). The hottest table (~600k rows/day at 100k
/// students): narrow, alignment-ordered, natural primary key (attemptId, position), 3 B-tree indexes + 2 BRIN. No
/// index references a column that answer saves or marking change (incl. markingStatus and isCounted), so those
/// UPDATEs are HOT (measured on PG18: 555 of 600 HOT). The PK contains the planned partition key (RANGE on attemptId,
/// UUIDv7 month bounds), and every reference to an answer uses (attemptId, position).
/// Exam modes create all rows at start (navigation, flags, "review unanswered" = response IS NULL); practice creates
/// rows as questions are presented. The answer is upserted on (attemptId, position); a save whose responseVersion is
/// not greater than the stored one is ignored (offline replays arriving out of order).
/// Invariants: userId/subjectId always equal the attempt's (composite FK); sectionNumber names an existing attempt
/// section (composite FK); topicId is the question's PRIMARY topic at attempt time (leaf of the pinned syllabus
/// version); marks are integers with 0 <= marksAwarded <= marksAvailable (CHECK); isCorrect = (marksAwarded =
/// marksAvailable) once marked; only a marked or unanswered row can be excluded from the score (CHECK).
model QuestionAttempt {
  attemptId        String        @db.Uuid
  /// Denormalised from the attempt (composite FK) so per-user queries never join AssessmentAttempt.
  userId           String        @db.Uuid
  /// Denormalised from the attempt (composite FK) so analytics never join through the curriculum tree.
  subjectId        String        @db.Uuid
  /// Primary topic of the question at attempt time. DELIBERATELY NOT A FOREIGN KEY: it is copied from the FK-checked
  /// Question -> primary QuestionTopic in the same transaction, Topic rows are never deleted, and an FK would force a
  /// fourth B-tree (topicId-leading) on this table purely for FK coverage. Analytics by topic use the BRIN range.
  topicId          String        @db.Uuid
  questionId       String        @db.Uuid
  /// When the question was presented (row creation). Immutable; used in indexes instead of answeredAt so answer
  /// saves stay HOT updates.
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  /// Server receipt time of the latest accepted answer save (also set when an answer is cleared). NULL = never saved.
  answeredAt       DateTime?     @db.Timestamptz(3)
  markedAt         DateTime?     @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)
  /// Question revision (ContentRevision version of the Question) the student saw; marking uses this revision.
  questionRevision Int
  /// Client-supplied monotonically increasing save counter for this answer (offline/out-of-order replays).
  responseVersion  Int           @default(0)
  /// Active time on this question (client-measured, clamped server-side).
  timeSpentSeconds Int           @default(0)
  markingStatus    MarkingStatus @default(PENDING)
  /// 1-based question number within the attempt (§13 numbering/navigation).
  position         Int           @db.SmallInt
  /// Paper section (Section A/B...) for assessment-backed attempts (FK to AssessmentAttemptSection); NULL otherwise.
  sectionNumber    Int?          @db.SmallInt
  /// Question difficulty (1-5) at attempt time; the adaptive engine's input and calibration key.
  difficulty       Int           @db.SmallInt
  /// Marks allocated to this question in this attempt (§12, §13 "mark allocation").
  marksAvailable   Int           @db.SmallInt
  /// NULL until marked (PENDING). Provisional while NEEDS_REVIEW.
  marksAwarded     Int?          @db.SmallInt
  hintsUsed        Int           @default(0) @db.SmallInt
  /// Full marks? NULL until marked.
  isCorrect        Boolean?
  /// Exam-mode "flag question" (§13).
  flaggedForReview Boolean       @default(false)
  /// The student had seen this question before (any attempt). Repeats are excluded from QuestionStats calibration.
  isRepeat         Boolean       @default(false)
  /// Counts towards the attempt score. FALSE only for answers beyond the N counted in an "answer any N" section (the
  /// N best by default, config.answerAnyPolicy), decided at marking. Deliberately unindexed. QuestionStats still
  /// counts every answered row.
  isCounted        Boolean       @default(true)
  /// The student's answer, discriminated by question type (Zod). NULL = not answered. Shape (one of):
  /// { type: "MULTIPLE_CHOICE", optionKeys: string[] /* QuestionOption.key, stable across revisions */ }
  /// | { type: "TRUE_FALSE", value: boolean }
  /// | { type: "SHORT_ANSWER" | "ESSAY" | "EXTENDED_RESPONSE", text: string }
  /// | { type: "NUMERICAL" | "CALCULATION", value: string, unit?: string, working?: string }
  /// | { type: "STRUCTURED", parts: { partId: string, text?: string, value?: string, unit?: string }[] }
  /// | { type: "MATCHING", pairs: { leftId: string, rightId: string }[] }
  /// | { type: "FILL_IN_THE_BLANK", blanks: { blankId: string, text: string }[] }
  /// | { type: "DIAGRAM_LABELLING", labels: { targetId: string, labelId?: string, text?: string }[] }
  /// Photos of working / drawn diagrams (§13) are NOT in this JSON: they are QuestionAttemptAttachment rows (FK to a
  /// validated MediaAsset), so no student-writable column ever holds a storage key.
  response         Json?
  /// Per-answer marking detail beyond marksAwarded. NULL for single-part deterministic types (the explanation lives on
  /// the Question). Shape: { parts?: { partId: string, awarded: number, max: number, correct: boolean }[],
  ///   points?: { pointId: string, awarded: number, evidence?: string }[], comment?: string,
  ///   misconceptions?: string[], aiMarked?: boolean }
  feedback         Json?

  attempt              AssessmentAttempt           @relation(fields: [attemptId, userId, subjectId], references: [id, userId, subjectId], onDelete: Cascade)
  /// Composite FK (attemptId, sectionNumber); NULL sectionNumber (unsectioned attempts) is not checked (MATCH SIMPLE).
  section              AssessmentAttemptSection?   @relation(fields: [attemptId, sectionNumber], references: [attemptId, sectionNumber], onDelete: Cascade)
  question             Question                    @relation(fields: [questionId], references: [id], onDelete: Restrict)
  markings             QuestionAttemptMarking[]
  attachments          QuestionAttemptAttachment[]
  // Back-relations (PLATFORM slice)
  /// WhatsApp conversations currently waiting for an answer to this question slot.
  channelPendingStates ChannelConversationState[]

  /// Natural key: load an attempt's questions in order; answer upsert key; partition-ready (contains attemptId);
  /// covers the composite attempt and section FKs by its leading column.
  @@id([attemptId, position])
  /// Adaptive engine: recent window per (user, topic), recent mistakes for the AI tutor context (§11, §14),
  /// "seen recently" exclusion, nightly mastery reconcile.
  @@index([userId, topicId, createdAt])
  /// Per-question history and stats recompute, re-marking after an answer-key fix (§42); covers the questionId FK.
  @@index([questionId, createdAt])
  /// Analytics range scans (§35: questions attempted, most difficult / most attempted topics, popular subjects).
  @@index([createdAt], type: Brin)
  /// Incremental QuestionStats rollup window (answers marked since the last run, including late AI marks).
  @@index([markedAt], type: Brin)
}

/// Append-only log of NON-deterministic marking decisions and overrides for one QuestionAttempt: AI marks (model,
/// prompt version, confidence, per-point awards), teacher/reviewer marks and overrides, self-assessment, and system
/// re-marks after an answer-key correction (§9, §42; ARCHITECTURE §6.5 "overrides are stored with the reviewer and
/// reused as an evaluation set"). Keeps QuestionAttempt narrow: deterministic auto-marks write no row here.
/// References the question attempt by its primary key (attemptId, position), which stays valid if QuestionAttempt is
/// partitioned.
model QuestionAttemptMarking {
  id                   String        @id @default(uuid(7)) @db.Uuid
  attemptId            String        @db.Uuid
  /// Teacher or reviewer who marked; NULL for AI, AUTO and SELF (the student is the attempt owner).
  markedById           String?       @db.Uuid
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  source               MarkingSource
  /// QuestionAttempt.markingStatus after this decision.
  resultingStatus      MarkingStatus
  /// AI confidence 0..1 (ARCHITECTURE §6.5 threshold ai.marking.minConfidence).
  confidence           Float?
  position             Int           @db.SmallInt
  marksAwarded         Int           @db.SmallInt
  /// Marks before this decision (NULL for the first mark).
  previousMarksAwarded Int?          @db.SmallInt
  aiModel              String?       @db.VarChar(64)
  promptVersion        String?       @db.VarChar(32)
  /// Override reason (teacher/reviewer), shown to the student.
  reason               String?       @db.VarChar(500)
  /// Mark-scheme point awards. Shape: { pointId: string, awarded: number, evidence?: string }[]
  points               Json?
  /// Shape: { comment?: string, misconceptions?: string[] }
  feedback             Json?

  questionAttempt QuestionAttempt @relation(fields: [attemptId, position], references: [attemptId, position], onDelete: Cascade)
  markedBy        User?           @relation(fields: [markedById], references: [id], onDelete: SetNull)

  /// Marking history of one answer; covers the composite FK.
  @@index([attemptId, position, createdAt])
  /// Teacher marking activity (§23 teacher performance), evaluation-set export; covers the markedById FK.
  @@index([markedById, createdAt])
}

/// A file attached to an answer (§13 "extended written answers": photo of working, drawn graph or diagram). The file is
/// a MediaAsset (purpose ANSWER_ATTACHMENT, PRIVATE) that went through the upload pipeline (type sniffing, size limits,
/// EXIF strip, status READY). Side table so the hot QuestionAttempt row stays narrow and every attachment is
/// FK-checked, findable for export / deletion and readable only through this link.
/// Invariants: the asset's uploadedById is the attempt's userId, purpose ANSWER_ATTACHMENT, status READY at attach time
/// (service); an asset is attached at most once (unique). Signed URLs are issued only for assets reached through this
/// table, to the attempt owner, the class teacher of the assignment, or a content reviewer for NEEDS_REVIEW items.
model QuestionAttemptAttachment {
  attemptId    String   @db.Uuid
  position     Int      @db.SmallInt
  mediaAssetId String   @unique @db.Uuid
  /// Order of the attachment within the answer.
  sortOrder    Int      @default(0) @db.SmallInt
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  questionAttempt QuestionAttempt @relation(fields: [attemptId, position], references: [attemptId, position], onDelete: Cascade)
  mediaAsset      MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  /// An answer's attachments; covers the composite FK (mediaAssetId FK covered by its unique).
  @@id([attemptId, position, mediaAssetId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Mastery, progress and question rollups
// ---------------------------------------------------------------------------------------------------------------------

/// Per-(student, topic) mastery and adaptive state (§11). Leaf rows (isLeaf) get direct evidence synchronously on
/// every marked answer (instant adaptivity); ancestor rows (topics above subtopics) are recomputed from their leaves
/// by the debounced progress.rollupSubject job. No row = topic not started.
/// Version scoping (§26): rows carry the topic's syllabusId. Every dashboard / parent / teacher / planner read filters
/// syllabusId = SubjectEnrollment.syllabusId; after a version move the old version's rows stay as history.
/// Which rows a view lists (code branches on kind, never on depth): §7 topic bars and "weakest area" = topicKind TOPIC;
/// fine-grained weak lists = leaf SUBTOPIC/TOPIC rows (isLeaf); SECTION rows are grouping rollups only.
/// Invariants: 0 <= score <= 100; band matches score per §11 (CHECK); 1 <= currentDifficulty <= 5;
/// (userId, subjectId) is an existing SubjectEnrollment, (topicId, syllabusId, topicKind) an existing Topic and
/// (syllabusId, subjectId) an existing Syllabus (composite FKs: version, kind and subject can never drift);
/// questionsCorrect <= questionsAttempted.
model TopicMastery {
  userId               String      @db.Uuid
  topicId              String      @db.Uuid
  /// Subject of the topic (pinned by the Syllabus composite FK) so subject dashboards never walk the topic tree.
  subjectId            String      @db.Uuid
  /// Syllabus version of the topic (pinned by the Topic composite FK). Immutable for the row.
  syllabusId           String      @db.Uuid
  firstPracticedAt     DateTime?   @db.Timestamptz(3)
  lastPracticedAt      DateTime?   @db.Timestamptz(3)
  /// When to re-test this topic (§11 "re-test later"); read by the planner (SPACED_REVIEW items).
  nextReviewAt         DateTime?   @db.Timestamptz(3)
  /// Set when repeated wrong answers put the topic into remediation (§11: lower difficulty, explain, recommend a
  /// lesson); cleared when the student recovers.
  remediationStartedAt DateTime?   @db.Timestamptz(3)
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @db.Timestamptz(3)
  /// Mastery 0-100 (algorithmVersion defines the formula: recency- and difficulty-weighted marks ratio).
  score                Float       @default(0)
  /// Recency-weighted accuracy (exponential moving average of marks ratio, 0..1).
  recentAccuracy       Float?
  /// Evidence counts (marked answers; UNANSWERED excluded).
  questionsAttempted   Int         @default(0)
  questionsCorrect     Int         @default(0)
  marksAwarded         Int         @default(0)
  marksAvailable       Int         @default(0)
  band                 MasteryBand @default(WEAK)
  /// Structural kind of the topic (pinned by the Topic composite FK; published topics are frozen). Views select on it.
  topicKind            TopicKind
  /// Depth of the topic in its syllabus tree; display/indentation only (depth varies by board, use topicKind).
  topicDepth           Int         @default(0) @db.SmallInt
  /// Adaptive difficulty the next question should target (1-5, §11).
  currentDifficulty    Int         @default(3) @db.SmallInt
  consecutiveCorrect   Int         @default(0) @db.SmallInt
  consecutiveIncorrect Int         @default(0) @db.SmallInt
  algorithmVersion     Int         @default(1) @db.SmallInt
  /// Leaf topic (direct evidence) vs ancestor rollup row.
  isLeaf               Boolean     @default(true)
  /// Score currently rests (partly) on the diagnostic (§52), so confidence is low until practice evidence arrives.
  seededByDiagnostic   Boolean     @default(false)

  enrollment SubjectEnrollment @relation(fields: [userId, subjectId], references: [userId, subjectId], onDelete: Cascade)
  topic      Topic             @relation(fields: [topicId, syllabusId, topicKind], references: [id, syllabusId, kind], onDelete: Restrict)
  syllabus   Syllabus          @relation(fields: [syllabusId, subjectId], references: [id, subjectId], onDelete: Restrict)

  @@id([userId, topicId])
  /// Weak/strong topics and topic bars per subject for the PINNED version (§6, §7, §21, §22 class weak topics):
  /// WHERE userId = ? AND subjectId = ? AND syllabusId = ? AND topicKind = ? [AND band IN (...)]. Covers the composite
  /// enrolment FK by its leading columns. Excludes `score` so per-answer updates stay HOT (band changes rarely;
  /// syllabusId and topicKind never change).
  @@index([userId, subjectId, syllabusId, topicKind, band])
  /// Platform "most difficult topics" distribution (§35), content analytics per version. Its leading columns cover the
  /// (syllabusId, subjectId) Syllabus FK and the (topicId, syllabusId, topicKind) Topic FK (equality on both ids).
  @@index([syllabusId, topicId, band])
}

/// Cached per-(student, subject) rollup that dashboards read instead of raw attempts (§6, §7, §21, §22, §23).
/// Recomputed by progress.rollupSubject (debounced after attempts, lesson completions and study sessions), by the
/// nightly reconcile and after a syllabus version move. Nullable metrics mean "not enough evidence yet": the UI shows
/// an honest empty state (§50).
/// "Topic" counts are over IN-SCOPE leaf topics of the enrolment (see SubjectEnrollment: pinned version ∩ route
/// components ∩ (not optional OR chosen in EnrollmentTopicChoice) ∩ exam-year window containing the target session's
/// year), read from TopicMastery rows of the pinned version only; completed = band >= COMPETENT.
model SubjectProgress {
  userId                  String    @db.Uuid
  subjectId               String    @db.Uuid
  lastActivityAt          DateTime? @db.Timestamptz(3)
  lastMockAt              DateTime? @db.Timestamptz(3)
  /// Last full recomputation.
  computedAt              DateTime  @default(now()) @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(3)
  /// Subject progress 0-100: mean leaf-topic mastery with unstarted topics counted as 0 (§6 "subject progress").
  progressPercent         Float     @default(0)
  /// Leaf topics with any evidence (practice or completed lesson) / total, 0-100 (§7 "syllabus progress").
  syllabusCoveragePercent Float     @default(0)
  /// Mean percentage of marked tests/quizzes/mocks (not practice) (§6, §7 "average score").
  averageScorePercent     Float?
  lastMockPercent         Float?
  bestMockPercent         Float?
  averageMockPercent      Float?
  /// Exam readiness 0-100 (§23): coverage, mastery and mock results combined (formula versioned in code).
  readinessPercent        Float?
  topicsTotal             Int       @default(0)
  topicsStarted           Int       @default(0)
  topicsCompleted         Int       @default(0)
  topicsMastered          Int       @default(0)
  weakTopicsCount         Int       @default(0)
  lessonsTotal            Int       @default(0)
  lessonsCompleted        Int       @default(0)
  questionsAttempted      Int       @default(0)
  questionsCorrect        Int       @default(0)
  marksAwarded            Int       @default(0)
  marksAvailable          Int       @default(0)
  assessmentsCompleted    Int       @default(0)
  mockExamsCompleted      Int       @default(0)
  /// Total study time in this subject (§21 parent "study time").
  studySeconds            Int       @default(0)
  /// Predicted grade from mastery + mocks via the qualification's GradeScheme; NULL until enough evidence.
  predictedGrade          String?   @db.VarChar(8)
  /// predictedGrade is a pass under the GradeScheme (§23 "pass rate"); NULL until enough evidence.
  predictedPass           Boolean?
  /// Cached "recommended topics / next session" for §6 and §7. Shape:
  /// { kind: "LESSON"|"PRACTICE"|"TOPIC_TEST"|"FLASHCARDS"|"REVIEW", topicId: string, lessonId?: string,
  ///   assessmentId?: string, questionCount?: number, minutes?: number, reason: StudyPlanItemReason }[]
  recommendations         Json?

  enrollment SubjectEnrollment @relation(fields: [userId, subjectId], references: [userId, subjectId], onDelete: Cascade)

  /// Dashboard lookup per student (all subjects) and per (student, subject); class and school views look up
  /// (userId IN members, subjectId). Also the 1:1 FK to SubjectEnrollment.
  @@id([userId, subjectId])
}

/// Aggregate answer statistics per question (1:1 extension of Question) for difficulty calibration, the adaptive
/// engine and quality control (§9, §11, §35 "most difficult", §42 suspect answer keys). Updated hourly from the
/// QuestionAttempt markedAt BRIN window (never per answer: a popular daily question would be a hot row); fully
/// recomputed weekly. Contains no per-student data (safe for CONTENT_EDITOR views).
model QuestionStats {
  questionId              String    @id @db.Uuid
  lastAnsweredAt          DateTime? @db.Timestamptz(3)
  /// Watermark/time of the last rollup that touched this row.
  computedAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(3)
  /// Average marksAwarded / marksAvailable over answered attempts (classical facility, 0..1).
  facility                Float?
  /// Share of answered attempts with full marks (0..1).
  correctRate             Float?
  /// First-exposure facility (isRepeat = false) used for calibration (0..1).
  calibratedFacility      Float?
  avgTimeSeconds          Float?
  /// Point-biserial correlation with the students' topic mastery (-1..1); low/negative flags a bad item.
  discrimination          Float?
  /// Empirical difficulty on the 1-5 scale derived from calibratedFacility; editors compare with Question.difficulty.
  empiricalDifficulty     Float?
  presentedCount          Int       @default(0)
  answeredCount           Int       @default(0)
  correctCount            Int       @default(0)
  partialCount            Int       @default(0)
  unansweredCount         Int       @default(0)
  /// First-exposure answered / correct counts (calibration sample).
  calibrationCount        Int       @default(0)
  calibrationCorrectCount Int       @default(0)
  needsReviewCount        Int       @default(0)
  hintsUsedSum            Int       @default(0)
  marksAwardedSum         BigInt    @default(0)
  marksAvailableSum       BigInt    @default(0)
  timeSpentSecondsSum     BigInt    @default(0)
  /// Automated suspicion of a wrong answer key (e.g. a distractor chosen far more often than the key by high-mastery
  /// students). Editors confirm via ContentFlag (§42).
  suspectAnswerKey        Boolean   @default(false)
  /// MCQ distractor analysis. Shape: { [optionKey: string]: number /* times chosen, keyed by QuestionOption.key */ }
  optionCounts            Json?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

/// Per-(student, lesson) progress (§8, §52 "return the next day and continue"). Row created on first view.
/// Invariants: 0 <= progressPercent <= 100; status COMPLETED <=> completedAt IS NOT NULL (CHECK).
model LessonProgress {
  userId            String               @db.Uuid
  lessonId          String               @db.Uuid
  firstViewedAt     DateTime             @default(now()) @db.Timestamptz(3)
  lastViewedAt      DateTime             @default(now()) @db.Timestamptz(3)
  completedAt       DateTime?            @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)
  timeSpentSeconds  Int                  @default(0)
  viewCount         Int                  @default(1)
  /// Lesson revision the student completed (content may be revised later).
  completedRevision Int?
  status            LessonProgressStatus @default(IN_PROGRESS)
  progressPercent   Int                  @default(0) @db.SmallInt
  /// Resume position inside the lesson (block/heading anchor id).
  resumeAnchor      String?              @db.VarChar(100)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  /// "Which lessons in this topic are done" (userId + lessonId IN ...); covers the userId FK. "Continue learning" (§52)
  /// scans this PK prefix (a student has at most a few hundred rows) and sorts by lastViewedAt in memory, so the
  /// per-view lastViewedAt write stays a HOT update (no index on it).
  @@id([userId, lessonId])
  /// Lesson completion rates for the content team (§35); covers the lessonId FK.
  @@index([lessonId, status])
}

// ---------------------------------------------------------------------------------------------------------------------
// Flashcards (§18)
// ---------------------------------------------------------------------------------------------------------------------

/// Per-(student, card) spaced-repetition state: Anki-style SM-2 variant with Again/Hard/Good/Easy (§18); scheduler
/// parameters live in Setting. Created when a card is first introduced (daily new-card limit). New-card discovery:
/// platform cards tagged (FlashcardTopic) to in-scope topics of the student's PINNED syllabus version, plus the
/// student's personal cards, anti-joined with existing state rows; never through Flashcard.subjectId, which is only
/// the card's authoring subject (cards are reused across boards).
/// Invariants: easeFactor >= 1.3; intervalDays >= 0; dueAt is the single source of truth for the due queue;
/// (userId, subjectId) is an existing SubjectEnrollment (composite FK).
model FlashcardState {
  userId         String            @db.Uuid
  flashcardId    String            @db.Uuid
  /// ENROLMENT subject the card was introduced under (for a reused platform card: the subject of the pinned syllabus
  /// it was found through; for a personal card: Flashcard.subjectId). Per-subject due queues and deck counts read it.
  subjectId      String            @db.Uuid
  dueAt          DateTime          @db.Timestamptz(3)
  lastReviewedAt DateTime?         @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  easeFactor     Float             @default(2.5)
  /// Current review interval in days (0 while in LEARNING/RELEARNING steps, which are scheduled via dueAt).
  intervalDays   Int               @default(0)
  /// Consecutive successful reviews.
  repetitions    Int               @default(0)
  lapses         Int               @default(0)
  reviewCount    Int               @default(0)
  state          FlashcardSrsState @default(NEW)
  lastRating     FlashcardRating?
  /// Index into the learning / relearning step list.
  learningStep   Int               @default(0) @db.SmallInt
  /// Student suspended the card ("I know this"); excluded from the due queue.
  isSuspended    Boolean           @default(false)

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard  Flashcard         @relation(fields: [flashcardId], references: [id], onDelete: Restrict)
  enrollment SubjectEnrollment @relation(fields: [userId, subjectId], references: [userId, subjectId], onDelete: Cascade)
  reviews    FlashcardReview[]

  @@id([userId, flashcardId])
  /// Per-subject due queue and counts: WHERE userId = ? AND subjectId = ? AND dueAt <= now() ORDER BY dueAt (§18).
  /// The all-subjects queue (WHERE userId = ? AND dueAt <= now()) range-scans the same index by userId: a student's
  /// card states number in the low thousands, so one dueAt index (rewritten on every review) is enough.
  /// Covers the composite enrolment FK.
  @@index([userId, subjectId, dueAt])
  /// Covers the flashcardId FK; card-level stats.
  @@index([flashcardId])
}

/// Append-only review log (§18), one row per Again/Hard/Good/Easy press, including reviews replayed from the offline
/// IndexedDB outbox (ARCHITECTURE §3.13). Enables re-simulating the scheduler and analytics; never updated.
/// Invariant: (userId, flashcardId) is an existing FlashcardState (composite FK).
model FlashcardReview {
  id                   String            @id @default(uuid(7)) @db.Uuid
  userId               String            @db.Uuid
  flashcardId          String            @db.Uuid
  /// When the student pressed the button (client time for offline replays, clamped to <= server receipt).
  reviewedAt           DateTime          @db.Timestamptz(3)
  previousDueAt        DateTime?         @db.Timestamptz(3)
  newDueAt             DateTime          @db.Timestamptz(3)
  /// Server receipt time.
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  previousEaseFactor   Float
  newEaseFactor        Float
  previousIntervalDays Int
  newIntervalDays      Int
  /// Time from card shown to rating (ms).
  durationMs           Int?
  rating               FlashcardRating
  previousState        FlashcardSrsState
  newState             FlashcardSrsState
  /// Client-generated id for idempotent offline replay (POST /flashcards/reviews batch).
  clientReviewId       String?           @db.VarChar(64)

  cardState FlashcardState @relation(fields: [userId, flashcardId], references: [userId, flashcardId], onDelete: Cascade)

  /// Replay idempotency.
  @@unique([userId, clientReviewId])
  /// Per-card review history; covers the composite FK.
  @@index([userId, flashcardId, reviewedAt])
  /// Analytics / DailyActivity reconcile range scans.
  @@index([reviewedAt], type: Brin)
  // Raw SQL (migration 20261006102004): partial "FlashcardReview_new_daily_idx" (userId, reviewedAt)
  // WHERE previousState = 'NEW', for the daily new-card cap count.
}

// ---------------------------------------------------------------------------------------------------------------------
// Study plan and study time (§16, §21, §23)
// ---------------------------------------------------------------------------------------------------------------------

/// A student's personalised study plan (§16, §52). Generated by the pure planner from enrolments, exam date,
/// availability, mastery and history; adapted nightly and after mocks (studyplan.adapt) by regenerating FUTURE
/// pending items. Regeneration with changed inputs creates a new plan and marks the old one SUPERSEDED.
/// A plan may start from an editorial StudyPlanTemplate (templateId, revision recorded in inputs); the template is
/// never modified by personal adaptation.
/// Invariant: at most one ACTIVE plan per user (partial unique index, raw SQL).
model StudyPlan {
  id                  String          @id @default(uuid(7)) @db.Uuid
  userId              String          @db.Uuid
  /// Template the plan was generated from (§25 CMS study plans); NULL = generated purely by the planner.
  templateId          String?         @db.Uuid
  startsOn            DateTime        @db.Date
  /// Earliest target exam date across the plan's subjects (student local date); per-subject dates are in inputs.
  examDate            DateTime        @db.Date
  generatedAt         DateTime        @default(now()) @db.Timestamptz(3)
  lastAdaptedAt       DateTime?       @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)
  status              StudyPlanStatus @default(ACTIVE)
  adaptationCount     Int             @default(0)
  /// Average daily target (§6 "Today's target: 45 minutes"); per-day targets follow availability.
  dailyTargetMinutes  Int             @db.SmallInt
  weeklyTargetMinutes Int             @db.SmallInt
  /// Planner algorithm version that produced the plan (reproducibility, tests).
  generatorVersion    String          @db.VarChar(32)
  /// Minutes available per ISO weekday. Shape: { mon: number, tue: number, wed: number, thu: number, fri: number,
  ///   sat: number, sun: number }
  availability        Json
  /// Snapshot of the planner inputs. Shape: { subjects: { subjectId: string, enrollmentId: string,
  ///   examDate?: string, targetGrade?: string, progressPercent?: number, weakTopicIds: string[] }[],
  ///   availability: {...}, timezone: string, diagnosticAttemptIds?: string[], templateRevision?: number,
  ///   notes?: string }
  inputs              Json

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  template StudyPlanTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  items    StudyPlanItem[]

  /// Target of StudyPlanItem's composite FK.
  @@unique([id, userId])
  /// Plan history per user; covers the userId FK. Active plan lookup uses the partial unique index (raw SQL).
  @@index([userId, generatedAt])
  /// Template uptake analytics; covers the FK.
  @@index([templateId])
}

/// One scheduled activity on one day of a plan (§16 "Monday: Mathematics 45 min"; §6 "Recommended: Mathematics /
/// Quadratic Equations / 20 questions"). Progress accumulates from StudySessions linked via planItemId.
/// Invariants: userId = plan's userId (composite FK); (planId, date, sortOrder) unique; activityType is not
/// DAILY_QUESTION or AI_TUTOR (CHECK).
model StudyPlanItem {
  id                 String              @id @default(uuid(7)) @db.Uuid
  planId             String              @db.Uuid
  /// Denormalised owner (composite FK to the plan) for ownership checks without a join.
  userId             String              @db.Uuid
  subjectId          String              @db.Uuid
  topicId            String?             @db.Uuid
  lessonId           String?             @db.Uuid
  /// Test / mock to take (e.g. "English / Comprehension / Practice Test").
  assessmentId       String?             @db.Uuid
  /// Teacher assignment folded into the plan (reason ASSIGNMENT_DUE).
  assignmentId       String?             @db.Uuid
  /// Student local date.
  date               DateTime            @db.Date
  completedAt        DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  /// Active seconds credited from linked StudySessions.
  completedSeconds   Int                 @default(0)
  activityType       StudyActivityType
  reason             StudyPlanItemReason
  status             StudyPlanItemStatus @default(PENDING)
  sortOrder          Int                 @db.SmallInt
  targetMinutes      Int                 @db.SmallInt
  targetQuestions    Int?                @db.SmallInt
  completedQuestions Int                 @default(0) @db.SmallInt
  /// Adaptation pass that produced the item (StudyPlan.adaptationCount at creation).
  generation         Int                 @default(0) @db.SmallInt
  /// Facts behind the reason, for the "why this?" text. Shape: { masteryScore?: number, band?: MasteryBand,
  ///   daysToExam?: number, dueCards?: number, missedOn?: string }
  reasonData         Json?

  plan          StudyPlan      @relation(fields: [planId, userId], references: [id, userId], onDelete: Cascade)
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic         Topic?         @relation(fields: [topicId], references: [id], onDelete: Restrict)
  lesson        Lesson?        @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  assessment    Assessment?    @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  assignment    Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  studySessions StudySession[]

  /// Today's / this week's items of a plan in order; covers the composite plan FK.
  @@unique([planId, date, sortOrder])
  /// FK coverage.
  @@index([subjectId])
  @@index([topicId])
  @@index([lessonId])
  @@index([assessmentId])
  @@index([assignmentId])
}

/// Actual study time (§16 "previous study sessions", §21 parent "study time", §23 engagement, §35 study time) and
/// the learning-history feed (§14). Opened when an activity starts, extended by client heartbeats (lastActiveAt,
/// durationSeconds += capped delta), closed on finish or idle. A session that crosses local midnight is split.
/// Deliberately never linked to an AI conversation (parents see sessions, never AI content, §21).
model StudySession {
  id              String            @id @default(uuid(7)) @db.Uuid
  userId          String            @db.Uuid
  subjectId       String?           @db.Uuid
  topicId         String?           @db.Uuid
  lessonId        String?           @db.Uuid
  /// The plan item this session works on (credits StudyPlanItem.completedSeconds).
  planItemId      String?           @db.Uuid
  /// The attempt this session belongs to (practice, test, mock, diagnostic, daily question).
  attemptId       String?           @db.Uuid
  startedAt       DateTime          @default(now()) @db.Timestamptz(3)
  lastActiveAt    DateTime          @default(now()) @db.Timestamptz(3)
  endedAt         DateTime?         @db.Timestamptz(3)
  /// Student-local calendar date of startedAt (Profile timezone, default Africa/Harare): DailyActivity bucket.
  localDate       DateTime          @db.Date
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  /// Active seconds (heartbeat-accumulated, idle gaps excluded).
  durationSeconds Int               @default(0)
  activityType    StudyActivityType
  channel         ActivityChannel   @default(WEB)

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject  Subject?           @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic    Topic?             @relation(fields: [topicId], references: [id], onDelete: Restrict)
  lesson   Lesson?            @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  planItem StudyPlanItem?     @relation(fields: [planItemId], references: [id], onDelete: SetNull)
  attempt  AssessmentAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  /// Learning-history feed, weekly study time per subject (parent view), planner history; covers the userId FK.
  @@index([userId, startedAt])
  /// Study time by subject (§35 popular subjects); covers the subjectId FK.
  @@index([subjectId, startedAt])
  /// FK coverage.
  @@index([topicId])
  @@index([lessonId])
  @@index([planItemId])
  @@index([attemptId])
}

/// One row per (student, local calendar day) with any learning activity: the raw fact table for streaks (§19), the
/// daily target (§6), parent "attendance / study activity" (§21), school engagement (§23) and DAU/MAU/retention/study
/// time (§35). Upserted incrementally in the same transaction as the activity (answer, heartbeat, lesson, review,
/// XP). date is the student-local date (Profile timezone, default Africa/Harare).
/// A row may also be written by gamification.streakMaintenance for a day saved by a streak freeze
/// (streakFreezeUsed = true, zero activity): DAU counts only rows with activity.
model DailyActivity {
  userId               String    @db.Uuid
  date                 DateTime  @db.Date
  firstActivityAt      DateTime? @db.Timestamptz(3)
  lastActivityAt       DateTime? @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)
  studySeconds         Int       @default(0)
  questionsAttempted   Int       @default(0)
  questionsCorrect     Int       @default(0)
  flashcardsReviewed   Int       @default(0)
  xpEarned             Int       @default(0)
  lessonsCompleted     Int       @default(0) @db.SmallInt
  /// Marked quizzes / tests / mocks / diagnostics finished that day.
  assessmentsCompleted Int       @default(0) @db.SmallInt
  /// Daily target in force that day (from the active plan or LearnerStats.dailyGoalMinutes), for honest history.
  targetMinutes        Int?      @db.SmallInt
  dailyGoalMet         Boolean   @default(false)
  /// Day counted toward the streak (minimum-activity threshold met, or saved by a freeze).
  streakCredited       Boolean   @default(false)
  streakFreezeUsed     Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Per-student calendar ranges (streak, week, parent attendance); covers the userId FK.
  @@id([userId, date])
  /// DAU / MAU / retention per day (§35).
  @@index([date])
}

/// Per-student gamification and lifetime counters (§19), 1:1 with User. Updated at attempt close / lesson completion
/// / XP award (never per answer) and by the nightly streak job. Lifetime counters let achievement criteria be
/// evaluated without aggregating raw rows.
/// Invariants: longestStreak >= currentStreak >= 0; counters >= 0 (CHECK).
model LearnerStats {
  userId                  String    @id @db.Uuid
  /// Last day credited to the streak (local date).
  lastStreakDate          DateTime? @db.Date
  streakStartDate         DateTime? @db.Date
  /// First / last local date with activity (retention cohorts, §35).
  firstActiveDate         DateTime? @db.Date
  lastActiveDate          DateTime? @db.Date
  /// Monday (local) of the week the week* counters refer to; counters reset when the week rolls over.
  weekStartDate           DateTime? @db.Date
  lastActivityAt          DateTime? @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(3)
  totalXp                 Int       @default(0)
  currentStreak           Int       @default(0)
  longestStreak           Int       @default(0)
  streakFreezesUsedTotal  Int       @default(0)
  /// Weekly goal set by the student (§19 weekly goals); NULL = platform default from Setting.
  weeklyGoalXp            Int?
  weekStudySeconds        Int       @default(0)
  weekXp                  Int       @default(0)
  weekQuestions           Int       @default(0)
  weeksGoalMetTotal       Int       @default(0)
  totalQuestionsAttempted Int       @default(0)
  totalQuestionsCorrect   Int       @default(0)
  totalStudySeconds       Int       @default(0)
  lessonsCompleted        Int       @default(0)
  assessmentsCompleted    Int       @default(0)
  mockExamsCompleted      Int       @default(0)
  flashcardsReviewed      Int       @default(0)
  topicsMastered          Int       @default(0)
  streakFreezesAvailable  Int       @default(0) @db.SmallInt
  /// Daily study goal in minutes (§6 "daily target"), used when no active plan sets one. The single owner of the
  /// student's daily goal (onboarding writes it here); NULL = platform default (Setting `learning.defaults`).
  dailyGoalMinutes        Int?      @db.SmallInt
  weeklyGoalMinutes       Int?      @db.SmallInt
  /// Consecutive weeks with the weekly goal met.
  weeklyGoalStreak        Int       @default(0) @db.SmallInt
  weekGoalMet             Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------------------------------------------------
// XP, achievements and leaderboards (§19, §20)
// ---------------------------------------------------------------------------------------------------------------------

/// Append-only XP ledger (§19). LearnerStats.totalXp / weekXp and DailyActivity.xpEarned are incremented in the same
/// transaction as the insert. Idempotency: unique (userId, reason, sourceId), so a retried job, double tap or
/// replayed request never double-awards (insert ... on conflict do nothing, then increment only if inserted).
model XpEvent {
  id         String       @id @default(uuid(7)) @db.Uuid
  userId     String       @db.Uuid
  occurredAt DateTime     @default(now()) @db.Timestamptz(3)
  /// Student-local date of occurredAt (weekly XP leaderboard windows).
  localDate  DateTime     @db.Date
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  /// XP amount; positive except ADJUSTMENT (CHECK amount <> 0).
  amount     Int
  reason     XpReason
  sourceType XpSourceType
  /// Id of the source row, or a natural key when the source is a period: e.g. an AssessmentAttempt id, a local date
  /// "2026-10-05" for DAILY_GOAL_MET, "2026-W41" for WEEKLY_GOAL_MET, "30" for a 30-day STREAK_MILESTONE.
  sourceId   String       @db.VarChar(100)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Idempotency key; covers the userId FK.
  @@unique([userId, reason, sourceId])
  /// XP history feed.
  @@index([userId, occurredAt])
}

/// Badge definition (§19), admin-editable data (not hard-coded). Seeded definitions are real rules, not fake progress.
/// Deactivate (isActive = false) instead of deleting once anyone has earned it.
model Achievement {
  id          String              @id @default(uuid(7)) @db.Uuid
  /// Stable code used by the rules engine and seeds, e.g. "STREAK_30", "FIRST_MOCK".
  code        String              @unique @db.VarChar(64)
  name        String              @db.VarChar(100)
  description String              @db.VarChar(500)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  xpReward    Int                 @default(0)
  sortOrder   Int                 @default(0)
  category    AchievementCategory
  /// 1 = bronze-equivalent ... 3 = gold-equivalent (visual weight only).
  tier        Int                 @default(1) @db.SmallInt
  /// Icon key from the design system (no image upload needed).
  iconKey     String              @db.VarChar(64)
  isActive    Boolean             @default(true)
  /// Hidden until earned.
  isSecret    Boolean             @default(false)
  /// Dev-seed demo definition (§50). Never true in production data (trigger, raw SQL).
  isDemo      Boolean             @default(false)
  /// Rule evaluated by the pure gamification core (Zod discriminated union). Shape (one of):
  /// { type: "STREAK_DAYS", days: number } | { type: "QUESTIONS_ANSWERED", count: number }
  /// | { type: "TOPICS_MASTERED", count: number, subjectId?: string } | { type: "MOCKS_COMPLETED", count: number }
  /// | { type: "MOCK_SCORE_AT_LEAST", percent: number } | { type: "WEEKLY_GOALS_MET", count: number }
  /// | { type: "STUDY_HOURS", hours: number } | { type: "FLASHCARDS_REVIEWED", count: number }
  /// | { type: "DIAGNOSTIC_COMPLETED" } | { type: "DAYS_TO_EXAM", days: number }
  criteria    Json

  userAchievements UserAchievement[]
}

/// A badge earned by a student. One row per (user, achievement); achievements are one-time.
model UserAchievement {
  userId        String    @db.Uuid
  achievementId String    @db.Uuid
  unlockedAt    DateTime  @default(now()) @db.Timestamptz(3)
  /// When the student first saw the "new badge" notice.
  seenAt        DateTime? @db.Timestamptz(3)
  /// What triggered it. Shape: { attemptId?: string, subjectId?: string, topicId?: string, value?: number }
  context       Json?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Restrict)

  /// The student's badges; idempotent award; covers the userId FK.
  @@id([userId, achievementId])
  /// "How many students hold this badge"; covers the achievementId FK.
  @@index([achievementId, unlockedAt])
}

/// Leaderboard score row (§20), written only by gamification.leaderboardSnapshot (hourly + weekly close); never
/// computed live from raw activity. Rows exist only for students who opted in (Profile privacy setting); opting out
/// deletes the user's rows immediately and the job also removes rows of users no longer opted in. The display name is
/// resolved at READ time from the student's Profile privacy mode (real name / first name / username / anonymous) and
/// is never stored here.
/// Scores, not ranks, on the hourly path: the job upserts `value` only when it changed (INSERT ... ON CONFLICT DO
/// UPDATE ... WHERE value IS DISTINCT FROM EXCLUDED.value), so inactive students cost nothing and one student's
/// movement never rewrites everyone below them. Reads: top-N = ORDER BY value DESC on the board index; "my rank" =
/// 1 + count(DISTINCT value) WHERE <board> AND value > :mine (dense ranking, an index range count). rank/previousRank
/// are written only at the weekly close (final standings and movement arrows).
/// periodKey: "2026-W41" (ISO week, local Monday start) for WEEKLY_* metrics; "2026-10" for monthly MOCK_AVERAGE;
/// "LIVE" for STREAK and SUBJECT_MASTERY (current values).
/// Invariants: scopeId IS NULL <=> scopeType = GLOBAL; unique (metric, periodKey, scopeType, scopeId, userId) via two
/// partial uniques (raw SQL); rank / previousRank >= 1 when set.
model LeaderboardEntry {
  id           String            @id @default(uuid(7)) @db.Uuid
  /// Country / School / Class / Subject id according to scopeType; NULL for GLOBAL. Polymorphic: no FK.
  scopeId      String?           @db.Uuid
  userId       String            @db.Uuid
  /// When `value` last changed (the job does not touch unchanged rows).
  computedAt   DateTime          @default(now()) @db.Timestamptz(3)
  value        Float
  /// Final dense rank at the weekly close; NULL on live boards (computed at read time).
  rank         Int?
  /// Final rank in the previous closed period of the same board (movement arrows); written at the weekly close.
  previousRank Int?
  metric       LeaderboardMetric
  scopeType    LeaderboardScope
  periodKey    String            @db.VarChar(16)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Top-N of one board by score, and the "my rank" range count.
  @@index([metric, periodKey, scopeType, scopeId, value(sort: Desc)])
  /// "My positions" across boards; covers the userId FK.
  @@index([userId, periodKey])
}

// ---------------------------------------------------------------------------------------------------------------------
// Teacher assignments (§22)
// ---------------------------------------------------------------------------------------------------------------------

/// Work a teacher sets for a class (§22: assign lessons, assign quizzes, tests created by the teacher, practice).
/// Publishing fans out one AssignmentProgress row per targeted class member (all members, or a chosen subset);
/// students joining while it is open get a row too. Counters are cached for the teacher's list view.
/// Invariants: the target column matching `type` is set (CHECK); status PUBLISHED => publishedAt IS NOT NULL (CHECK);
/// assignments with work are CLOSED/ARCHIVED, never deleted (attempts keep their history via SetNull anyway); the
/// assessment is a platform test, a test of the class's school, or (school-less tutor class) a test owned by the
/// assigning teacher (tenant guard trigger, raw SQL). Deliberately NO relation to AiConversation: a teacher-owned row
/// must never be a navigable path to students' private AI conversations (the tutor reads aiHelp from its own
/// conversation snapshot).
model Assignment {
  id                  String                @id @default(uuid(7)) @db.Uuid
  classId             String                @db.Uuid
  /// Teacher who created it.
  createdById         String                @db.Uuid
  /// Subject of the work (class subject); attempts are made in this subject.
  subjectId           String                @db.Uuid
  lessonId            String?               @db.Uuid
  assessmentId        String?               @db.Uuid
  /// Topic scope for PRACTICE (and optional context for others).
  topicId             String?               @db.Uuid
  /// When students can see it; NULL while DRAFT. May be in the future (scheduled).
  publishedAt         DateTime?             @db.Timestamptz(3)
  dueAt               DateTime?             @db.Timestamptz(3)
  /// Hard close (no submissions after); NULL = stays open (late submissions marked LATE if allowed).
  closesAt            DateTime?             @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(3)
  /// Cached counters for the teacher's assignment list ("18/25 submitted, average 64%").
  assignedCount       Int                   @default(0)
  startedCount        Int                   @default(0)
  submittedCount      Int                   @default(0)
  averageScorePercent Float?
  type                AssignmentType
  status              AssignmentStatus      @default(DRAFT)
  aiHelp              AssignmentAiHelp      @default(HINTS_ONLY)
  scorePolicy         AssignmentScorePolicy @default(BEST)
  /// NULL = unlimited attempts.
  maxAttempts         Int?                  @db.SmallInt
  allowLateSubmission Boolean               @default(true)
  title               String                @db.VarChar(200)
  /// Teacher-written instructions (Markdown source, strict pipeline profile).
  instructions        String?
  /// Sanitised HTML rendered at write time from instructions.
  instructionsHtml    String?
  /// Required for PRACTICE. Shape: { questionCount: number, difficulty: "EASY"|"MEDIUM"|"HARD"|"ADAPTIVE",
  ///   topicIds: string[], timeLimitSeconds?: number, feedback: "IMMEDIATE"|"ON_SUBMIT" }
  practiceConfig      Json?

  class      Class                @relation(fields: [classId], references: [id], onDelete: Restrict)
  createdBy  User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  subject    Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  lesson     Lesson?              @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  assessment Assessment?          @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  topic      Topic?               @relation(fields: [topicId], references: [id], onDelete: Restrict)
  progress   AssignmentProgress[]
  attempts   AssessmentAttempt[]
  planItems  StudyPlanItem[]

  /// A class's assignments by status and due date (§22); covers the classId FK.
  @@index([classId, status, dueAt])
  /// A teacher's assignments across classes, teacher activity (§23); covers the createdById FK.
  @@index([createdById, createdAt])
  /// FK coverage.
  @@index([subjectId])
  @@index([lessonId])
  @@index([assessmentId])
  @@index([topicId])
}

/// One row per (assignment, targeted student): the student's status and the counted result (§22 "view
/// performance"). The counted attempt follows Assignment.scorePolicy.
model AssignmentProgress {
  assignmentId    String                   @db.Uuid
  userId          String                   @db.Uuid
  /// Counted attempt (FIRST / BEST / LATEST). For LESSON assignments NULL (progress from LessonProgress).
  attemptId       String?                  @unique @db.Uuid
  startedAt       DateTime?                @db.Timestamptz(3)
  submittedAt     DateTime?                @db.Timestamptz(3)
  completedAt     DateTime?                @db.Timestamptz(3)
  feedbackAt      DateTime?                @db.Timestamptz(3)
  /// Assigned at.
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)
  /// Counted score 0-100 (provisional while the counted attempt has pendingReviewCount > 0).
  scorePercent    Float?
  marksAwarded    Int?
  totalMarks      Int?
  status          AssignmentProgressStatus @default(NOT_STARTED)
  attemptsCount   Int                      @default(0) @db.SmallInt
  /// Lesson % or answered/required for practice.
  progressPercent Int                      @default(0) @db.SmallInt
  /// Teacher comment to the student (plain text).
  teacherFeedback String?                  @db.VarChar(2000)

  assignment Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt    AssessmentAttempt? @relation("AssignmentProgressCountedAttempt", fields: [attemptId], references: [id], onDelete: SetNull)

  /// Assignment roster/results for the teacher; covers the assignmentId FK.
  @@id([assignmentId, userId])
  /// Student's assignment inbox (§22, /app/assignments); covers the userId FK.
  @@index([userId, status])
}

// ---------------------------------------------------------------------------------------------------------------------
// Sharing (§46)
// ---------------------------------------------------------------------------------------------------------------------

/// A public, revocable share card ("I scored 82% in O-Level Mathematics", §46) at /share/[token].
/// snapshot holds ONLY public-safe facts chosen at share time; the public page and OG image read nothing else (no
/// joins to the user). No surname, school, photo, contact details or AI content.
/// Invariants: the raw token is 32 random bytes base64url (not derived from id), shown once at creation and stored
/// only as tokenHash = SHA-256 hex (like every other bearer secret); "copy link again" rotates the token. Every share
/// expires within one year (CHECK); a revoked or expired share returns 404. Deleted with the account.
model ShareableResult {
  id           String              @id @default(uuid(7)) @db.Uuid
  userId       String              @db.Uuid
  /// Source attempt for MOCK_SCORE / TEST_SCORE (internal only; never exposed on the public page).
  attemptId    String?             @db.Uuid
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  /// At most createdAt + 1 year (CHECK).
  expiresAt    DateTime            @db.Timestamptz(3)
  revokedAt    DateTime?           @db.Timestamptz(3)
  lastViewedAt DateTime?           @db.Timestamptz(3)
  viewCount    Int                 @default(0)
  kind         ShareableResultKind
  /// SHA-256(token) as 64 lower-case hex chars; the public page hashes the URL segment and looks it up here.
  tokenHash    String              @unique @db.Char(64)
  /// Public-safe facts only (Zod-validated). Shape: { headline: string /* "I scored 82% in O-Level Mathematics" */,
  ///   displayName?: string /* as chosen: first name / username; omitted = anonymous */,
  ///   value: number, unit: "PERCENT"|"DAYS"|"TOPICS"|"BADGE", boardName?: string, qualificationName?: string,
  ///   subjectName?: string, achievementName?: string, achievedOn: string /* YYYY-MM-DD */ }
  snapshot     Json

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt AssessmentAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  /// "My shares" (manage / revoke); covers the userId FK.
  @@index([userId, createdAt])
  /// Covers the attemptId FK.
  @@index([attemptId])
}

// #####################################################################################################################
// ===== PLATFORM =====
// #####################################################################################################################

// =====================================================================================================================
// SLICE: PLATFORM  (identity & accounts, organisations, billing, AI, messaging channels, infrastructure)
//
// Owns: User, Profile, Student, Parent, Teacher, Session, OAuthAccount, VerificationCode, ParentStudentLink, School,
//       SchoolMember, SchoolSubject*, Class, ClassTeacher, ClassMember, Invitation*, Announcement, Notification,
//       PushSubscription*, Plan, PlanPrice, Subscription, Payment, PaymentEvent, EntitlementGrant, PromoCode,
//       PromoCodePlan*, PromoRedemption*, ReferralCode, Referral, AiConversation, AiMessage, AiUsageDaily,
//       AiResponseCache, AiGenerationJob, ChannelIdentity, ChannelMessage, ChannelConversationState, AuditLog, Job,
//       RateLimitBucket, Setting, DailyMetric, PrivacyRequest*.   (* = slice-local helper table)
// References (other slices, by contract name; back-relations are added by the integrator, see notes):
//   CURRICULUM: Country, ExamBoard, Qualification, YearGroup, ExamSession, Subject, Syllabus, Topic, Question,
//               MediaAsset, StudyPack
//   LEARNING:   AssessmentAttempt, QuestionAttempt; enums AbilityLevel, ActivityChannel
// Raw SQL that Prisma cannot express (CHECKs, partial unique indexes, GIN/BRIN, triggers, grants) is listed in
// .scratch/design/slice-platform-notes.md §"Raw SQL".
//
// Slice-local rules (on top of the shared conventions):
//  * Users are never hard-deleted by the application: deletion = status DELETED + anonymisation (ARCHITECTURE §5.13).
//    Owned, disposable rows (sessions, codes, links, notifications, AI conversations) Cascade from User so a deliberate
//    DBA erasure still works; financial rows (Subscription, Payment) Restrict so money records can never vanish.
//  * Secrets are never stored: session tokens, OTP codes, invite codes and IPs are stored as SHA-256 / HMAC-SHA256 hex
//    digests (Char(64)). No OAuth access/refresh tokens are stored (login only needs the verified ID token).
//  * Open, code-registered vocabularies (payment provider keys, notification types, audit actions, job types, setting
//    keys, metric names) are VarChar keys validated by a code registry, not enums: adding one must not need a migration.
// =====================================================================================================================

// ---------------------------------------------------------------------------------------------------------------------
// Enums: identity & accounts
// ---------------------------------------------------------------------------------------------------------------------

/// Platform roles (§33). User.roles holds PLATFORM-LEVEL roles only: STUDENT, PARENT, TEACHER (the teacher persona,
/// including independent tutors), CONTENT_EDITOR, ADMIN, SUPER_ADMIN. SCHOOL_ADMIN is never stored in User.roles
/// (CHECK, raw SQL): it is held per school through SchoolMember(role = SCHOOL_ADMIN, status = ACTIVE), and the auth
/// layer adds it to the session's effective role set when such a membership exists. The value lives in this enum so
/// guards, permission maps, Announcement.audienceRoles and AuditLog.actorRoles can use one vocabulary.
enum Role {
  STUDENT
  PARENT
  TEACHER
  SCHOOL_ADMIN
  CONTENT_EDITOR
  ADMIN
  SUPER_ADMIN
}

/// Account lifecycle. DELETED rows are anonymised tombstones (no email, phone, names) kept so learning history and
/// payments stay attached to an id (ARCHITECTURE §5.13).
enum UserStatus {
  ACTIVE
  /// Blocked by staff (abuse, chargeback, safeguarding). Sessions are revoked; login refused.
  SUSPENDED
  /// Deletion requested; 14-day cancellable grace period (PrivacyRequest kind DELETION holds the schedule).
  PENDING_DELETION
  /// Anonymised. deletedAt is set (CHECK).
  DELETED
}

/// How a student's name appears on leaderboards and share cards (§20).
enum LeaderboardDisplay {
  /// First name + last name (opt-in only).
  REAL_NAME
  /// First name + last initial.
  FIRST_NAME
  /// Profile.username (auto-generated at registration). The default.
  USERNAME
  /// "Anonymous student"; the row still counts toward ranks.
  ANONYMOUS
}

/// Colour theme preference (dark mode via tokens, CLAUDE.md UI rules).
enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

/// Adjustable font size (§43). Mapped to a root font-size class in the UI.
enum FontScale {
  SMALL
  DEFAULT
  LARGE
  EXTRA_LARGE
}

/// Resumable onboarding wizard position (§5, §52). The wizard is server-driven so a dropped connection loses nothing.
enum OnboardingStep {
  COUNTRY
  /// "Are you under 18?" drives Student.isMinor and the guardian-consent flow.
  AGE_CHECK
  EXAM_BOARD
  /// Level = Qualification (O-Level / A-Level / IGCSE / AS & A Level...).
  LEVEL
  /// Year/form (YearGroup).
  YEAR_GROUP
  SUBJECTS
  TARGET_EXAM
  ABILITY
  TARGET_GRADE
  /// Offer of the free diagnostic test (§46, §52); may be skipped.
  DIAGNOSTIC_OFFER
  COMPLETED
}

/// Guardian consent for processing a minor's data (Cyber and Data Protection Act; legal TBC, ARCHITECTURE §5.12).
enum GuardianConsentStatus {
  /// Adult student (isMinor = false).
  NOT_REQUIRED
  PENDING
