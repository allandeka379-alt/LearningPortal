  /// it). Never renews and has no Subscription: fulfilled as ONE EntitlementGrant(source PURCHASE, planId, paymentId);
  /// the price's periodDays NULL = lifetime access (grant endsAt NULL), N = an N-day pass.
  PLAN_PURCHASE
}

/// Where a PaymentEvent came from.
enum PaymentEventSource {
