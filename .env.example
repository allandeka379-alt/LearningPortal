# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BvunzoHub
NEXT_PUBLIC_SUPPORT_EMAIL=
# debug | info | warn | error | silent (default: info, debug in development)
LOG_LEVEL=
# Production with several app replicas: set the same 32-byte base64 key on every replica so Server Action
# payloads encrypted by one instance can be decrypted by another.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# PostgreSQL. Local dev cluster: npm run db:start (port 5433, trust auth, data in .data/pg).
# The APP connects as app_rw (NOSUPERUSER NOBYPASSRLS, so row-level security is enforced);
# MIGRATIONS run as the owner. After prisma migrate dev, run: npm run db:grants
DATABASE_URL=postgresql://app_rw@localhost:5433/zimstudy
MIGRATION_DATABASE_URL=postgresql://postgres@localhost:5433/zimstudy
# Vitest integration tests (database name must end in _test; never point these at a real database)
DATABASE_URL_TEST=postgresql://app_rw@localhost:5433/zimstudy_test
MIGRATION_DATABASE_URL_TEST=postgresql://postgres@localhost:5433/zimstudy_test

# 32+ random bytes, hex/base64. Used for HMAC of OTP codes, signed tokens, etc.
SESSION_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# AI (Anthropic). Leave empty in dev: AI features then report "not configured"
# instead of returning fabricated answers.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Auth providers (optional)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Outbound messaging (src/server/messaging/providers.ts). "console" captures messages in memory and logs a redacted
# line (dev/test only; refused in production). Accounts are email-based: production REQUIRES EMAIL_PROVIDER=resend
# with its key and a verified sender (verification codes, sign-in codes, password resets, security notices and
# invitations always go by email). SMS is switched off (features.sms): production leaves SMS_PROVIDER unset (= none);
# set twilio or africastalking with its keys only before switching SMS on. Naming a real provider in development
# SENDS for real.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console
# Sender on a domain verified at the provider ("Name <address>" or "address"); example.com is refused in production
EMAIL_FROM="BvunzoHub <no-reply@example.com>"
# Optional Reply-To (e.g. the support mailbox)
EMAIL_REPLY_TO=
# EMAIL_PROVIDER=resend
RESEND_API_KEY=
SMS_PROVIDER=console
# SMS_PROVIDER=twilio: account SID (AC...), auth token, and TWILIO_FROM (E.164 number or alphanumeric sender ID)
# or TWILIO_MESSAGING_SERVICE_SID (MG...). Enable Zimbabwe in Twilio's SMS Geo Permissions.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# SMS_PROVIDER=africastalking: app username ("sandbox" = sandbox API, refused in production) and API key;
# optional registered sender ID / short code. Confirm Zimbabwe (Econet, NetOne, Telecel) coverage with the provider.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# ---------------------------------------------------------------------------
# Payments (provider adapters). "sandbox" is a local fake gateway, dev/test only.
# ---------------------------------------------------------------------------
PAYMENTS_ENABLED_PROVIDERS=sandbox
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# Currency of this Paynow integration (one integration per currency), merchant email (authemail in test mode)
PAYNOW_CURRENCY=USD
PAYNOW_MERCHANT_EMAIL=
PAYNOW_TEST_MODE=false
# Stripe is dormant (features.stripe off): it is never offered, even with these keys set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: pin the Stripe API version before go-live
STRIPE_API_VERSION=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (dormant: features.whatsapp off; nothing is sent to or accepted from WhatsApp)
# ---------------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Optional: Graph API version (default v23.0; verify the current one before go-live)
WHATSAPP_GRAPH_VERSION=

# ---------------------------------------------------------------------------
# File storage. "local" writes to ./storage (dev, or one host with a shared volume).
# "s3" = any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO); keep the bucket PRIVATE,
# every object is served through /api/media. Bucket, region and both keys are required with "s3".
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
S3_BUCKET=
# af-south-1 (AWS Cape Town); "auto" for Cloudflare R2
S3_REGION=
# Only for non-AWS providers, e.g. https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for temporary (STS) credentials
S3_SESSION_TOKEN=
# true for path-style URLs (MinIO)
S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# Client IP (every IP rate limit depends on it). REQUIRED in production: set ONE of these.
# TRUSTED_PROXY_HOPS = number of proxies in front of the app that APPEND to X-Forwarded-For
#   (load balancer only: 1; Cloudflare + load balancer: 2). The client is that many entries from the right;
#   whatever a client sends further left is ignored. Default 1 in development.
# CLIENT_IP_HEADER = a header your edge SETS to the client address instead, e.g. cf-connecting-ip
#   (only safe if the origin accepts traffic from the edge alone).
# ---------------------------------------------------------------------------
TRUSTED_PROXY_HOPS=
CLIENT_IP_HEADER=
