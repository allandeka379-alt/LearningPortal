[
 {
  "key": "soil.inorganic-fertilisers.c01",
  "cardType": "DEFINITION",
  "front": "Straight fertiliser",
  "back": "Supplies only one primary nutrient, e.g. ammonium nitrate (N), single superphosphate (P), muriate of potash (K).",
  "concepts": [
   "agri.soil.inorganic-fertilisers"
  ]
 },
 {
  "key": "soil.inorganic-fertilisers.c02",
  "cardType": "DEFINITION",
  "front": "Compound fertiliser",
  "back": "Supplies two or more primary nutrients in a fixed ratio, e.g. Compound D (7:14:7).",
  "concepts": [
   "agri.soil.inorganic-fertilisers"
  ]
 },
 {
  "key": "soil.inorganic-fertilisers.c03",
  "cardType": "FACT",
  "front": "What does 7:14:7 mean?",
  "back": "7% N, 14% P₂O₅ and 7% K₂O by mass (always in the order N:P:K).",
  "concepts": [
   "agri.soil.inorganic-fertilisers"
  ]
 },
 {
  "key": "soil.inorganic-fertilisers.c04",
  "cardType": "FACT",
  "front": "Nitrogen content of common straights (assume)",
  "back": "Ammonium nitrate 34.5% N; urea 46% N; ammonium sulfate 21% N.",
  "concepts": [
   "agri.soil.inorganic-fertilisers"
  ]
 },
 {
  "key": "soil.inorganic-fertilisers.c05",
  "cardType": "CONCEPT",
  "front": "Basal vs top dressing",
  "back": "Basal: at planting, mainly P and K, near the seed. Top: on the growing crop, mainly N, often split.",
  "concepts": [
   "agri.soil.inorganic-fertilisers"
  ]
 },
 {
  "key": "soil.inorganic-fertilisers.c06",
  "cardType": "FORMULA",
  "front": "Fertiliser needed",
  "back": "kg = rate (kg/ha) × area (ha); bags = kg ÷ bag mass, rounded UP.",
  "concepts": [
   "agri.soil.inorganic-fertilisers"
  ]
 },
 {
  "key": "soil.inorganic-fertilisers.c07",
  "cardType": "FORMULA",
  "front": "Grams per station",
  "back": "g per station = rate (kg/ha) × 1000 ÷ stations per hectare.",
  "concepts": [
   "agri.soil.inorganic-fertilisers"
  ]
 },
 {
  "key": "soil.inorganic-fertilisers.c08",
  "cardType": "FORMULA",
  "front": "Product for a nutrient target",
  "back": "Product (kg) = nutrient needed (kg) ÷ (nutrient % ÷ 100).",
  "concepts": [
   "agri.soil.inorganic-fertilisers"
  ]
 },
 {
  "key": "soil.inorganic-fertilisers.c09",
  "cardType": "CONCEPT",
  "front": "Methods of application",
  "back": "Broadcasting, banding, placement, side dressing, foliar feeding, fertigation.",
  "concepts": [
   "agri.soil.inorganic-fertilisers"
  ]
 },
 {
  "key": "soil.inorganic-fertilisers.c10",
  "cardType": "FACT",
  "front": "Storing fertiliser",
  "back": "Dry, on pallets, away from seed, food and chemicals; ammonium nitrate away from fuels and flames.",
  "concepts": [
   "agri.soil.inorganic-fertilisers"
  ]
 }
]
