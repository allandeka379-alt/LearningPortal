[
 {
  "key": "accounts.financial-position.c01",
  "cardType": "DEFINITION",
  "front": "Statement of financial position",
  "back": "A statement listing a business's assets, liabilities and equity at a particular date (also called a balance sheet).",
  "concepts": [
   "abus.accounts.financial-position"
  ]
 },
 {
  "key": "accounts.financial-position.c02",
  "cardType": "FORMULA",
  "front": "Net current assets",
  "back": "Current assets − current liabilities (working capital).",
  "concepts": [
   "abus.accounts.financial-position"
  ]
 },
 {
  "key": "accounts.financial-position.c03",
  "cardType": "FORMULA",
  "front": "Net assets",
  "back": "Non-current assets + net current assets − non-current liabilities = equity.",
  "concepts": [
   "abus.accounts.financial-position"
  ]
 },
 {
  "key": "accounts.financial-position.c04",
  "cardType": "FORMULA",
  "front": "Capital employed",
  "back": "Issued shares + reserves + non-current liabilities.",
  "concepts": [
   "abus.accounts.financial-position"
  ]
 },
 {
  "key": "accounts.financial-position.c05",
  "cardType": "CONCEPT",
  "front": "Non-current and current items",
  "back": "Non-current: used or due after more than a year. Current: expected to be turned into cash, or due, within a year.",
  "concepts": [
   "abus.accounts.financial-position"
  ]
 },
 {
  "key": "accounts.financial-position.c06",
  "cardType": "CONCEPT",
  "front": "Retained profit and reserves",
  "back": "Closing reserves = opening reserves + profit for the year − dividends.",
  "concepts": [
   "abus.accounts.financial-position"
  ]
 },
 {
  "key": "accounts.financial-position.c07",
  "cardType": "CONCEPT",
  "front": "Depreciation and net book value",
  "back": "Net book value = cost − accumulated depreciation; the yearly charge is an expense.",
  "concepts": [
   "abus.accounts.financial-position"
  ]
 },
 {
  "key": "accounts.financial-position.c08",
  "cardType": "CONCEPT",
  "front": "Amending the statement",
  "back": "Record both sides of the change, recalculate subtotals and check that net assets still equal equity.",
  "concepts": [
   "abus.accounts.financial-position"
  ]
 },
 {
  "key": "accounts.financial-position.c09",
  "cardType": "CONCEPT",
  "front": "Limits of the statement",
  "back": "One date only, book values not market values, open to window dressing, no future cash flows.",
  "concepts": [
   "abus.accounts.financial-position"
  ]
 }
]
