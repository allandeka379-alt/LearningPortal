[
 {
  "key": "ratios.profitability.c01",
  "cardType": "DEFINITION",
  "front": "Profitability",
  "back": "The ability of a business to earn profit from its revenue and from the capital invested in it.",
  "concepts": [
   "abus.ratios.profitability"
  ]
 },
 {
  "key": "ratios.profitability.c02",
  "cardType": "FORMULA",
  "front": "Gross profit margin",
  "back": "Gross profit ÷ revenue × 100.",
  "concepts": [
   "abus.ratios.profitability"
  ]
 },
 {
  "key": "ratios.profitability.c03",
  "cardType": "FORMULA",
  "front": "Operating profit margin",
  "back": "Profit from operations ÷ revenue × 100.",
  "concepts": [
   "abus.ratios.profitability"
  ]
 },
 {
  "key": "ratios.profitability.c04",
  "cardType": "FORMULA",
  "front": "ROCE",
  "back": "Profit from operations ÷ capital employed × 100.",
  "concepts": [
   "abus.ratios.profitability"
  ]
 },
 {
  "key": "ratios.profitability.c05",
  "cardType": "FORMULA",
  "front": "Capital employed",
  "back": "Issued shares + reserves + non-current liabilities.",
  "concepts": [
   "abus.ratios.profitability"
  ]
 },
 {
  "key": "ratios.profitability.c06",
  "cardType": "FORMULA",
  "front": "Net profit margin",
  "back": "Profit for the year ÷ revenue (turnover) × 100.",
  "notes": "Some syllabi use the operating margin instead.",
  "concepts": [
   "abus.ratios.profitability"
  ],
  "applies": [
   "zimsec"
  ]
 },
 {
  "key": "ratios.profitability.c07",
  "cardType": "CONCEPT",
  "front": "Why a gross margin falls",
  "back": "Higher cost of sales, discounting, waste or theft, or a shift to low-margin products.",
  "concepts": [
   "abus.ratios.profitability"
  ]
 },
 {
  "key": "ratios.profitability.c08",
  "cardType": "CONCEPT",
  "front": "Why ROCE falls although profit rises",
  "back": "Capital employed rose faster than profit: new loans or shares have not yet earned a return.",
  "concepts": [
   "abus.ratios.profitability"
  ]
 },
 {
  "key": "ratios.profitability.c09",
  "cardType": "CONCEPT",
  "front": "Comparing ROCE with the interest rate",
  "back": "If ROCE is below the cost of borrowing, debt-financed expansion reduces the owners' return.",
  "concepts": [
   "abus.ratios.profitability"
  ]
 },
 {
  "key": "ratios.profitability.c10",
  "cardType": "FACT",
  "front": "Ways of improving profitability",
  "back": "Raise prices or the sales mix, cut cost of sales, cut expenses, or earn the same profit from less capital; each has a trade-off.",
  "concepts": [
   "abus.ratios.profitability"
  ]
 }
]
