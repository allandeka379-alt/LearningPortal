[
 {
  "key": "capacitance.energy-stored.c01",
  "cardType": "FORMULA",
  "front": "Energy stored in a capacitor",
  "back": "$W = \\tfrac{1}{2}QV = \\tfrac{1}{2}CV^2 = \\dfrac{Q^2}{2C}$",
  "concepts": [
   "aphys.capacitance.energy-stored"
  ]
 },
 {
  "key": "capacitance.energy-stored.c02",
  "cardType": "CONCEPT",
  "front": "Energy from a graph",
  "back": "Energy stored = area under the p.d.-charge graph (a triangle, ½QV).",
  "concepts": [
   "aphys.capacitance.energy-stored"
  ]
 },
 {
  "key": "capacitance.energy-stored.c03",
  "cardType": "CONCEPT",
  "front": "Why the factor ½",
  "back": "The p.d. rises linearly from 0 to V while charging, so the average p.d. is V/2.",
  "concepts": [
   "aphys.capacitance.energy-stored"
  ]
 },
 {
  "key": "capacitance.energy-stored.c04",
  "cardType": "CONCEPT",
  "front": "Energy and p.d.",
  "back": "W ∝ V²: doubling V quadruples the energy; halving V leaves a quarter.",
  "concepts": [
   "aphys.capacitance.energy-stored"
  ]
 },
 {
  "key": "capacitance.energy-stored.c05",
  "cardType": "FACT",
  "front": "Charging from a battery",
  "back": "Battery supplies QE; half is stored; half is dissipated in the circuit resistance, whatever its value.",
  "concepts": [
   "aphys.capacitance.energy-stored"
  ]
 },
 {
  "key": "capacitance.energy-stored.c06",
  "cardType": "CONCEPT",
  "front": "Charge sharing between capacitors",
  "back": "Charge is conserved but energy is lost (as heat and radiation in the connections).",
  "concepts": [
   "aphys.capacitance.energy-stored"
  ]
 },
 {
  "key": "capacitance.energy-stored.c07",
  "cardType": "CONCEPT",
  "front": "Camera flash principle",
  "back": "Battery charges the capacitor slowly; it discharges in ~1 ms, giving a very large power.",
  "concepts": [
   "aphys.capacitance.energy-stored"
  ]
 },
 {
