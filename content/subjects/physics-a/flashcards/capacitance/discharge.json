[
 {
  "key": "capacitance.discharge.c01",
  "cardType": "DEFINITION",
  "front": "**Time constant**",
  "back": "τ = RC: the time for the charge, p.d. or current of a discharging capacitor to fall to 1/e (37%) of its initial value.",
  "concepts": [
   "aphys.capacitance.discharge"
  ]
 },
 {
  "key": "capacitance.discharge.c02",
  "cardType": "FORMULA",
  "front": "Capacitor discharge",
  "back": "$x = x_0e^{-t/RC}$ for $Q$, $V$ or $I$",
  "concepts": [
   "aphys.capacitance.discharge"
  ]
 },
 {
  "key": "capacitance.discharge.c03",
  "cardType": "FORMULA",
  "front": "Time to halve",
  "back": "$t_{1/2} = RC\\ln 2 \\approx 0.693RC$",
  "concepts": [
   "aphys.capacitance.discharge"
  ]
 },
 {
  "key": "capacitance.discharge.c04",
  "cardType": "FORMULA",
  "front": "Straight-line form",
  "back": "$\\ln V = \\ln V_0 - \\dfrac{t}{RC}$: gradient $-1/RC$",
  "concepts": [
   "aphys.capacitance.discharge"
  ]
 },
 {
  "key": "capacitance.discharge.c05",
  "cardType": "CONCEPT",
  "front": "Why discharge is exponential",
  "back": "I = Q/RC, so the rate of loss of charge is proportional to the charge remaining.",
  "concepts": [
   "aphys.capacitance.discharge"
  ]
 },
 {
  "key": "capacitance.discharge.c06",
  "cardType": "CONCEPT",
  "front": "Discharge graphs",
  "back": "Q, V and I all start at their maxima and decay exponentially with the same RC; gradient of Q-t = −I; area under I-t = charge.",
  "concepts": [
   "aphys.capacitance.discharge"
  ]
 },
 {
  "key": "capacitance.discharge.c07",
  "cardType": "FACT",
  "front": "Fraction left after n time constants",
  "back": "e⁻¹ ≈ 37%, e⁻² ≈ 13.5%, e⁻⁵ < 1%.",
  "concepts": [
   "aphys.capacitance.discharge"
  ]
 },
 {
  "key": "capacitance.discharge.c08",
  "cardType": "CONCEPT",
  "front": "Charging through a resistor",
  "back": "Current decays as I₀e^(−t/RC); V and Q rise towards E and CE (63% after RC).",
  "concepts": [
   "aphys.capacitance.discharge"
  ]
 },
 {
  "key": "capacitance.discharge.c09",
  "cardType": "FORMULA",
  "front": "Charging p.d. (ZIMSEC detail)",
  "back": "$V = E\\left(1 - e^{-t/RC}\\right)$",
  "concepts": [
   "aphys.capacitance.discharge"
  ],
  "applies": [
   "zimsec"
  ]
 }
