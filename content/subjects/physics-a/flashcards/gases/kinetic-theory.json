[
 {
  "key": "gases.kinetic-theory.c01",
  "cardType": "CONCEPT",
  "front": "Kinetic theory assumptions",
  "back": "Random motion; negligible molecular volume; no forces except in collisions; elastic collisions; negligible collision time.",
  "concepts": [
   "aphys.gases.kinetic-theory"
  ]
 },
 {
  "key": "gases.kinetic-theory.c02",
  "cardType": "FORMULA",
  "front": "Kinetic theory equation",
  "back": "$pV = \\tfrac{1}{3}Nm\\langle c^2\\rangle$, or $p = \\tfrac{1}{3}\\rho\\langle c^2\\rangle$",
  "concepts": [
   "aphys.gases.kinetic-theory"
  ]
 },
 {
  "key": "gases.kinetic-theory.c03",
  "cardType": "DEFINITION",
  "front": "**Mean-square speed**",
  "back": "⟨c²⟩ = (c₁² + c₂² + … + c_N²)/N; r.m.s. speed = √⟨c²⟩.",
  "concepts": [
   "aphys.gases.kinetic-theory"
  ]
 },
 {
  "key": "gases.kinetic-theory.c04",
  "cardType": "FORMULA",
  "front": "Mean kinetic energy and temperature",
  "back": "$\\tfrac{1}{2}m\\langle c^2\\rangle = \\tfrac{3}{2}kT$",
  "concepts": [
   "aphys.gases.kinetic-theory"
  ]
 },
 {
  "key": "gases.kinetic-theory.c05",
  "cardType": "FORMULA",
  "front": "r.m.s. speed",
  "back": "$c_{\\text{r.m.s.}} = \\sqrt{\\dfrac{3kT}{m}} = \\sqrt{\\dfrac{3RT}{M}}$",
  "concepts": [
   "aphys.gases.kinetic-theory"
  ]
 },
 {
  "key": "gases.kinetic-theory.c06",
  "cardType": "CONCEPT",
  "front": "Origin of gas pressure",
  "back": "Molecules rebound from the walls: the rate of change of momentum per unit area is the pressure.",
  "concepts": [
   "aphys.gases.kinetic-theory"
  ]
 },
 {
  "key": "gases.kinetic-theory.c07",
  "cardType": "CONCEPT",
  "front": "Why ⟨cₓ²⟩ = ⅓⟨c²⟩",
  "back": "Random motion: no preferred direction, so the three components have equal mean squares.",
  "concepts": [
   "aphys.gases.kinetic-theory"
  ]
 },
 {
  "key": "gases.kinetic-theory.c08",
  "cardType": "CONCEPT",
  "front": "Different gases at one temperature",
  "back": "Same mean kinetic energy; c_rms ∝ 1/√m, so lighter molecules move faster.",
  "concepts": [
   "aphys.gases.kinetic-theory"
  ]
 },
 {
  "key": "gases.kinetic-theory.c09",
  "cardType": "FACT",
  "front": "Total kinetic energy of an ideal gas",
  "back": "$\\tfrac{3}{2}NkT = \\tfrac{3}{2}nRT = \\tfrac{3}{2}pV$",
  "concepts": [
   "aphys.gases.kinetic-theory"
  ]
 }
]
