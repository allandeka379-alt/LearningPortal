  "concepts": [
   "aphys.communication.digital-signals"
  ]
 },
 {
  "key": "communication.digital-signals.c04",
  "cardType": "FORMULA",
  "front": "Sampling rule",
  "back": "$f_{\\text{s}} \\geq 2f_{\\max}$",
  "concepts": [
   "aphys.communication.digital-signals"
  ]
 },
 {
  "key": "communication.digital-signals.c05",
  "cardType": "FORMULA",
  "front": "Levels and bit rate",
  "back": "$N = 2^{n}$ levels; bit rate $= f_{\\text{s}} \\times n$",
  "concepts": [
   "aphys.communication.digital-signals"
  ]
 },
 {
  "key": "communication.digital-signals.c06",
  "cardType": "CONCEPT",
  "front": "ADC steps",
  "back": "Sample at regular intervals → quantise to the nearest level → code as an n-bit binary number.",
  "concepts": [
   "aphys.communication.digital-signals"
  ]
 },
 {
  "key": "communication.digital-signals.c07",
  "cardType": "CONCEPT",
  "front": "DAC output",
  "back": "A staircase of voltages proportional to the codes, smoothed by a filter.",
  "concepts": [
   "aphys.communication.digital-signals"
  ]
 },
 {
  "key": "communication.digital-signals.c08",
  "cardType": "CONCEPT",
  "front": "Quantisation error",
  "back": "Up to half a step; reduced by using more bits.",
  "concepts": [
   "aphys.communication.digital-signals"
  ]
 },
 {
  "key": "communication.digital-signals.c09",
  "cardType": "CONCEPT",
  "front": "Parallel-to-serial conversion",
