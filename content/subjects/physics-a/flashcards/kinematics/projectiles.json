[
 {
  "key": "kinematics.projectiles.c01",
  "cardType": "DEFINITION",
  "front": "Projectile",
  "back": "An object moving under gravity alone after launch: acceleration g downwards, no horizontal acceleration (no air resistance).",
  "concepts": [
   "aphys.kinematics.projectiles"
  ]
 },
 {
  "key": "kinematics.projectiles.c02",
  "cardType": "CONCEPT",
  "front": "Independence of horizontal and vertical motion",
  "back": "Horizontal: constant velocity. Vertical: uniform acceleration g. They are linked only by the time.",
  "concepts": [
   "aphys.kinematics.projectiles"
  ]
 },
 {
  "key": "kinematics.projectiles.c03",
  "cardType": "FORMULA",
  "front": "Components of the launch velocity",
  "back": "$u_x = u\\cos\\theta$, $u_y = u\\sin\\theta$",
  "concepts": [
   "aphys.kinematics.projectiles"
  ]
 },
 {
  "key": "kinematics.projectiles.c04",
  "cardType": "FORMULA",
  "front": "Time of flight on level ground",
  "back": "$T = \\dfrac{2u\\sin\\theta}{g}$",
  "concepts": [
   "aphys.kinematics.projectiles"
  ]
 },
 {
  "key": "kinematics.projectiles.c05",
  "cardType": "FORMULA",
  "front": "Maximum height of a projectile",
  "back": "$H = \\dfrac{(u\\sin\\theta)^2}{2g}$",
  "concepts": [
   "aphys.kinematics.projectiles"
  ]
 },
 {
  "key": "kinematics.projectiles.c06",
  "cardType": "FORMULA",
  "front": "Range on level ground",
  "back": "$R = u\\cos\\theta \\times \\dfrac{2u\\sin\\theta}{g} = \\dfrac{u^2\\sin 2\\theta}{g}$; greatest at $45^\\circ$.",
  "concepts": [
   "aphys.kinematics.projectiles"
  ]
 },
 {
  "key": "kinematics.projectiles.c07",
  "cardType": "FACT",
  "front": "Velocity at the top of the path",
  "back": "Horizontal, equal to $u\\cos\\theta$: not zero.",
  "concepts": [
   "aphys.kinematics.projectiles"
  ]
 },
 {
  "key": "kinematics.projectiles.c08",
  "cardType": "FORMULA",
  "front": "Fall time for a horizontal launch from height h",
  "back": "$t = \\sqrt{2h/g}$, independent of the launch speed.",
  "concepts": [
   "aphys.kinematics.projectiles"
  ]
 },
 {
  "key": "kinematics.projectiles.c09",
  "cardType": "CONCEPT",
  "front": "Effect of air resistance on a projectile",
  "back": "Shorter range, lower and earlier peak, steeper descent than ascent.",
  "concepts": [
   "aphys.kinematics.projectiles"
  ]
 }
]
