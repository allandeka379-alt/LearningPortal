[
 {
  "key": "gravitation.potential.c01",
  "cardType": "DEFINITION",
  "front": "**Gravitational potential**",
  "back": "The work done per unit mass in bringing a small test mass from infinity to the point.",
  "concepts": [
   "aphys.gravitation.potential"
  ]
 },
 {
  "key": "gravitation.potential.c02",
  "cardType": "FORMULA",
  "front": "Potential of a point mass",
  "back": "$\\phi = -\\dfrac{GM}{r}$, unit $\\text{J kg}^{-1}$, zero at infinity",
  "concepts": [
   "aphys.gravitation.potential"
  ]
 },
 {
  "key": "gravitation.potential.c03",
  "cardType": "FORMULA",
  "front": "Potential energy of two masses",
  "back": "$E_P = -\\dfrac{GMm}{r}$",
  "concepts": [
   "aphys.gravitation.potential"
  ]
 },
 {
  "key": "gravitation.potential.c04",
  "cardType": "CONCEPT",
  "front": "Why potential is negative",
  "back": "Zero at infinity; gravity attracts, so work is done by the field as a mass comes in: φ < 0 at every finite distance.",
  "concepts": [
   "aphys.gravitation.potential"
  ]
 },
 {
  "key": "gravitation.potential.c05",
  "cardType": "FORMULA",
  "front": "Energy to move between radii",
  "back": "$\\Delta E_P = GMm\\left(\\dfrac{1}{r_1} - \\dfrac{1}{r_2}\\right)$ (outwards: positive)",
  "concepts": [
   "aphys.gravitation.potential"
  ]
 },
 {
  "key": "gravitation.potential.c06",
  "cardType": "FORMULA",
  "front": "Escape speed",
  "back": "$\\tfrac{1}{2}mv^2 = \\dfrac{GMm}{R} \\Rightarrow v = \\sqrt{\\dfrac{2GM}{R}}$",
  "concepts": [
   "aphys.gravitation.potential"
  ]
 },
 {
  "key": "gravitation.potential.c07",
  "cardType": "CONCEPT",
  "front": "Field and potential gradient",
  "back": "$g = -\\Delta\\phi/\\Delta r$: the gradient of the $\\phi$-$r$ graph gives $g$",
  "concepts": [
   "aphys.gravitation.potential"
  ]
 },
 {
  "key": "gravitation.potential.c08",
  "cardType": "CONCEPT",
  "front": "φ versus g with distance",
  "back": "Doubling r halves φ (1/r) but quarters g (1/r²).",
  "concepts": [
   "aphys.gravitation.potential"
  ]
 },
 {
  "key": "gravitation.potential.c09",
  "cardType": "FACT",
  "front": "Earth's escape speed",
  "back": "About $11.2\\ \\text{km s}^{-1}$, independent of the escaping mass",
  "concepts": [
   "aphys.gravitation.potential"
  ]
 }
