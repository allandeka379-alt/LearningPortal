  "cardType": "DEFINITION",
  "front": "**Gravitational field strength**",
  "back": "The gravitational force per unit mass on a small test mass placed at the point (a vector, towards the attracting mass).",
  "concepts": [
   "aphys.gravitation.field-strength"
  ]
 },
 {
  "key": "gravitation.field-strength.c03",
