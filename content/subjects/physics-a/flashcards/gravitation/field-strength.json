  "concepts": [
   "aphys.gravitation.field-strength"
  ]
 },
 {
  "key": "gravitation.field-strength.c04",
  "cardType": "FORMULA",
  "front": "Field of a point mass or uniform sphere",
  "back": "$g = \\dfrac{GM}{r^2}$, $r$ from the centre",
  "concepts": [
   "aphys.gravitation.field-strength"
  ]
 },
 {
  "key": "gravitation.field-strength.c05",
  "cardType": "FACT",
  "front": "Gravitational constant",
  "back": "$G = 6.67 \\times 10^{-11}\\ \\text{N m}^2\\,\\text{kg}^{-2}$",
  "concepts": [
   "aphys.gravitation.field-strength"
  ]
 },
 {
  "key": "gravitation.field-strength.c06",
  "cardType": "CONCEPT",
  "front": "Inverse-square law",
  "back": "Doubling the distance from the centre divides g by four; g against 1/r² is a straight line through the origin.",
  "concepts": [
   "aphys.gravitation.field-strength"
  ]
 },
 {
  "key": "gravitation.field-strength.c07",
  "cardType": "CONCEPT",
  "front": "Radial and uniform fields",
  "back": "Radial: lines converge on the centre of the mass. Near the surface: parallel, equally spaced lines (uniform field).",
  "concepts": [
   "aphys.gravitation.field-strength"
  ]
 },
 {
  "key": "gravitation.field-strength.c08",
  "cardType": "CONCEPT",
  "front": "Why g is constant near the surface",
  "back": "Height changes of metres or kilometres are tiny compared with the Earth's radius (6400 km), so r and g hardly change.",
  "concepts": [
   "aphys.gravitation.field-strength"
  ]
 },
