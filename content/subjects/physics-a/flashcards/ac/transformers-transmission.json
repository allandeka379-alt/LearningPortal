[
 {
  "key": "ac.transformers-transmission.c01",
  "cardType": "DEFINITION",
  "front": "**Transformer**",
  "back": "Primary and secondary coils on a common laminated soft-iron core, used to change an alternating voltage.",
  "concepts": [
   "aphys.ac.transformers-transmission"
  ]
 },
 {
  "key": "ac.transformers-transmission.c02",
  "cardType": "FORMULA",
  "front": "Ideal transformer",
  "back": "$\\dfrac{V_s}{V_p} = \\dfrac{N_s}{N_p} = \\dfrac{I_p}{I_s}$",
  "concepts": [
   "aphys.ac.transformers-transmission"
  ]
 },
 {
  "key": "ac.transformers-transmission.c03",
  "cardType": "CONCEPT",
  "front": "How a transformer works",
  "back": "Alternating primary current → alternating flux in core → changing flux linkage in secondary → induced e.m.f.",
  "concepts": [
   "aphys.ac.transformers-transmission"
  ]
 },
 {
  "key": "ac.transformers-transmission.c04",
  "cardType": "CONCEPT",
  "front": "Why not d.c.?",
  "back": "Steady current → constant flux → no change of flux linkage → no induced e.m.f.",
  "concepts": [
   "aphys.ac.transformers-transmission"
  ]
 },
 {
  "key": "ac.transformers-transmission.c05",
  "cardType": "CONCEPT",
  "front": "Transformer losses",
  "back": "Winding resistance (thick wire), eddy currents (laminations), hysteresis (soft iron), flux leakage (closed core, coils wound together).",
  "concepts": [
   "aphys.ac.transformers-transmission"
  ]
 },
 {
  "key": "ac.transformers-transmission.c06",
  "cardType": "FORMULA",
  "front": "Efficiency",
  "back": "$\\eta = \\dfrac{V_sI_s}{V_pI_p} \\times 100\\%$",
  "concepts": [
   "aphys.ac.transformers-transmission"
  ]
 },
 {
  "key": "ac.transformers-transmission.c07",
  "cardType": "FORMULA",
  "front": "Cable loss",
  "back": "$P_{\\text{loss}} = I^2R = \\left(\\dfrac{P}{V}\\right)^2R$",
  "concepts": [
   "aphys.ac.transformers-transmission"
  ]
 },
 {
  "key": "ac.transformers-transmission.c08",
  "cardType": "CONCEPT",
  "front": "Why high-voltage transmission",
  "back": "Same power at higher V needs smaller I; loss I²R falls as I², so far less energy is wasted.",
  "concepts": [
   "aphys.ac.transformers-transmission"
  ]
 },
 {
  "key": "ac.transformers-transmission.c09",
  "cardType": "CONCEPT",
  "front": "The grid",
  "back": "Generator → step-up transformer → high-voltage lines → substations step down → distribution → 230 V to homes.",
  "concepts": [
   "aphys.ac.transformers-transmission"
  ]
 }
]
