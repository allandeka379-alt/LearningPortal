[
 {
  "key": "induction.flux-faraday.c01",
  "cardType": "DEFINITION",
  "front": "**Magnetic flux**",
  "back": "The product of an area and the component of the magnetic flux density perpendicular to it: Φ = BA cos θ.",
  "concepts": [
   "aphys.induction.flux-faraday"
  ]
 },
 {
  "key": "induction.flux-faraday.c02",
  "cardType": "DEFINITION",
  "front": "**Weber**",
  "back": "The flux through 1 m² at right angles to a uniform field of 1 T (1 Wb = 1 T m² = 1 V s).",
  "concepts": [
   "aphys.induction.flux-faraday"
  ]
 },
 {
  "key": "induction.flux-faraday.c03",
  "cardType": "DEFINITION",
  "front": "**Flux linkage**",
  "back": "The flux through a coil multiplied by its number of turns, NΦ.",
  "concepts": [
   "aphys.induction.flux-faraday"
  ]
 },
 {
  "key": "induction.flux-faraday.c04",
  "cardType": "DEFINITION",
  "front": "**Faraday's law**",
  "back": "The induced e.m.f. equals the rate of change of magnetic flux linkage.",
  "concepts": [
   "aphys.induction.flux-faraday"
  ]
 },
 {
  "key": "induction.flux-faraday.c05",
  "cardType": "FORMULA",
  "front": "Faraday's law",
  "back": "$E = \\dfrac{\\Delta(N\\Phi)}{\\Delta t}$",
  "concepts": [
   "aphys.induction.flux-faraday"
  ]
 },
 {
  "key": "induction.flux-faraday.c06",
  "cardType": "FORMULA",
  "front": "Moving rod",
  "back": "$E = BLv$",
  "concepts": [
   "aphys.induction.flux-faraday"
  ]
 },
 {
  "key": "induction.flux-faraday.c07",
  "cardType": "CONCEPT",
  "front": "Ways to change flux linkage",
  "back": "Change B (move a magnet, switch a current), change the area (moving rod), or change the angle (rotating coil).",
  "concepts": [
   "aphys.induction.flux-faraday"
  ]
 },
 {
  "key": "induction.flux-faraday.c08",
  "cardType": "CONCEPT",
  "front": "Graphs",
  "back": "E = gradient of the NΦ–t graph; area under the E–t graph = change in NΦ.",
  "concepts": [
   "aphys.induction.flux-faraday"
  ]
 },
 {
  "key": "induction.flux-faraday.c09",
