  "concepts": [
   "bus.finance.trading-calculations"
  ]
 },
 {
  "key": "finance.trading-calculations.c04",
  "cardType": "FORMULA",
  "front": "Rate of stock turnover",
  "back": "Cost of goods sold ÷ average stock (answer in times).",
  "concepts": [
   "bus.finance.trading-calculations"
  ]
 },
 {
  "key": "finance.trading-calculations.c05",
  "cardType": "FORMULA",
  "front": "Mark-up",
  "back": "Gross profit ÷ cost of goods sold × 100.",
  "concepts": [
   "bus.finance.trading-calculations"
  ]
 },
 {
  "key": "finance.trading-calculations.c06",
  "cardType": "FORMULA",
  "front": "Margin",
  "back": "Gross profit ÷ turnover (selling price) × 100.",
  "concepts": [
   "bus.finance.trading-calculations"
  ]
 },
 {
  "key": "finance.trading-calculations.c07",
  "cardType": "FORMULA",
  "front": "Converting mark-up and margin",
  "back": "Margin = mark-up ÷ (100 + mark-up) × 100; mark-up = margin ÷ (100 − margin) × 100.",
  "concepts": [
   "bus.finance.trading-calculations"
  ]
 },
 {
  "key": "finance.trading-calculations.c08",
  "cardType": "CONCEPT",
  "front": "Interpreting stock turnover",
  "back": "Higher rate: stock sells faster, less cash tied up, fresher goods. Improve by promotion, clearance sales, smaller frequent orders.",
  "concepts": [
   "bus.finance.trading-calculations"
  ]
 },
 {
  "key": "finance.trading-calculations.c09",
  "cardType": "FACT",
  "front": "Mark-up v margin",
  "back": "Same gross profit; margin divides by the larger selling price, so the margin is always smaller.",
  "concepts": [
   "bus.finance.trading-calculations"
  ]
 }
