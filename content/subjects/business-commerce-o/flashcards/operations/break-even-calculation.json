[
 {
  "key": "operations.break-even-calculation.c01",
  "cardType": "DEFINITION",
  "front": "Break-even",
  "back": "The output at which total revenue equals total costs: no profit, no loss.",
  "concepts": [
   "bus.operations.break-even-calculation"
  ]
 },
 {
  "key": "operations.break-even-calculation.c02",
  "cardType": "FORMULA",
  "front": "Contribution per unit",
  "back": "Selling price − variable cost per unit.",
  "concepts": [
   "bus.operations.break-even-calculation"
  ]
 },
 {
  "key": "operations.break-even-calculation.c03",
  "cardType": "FORMULA",
  "front": "Break-even output",
  "back": "Fixed costs ÷ contribution per unit (round up to a whole unit).",
  "concepts": [
   "bus.operations.break-even-calculation"
  ]
 },
 {
  "key": "operations.break-even-calculation.c04",
  "cardType": "FORMULA",
  "front": "Break-even revenue",
  "back": "Break-even output × selling price.",
  "concepts": [
   "bus.operations.break-even-calculation"
  ]
 },
 {
  "key": "operations.break-even-calculation.c05",
  "cardType": "FORMULA",
  "front": "Margin of safety",
  "back": "Actual sales − break-even sales (units).",
  "concepts": [
   "bus.operations.break-even-calculation"
  ]
 },
 {
  "key": "operations.break-even-calculation.c06",
  "cardType": "FORMULA",
  "front": "Profit from contribution",
  "back": "Contribution per unit × units sold − fixed costs.",
  "concepts": [
   "bus.operations.break-even-calculation"
  ]
 },
 {
  "key": "operations.break-even-calculation.c07",
  "cardType": "CONCEPT",
  "front": "Effects of changes",
  "back": "Price up or variable cost down → break-even falls. Fixed costs up or variable cost up or price down → break-even rises.",
  "concepts": [
   "bus.operations.break-even-calculation"
  ]
 },
 {
  "key": "operations.break-even-calculation.c08",
  "cardType": "CONCEPT",
  "front": "Why break-even matters",
  "back": "Tests whether a business idea is realistic, guides pricing, compares options, supports loan applications.",
  "concepts": [
   "bus.operations.break-even-calculation"
  ]
 }
