  ]
 },
 {
  "key": "waves.properties.c02",
  "cardType": "DEFINITION",
  "front": "What is the **wavelength** λ?",
  "back": "The distance between two neighbouring crests (or troughs).",
  "concepts": [
   "phys.waves.wave-properties"
  ]
 },
 {
  "key": "waves.properties.c03",
  "cardType": "DEFINITION",
  "front": "What is **frequency**?",
  "back": "The number of waves passing a point each second; unit hertz (Hz).",
  "concepts": [
   "phys.waves.wave-properties"
  ]
 },
 {
  "key": "waves.properties.c04",
  "cardType": "DEFINITION",
  "front": "What is **amplitude**?",
  "back": "The maximum displacement of a point on the wave from its rest position.",
  "concepts": [
   "phys.waves.wave-properties"
  ]
 },
 {
