[
 {
  "key": "machines.simple.c01",
  "cardType": "FORMULA",
  "front": "Mechanical advantage?",
  "back": "MA = load ÷ effort (no unit).",
  "concepts": [
   "phys.machines.simple-machines"
  ],
  "applies": [
   "zimsec"
  ]
 },
 {
  "key": "machines.simple.c02",
  "cardType": "FORMULA",
  "front": "Velocity ratio?",
  "back": "VR = distance moved by effort ÷ distance moved by load.",
  "concepts": [
   "phys.machines.simple-machines"
  ],
  "applies": [
   "zimsec"
  ]
 },
 {
  "key": "machines.simple.c03",
  "cardType": "FORMULA",
  "front": "Efficiency of a machine?",
  "back": "Efficiency = MA ÷ VR × 100% = useful work out ÷ work in × 100%.",
  "concepts": [
   "phys.machines.simple-machines"
  ],
  "applies": [
   "zimsec"
  ]
 },
 {
  "key": "machines.simple.c04",
  "cardType": "FACT",
  "front": "VR of a single-string pulley system?",
  "back": "The number of strands supporting the moving (lower) block.",
  "concepts": [
   "phys.machines.simple-machines"
  ],
  "applies": [
   "zimsec"
  ]
 },
 {
  "key": "machines.simple.c05",
  "cardType": "FORMULA",
  "front": "VR of an inclined plane?",
  "back": "Length of the slope ÷ vertical height.",
  "concepts": [
   "phys.machines.simple-machines"
  ],
  "applies": [
   "zimsec"
  ]
 },
 {
  "key": "machines.simple.c06",
  "cardType": "CONCEPT",
  "front": "Why is no machine 100% efficient?",
  "back": "Work is wasted against friction and in lifting the machine's own moving parts.",
  "concepts": [
   "phys.machines.simple-machines"
  ],
  "applies": [
   "zimsec"
  ]
 },
 {
  "key": "machines.simple.c07",
  "cardType": "FACT",
  "front": "How can the efficiency of a machine be improved?",
  "back": "Lubrication, ball bearings, lighter moving parts, smooth surfaces.",
  "concepts": [
   "phys.machines.simple-machines"
  ],
  "applies": [
   "zimsec"
  ]
 },
 {
  "key": "machines.simple.c08",
  "cardType": "CONCEPT",
  "front": "Do machines save work?",
  "back": "No: they reduce the force needed, but the effort moves further.",
