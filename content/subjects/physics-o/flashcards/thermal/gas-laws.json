 {
  "key": "thermal.gas.c05",
  "cardType": "FORMULA",
  "front": "Boyle's law?",
  "back": "pV = constant (fixed mass, constant temperature): p₁V₁ = p₂V₂.",
  "concepts": [
   "phys.thermal.gas-laws"
  ]
 },
 {
  "key": "thermal.gas.c06",
  "cardType": "FORMULA",
  "front": "Charles's law?",
  "back": "V/T = constant at constant pressure (T in kelvin).",
  "concepts": [
   "phys.thermal.gas-laws"
  ],
  "applies": [
   "zimsec"
  ]
 },
 {
  "key": "thermal.gas.c07",
