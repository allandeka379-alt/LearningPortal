[
 {
  "key": "measurement.units.c01",
  "cardType": "FACT",
  "front": "Name five SI base units.",
  "back": "Kilogram (mass), metre (length), second (time), ampere (current), kelvin (temperature).",
  "notes": "The mole is also a base unit.",
  "concepts": [
   "phys.measurement.si-units"
  ]
 },
 {
  "key": "measurement.units.c02",
  "cardType": "FACT",
  "front": "What do the prefixes **kilo**, **mega** and **giga** mean?",
  "back": "kilo × 10³, mega × 10⁶, giga × 10⁹.",
  "concepts": [
   "phys.measurement.si-units"
  ]
 },
 {
  "key": "measurement.units.c03",
  "cardType": "FACT",
  "front": "What do the prefixes **milli**, **micro** and **nano** mean?",
  "back": "milli × 10⁻³, micro × 10⁻⁶, nano × 10⁻⁹.",
  "concepts": [
   "phys.measurement.si-units"
  ]
 },
 {
  "key": "measurement.units.c04",
  "cardType": "FORMULA",
  "front": "What is 1 newton in base units?",
  "back": "1 N = 1 kg m/s².",
  "concepts": [
   "phys.measurement.si-units"
  ]
 },
 {
  "key": "measurement.units.c05",
  "cardType": "FORMULA",
  "front": "What is 1 joule in other units?",
  "back": "1 J = 1 N m = 1 kg m²/s².",
  "concepts": [
   "phys.measurement.si-units"
  ]
 },
 {
  "key": "measurement.units.c06",
  "cardType": "FORMULA",
  "front": "What is 1 watt? What is 1 pascal?",
  "back": "1 W = 1 J/s; 1 Pa = 1 N/m².",
  "concepts": [
   "phys.measurement.si-units"
  ]
 },
 {
  "key": "measurement.units.c07",
  "cardType": "FACT",
  "front": "How many cm² are in 1 m²? How many cm³ in 1 m³?",
  "back": "1 m² = 10 000 cm²; 1 m³ = 1 000 000 cm³.",
  "concepts": [
   "phys.measurement.si-units"
  ]
 },
 {
  "key": "measurement.units.c08",
  "cardType": "CONCEPT",
  "front": "What is standard form?",
  "back": "A number written as A × 10ⁿ with 1 ≤ A < 10, e.g. 3.0 × 10⁸.",
  "concepts": [
   "phys.measurement.si-units"
  ]
 },
 {
  "key": "measurement.units.c09",
  "cardType": "CONCEPT",
  "front": "What does it mean for an equation to be homogeneous?",
  "back": "Both sides have the same units; if they do not, the equation is wrong.",
  "concepts": [
   "phys.measurement.si-units"
  ]
 },
 {
  "key": "measurement.units.c10",
  "cardType": "CONCEPT",
  "front": "How do you convert km/h to m/s?",
  "back": "Divide by 3.6 (and multiply by 3.6 to go back).",
  "concepts": [
   "phys.measurement.si-units"
  ]
 }
]
