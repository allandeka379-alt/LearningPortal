  "back": "$I_p V_p = I_s V_s$",
  "concepts": [
   "phys.em.transformers"
  ]
 },
 {
  "key": "em.transformers.c05",
  "cardType": "DEFINITION",
  "front": "**Step-up** vs **step-down**?",
  "back": "Step-up: more secondary turns, higher output voltage. Step-down: fewer secondary turns, lower output voltage.",
  "concepts": [
   "phys.em.transformers"
  ]
 },
 {
