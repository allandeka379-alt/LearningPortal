  "difficulty": 3,
  "marks": 1,
  "estimatedSeconds": 75,
  "stem": "A shelf bracket is held to a wall plank by nails. Which arrangement is likely to be strongest?",
  "options": [
   {
    "key": "A",
    "content": "One nail in the centre",
    "rationale": "Fewer pins carry less load."
   },
   {
    "key": "B",
    "content": "Three nails close together near one edge",
    "rationale": "Bunched pins near an edge can split the wood and resist turning poorly."
   },
   {
    "key": "C",
    "content": "Two nails very close to each other",
    "rationale": "They act almost like one pin."
   },
   {
    "key": "D",
    "content": "Three nails spread out across the bracket",
    "correct": true,
    "rationale": "Correct: more pins, well spaced, share the load and resist turning."
   }
  ],
  "explanation": "The strength of a pinned joint rises with the number of pins and their sensible spacing.",
  "hints": [
   "Think about the number and position of the pins."
  ],
