  "estimatedSeconds": 75,
  "stem": "Two pieces of wood are glued together. Which change would make the joint stronger?",
  "options": [
   {
    "key": "A",
    "content": "Using a thicker layer of glue on a small area",
    "rationale": "Contact area matters, not glue thickness."
   },
   {
    "key": "B",
    "content": "Making the surfaces badly fitting so glue fills the gaps",
    "rationale": "Gaps weaken the joint."
   },
   {
    "key": "C",
    "content": "Using less glue so that the joint dries harder and faster",
    "rationale": "Too little glue weakens the joint."
   },
   {
    "key": "D",
    "content": "Increasing the glued area, e.g. with a tongue-and-groove joint",
    "correct": true,
    "rationale": "Correct."
   }
  ],
  "explanation": "A glued joint's strength depends mainly on the area of good contact between the surfaces.",
