 {
  "key": "quadratics.completing-square-discriminant.q16",
  "type": "EXTENDED_RESPONSE",
  "concepts": [
   "amaths.quadratics.completing-square-discriminant"
  ],
  "difficulty": 4,
  "marks": 3,
  "estimatedSeconds": 270,
  "stem": "Show that the equation $kx^{2} + (k + 2)x + 1 = 0$, where $k$ is a non-zero constant, has two distinct real roots for every value of $k$.",
  "answerSpec": {
   "markScheme": {
    "points": [
     {
      "id": "p1",
      "description": "M1 writes the discriminant $(k + 2)^{2} - 4k$",
      "marks": 1
     },
     {
      "id": "p2",
      "description": "A1 simplifies to $k^{2} + 4$",
      "marks": 1
     },
     {
      "id": "p3",
      "description": "A1 argues $k^{2} \\geq 0$ so $k^{2} + 4 \\geq 4 > 0$, hence two distinct real roots",
      "marks": 1
     }
    ]
   },
   "modelAnswer": "$$\nb^{2} - 4ac = (k + 2)^{2} - 4(k)(1) = k^{2} + 4k + 4 - 4k = k^{2} + 4\n$$\nSince $k^{2} \\geq 0$ for all real $k$, $k^{2} + 4 \\geq 4 > 0$. The discriminant is always positive, so the equation has two distinct real roots for every non-zero $k$ (for $k = 0$ it is not a quadratic)."
  },
  "markingMode": "MANUAL",
  "explanation": "The $4k$ terms cancel, leaving $k^{2} + 4$, which is always positive.",
  "hints": [
   "Write down b² − 4ac in terms of k and simplify."
  ],
  "skill": "ANALYSIS",
  "calculator": false
 },
