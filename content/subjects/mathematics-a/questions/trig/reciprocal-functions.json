 {
  "key": "trig.reciprocal-functions.q09",
  "type": "EXTENDED_RESPONSE",
  "concepts": [
   "amaths.trig.reciprocal-functions"
  ],
  "difficulty": 3,
  "marks": 3,
  "estimatedSeconds": 270,
  "stem": "Prove that $\\operatorname{cosec}\\theta - \\sin\\theta \\equiv \\cot\\theta\\cos\\theta$.",
  "answerSpec": {
   "markScheme": {
    "points": [
     {
      "id": "p1",
      "description": "M1 writes $\\operatorname{cosec}\\theta = \\frac{1}{\\sin\\theta}$ and combines: $\\frac{1 - \\sin^2\\theta}{\\sin\\theta}$.",
      "marks": 1
     },
     {
      "id": "p2",
      "description": "M1 uses $1 - \\sin^2\\theta = \\cos^2\\theta$.",
      "marks": 1
     },
     {
      "id": "p3",
      "description": "A1 splits $\\frac{\\cos^2\\theta}{\\sin\\theta} = \\frac{\\cos\\theta}{\\sin\\theta}\\cos\\theta = \\cot\\theta\\cos\\theta$.",
      "marks": 1
     }
    ]
   },
   "modelAnswer": "$$\n\\operatorname{cosec}\\theta - \\sin\\theta = \\frac{1}{\\sin\\theta} - \\sin\\theta = \\frac{1 - \\sin^2\\theta}{\\sin\\theta}\n$$\n\n$$\n= \\frac{\\cos^2\\theta}{\\sin\\theta} = \\frac{\\cos\\theta}{\\sin\\theta} \\cdot \\cos\\theta = \\cot\\theta\\cos\\theta\n$$"
  },
  "markingMode": "MANUAL",
  "explanation": "Write in sin and cos, combine, then use the Pythagorean identity.",
  "hints": [
   "Put both terms over the denominator sin θ."
  ],
  "skill": "APPLICATION",
  "calculator": false
 },
 {
  "key": "trig.reciprocal-functions.q10",
  "type": "EXTENDED_RESPONSE",
  "concepts": [
   "amaths.trig.reciprocal-functions"
  ],
  "difficulty": 4,
  "marks": 4,
  "estimatedSeconds": 360,
  "stem": "Prove that $\\dfrac{1}{\\operatorname{cosec}\\theta - \\cot\\theta} - \\dfrac{1}{\\operatorname{cosec}\\theta + \\cot\\theta} \\equiv 2\\cot\\theta$.",
  "answerSpec": {
   "markScheme": {
    "points": [
     {
      "id": "p1",
      "description": "M1 combines over the common denominator $(\\operatorname{cosec}\\theta - \\cot\\theta)(\\operatorname{cosec}\\theta + \\cot\\theta)$.",
      "marks": 1
     },
     {
      "id": "p2",
      "description": "A1 numerator $= 2\\cot\\theta$.",
      "marks": 1
     },
     {
      "id": "p3",
      "description": "M1 denominator $= \\operatorname{cosec}^2\\theta - \\cot^2\\theta$.",
      "marks": 1
     },
     {
      "id": "p4",
      "description": "A1 uses $\\operatorname{cosec}^2\\theta - \\cot^2\\theta = 1$ to obtain $2\\cot\\theta$.",
      "marks": 1
     }
    ]
   },
   "modelAnswer": "$$\n\\text{LHS} = \\frac{(\\operatorname{cosec}\\theta + \\cot\\theta) - (\\operatorname{cosec}\\theta - \\cot\\theta)}{(\\operatorname{cosec}\\theta - \\cot\\theta)(\\operatorname{cosec}\\theta + \\cot\\theta)} = \\frac{2\\cot\\theta}{\\operatorname{cosec}^2\\theta - \\cot^2\\theta}\n$$\n\nSince $\\operatorname{cosec}^2\\theta = 1 + \\cot^2\\theta$, the denominator is $1$:\n\n$$\n\\text{LHS} = 2\\cot\\theta = \\text{RHS}\n$$"
  },
  "markingMode": "MANUAL",
  "explanation": "The denominator is a difference of two squares that the identity cosec² − cot² = 1 reduces to 1.",
  "hints": [
   "Combine the fractions; the denominator is a difference of two squares."
  ],
  "skill": "ANALYSIS",
  "calculator": false
 },
