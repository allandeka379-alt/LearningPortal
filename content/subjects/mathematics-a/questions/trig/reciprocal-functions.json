  ],
  "difficulty": 3,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "Given that $\\tan\\theta = \\frac{3}{4}$ and $180^\\circ < \\theta < 270^\\circ$, what is the exact value of $\\operatorname{cosec}\\theta$?",
  "options": [
   {
    "key": "A",
    "content": "$\\frac{5}{3}$",
    "rationale": "The size is right, but sine (and cosecant) is negative in the third quadrant."
   },
   {
    "key": "B",
    "content": "$-\\frac{5}{4}$",
    "rationale": "This is $\\sec\\theta = \\frac{1}{\\cos\\theta}$ with $\\cos\\theta = -\\frac{4}{5}$."
   },
   {
    "key": "C",
    "content": "$-\\frac{5}{3}$",
    "correct": true,
    "rationale": "Correct: in the third quadrant $\\sin\\theta = -\\frac{3}{5}$, so $\\operatorname{cosec}\\theta = -\\frac{5}{3}$."
   },
   {
    "key": "D",
    "content": "$-\\frac{3}{5}$",
    "rationale": "This is $\\sin\\theta$, not its reciprocal."
   }
