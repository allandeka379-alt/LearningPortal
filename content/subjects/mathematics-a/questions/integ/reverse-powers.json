 {
  "key": "integ.reverse-powers.q11",
  "type": "MULTIPLE_CHOICE",
  "concepts": [
   "amaths.integ.reverse-powers"
  ],
  "difficulty": 2,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "Why does $\\displaystyle\\int 2x\\,dx$ include an arbitrary constant $c$?",
  "options": [
   {
    "key": "A",
    "content": "Because the area under y = 2x always includes an extra constant region",
    "rationale": "An indefinite integral is a family of functions, not an area."
   },
   {
    "key": "B",
    "content": "Because every function x² + c has derivative 2x, so the integral is not unique",
    "correct": true,
    "rationale": "Correct: constants vanish on differentiation, so integration cannot recover them."
   },
   {
    "key": "C",
    "content": "Because 2x is not defined at x = 0",
    "rationale": "2x is defined everywhere; the constant has nothing to do with this."
   },
   {
    "key": "D",
    "content": "Because integration rounds the answer, and c is the rounding error",
    "rationale": "Integration is exact; c represents every possible constant."
   }
  ],
  "explanation": "$\\frac{d}{dx}(x^{2} + c) = 2x$ for every constant $c$, so $\\int 2x\\,dx = x^{2} + c$ describes the whole family of curves.",
