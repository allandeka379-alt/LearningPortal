  "difficulty": 1,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "Which is the correct form of the partial fractions for $\\dfrac{x + 5}{(x - 2)(x + 1)^{2}}$?",
  "options": [
   {
    "key": "A",
    "content": "$\\dfrac{A}{x - 2} + \\dfrac{B}{x + 1} + \\dfrac{C}{(x + 1)^{2}}$",
    "correct": true,
    "rationale": "Correct: a repeated linear factor needs a term for each power."
   },
   {
    "key": "B",
    "content": "$\\dfrac{A}{x - 2} + \\dfrac{B}{(x + 1)^{2}}$",
    "rationale": "The term over (x + 1) is missing; two constants cannot fit every such fraction."
   },
   {
    "key": "C",
    "content": "$\\dfrac{A}{x - 2} + \\dfrac{Bx + C}{(x + 1)^{2}}$",
    "rationale": "Bx + C is used over an irreducible quadratic, not over a repeated linear factor."
   },
   {
    "key": "D",
    "content": "$\\dfrac{A}{x - 2} + \\dfrac{B}{x + 1} + \\dfrac{C}{x + 1}$",
    "rationale": "The last two terms are the same type and merge into one; the squared factor is lost."
   }
  ],
  "explanation": "A repeated factor $(x + 1)^{2}$ contributes $\\dfrac{B}{x + 1} + \\dfrac{C}{(x + 1)^{2}}$, and the linear factor contributes $\\dfrac{A}{x - 2}$.",
