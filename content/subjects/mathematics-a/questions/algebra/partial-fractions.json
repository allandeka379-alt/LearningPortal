  "difficulty": 2,
  "marks": 2,
  "estimatedSeconds": 180,
  "stem": "Show that $\\dfrac{2}{x - 1} - \\dfrac{1}{x + 1} \\equiv \\dfrac{x + 3}{x^{2} - 1}$.",
  "answerSpec": {
   "markScheme": {
    "points": [
     {
      "id": "p1",
      "description": "M1 uses the common denominator $(x - 1)(x + 1)$ with numerator $2(x + 1) - (x - 1)$",
      "marks": 1
     },
     {
      "id": "p2",
      "description": "A1 simplifies the numerator to $x + 3$ and writes the denominator as $x^{2} - 1$",
      "marks": 1
     }
    ]
   },
   "modelAnswer": "$$\n\\frac{2}{x - 1} - \\frac{1}{x + 1} = \\frac{2(x + 1) - (x - 1)}{(x - 1)(x + 1)} = \\frac{2x + 2 - x + 1}{x^{2} - 1} = \\frac{x + 3}{x^{2} - 1}\n$$"
  },
  "markingMode": "MANUAL",
  "explanation": "Combining partial fractions is the reverse of splitting; it is also a quick check on a partial-fraction answer.",
  "skill": "UNDERSTANDING",
  "calculator": false
 },
