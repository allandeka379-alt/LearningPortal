  "stem": "Express $\\log a + \\log b - \\log c$ as a single logarithm.",
  "options": [
   {
    "key": "A",
    "content": "$\\log(a + b - c)$",
    "rationale": "The laws turn products into sums, not sums into sums."
   },
   {
    "key": "B",
    "content": "$\\log\\dfrac{ab}{c}$",
    "correct": true,
    "rationale": "Correct: add for a product, subtract for a quotient."
   },
   {
    "key": "C",
    "content": "$\\dfrac{\\log ab}{\\log c}$",
    "rationale": "Subtracting logarithms gives the logarithm of a quotient, not a quotient of logarithms."
   },
   {
    "key": "D",
    "content": "$\\log(ab - c)$",
    "rationale": "$-\\log c$ divides by $c$; it does not subtract $c$."
   }
  ],
  "explanation": "$\\log a + \\log b = \\log(ab)$, and $\\log(ab) - \\log c = \\log\\dfrac{ab}{c}$.",
