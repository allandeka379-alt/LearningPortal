    "stem": "Show that $\\dfrac{1}{r(r + 1)} - \\dfrac{1}{(r + 1)(r + 2)} = \\dfrac{2}{r(r + 1)(r + 2)}$.",
    "answerSpec": {
     "markScheme": {
      "points": [
       {
        "id": "p1",
        "description": "M1 common denominator $r(r + 1)(r + 2)$.",
