  ],
  "difficulty": 1,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "$X \\sim \\mathrm{Geo}(p)$. Which expression gives $\\mathrm{P}(X = r)$?",
  "options": [
   {
    "key": "A",
    "content": "$(1 - p)^{r - 1}p$",
    "correct": true,
    "rationale": "Correct: r − 1 failures, then the first success."
   },
   {
    "key": "B",
    "content": "$(1 - p)^r p$",
    "rationale": "This has one failure too many: it is P(X = r + 1)."
   },
   {
    "key": "C",
    "content": "$p^{r - 1}(1 - p)$",
    "rationale": "Success and failure are swapped."
   },
   {
    "key": "D",
    "content": "${}^rC_1(1 - p)^{r - 1}p$",
    "rationale": "The success must come last, so there is only one order: no coefficient."
   }
  ],
  "explanation": "The first success on trial $r$ needs failures on trials $1$ to $r - 1$: $(1 - p)^{r - 1}p$.",
  "modelResponse": {
