[
 {
  "key": "discrete.binomial.q01",
  "type": "MULTIPLE_CHOICE",
  "concepts": [
   "amaths.discrete.binomial"
  ],
  "difficulty": 1,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "$X \\sim \\mathrm{B}(n, p)$. Which expression gives $\\mathrm{P}(X = r)$?",
  "options": [
   {
    "key": "A",
    "content": "$p^r(1 - p)^{n - r}$",
    "rationale": "This is the probability of one particular order; the ${}^nC_r$ orders are missing."
   },
   {
    "key": "B",
    "content": "${}^nP_r\\,p^r(1 - p)^{n - r}$",
    "rationale": "Permutations overcount: the r successes are not distinguished from each other."
   },
   {
    "key": "C",
    "content": "${}^nC_r\\,p^r(1 - p)^{n - r}$",
    "correct": true,
    "rationale": "Correct: the number of orders times the probability of one order."
   },
   {
    "key": "D",
    "content": "${}^nC_r\\,p^{n - r}(1 - p)^r$",
    "rationale": "The powers are swapped: p goes with the r successes."
   }
  ],
  "explanation": "Choose which $r$ of the $n$ trials succeed (${}^nC_r$ ways); each such order has probability $p^r(1 - p)^{n - r}$.",
  "modelResponse": {
   "type": "MULTIPLE_CHOICE",
   "optionKeys": [
    "C"
   ]
  },
  "wrongResponses": [
   {
    "type": "MULTIPLE_CHOICE",
    "optionKeys": [
     "A"
    ]
   }
  ],
  "skill": "RECALL",
  "calculator": false
 },
