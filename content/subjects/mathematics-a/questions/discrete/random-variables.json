[
 {
  "key": "discrete.random-variables.q01",
  "type": "MULTIPLE_CHOICE",
  "concepts": [
   "amaths.discrete.random-variables"
  ],
  "difficulty": 1,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "Which expression gives $\\mathrm{Var}(X)$ for a discrete random variable $X$?",
  "options": [
   {
    "key": "A",
    "content": "$\\sum x^2\\,\\mathrm{P}(X = x) - [\\mathrm{E}(X)]^2$",
    "correct": true,
    "rationale": "Correct: E(X²) minus the square of the mean."
   },
   {
    "key": "B",
    "content": "$\\sum x^2\\,\\mathrm{P}(X = x)$",
    "rationale": "This is $\\mathrm{E}(X^2)$; the square of the mean has not been subtracted."
   },
   {
    "key": "C",
    "content": "$\\sum x\\,[\\mathrm{P}(X = x)]^2 - [\\mathrm{E}(X)]^2$",
    "rationale": "The values, not the probabilities, are squared."
   },
   {
    "key": "D",
    "content": "$[\\sum x\\,\\mathrm{P}(X = x)]^2$",
    "rationale": "This is the square of the mean."
   }
  ],
  "explanation": "$\\mathrm{Var}(X) = \\mathrm{E}(X^2) - [\\mathrm{E}(X)]^2$, with $\\mathrm{E}(X^2) = \\sum x^2\\,\\mathrm{P}(X = x)$.",
  "modelResponse": {
   "type": "MULTIPLE_CHOICE",
   "optionKeys": [
    "A"
   ]
  },
  "wrongResponses": [
   {
    "type": "MULTIPLE_CHOICE",
    "optionKeys": [
     "B"
    ]
   }
  ],
  "skill": "RECALL",
  "calculator": false
 },
