  ],
  "difficulty": 3,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "At a school fête in Chitungwiza a player pays US\\$0.50 to throw a fair die. A six wins US\\$2, a 4 or 5 wins US\\$0.50 (the stake back), and any other score wins nothing. What is the player's expected gain per game?",
  "options": [
   {
    "key": "A",
    "content": "US\\$0.50 gain",
    "rationale": "This is the expected winnings, $2 \\times \\frac{1}{6} + 0.5 \\times \\frac{2}{6} = 0.5$, before taking off the stake."
   },
   {
    "key": "B",
    "content": "US\\$0, a fair game",
    "correct": true,
    "rationale": "Correct: $1.5 \\times \\frac{1}{6} + 0 \\times \\frac{2}{6} - 0.5 \\times \\frac{3}{6} = 0.25 - 0.25 = 0$."
   },
   {
    "key": "C",
    "content": "US\\$0.25 gain",
    "rationale": "This forgets the losses on scores 1 to 3."
   },
   {
    "key": "D",
    "content": "US\\$0.25 loss",
    "rationale": "This ignores the winnings on a six."
   }
  ],
  "explanation": "Gain $G$ (in US\\$): $1.5$ with probability $\\frac{1}{6}$, $0$ with probability $\\frac{1}{3}$, $-0.5$ with probability $\\frac{1}{2}$. $\\mathrm{E}(G) = 0.25 + 0 - 0.25 = 0$: on average the player neither wins nor loses.",
  "hints": [
   "Work with the gain: winnings minus the 50-cent stake."
  ],
  "modelResponse": {
   "type": "MULTIPLE_CHOICE",
   "optionKeys": [
    "B"
