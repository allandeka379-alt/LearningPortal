[
 {
  "key": "diff.implicit-parametric.q01",
  "type": "MULTIPLE_CHOICE",
  "concepts": [
   "amaths.diff.implicit-parametric"
  ],
  "difficulty": 1,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "When differentiating an implicit equation with respect to $x$, what is $\\dfrac{d}{dx}\\left(y^{3}\\right)$?",
  "options": [
   {
    "key": "A",
    "content": "$3y^{2}\\dfrac{dy}{dx}$",
    "correct": true,
    "rationale": "Correct: chain rule, since y is a function of x."
   },
   {
    "key": "B",
    "content": "$3y^{2}$",
    "rationale": "The factor dy/dx from the chain rule is missing."
   },
   {
    "key": "C",
    "content": "$3x^{2}$",
    "rationale": "y cannot be replaced by x."
   },
   {
    "key": "D",
    "content": "$y^{3}\\dfrac{dy}{dx}$",
    "rationale": "The power must come down and reduce by one: 3y²."
   }
  ],
  "explanation": "$\\dfrac{d}{dx}(y^{3}) = \\dfrac{d}{dy}(y^{3}) \\times \\dfrac{dy}{dx} = 3y^{2}\\dfrac{dy}{dx}$.",
  "modelResponse": {
   "type": "MULTIPLE_CHOICE",
   "optionKeys": [
    "A"
   ]
  },
  "wrongResponses": [
   {
    "type": "MULTIPLE_CHOICE",
    "optionKeys": [
     "B"
    ]
   }
  ],
  "skill": "RECALL",
  "calculator": false
 },
 {
