  "difficulty": 2,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "A curve has parametric equations $x = t^{2}$, $y = t^{3}$. Find $\\dfrac{dy}{dx}$ in terms of $t$.",
  "options": [
   {
    "key": "A",
