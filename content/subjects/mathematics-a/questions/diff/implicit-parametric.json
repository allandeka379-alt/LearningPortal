  ],
  "difficulty": 2,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "What is $\\dfrac{d}{dx}(xy)$, where $y$ is a function of $x$?",
  "options": [
   {
    "key": "A",
    "content": "$\\dfrac{dy}{dx}$",
    "rationale": "This treats x as a constant; the product rule gives two terms."
   },
   {
    "key": "B",
    "content": "$x + y\\dfrac{dy}{dx}$",
    "rationale": "The factor dy/dx belongs with x (the derivative of y), not with y."
   },
   {
    "key": "C",
    "content": "$x\\dfrac{dy}{dx} + y$",
    "correct": true,
    "rationale": "Correct: the product rule with u = x and v = y."
   },
   {
    "key": "D",
    "content": "$y\\dfrac{dy}{dx}$",
    "rationale": "The derivative of x, which is 1, multiplies y; and x multiplies dy/dx."
   }
  ],
