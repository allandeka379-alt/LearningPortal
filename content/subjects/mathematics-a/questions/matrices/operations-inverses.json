 {
  "key": "matrices.operations-inverses.q15",
  "type": "EXTENDED_RESPONSE",
  "concepts": [
   "amaths.matrices.operations-inverses"
  ],
  "difficulty": 4,
  "marks": 3,
  "estimatedSeconds": 270,
  "stem": "$\\mathbf{A}$ and $\\mathbf{B}$ are non-singular $n \\times n$ matrices. Prove that $(\\mathbf{AB})^{-1} = \\mathbf{B}^{-1}\\mathbf{A}^{-1}$.",
  "answerSpec": {
   "markScheme": {
    "points": [
     {
      "id": "p1",
      "description": "M1 multiplies $(\\mathbf{AB})(\\mathbf{B}^{-1}\\mathbf{A}^{-1})$ and uses associativity to regroup as $\\mathbf{A}(\\mathbf{BB}^{-1})\\mathbf{A}^{-1}$.",
      "marks": 1
     },
     {
      "id": "p2",
      "description": "M1 uses $\\mathbf{BB}^{-1} = \\mathbf{I}$ and $\\mathbf{AI} = \\mathbf{A}$ to reach $\\mathbf{AA}^{-1} = \\mathbf{I}$.",
      "marks": 1
     },
     {
      "id": "p3",
      "description": "A1 concludes that $\\mathbf{B}^{-1}\\mathbf{A}^{-1}$ is the inverse of $\\mathbf{AB}$ (inverses are unique).",
      "marks": 1
     }
    ]
   },
   "modelAnswer": "$$\n(\\mathbf{AB})(\\mathbf{B}^{-1}\\mathbf{A}^{-1}) = \\mathbf{A}(\\mathbf{B}\\mathbf{B}^{-1})\\mathbf{A}^{-1} = \\mathbf{A}\\mathbf{I}\\mathbf{A}^{-1} = \\mathbf{A}\\mathbf{A}^{-1} = \\mathbf{I}\n$$\nSo $\\mathbf{B}^{-1}\\mathbf{A}^{-1}$ multiplied by $\\mathbf{AB}$ gives the identity; since a matrix has only one inverse, $(\\mathbf{AB})^{-1} = \\mathbf{B}^{-1}\\mathbf{A}^{-1}$."
  },
  "markingMode": "MANUAL",
  "explanation": "Associativity lets you move the brackets; commutativity is never needed.",
  "hints": [
   "Multiply AB by B⁻¹A⁻¹ and regroup."
  ],
  "skill": "ANALYSIS",
  "calculator": false
 },
