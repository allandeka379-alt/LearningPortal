     },
     {
      "key": "B",
      "content": "Minimum: $\\frac{d^{2}A}{dx^{2}} = 2x = 8 > 0$",
      "rationale": "The derivative of $-\\frac{128}{x^{2}}$ has been left out."
     },
     {
      "key": "C",
      "content": "Minimum: $\\frac{d^{2}A}{dx^{2}} = 2 + \\frac{256}{x^{3}} = 6 > 0$",
      "correct": true,
      "rationale": "Correct: the second derivative is positive."
     },
     {
      "key": "D",
      "content": "Maximum: $\\frac{dA}{dx} = 0$ there",
      "rationale": "dA/dx = 0 only shows that the point is stationary."
     }
    ],
    "explanation": "$\\frac{d^{2}A}{dx^{2}} = 2 + 256x^{-3} = 2 + 4 = 6 > 0$ at $x = 4$, so $A$ is a minimum."
   },
