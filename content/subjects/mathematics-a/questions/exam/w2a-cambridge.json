  ],
  "difficulty": 4,
  "marks": 9,
  "estimatedSeconds": 810,
  "stem": "An open water tank at a fish farm near Kariba has a square base of side $x$ m and height $h$ m. Its volume is 32 m$^3$. The tank has no lid.",
  "parts": [
   {
    "label": "(a)",
    "type": "EXTENDED_RESPONSE",
    "marks": 2,
    "markingMode": "MANUAL",
    "stem": "Show that the total outer surface area is $A = x^{2} + \\dfrac{128}{x}$.",
    "answerSpec": {
     "markScheme": {
      "points": [
       {
        "id": "p1",
        "description": "M1 uses $x^{2}h = 32$ to write $h = \\dfrac{32}{x^{2}}$",
        "marks": 1
       },
       {
        "id": "p2",
        "description": "A1 substitutes into $A = x^{2} + 4xh$ to reach the given result",
        "marks": 1
       }
      ]
     },
     "modelAnswer": "$$\nx^{2}h = 32 \\Rightarrow h = \\frac{32}{x^{2}}, \\qquad A = x^{2} + 4xh = x^{2} + 4x \\cdot \\frac{32}{x^{2}} = x^{2} + \\frac{128}{x}\n$$"
    },
    "explanation": "The base plus four vertical sides; no lid."
   },
   {
    "label": "(b)",
    "type": "NUMERICAL",
