       "square metres"
      ]
     }
    },
    "explanation": "$A = 16 + 32 = 48$ m$^2$.",
    "workedSolution": "1. $A = 16 + 32 = 48$ m$^2$."
   },
   {
    "label": "(e)",
    "type": "NUMERICAL",
    "marks": 1,
    "stem": "A design is tested in which x increases at 0.05 m per second. Find the rate of change of A, in m² per second, at the instant when x = 2.",
    "answerSpec": {
