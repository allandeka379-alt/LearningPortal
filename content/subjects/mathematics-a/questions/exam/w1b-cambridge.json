    "stem": "Show that the equation can be written as $2\\cos^2\\theta - 3\\cos\\theta - 2 = 0$.",
    "answerSpec": {
     "markScheme": {
      "points": [
       {
        "id": "p1",
        "description": "M1 replaces $\\sin^2\\theta$ by $1 - \\cos^2\\theta$.",
        "marks": 1
       },
       {
        "id": "p2",
        "description": "A1 rearranges to $2\\cos^2\\theta - 3\\cos\\theta - 2 = 0$.",
        "marks": 1
       }
      ]
     },
     "modelAnswer": "$$\n2(1 - \\cos^2\\theta) + 3\\cos\\theta = 0 \\Rightarrow 2 - 2\\cos^2\\theta + 3\\cos\\theta = 0 \\Rightarrow 2\\cos^2\\theta - 3\\cos\\theta - 2 = 0\n$$"
    },
