    "answerSpec": {
     "markScheme": {
      "points": [
       {
        "id": "p1",
        "description": "M1 writes $\\cos 3\\theta + \\mathrm{i}\\sin 3\\theta = (\\cos\\theta + \\mathrm{i}\\sin\\theta)^3$.",
