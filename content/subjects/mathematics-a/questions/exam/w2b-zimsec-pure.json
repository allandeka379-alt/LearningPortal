  ],
  "difficulty": 4,
  "marks": 10,
  "estimatedSeconds": 900,
  "stem": "The function f is defined by $f(x) = x^4 - 3x - 5$.",
  "parts": [
   {
    "label": "(a)",
    "type": "EXTENDED_RESPONSE",
    "marks": 2,
    "markingMode": "MANUAL",
    "stem": "Show that the equation $f(x) = 0$ has a root $\\alpha$ between 1 and 2.",
    "answerSpec": {
     "markScheme": {
      "points": [
       {
        "id": "p1",
        "description": "M1 $f(1) = -7$ and $f(2) = 5$.",
        "marks": 1
       },
       {
        "id": "p2",
        "description": "A1 change of sign, f continuous, so 1 < α < 2.",
        "marks": 1
       }
      ]
     },
     "modelAnswer": "$f(1) = 1 - 3 - 5 = -7 < 0$ and $f(2) = 16 - 6 - 5 = 5 > 0$. $f$ is continuous, so there is a root between 1 and 2."
    },
    "explanation": "Change of sign."
   },
   {
    "label": "(b)",
    "type": "EXTENDED_RESPONSE",
    "marks": 2,
    "markingMode": "MANUAL",
    "stem": "Show that the Newton–Raphson iteration for $f(x) = 0$ can be written $x_{n+1} = \\dfrac{3x_n^4 + 5}{4x_n^3 - 3}$.",
    "answerSpec": {
     "markScheme": {
      "points": [
       {
        "id": "p1",
        "description": "M1 $f'(x) = 4x^3 - 3$ and $x_{n+1} = x_n - \\frac{x_n^4 - 3x_n - 5}{4x_n^3 - 3}$.",
        "marks": 1
       },
       {
        "id": "p2",
        "description": "A1 simplifies over a common denominator to the given form.",
        "marks": 1
       }
      ]
     },
     "modelAnswer": "$$\nx_{n+1} = x_n - \\frac{x_n^4 - 3x_n - 5}{4x_n^3 - 3} = \\frac{4x_n^4 - 3x_n - x_n^4 + 3x_n + 5}{4x_n^3 - 3} = \\frac{3x_n^4 + 5}{4x_n^3 - 3}\n$$"
    },
    "explanation": "The −3xₙ terms cancel."
   },
   {
