  ],
  "difficulty": 4,
  "marks": 8,
  "estimatedSeconds": 720,
  "stem": "The time, in minutes, for a kombi to travel a route in Bulawayo is normally distributed with mean 40 and standard deviation 6. After road works, a random sample of 16 journeys is used to test, at the 5% level, whether the mean time has decreased.",
  "parts": [
   {
    "label": "(a)",
    "type": "NUMERICAL",
    "marks": 3,
    "stem": "Find the critical value $c$ such that $H_0: \\mu = 40$ is rejected if $\\bar{x} < c$. Give $c$ correct to 4 significant figures.",
    "answerSpec": {
     "value": 37.5325,
     "tolerance": {
      "kind": "absolute",
      "amount": 0.005
     }
