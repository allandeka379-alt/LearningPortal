 {
  "key": "vectors.basics.q18",
  "type": "EXTENDED_RESPONSE",
  "concepts": [
   "amaths.vectors.basics"
  ],
  "difficulty": 4,
  "marks": 3,
  "estimatedSeconds": 270,
  "stem": "The points $A$, $B$ and $C$ have position vectors $2\\mathbf{i} - \\mathbf{j} + 4\\mathbf{k}$, $4\\mathbf{i} + 3\\mathbf{j} + \\mathbf{k}$ and $8\\mathbf{i} + 11\\mathbf{j} - 5\\mathbf{k}$. Show that $A$, $B$ and $C$ are collinear and find the ratio $AB : BC$.",
  "answerSpec": {
   "markScheme": {
    "points": [
     {
      "id": "p1",
      "description": "M1 finds $\\overrightarrow{AB} = 2\\mathbf{i} + 4\\mathbf{j} - 3\\mathbf{k}$ and $\\overrightarrow{BC} = 4\\mathbf{i} + 8\\mathbf{j} - 6\\mathbf{k}$.",
      "marks": 1
     },
     {
      "id": "p2",
      "description": "A1 $\\overrightarrow{BC} = 2\\overrightarrow{AB}$, parallel with the common point $B$, so collinear.",
      "marks": 1
     },
     {
      "id": "p3",
      "description": "A1 $AB : BC = 1 : 2$.",
      "marks": 1
     }
    ]
   },
   "modelAnswer": "$$\n\\overrightarrow{AB} = 2\\mathbf{i} + 4\\mathbf{j} - 3\\mathbf{k}, \\qquad \\overrightarrow{BC} = 4\\mathbf{i} + 8\\mathbf{j} - 6\\mathbf{k} = 2\\overrightarrow{AB}\n$$\n$$\n\\overrightarrow{AB} \\parallel \\overrightarrow{BC} \\text{ and both contain } B \\Rightarrow A, B, C \\text{ collinear}\n$$\n$$\nAB : BC = 1 : 2\n$$"
  },
  "markingMode": "MANUAL",
  "explanation": "Parallel vectors alone are not enough: they must share a point.",
  "hints": [
   "Compare AB and BC."
  ],
  "skill": "ANALYSIS",
  "calculator": false
 },
