  "difficulty": 1,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "$\\mathbf{a}$ and $\\mathbf{b}$ are non-parallel, non-zero vectors. Which statement about $\\mathbf{a} \\times \\mathbf{b}$ is true?",
  "options": [
   {
    "key": "A",
    "content": "It is perpendicular to both $\\mathbf{a}$ and $\\mathbf{b}$",
    "correct": true,
    "rationale": "Correct: the vector product is normal to the plane containing a and b."
   },
   {
    "key": "B",
    "content": "It is a scalar",
    "rationale": "That is the scalar (dot) product $\\mathbf{a} \\cdot \\mathbf{b}$; the cross product is a vector."
   },
   {
    "key": "C",
    "content": "It is parallel to $\\mathbf{a} + \\mathbf{b}$",
    "rationale": "$\\mathbf{a} + \\mathbf{b}$ lies in the plane of $\\mathbf{a}$ and $\\mathbf{b}$; the cross product is perpendicular to that plane."
   },
   {
    "key": "D",
    "content": "Its magnitude is $|\\mathbf{a}||\\mathbf{b}|\\cos\\theta$",
    "rationale": "The magnitude is $|\\mathbf{a}||\\mathbf{b}|\\sin\\theta$; $\\cos\\theta$ belongs to the scalar product."
   }
  ],
  "explanation": "$\\mathbf{a} \\times \\mathbf{b}$ is a vector of magnitude $|\\mathbf{a}||\\mathbf{b}|\\sin\\theta$, perpendicular to both $\\mathbf{a}$ and $\\mathbf{b}$ (right-hand rule).",
