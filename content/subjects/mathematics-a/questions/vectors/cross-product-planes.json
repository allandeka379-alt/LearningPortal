  ],
  "difficulty": 2,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "What is $\\mathbf{i} \\times \\mathbf{k}$?",
  "options": [
   {
    "key": "A",
    "content": "$\\mathbf{j}$",
    "rationale": "That is $\\mathbf{k} \\times \\mathbf{i}$; reversing the order changes the sign."
   },
   {
    "key": "B",
    "content": "$\\mathbf{0}$",
    "rationale": "$\\mathbf{i}$ and $\\mathbf{k}$ are perpendicular, not parallel, so their cross product is not zero."
   },
   {
    "key": "C",
    "content": "$-\\mathbf{j}$",
    "correct": true,
    "rationale": "Correct: $\\mathbf{k} \\times \\mathbf{i} = \\mathbf{j}$, so $\\mathbf{i} \\times \\mathbf{k} = -\\mathbf{j}$."
   },
   {
    "key": "D",
    "content": "1",
    "rationale": "This would be a scalar; the cross product of two vectors is a vector."
   }
  ],
  "explanation": "Cyclic order $\\mathbf{i} \\to \\mathbf{j} \\to \\mathbf{k} \\to \\mathbf{i}$ gives positive products ($\\mathbf{k} \\times \\mathbf{i} = \\mathbf{j}$); against the cycle the sign is negative.",
