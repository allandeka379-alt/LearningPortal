 {
  "key": "normal.probabilities.q07",
  "type": "MULTIPLE_CHOICE",
  "concepts": [
   "amaths.normal.probabilities"
  ],
  "difficulty": 2,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "$Z \\sim \\mathrm{N}(0, 1)$. Which expression equals $\\mathrm{P}(Z > -0.8)$?",
  "options": [
   {
    "key": "A",
    "content": "$1 - \\Phi(0.8)$",
    "rationale": "This is P(Z > 0.8), the small upper tail."
   },
   {
    "key": "B",
    "content": "$\\Phi(0.8)$",
    "correct": true,
    "rationale": "Correct: by symmetry the area above −0.8 equals the area below 0.8."
   },
   {
    "key": "C",
    "content": "$\\Phi(-0.8)$",
    "rationale": "This is P(Z < −0.8), the opposite side."
   },
   {
    "key": "D",
    "content": "$2\\Phi(0.8) - 1$",
    "rationale": "This is P(−0.8 < Z < 0.8)."
   }
  ],
  "explanation": "Reflect in $z = 0$: $\\mathrm{P}(Z > -0.8) = \\mathrm{P}(Z < 0.8) = \\Phi(0.8)$.",
  "hints": [
   "Sketch and shade the region."
  ],
  "modelResponse": {
   "type": "MULTIPLE_CHOICE",
   "optionKeys": [
    "B"
   ]
  },
