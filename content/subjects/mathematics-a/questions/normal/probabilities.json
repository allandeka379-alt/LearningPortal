  "type": "STRUCTURED",
  "concepts": [
   "amaths.normal.probabilities"
  ],
  "difficulty": 3,
  "marks": 5,
  "estimatedSeconds": 450,
  "stem": "The daily rainfall on wet days at a station near Chimanimani in March is modelled by a normal distribution with mean 1.2 cm and standard deviation 0.15 cm.",
  "parts": [
   {
    "label": "(a)",
    "type": "NUMERICAL",
    "marks": 2,
    "stem": "Find the probability that on a wet day the rainfall is more than 1.5 cm, correct to 3 significant figures.",
    "answerSpec": {
     "value": 0.022750129890124482,
     "tolerance": {
      "kind": "absolute",
      "amount": 0.0001
     }
    },
    "explanation": "$z = \\frac{1.5 - 1.2}{0.15} = 2$; $1 - \\Phi(2) = 1 - 0.9772 = 0.0228$.",
    "workedSolution": "1. $z = \\frac{1.5 - 1.2}{0.15} = 2$; $1 - \\Phi(2) = 1 - 0.9772 = 0.0228$."
   },
   {
    "label": "(b)",
    "type": "NUMERICAL",
    "marks": 3,
    "stem": "Find the probability that on a wet day the rainfall is between 1.0 cm and 1.35 cm, correct to 3 significant figures.",
    "answerSpec": {
     "value": 0.7501335142170218,
     "tolerance": {
      "kind": "absolute",
      "amount": 0.0011
     }
    },
