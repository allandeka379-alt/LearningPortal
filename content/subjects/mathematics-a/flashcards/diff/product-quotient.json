 {
  "key": "diff.product-quotient.c02",
  "cardType": "FORMULA",
  "front": "Quotient rule",
  "back": "$\\dfrac{d}{dx}\\left(\\dfrac{u}{v}\\right) = \\dfrac{v\\frac{du}{dx} - u\\frac{dv}{dx}}{v^{2}}$",
  "notes": "In MF19.",
  "concepts": [
   "amaths.diff.product-quotient"
  ]
 },
 {
  "key": "diff.product-quotient.c03",
  "cardType": "CONCEPT",
  "front": "Quotient rule in words",
  "back": "Bottom times derivative of top, minus top times derivative of bottom, all over bottom squared.",
  "concepts": [
   "amaths.diff.product-quotient"
  ]
 },
