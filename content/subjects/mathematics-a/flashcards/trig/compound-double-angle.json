  "back": "$\\cos^2 A - \\sin^2 A = 2\\cos^2 A - 1 = 1 - 2\\sin^2 A$",
  "concepts": [
   "amaths.trig.compound-double-angle"
  ]
 },
 {
  "key": "trig.compound-double-angle.c06",
  "cardType": "FORMULA",
  "front": "sin² and cos² in terms of cos 2A",
  "back": "$\\sin^2 A = \\frac{1}{2}(1 - \\cos 2A)$, $\\cos^2 A = \\frac{1}{2}(1 + \\cos 2A)$",
  "concepts": [
   "amaths.trig.compound-double-angle"
  ]
 },
 {
