[
 {
  "key": "trig.basic-identities-equations.c01",
  "cardType": "FORMULA",
  "front": "Quotient identity",
  "back": "$\\tan\\theta \\equiv \\frac{\\sin\\theta}{\\cos\\theta}$",
  "concepts": [
   "amaths.trig.basic-identities-equations"
  ]
 },
 {
  "key": "trig.basic-identities-equations.c02",
  "cardType": "FORMULA",
  "front": "Pythagorean identity",
  "back": "$\\sin^2\\theta + \\cos^2\\theta \\equiv 1$",
  "notes": "Rearranged: sin²θ ≡ 1 − cos²θ, cos²θ ≡ 1 − sin²θ.",
  "concepts": [
   "amaths.trig.basic-identities-equations"
  ]
 },
 {
  "key": "trig.basic-identities-equations.c03",
  "cardType": "CONCEPT",
  "front": "Second solution in one cycle",
  "back": "$\\sin$: $180^\\circ - \\alpha$; $\\cos$: $360^\\circ - \\alpha$; $\\tan$: $\\alpha + 180^\\circ$.",
  "concepts": [
   "amaths.trig.basic-identities-equations"
  ]
 },
 {
  "key": "trig.basic-identities-equations.c04",
  "cardType": "CONCEPT",
  "front": "Multiple angles",
  "back": "For $\\sin kx$ on $a \\le x \\le b$, solve for $kx$ on $ka \\le kx \\le kb$, then divide by $k$.",
  "concepts": [
   "amaths.trig.basic-identities-equations"
  ]
 },
 {
  "key": "trig.basic-identities-equations.c05",
  "cardType": "CONCEPT",
  "front": "Never divide by sin θ or cos θ",
  "back": "Factorise instead; dividing loses the solutions where the divisor is zero.",
  "concepts": [
   "amaths.trig.basic-identities-equations"
  ]
 },
 {
  "key": "trig.basic-identities-equations.c06",
  "cardType": "CONCEPT",
  "front": "Quadratic in sin or cos",
  "back": "Use $\\sin^2 = 1 - \\cos^2$ (or the reverse) so only one function appears, then factorise.",
  "concepts": [
   "amaths.trig.basic-identities-equations"
  ]
 },
 {
  "key": "trig.basic-identities-equations.c07",
  "cardType": "FACT",
  "front": "Impossible values",
  "back": "$\\sin\\theta$ and $\\cos\\theta$ lie in $[-1, 1]$; reject $\\cos\\theta = -2$, $\\sin\\theta = 1.5$.",
  "concepts": [
   "amaths.trig.basic-identities-equations"
  ]
 },
 {
  "key": "trig.basic-identities-equations.c08",
  "cardType": "CONCEPT",
  "front": "Proving an identity",
  "back": "Start from one side and transform it into the other; never operate on both sides at once.",
  "concepts": [
   "amaths.trig.basic-identities-equations"
  ]
 },
 {
  "key": "trig.basic-identities-equations.c09",
  "cardType": "CONCEPT",
  "front": "a sin x = b cos x",
  "back": "Divide by $a\\cos x$: $\\tan x = \\frac{b}{a}$.",
  "concepts": [
   "amaths.trig.basic-identities-equations"
  ]
 }
]
