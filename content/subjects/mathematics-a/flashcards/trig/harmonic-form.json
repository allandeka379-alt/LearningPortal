[
 {
  "key": "trig.harmonic-form.c01",
  "cardType": "FORMULA",
  "front": "R in the harmonic form",
  "back": "$R = \\sqrt{a^2 + b^2}$ for $a\\sin\\theta \\pm b\\cos\\theta$ or $a\\cos\\theta \\pm b\\sin\\theta$",
  "concepts": [
   "amaths.trig.harmonic-form"
  ]
 },
 {
  "key": "trig.harmonic-form.c02",
  "cardType": "CONCEPT",
  "front": "Finding α",
  "back": "Expand $R\\sin(\\theta \\pm \\alpha)$ or $R\\cos(\\theta \\pm \\alpha)$, match coefficients to get $R\\cos\\alpha$ and $R\\sin\\alpha$, then divide for $\\tan\\alpha$.",
  "concepts": [
   "amaths.trig.harmonic-form"
  ]
 },
 {
  "key": "trig.harmonic-form.c03",
  "cardType": "FACT",
  "front": "Range of a sin θ + b cos θ",
  "back": "From $-\\sqrt{a^2 + b^2}$ to $\\sqrt{a^2 + b^2}$.",
  "concepts": [
   "amaths.trig.harmonic-form"
  ]
 },
 {
  "key": "trig.harmonic-form.c04",
  "cardType": "CONCEPT",
  "front": "Solving a sin θ + b cos θ = c",
  "back": "Convert to R sin(θ + α) = c, solve for θ + α over the shifted interval, then subtract α.",
  "concepts": [
   "amaths.trig.harmonic-form"
  ]
 },
 {
  "key": "trig.harmonic-form.c05",
  "cardType": "FACT",
  "front": "When there is no solution",
  "back": "$a\\sin\\theta + b\\cos\\theta = c$ has no solution if $|c| > \\sqrt{a^2 + b^2}$.",
  "concepts": [
   "amaths.trig.harmonic-form"
  ]
 },
 {
  "key": "trig.harmonic-form.c06",
  "cardType": "CONCEPT",
  "front": "Greatest value of a reciprocal",
  "back": "k ÷ (c + R cos(θ − α)) is greatest when the denominator is least, c − R (if positive).",
  "concepts": [
   "amaths.trig.harmonic-form"
  ]
 },
 {
  "key": "trig.harmonic-form.c07",
  "cardType": "CONCEPT",
  "front": "Matching form to signs",
  "back": "$a\\cos\\theta + b\\sin\\theta \\to R\\cos(\\theta - \\alpha)$; $a\\sin\\theta - b\\cos\\theta \\to R\\sin(\\theta - \\alpha)$ (keeps $\\alpha$ acute).",
  "concepts": [
   "amaths.trig.harmonic-form"
  ]
 },
 {
  "key": "trig.harmonic-form.c08",
  "cardType": "FACT",
  "front": "Where the maximum occurs",
  "back": "$R\\cos(\\theta - \\alpha)$ is greatest at $\\theta = \\alpha$; $R\\sin(\\theta + \\alpha)$ at $\\theta + \\alpha = 90^\\circ$.",
  "concepts": [
   "amaths.trig.harmonic-form"
  ]
 },
 {
  "key": "trig.harmonic-form.c09",
  "cardType": "CONCEPT",
  "front": "Accuracy of α",
  "back": "Keep α to 2 d.p. (degrees) or 4 s.f. (radians) when it is used in later parts.",
  "concepts": [
   "amaths.trig.harmonic-form"
  ]
 }
]
