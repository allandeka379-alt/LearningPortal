[
 {
  "key": "estimation.unbiased.c01",
  "cardType": "DEFINITION",
  "front": "Unbiased estimator",
  "back": "A statistic $T$ with $\\mathrm{E}(T) = \\theta$: correct on average over all samples.",
  "concepts": [
   "amaths.estimation.unbiased"
  ]
 },
 {
  "key": "estimation.unbiased.c02",
  "cardType": "FORMULA",
  "front": "Unbiased estimate of the population mean",
  "back": "$\\bar{x} = \\frac{\\sum x}{n}$",
  "concepts": [
   "amaths.estimation.unbiased"
  ]
 },
 {
  "key": "estimation.unbiased.c03",
  "cardType": "FORMULA",
  "front": "Unbiased estimate of the population variance",
  "back": "$s^2 = \\frac{1}{n - 1}\\left(\\sum x^2 - \\frac{(\\sum x)^2}{n}\\right)$",
  "notes": "Given in MF19 (Cambridge).",
  "concepts": [
   "amaths.estimation.unbiased"
  ]
 },
 {
  "key": "estimation.unbiased.c04",
  "cardType": "FORMULA",
  "front": "Unbiased estimate from the sample variance",
  "back": "$s^2 = \\frac{n}{n - 1} \\times \\left(\\frac{\\sum x^2}{n} - \\bar{x}^2\\right)$",
  "concepts": [
   "amaths.estimation.unbiased"
  ]
 },
 {
  "key": "estimation.unbiased.c05",
  "cardType": "CONCEPT",
  "front": "Why divide by n − 1",
  "back": "Deviations from $\\bar{x}$ are smaller on average than deviations from $\\mu$; the divisor $n - 1$ corrects this bias.",
  "concepts": [
   "amaths.estimation.unbiased"
  ]
 },
 {
  "key": "estimation.unbiased.c06",
  "cardType": "CONCEPT",
  "front": "Coded data",
  "back": "For $y = x - a$: $\\bar{x} = \\bar{y} + a$ and $s_x^2 = s_y^2$. For $y = \\frac{x - a}{c}$: $s_x^2 = c^2 s_y^2$.",
  "concepts": [
   "amaths.estimation.unbiased"
  ]
 },
 {
  "key": "estimation.unbiased.c07",
  "cardType": "CONCEPT",
  "front": "Combining two samples",
  "back": "Add the $n$'s, the $\\sum x$'s and the $\\sum x^2$'s, then apply the formula once.",
  "concepts": [
   "amaths.estimation.unbiased"
  ]
 },
 {
  "key": "estimation.unbiased.c08",
  "cardType": "FORMULA",
  "front": "Estimated standard error of the mean",
  "back": "$\\frac{s}{\\sqrt{n}}$",
  "concepts": [
   "amaths.estimation.unbiased"
  ]
 }
]
