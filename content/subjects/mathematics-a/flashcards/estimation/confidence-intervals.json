[
 {
  "key": "estimation.confidence-intervals.c01",
  "cardType": "FORMULA",
  "front": "Confidence interval for μ (σ known, normal population)",
  "back": "$\\bar{x} \\pm z\\frac{\\sigma}{\\sqrt{n}}$",
  "concepts": [
