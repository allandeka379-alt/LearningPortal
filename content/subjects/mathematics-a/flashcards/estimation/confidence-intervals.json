  ]
 },
 {
  "key": "estimation.confidence-intervals.c02",
  "cardType": "FORMULA",
  "front": "Confidence interval for μ (large sample, σ unknown)",
  "back": "$\\bar{x} \\pm z\\frac{s}{\\sqrt{n}}$, valid by the central limit theorem",
  "concepts": [
   "amaths.estimation.confidence-intervals"
  ]
 },
 {
  "key": "estimation.confidence-intervals.c03",
  "cardType": "FORMULA",
  "front": "Approximate confidence interval for a proportion",
