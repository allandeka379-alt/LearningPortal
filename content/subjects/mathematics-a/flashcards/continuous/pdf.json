[
 {
  "key": "continuous.pdf.c01",
  "cardType": "DEFINITION",
  "front": "Probability density function (pdf)",
  "back": "A function with $f(x) \\ge 0$ and total area 1; $\\mathrm{P}(a < X < b) = \\int_a^b f(x)\\,\\mathrm{d}x$.",
  "concepts": [
   "amaths.continuous.pdf"
  ]
 },
 {
  "key": "continuous.pdf.c02",
  "cardType": "FORMULA",
  "front": "$\\mathrm{E}(X)$ for a continuous random variable",
  "back": "$\\int x f(x)\\,\\mathrm{d}x$ over the range of $X$",
  "concepts": [
   "amaths.continuous.pdf"
  ]
 },
 {
  "key": "continuous.pdf.c03",
  "cardType": "FORMULA",
  "front": "$\\mathrm{Var}(X)$ for a continuous random variable",
  "back": "$\\int x^2 f(x)\\,\\mathrm{d}x - [\\mathrm{E}(X)]^2$",
  "concepts": [
   "amaths.continuous.pdf"
  ]
 },
 {
  "key": "continuous.pdf.c04",
  "cardType": "FORMULA",
  "front": "Median m of a continuous random variable",
  "back": "$\\int_{\\text{lowest}}^{m} f(x)\\,\\mathrm{d}x = 0.5$",
  "notes": "Use 0.25 and 0.75 for the quartiles.",
  "concepts": [
   "amaths.continuous.pdf"
  ]
 },
 {
  "key": "continuous.pdf.c05",
  "cardType": "FACT",
  "front": "$\\mathrm{P}(X = c)$ for a continuous random variable",
  "back": "0, so P(X < c) = P(X ≤ c).",
  "concepts": [
   "amaths.continuous.pdf"
  ]
 },
 {
  "key": "continuous.pdf.c06",
  "cardType": "CONCEPT",
  "front": "Mode of a continuous distribution",
  "back": "The $x$ where $f(x)$ is greatest: solve $f'(x) = 0$ or take an end point if $f$ is monotonic.",
  "concepts": [
   "amaths.continuous.pdf"
  ],
  "applies": [
   "zimsec/a-level/statistics"
  ]
 },
 {
  "key": "continuous.pdf.c07",
  "cardType": "CONCEPT",
  "front": "Mean greater than median for a pdf",
  "back": "The distribution is positively skewed (long right-hand tail).",
  "concepts": [
   "amaths.continuous.pdf"
  ]
 },
 {
  "key": "continuous.pdf.c08",
  "cardType": "FACT",
  "front": "Can f(x) exceed 1?",
  "back": "Yes: f(x) is a density, not a probability. Only areas must be at most 1.",
  "concepts": [
   "amaths.continuous.pdf"
  ]
 },
 {
  "key": "continuous.pdf.c09",
  "cardType": "CONCEPT",
  "front": "Finding an unknown constant k in a pdf",
  "back": "Set $\\int f(x)\\,\\mathrm{d}x = 1$ over the whole range and solve for $k$.",
  "concepts": [
   "amaths.continuous.pdf"
  ]
 }
]
