[
 {
  "key": "probability.events-rules.c01",
  "cardType": "DEFINITION",
  "front": "Sample space",
  "back": "The set $S$ of all possible outcomes of an experiment; an event is a subset of $S$.",
  "concepts": [
   "amaths.probability.events-rules"
  ]
 },
 {
  "key": "probability.events-rules.c02",
  "cardType": "FORMULA",
  "front": "Equally likely outcomes",
  "back": "$\\mathrm{P}(A) = \\dfrac{n(A)}{n(S)}$",
  "notes": "Only when every outcome is equally likely.",
  "concepts": [
   "amaths.probability.events-rules"
  ]
 },
 {
  "key": "probability.events-rules.c03",
  "cardType": "FORMULA",
  "front": "Complement",
  "back": "$\\mathrm{P}(A') = 1 - \\mathrm{P}(A)$",
  "notes": "Use it for 'at least one'.",
  "concepts": [
   "amaths.probability.events-rules"
  ]
 },
 {
  "key": "probability.events-rules.c04",
  "cardType": "DEFINITION",
  "front": "Mutually exclusive",
  "back": "$A$ and $B$ cannot both happen: $\\mathrm{P}(A \\cap B) = 0$, so $\\mathrm{P}(A \\cup B) = \\mathrm{P}(A) + \\mathrm{P}(B)$.",
  "concepts": [
   "amaths.probability.events-rules"
  ]
 },
 {
  "key": "probability.events-rules.c05",
  "cardType": "DEFINITION",
  "front": "Exhaustive events",
  "back": "Events that between them include every outcome of the sample space; at least one must happen.",
  "concepts": [
   "amaths.probability.events-rules"
  ]
 },
 {
  "key": "probability.events-rules.c06",
  "cardType": "FORMULA",
  "front": "General addition rule",
  "back": "$\\mathrm{P}(A \\cup B) = \\mathrm{P}(A) + \\mathrm{P}(B) - \\mathrm{P}(A \\cap B)$",
  "notes": "ZIMSEC uses it explicitly; not in MF19.",
  "concepts": [
   "amaths.probability.events-rules"
  ]
 },
 {
  "key": "probability.events-rules.c07",
  "cardType": "CONCEPT",
  "front": "Filling a Venn diagram",
  "back": "Start with the intersection (the centre for three sets), then the 'only' regions, then the region outside all sets.",
  "concepts": [
   "amaths.probability.events-rules"
  ]
 },
 {
  "key": "probability.events-rules.c08",
  "cardType": "FACT",
  "front": "Two dice",
  "back": "36 equally likely ordered pairs; a total of 7 is the most likely (6 ways).",
  "concepts": [
   "amaths.probability.events-rules"
  ]
 },
 {
  "key": "probability.events-rules.c09",
  "cardType": "CONCEPT",
  "front": "Probability by counting",
  "back": "$\\mathrm{P} = \\dfrac{\\text{favourable selections}}{\\text{all selections}}$, e.g. $\\dfrac{{}^6C_2 \\times {}^4C_2}{{}^{10}C_4}$.",
  "concepts": [
   "amaths.probability.events-rules"
  ]
 }
