  ]
 },
 {
  "key": "probability.bayes.c02",
  "cardType": "FORMULA",
  "front": "Bayes' theorem (partition)",
  "back": "$\\mathrm{P}(A_j \\mid B) = \\dfrac{\\mathrm{P}(A_j)\\mathrm{P}(B \\mid A_j)}{\\sum_i \\mathrm{P}(A_i)\\mathrm{P}(B \\mid A_i)}$",
  "notes": "The A_i are mutually exclusive and exhaustive.",
  "concepts": [
   "amaths.probability.bayes"
  ]
 },
 {
  "key": "probability.bayes.c03",
  "cardType": "FORMULA",
  "front": "Law of total probability",
  "back": "$\\mathrm{P}(B) = \\sum_i \\mathrm{P}(A_i)\\,\\mathrm{P}(B \\mid A_i)$",
  "concepts": [
   "amaths.probability.bayes"
  ]
 },
 {
