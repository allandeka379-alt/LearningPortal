 {
  "key": "probability.bayes.c01",
  "cardType": "FORMULA",
  "front": "Bayes' theorem (two events)",
  "back": "$\\mathrm{P}(A \\mid B) = \\dfrac{\\mathrm{P}(A)\\mathrm{P}(B \\mid A)}{\\mathrm{P}(A)\\mathrm{P}(B \\mid A) + \\mathrm{P}(A')\\mathrm{P}(B \\mid A')}$",
  "concepts": [
