  ]
 },
 {
  "key": "circular.motion.c02",
  "cardType": "FORMULA",
  "front": "Speed and acceleration in a circle",
  "back": "$v = r\\omega$; $a = r\\omega^2 = \\dfrac{v^2}{r}$ towards the centre.",
  "concepts": [
   "amaths.circular.motion"
  ]
 },
 {
  "key": "circular.motion.c03",
  "cardType": "FORMULA",
  "front": "Period of circular motion",
  "back": "$T = \\dfrac{2\\pi}{\\omega} = \\dfrac{2\\pi r}{v}$",
  "concepts": [
   "amaths.circular.motion"
  ]
 },
 {
  "key": "circular.motion.c04",
  "cardType": "CONCEPT",
  "front": "Method for a horizontal circle",
  "back": "Resolve vertically (forces balance) and towards the centre (resultant $= mr\\omega^2$).",
  "concepts": [
   "amaths.circular.motion"
  ]
 },
 {
  "key": "circular.motion.c05",
  "cardType": "FORMULA",
  "front": "Conical pendulum (string l at θ to vertical)",
  "back": "$r = l\\sin\\theta$, $T = ml\\omega^2$, $\\omega^2 = \\dfrac{g}{l\\cos\\theta}$.",
  "concepts": [
   "amaths.circular.motion"
  ]
 },
 {
  "key": "circular.motion.c06",
  "cardType": "FORMULA",
  "front": "Smooth banked track (no friction needed)",
  "back": "$\\tan\\theta = \\dfrac{v^2}{rg}$",
  "concepts": [
   "amaths.circular.motion"
  ]
 },
 {
  "key": "circular.motion.c07",
  "cardType": "FORMULA",
  "front": "Particle on a string in a vertical circle",
  "back": "Top: $T + mg = \\dfrac{mv^2}{r}$; bottom: $T - mg = \\dfrac{mv^2}{r}$.",
  "concepts": [
   "amaths.circular.motion"
  ]
 },
 {
  "key": "circular.motion.c08",
  "cardType": "FACT",
  "front": "Least speed at the top of a vertical circle on a string",
  "back": "$v = \\sqrt{gr}$ (tension zero at the top).",
  "concepts": [
   "amaths.circular.motion"
  ]
 },
 {
  "key": "circular.motion.c09",
  "cardType": "CONCEPT",
  "front": "'Centripetal force'",
  "back": "Not an extra force: it is the resultant of the real forces (friction, tension, reaction, weight) towards the centre.",
  "concepts": [
   "amaths.circular.motion"
  ]
 }
