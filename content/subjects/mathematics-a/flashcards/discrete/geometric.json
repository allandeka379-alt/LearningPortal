[
 {
  "key": "discrete.geometric.c01",
  "cardType": "DEFINITION",
  "front": "Geometric conditions",
  "back": "Independent trials, constant probability p of success, continued until the first success.",
  "concepts": [
   "amaths.discrete.geometric"
  ]
 },
 {
  "key": "discrete.geometric.c02",
  "cardType": "FORMULA",
  "front": "Geometric probability",
  "back": "$\\mathrm{P}(X = r) = (1 - p)^{r - 1}p$, $r = 1, 2, 3, \\ldots$",
  "notes": "In MF19.",
  "concepts": [
   "amaths.discrete.geometric"
  ]
 },
 {
  "key": "discrete.geometric.c03",
  "cardType": "FORMULA",
  "front": "Geometric tail",
  "back": "$\\mathrm{P}(X > r) = (1 - p)^r$; $\\mathrm{P}(X \\le r) = 1 - (1 - p)^r$",
  "concepts": [
   "amaths.discrete.geometric"
  ]
 },
 {
  "key": "discrete.geometric.c04",
  "cardType": "FORMULA",
  "front": "Geometric mean",
  "back": "$\\mathrm{E}(X) = \\dfrac{1}{p}$",
  "notes": "In MF19.",
  "concepts": [
   "amaths.discrete.geometric"
  ]
 },
 {
  "key": "discrete.geometric.c05",
  "cardType": "FORMULA",
  "front": "Geometric variance (ZIMSEC)",
  "back": "$\\mathrm{Var}(X) = \\dfrac{1 - p}{p^2}$",
  "notes": "Cambridge requires the expectation only.",
  "concepts": [
   "amaths.discrete.geometric"
  ],
  "applies": [
   "zimsec/a-level/statistics"
  ]
 },
 {
  "key": "discrete.geometric.c06",
  "cardType": "CONCEPT",
  "front": "Between two values",
  "back": "$\\mathrm{P}(a \\le X \\le b) = (1 - p)^{a - 1} - (1 - p)^b$",
  "concepts": [
   "amaths.discrete.geometric"
  ]
 },
 {
  "key": "discrete.geometric.c07",
  "cardType": "FACT",
  "front": "Mode",
  "back": "The mode of every geometric distribution is 1.",
  "concepts": [
   "amaths.discrete.geometric"
  ]
 },
 {
  "key": "discrete.geometric.c08",
  "cardType": "CONCEPT",
  "front": "Geometric vs binomial",
  "back": "Binomial: fixed number of trials, count successes. Geometric: count trials until the first success.",
  "concepts": [
   "amaths.discrete.geometric"
  ]
 }
]
