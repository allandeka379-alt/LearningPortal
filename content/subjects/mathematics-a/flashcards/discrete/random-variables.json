[
 {
  "key": "discrete.random-variables.c01",
  "cardType": "DEFINITION",
  "front": "Discrete random variable",
  "back": "A variable whose values are numbers decided by chance and can be listed (0, 1, 2, …).",
  "concepts": [
   "amaths.discrete.random-variables"
  ]
 },
 {
  "key": "discrete.random-variables.c02",
  "cardType": "FACT",
  "front": "Probability distribution",
  "back": "Every value with its probability; $\\sum \\mathrm{P}(X = x) = 1$.",
  "concepts": [
   "amaths.discrete.random-variables"
  ]
 },
 {
  "key": "discrete.random-variables.c03",
  "cardType": "FORMULA",
  "front": "Expectation",
  "back": "$\\mathrm{E}(X) = \\sum x\\,\\mathrm{P}(X = x)$",
  "notes": "In MF19.",
  "concepts": [
   "amaths.discrete.random-variables"
  ]
 },
 {
  "key": "discrete.random-variables.c04",
  "cardType": "FORMULA",
  "front": "Variance",
  "back": "$\\mathrm{Var}(X) = \\sum x^2\\,\\mathrm{P}(X = x) - [\\mathrm{E}(X)]^2$",
  "notes": "In MF19.",
  "concepts": [
   "amaths.discrete.random-variables"
  ]
 },
 {
  "key": "discrete.random-variables.c05",
  "cardType": "FORMULA",
  "front": "Discrete uniform on 1 to n",
  "back": "$\\mathrm{E}(X) = \\dfrac{n + 1}{2}$, $\\mathrm{Var}(X) = \\dfrac{n^2 - 1}{12}$",
  "notes": "ZIMSEC.",
  "concepts": [
   "amaths.discrete.random-variables"
  ],
  "applies": [
   "zimsec/a-level/statistics"
  ]
 },
 {
  "key": "discrete.random-variables.c06",
  "cardType": "CONCEPT",
  "front": "Unknown probabilities",
  "back": "Use ΣP = 1 and any given mean to form simultaneous equations.",
  "concepts": [
   "amaths.discrete.random-variables"
  ]
 },
 {
  "key": "discrete.random-variables.c07",
  "cardType": "CONCEPT",
  "front": "Meaning of E(X)",
  "back": "The long-run average value of X; it need not be a possible value.",
  "concepts": [
   "amaths.discrete.random-variables"
  ]
 },
 {
  "key": "discrete.random-variables.c08",
  "cardType": "FACT",
  "front": "Adding a constant",
  "back": "$\\mathrm{E}(X + c) = \\mathrm{E}(X) + c$; $\\mathrm{Var}(X + c) = \\mathrm{Var}(X)$.",
  "concepts": [
   "amaths.discrete.random-variables"
  ]
 },
 {
  "key": "discrete.random-variables.c09",
  "cardType": "CONCEPT",
  "front": "Standard deviation",
  "back": "$\\sqrt{\\mathrm{Var}(X)}$, in the units of $X$.",
  "concepts": [
   "amaths.discrete.random-variables"
  ]
 }
]
