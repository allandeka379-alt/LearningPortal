 },
 {
  "key": "complex.cartesian.c02",
  "cardType": "DEFINITION",
  "front": "Real and imaginary parts",
  "back": "For $z = x + \\mathrm{i}y$: $\\mathrm{Re}(z) = x$, $\\mathrm{Im}(z) = y$ (both real).",
  "concepts": [
   "amaths.complex.cartesian"
  ]
 },
 {
  "key": "complex.cartesian.c03",
  "cardType": "DEFINITION",
  "front": "Complex conjugate",
  "back": "$z^{*} = x - \\mathrm{i}y$: change the sign of the imaginary part.",
  "concepts": [
   "amaths.complex.cartesian"
  ]
 },
 {
  "key": "complex.cartesian.c04",
  "cardType": "FORMULA",
  "front": "z times its conjugate",
  "back": "$zz^{*} = x^2 + y^2$ (real, non-negative).",
  "concepts": [
   "amaths.complex.cartesian"
  ]
 },
 {
  "key": "complex.cartesian.c05",
  "cardType": "CONCEPT",
  "front": "Dividing complex numbers",
  "back": "Multiply numerator and denominator by the conjugate of the denominator, then split into real and imaginary parts.",
  "concepts": [
   "amaths.complex.cartesian"
  ]
 },
 {
  "key": "complex.cartesian.c06",
  "cardType": "FACT",
  "front": "Equality of complex numbers",
  "back": "$a + \\mathrm{i}b = c + \\mathrm{i}d \\iff a = c$ and $b = d$ (one complex equation gives two real ones).",
  "concepts": [
   "amaths.complex.cartesian"
  ]
 },
 {
  "key": "complex.cartesian.c07",
  "cardType": "CONCEPT",
  "front": "Square roots of a + ib",
  "back": "Set $(x + \\mathrm{i}y)^2 = a + \\mathrm{i}b$: $x^2 - y^2 = a$, $2xy = b$; solve the quadratic in $x^2$ and reject negative $x^2$.",
  "concepts": [
   "amaths.complex.cartesian"
  ]
 },
 {
  "key": "complex.cartesian.c08",
  "cardType": "FACT",
  "front": "Quadratic with negative discriminant",
  "back": "Roots $p \\pm \\mathrm{i}q$, a conjugate pair; sum $2p$, product $p^2 + q^2$.",
  "concepts": [
   "amaths.complex.cartesian"
  ]
 },
 {
  "key": "complex.cartesian.c09",
  "cardType": "FACT",
  "front": "Powers of i",
  "back": "$\\mathrm{i}, -1, -\\mathrm{i}, 1$ repeat with period 4: $\\mathrm{i}^{4k} = 1$.",
  "concepts": [
   "amaths.complex.cartesian"
  ]
 }
]
