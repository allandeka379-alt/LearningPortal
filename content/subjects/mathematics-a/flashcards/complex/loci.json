[
 {
  "key": "complex.loci.c01",
  "cardType": "CONCEPT",
  "front": "|z − a| as a distance",
  "back": "$|z - a|$ is the distance from the point $a$. Rewrite $|z + 2 - \\mathrm{i}|$ as $|z - (-2 + \\mathrm{i})|$.",
  "concepts": [
   "amaths.complex.loci"
  ]
 },
 {
  "key": "complex.loci.c02",
  "cardType": "FACT",
  "front": "Circle locus",
  "back": "$|z - a| = r$: circle, centre $a$, radius $r$; $|z - a| \\le r$ is the disc including the boundary.",
  "concepts": [
   "amaths.complex.loci"
  ]
 },
 {
  "key": "complex.loci.c03",
  "cardType": "FACT",
  "front": "Perpendicular bisector locus",
  "back": "$|z - a| = |z - b|$: the perpendicular bisector of the segment from $a$ to $b$.",
  "concepts": [
   "amaths.complex.loci"
  ]
 },
 {
  "key": "complex.loci.c04",
  "cardType": "FACT",
  "front": "Half-line locus",
  "back": "$\\arg(z - a) = \\alpha$: half-line from $a$ at angle $\\alpha$; the point $a$ is excluded.",
  "concepts": [
   "amaths.complex.loci"
  ]
 },
 {
  "key": "complex.loci.c05",
  "cardType": "CONCEPT",
  "front": "Dashed or solid boundaries",
  "back": "Strict inequalities ($<$, $>$) exclude the boundary (dashed); $\\le$, $\\ge$ include it (solid).",
  "concepts": [
   "amaths.complex.loci"
  ]
 },
 {
  "key": "complex.loci.c06",
  "cardType": "FORMULA",
  "front": "Range of |z| on a disc",
  "back": "For $|z - c| \\le r$ with $O$ outside: $|c| - r \\le |z| \\le |c| + r$.",
  "concepts": [
   "amaths.complex.loci"
  ]
 },
 {
  "key": "complex.loci.c07",
  "cardType": "FORMULA",
  "front": "Extreme arguments on a disc",
  "back": "$\\arg c \\pm \\sin^{-1}\\dfrac{r}{|c|}$ (tangents from $O$; radius ⟂ tangent).",
  "concepts": [
   "amaths.complex.loci"
  ]
 },
 {
  "key": "complex.loci.c08",
  "cardType": "CONCEPT",
  "front": "Cartesian equation of a locus",
  "back": "Put $z = x + \\mathrm{i}y$, write each modulus as a square root, square both sides and simplify.",
  "concepts": [
   "amaths.complex.loci"
  ]
 },
 {
  "key": "complex.loci.c09",
  "cardType": "CONCEPT",
  "front": "Coefficient of z",
  "back": "Divide it out: $|kz - a| = r \\iff \\left|z - \\frac{a}{k}\\right| = \\frac{r}{|k|}$.",
  "concepts": [
   "amaths.complex.loci"
  ]
 }
]
