  "concepts": [
   "amaths.normal.probabilities"
  ]
 },
 {
  "key": "normal.probabilities.c04",
  "cardType": "FORMULA",
  "front": "Probability between values",
  "back": "$\\mathrm{P}(a < Z < b) = \\Phi(b) - \\Phi(a)$",
  "concepts": [
   "amaths.normal.probabilities"
  ]
 },
 {
