[
 {
  "key": "data.mean-sd.c01",
  "cardType": "FORMULA",
  "front": "Variance (data)",
  "back": "$\\sigma^2 = \\dfrac{\\sum (x - \\bar{x})^2}{n} = \\dfrac{\\sum x^2}{n} - \\bar{x}^2$",
  "notes": "MF19 gives this; divisor n for data.",
  "concepts": [
   "amaths.data.mean-sd"
  ]
 },
 {
  "key": "data.mean-sd.c02",
  "cardType": "FORMULA",
  "front": "Variance of a frequency table",
  "back": "$\\sigma^2 = \\dfrac{\\sum fx^2}{\\sum f} - \\bar{x}^2$ (grouped data: $x$ = mid-points).",
  "concepts": [
   "amaths.data.mean-sd"
  ]
 },
 {
  "key": "data.mean-sd.c03",
  "cardType": "FORMULA",
  "front": "Coded data y = x − a",
  "back": "$\\bar{x} = a + \\dfrac{\\sum (x - a)}{n}$; $\\sigma_x = \\sigma_y$.",
  "concepts": [
   "amaths.data.mean-sd"
  ]
 },
 {
  "key": "data.mean-sd.c04",
  "cardType": "FORMULA",
  "front": "Rebuilding totals",
  "back": "$\\sum x = n\\bar{x}$, $\\sum x^2 = n(\\sigma^2 + \\bar{x}^2)$",
  "concepts": [
   "amaths.data.mean-sd"
  ]
 },
 {
  "key": "data.mean-sd.c05",
  "cardType": "CONCEPT",
  "front": "Combining two data sets",
  "back": "Rebuild Σx and Σx² for each group, add them, then use the formulas for the combined n. Never average the sds.",
  "concepts": [
   "amaths.data.mean-sd"
  ]
 },
 {
  "key": "data.mean-sd.c06",
  "cardType": "FACT",
  "front": "Linear changes",
  "back": "$y = x + c$: sd unchanged. $y = kx$: sd multiplied by $|k|$, variance by $k^2$.",
  "concepts": [
   "amaths.data.mean-sd"
  ]
 },
 {
  "key": "data.mean-sd.c07",
  "cardType": "DEFINITION",
  "front": "Standard deviation",
  "back": "The square root of the variance: roughly the typical distance of a value from the mean, in the data's units.",
  "concepts": [
   "amaths.data.mean-sd"
  ]
 },
 {
  "key": "data.mean-sd.c08",
  "cardType": "CONCEPT",
  "front": "Interpreting the sd",
  "back": "A smaller standard deviation means the data are more consistent (less spread about the mean). Pair it with the mean.",
  "concepts": [
   "amaths.data.mean-sd"
  ]
 }
]
