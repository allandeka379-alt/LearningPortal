[
 {
  "key": "bivariate.regression-correlation.c01",
  "cardType": "FORMULA",
  "front": "Summary statistics",
  "back": "$S_{xx} = \\sum x^2 - \\dfrac{(\\sum x)^2}{n}$, $S_{yy} = \\sum y^2 - \\dfrac{(\\sum y)^2}{n}$, $S_{xy} = \\sum xy - \\dfrac{\\sum x \\sum y}{n}$",
  "concepts": [
   "amaths.bivariate.regression-correlation"
  ]
 },
 {
  "key": "bivariate.regression-correlation.c02",
  "cardType": "FORMULA",
  "front": "Regression line of y on x",
  "back": "$y = a + bx$, $b = \\dfrac{S_{xy}}{S_{xx}}$, $a = \\bar{y} - b\\bar{x}$; passes through $(\\bar{x}, \\bar{y})$.",
  "concepts": [
   "amaths.bivariate.regression-correlation"
  ]
 },
 {
  "key": "bivariate.regression-correlation.c03",
  "cardType": "FORMULA",
  "front": "Regression line of x on y",
  "back": "$x = a' + b'y$, $b' = \\dfrac{S_{xy}}{S_{yy}}$, $a' = \\bar{x} - b'\\bar{y}$.",
  "concepts": [
   "amaths.bivariate.regression-correlation"
  ]
 },
 {
  "key": "bivariate.regression-correlation.c04",
  "cardType": "FORMULA",
  "front": "Product moment correlation coefficient",
  "back": "$r = \\dfrac{S_{xy}}{\\sqrt{S_{xx}S_{yy}}}$, $-1 \\le r \\le 1$; and $r^2 = b \\times b'$.",
  "concepts": [
   "amaths.bivariate.regression-correlation"
  ]
 },
 {
  "key": "bivariate.regression-correlation.c05",
  "cardType": "DEFINITION",
  "front": "Coefficient of determination",
  "back": "$r^2$: the proportion of the variation in $y$ explained by the linear relationship with $x$.",
  "concepts": [
   "amaths.bivariate.regression-correlation"
  ]
 },
 {
  "key": "bivariate.regression-correlation.c06",
  "cardType": "CONCEPT",
  "front": "Interpolation and extrapolation",
  "back": "Predictions inside the data range (interpolation) are reasonable; outside it (extrapolation) they are unreliable.",
  "concepts": [
   "amaths.bivariate.regression-correlation"
  ]
 },
 {
  "key": "bivariate.regression-correlation.c07",
  "cardType": "CONCEPT",
  "front": "Which line to use",
  "back": "Predict y from x with y on x; estimate x from y with x on y. If x is controlled, use only y on x.",
  "concepts": [
   "amaths.bivariate.regression-correlation"
  ]
 },
 {
  "key": "bivariate.regression-correlation.c08",
  "cardType": "FACT",
  "front": "Correlation is not causation",
  "back": "A strong r shows association; a third variable may cause both.",
  "concepts": [
   "amaths.bivariate.regression-correlation"
  ]
 }
]
