[
 {
  "key": "sampling.sample-mean-clt.c01",
  "cardType": "FORMULA",
  "front": "Distribution of the sample mean $\\bar{X}$",
  "back": "$\\mathrm{E}(\\bar{X}) = \\mu$, $\\mathrm{Var}(\\bar{X}) = \\frac{\\sigma^2}{n}$",
  "concepts": [
