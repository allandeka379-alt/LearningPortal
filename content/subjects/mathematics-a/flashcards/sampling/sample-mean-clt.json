  ]
 },
 {
  "key": "sampling.sample-mean-clt.c02",
  "cardType": "DEFINITION",
  "front": "Standard error of the mean",
  "back": "$\\frac{\\sigma}{\\sqrt{n}}$, the standard deviation of $\\bar{X}$.",
  "concepts": [
   "amaths.sampling.sample-mean-clt"
  ]
 },
 {
  "key": "sampling.sample-mean-clt.c03",
  "cardType": "FACT",
  "front": "Sample mean from a normal population",
  "back": "If $X \\sim \\mathrm{N}(\\mu, \\sigma^2)$, then $\\bar{X} \\sim \\mathrm{N}\\left(\\mu, \\frac{\\sigma^2}{n}\\right)$ exactly, for any $n$.",
  "concepts": [
   "amaths.sampling.sample-mean-clt"
  ]
 },
 {
  "key": "sampling.sample-mean-clt.c04",
  "cardType": "DEFINITION",
  "front": "Central limit theorem",
  "back": "For a large random sample from any population with mean $\\mu$ and variance $\\sigma^2$, $\\bar{X} \\approx \\mathrm{N}\\left(\\mu, \\frac{\\sigma^2}{n}\\right)$.",
  "notes": "Rule of thumb: n ≥ 30.",
  "concepts": [
   "amaths.sampling.sample-mean-clt"
  ]
 },
 {
  "key": "sampling.sample-mean-clt.c05",
  "cardType": "CONCEPT",
  "front": "When the CLT is needed",
  "back": "Only when the population is not normal; then the sample must be large.",
  "concepts": [
   "amaths.sampling.sample-mean-clt"
  ]
 },
 {
  "key": "sampling.sample-mean-clt.c06",
  "cardType": "FORMULA",
  "front": "Total $T$ of $n$ independent observations",
  "back": "$\\mathrm{E}(T) = n\\mu$, $\\mathrm{Var}(T) = n\\sigma^2$",
  "notes": "Not n²σ²: that would be nX, one observation scaled.",
  "concepts": [
   "amaths.sampling.sample-mean-clt"
  ]
 },
 {
  "key": "sampling.sample-mean-clt.c07",
  "cardType": "CONCEPT",
  "front": "Effect of sample size on the standard error",
  "back": "Quadrupling n halves the standard error.",
  "concepts": [
   "amaths.sampling.sample-mean-clt"
  ]
 },
 {
  "key": "sampling.sample-mean-clt.c08",
  "cardType": "FACT",
  "front": "Population vs sampling distribution",
  "back": "The CLT changes nothing about the population; it describes the distribution of the sample mean.",
  "concepts": [
   "amaths.sampling.sample-mean-clt"
  ]
 },
 {
  "key": "sampling.sample-mean-clt.c09",
  "cardType": "CONCEPT",
  "front": "Mean of a Poisson sample",
  "back": "If $X \\sim \\mathrm{Po}(\\lambda)$ and $n$ is large, $\\bar{X} \\approx \\mathrm{N}\\left(\\lambda, \\frac{\\lambda}{n}\\right)$.",
  "concepts": [
   "amaths.sampling.sample-mean-clt"
  ]
 }
]
