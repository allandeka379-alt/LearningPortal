[
 {
  "key": "energy.power.c01",
  "cardType": "DEFINITION",
  "front": "Power",
  "back": "The rate of doing work; unit watt, $1$ W $= 1$ J s$^{-1}$.",
  "concepts": [
   "amaths.energy.power"
  ]
 },
 {
  "key": "energy.power.c02",
  "cardType": "FORMULA",
  "front": "Average power",
  "back": "$\\dfrac{\\text{work done}}{\\text{time taken}}$",
  "concepts": [
   "amaths.energy.power"
  ]
 },
 {
  "key": "energy.power.c03",
  "cardType": "FORMULA",
  "front": "Power of a moving force",
  "back": "$P = Fv$ (force along the motion).",
  "concepts": [
   "amaths.energy.power"
  ]
 },
 {
  "key": "energy.power.c04",
  "cardType": "FORMULA",
  "front": "Driving force of an engine",
  "back": "$F = \\dfrac{P}{v}$ — convert kW to W first.",
  "concepts": [
   "amaths.energy.power"
  ]
 },
 {
  "key": "energy.power.c05",
  "cardType": "CONCEPT",
  "front": "Greatest speed",
  "back": "Acceleration zero: $\\frac{P}{v_{\\max}}$ equals the total resistance (add $mg\\sin\\alpha$ uphill, subtract it downhill).",
  "concepts": [
   "amaths.energy.power"
  ]
 },
 {
  "key": "energy.power.c06",
  "cardType": "CONCEPT",
  "front": "Acceleration at an instant",
  "back": "$\\frac{P}{v} - \\text{resistance} \\mp mg\\sin\\alpha = ma$.",
  "concepts": [
   "amaths.energy.power"
  ]
 },
 {
  "key": "energy.power.c07",
  "cardType": "FACT",
  "front": "Constant power",
  "back": "The driving force falls as the speed rises, so the acceleration is not constant: do not use suvat.",
  "concepts": [
   "amaths.energy.power"
  ]
 },
 {
  "key": "energy.power.c08",
  "cardType": "CONCEPT",
  "front": "Power and energy together",
  "back": "Work done by an engine of constant power P in time t is Pt; use it in the work–energy principle.",
  "concepts": [
   "amaths.energy.power"
  ]
 },
 {
  "key": "energy.power.c09",
  "cardType": "FACT",
  "front": "Speed conversion",
  "back": "$1$ km h$^{-1}$ $= \\frac{1000}{3600}$ m s$^{-1}$; e.g. $72$ km h$^{-1}$ $= 20$ m s$^{-1}$.",
  "concepts": [
   "amaths.energy.power"
  ]
 }
