[
 {
  "key": "projectiles.motion.c01",
  "cardType": "DEFINITION",
  "front": "Projectile",
  "back": "A particle moving freely under gravity alone (air resistance ignored); acceleration g vertically downwards throughout.",
  "concepts": [
   "amaths.projectiles.motion"
  ]
 },
 {
  "key": "projectiles.motion.c02",
  "cardType": "FORMULA",
  "front": "Projectile equations of motion (speed u, angle α, origin at launch, up positive)",
  "back": "$x = (u\\cos\\alpha)t$, $y = (u\\sin\\alpha)t - \\tfrac{1}{2}gt^2$; $\\dot{x} = u\\cos\\alpha$, $\\dot{y} = u\\sin\\alpha - gt$.",
  "concepts": [
   "amaths.projectiles.motion"
  ]
 },
 {
  "key": "projectiles.motion.c03",
  "cardType": "FORMULA",
  "front": "Time of flight on level ground",
  "back": "$T = \\dfrac{2u\\sin\\alpha}{g}$",
  "concepts": [
   "amaths.projectiles.motion"
  ]
 },
 {
  "key": "projectiles.motion.c04",
  "cardType": "FORMULA",
  "front": "Greatest height",
  "back": "$H = \\dfrac{u^2\\sin^2\\alpha}{2g}$, reached at $t = \\dfrac{u\\sin\\alpha}{g}$.",
  "concepts": [
   "amaths.projectiles.motion"
  ]
 },
 {
  "key": "projectiles.motion.c05",
  "cardType": "FORMULA",
  "front": "Range on level ground and maximum range",
  "back": "$R = \\dfrac{u^2\\sin 2\\alpha}{g}$; maximum $\\dfrac{u^2}{g}$ at $\\alpha = 45°$.",
  "concepts": [
   "amaths.projectiles.motion"
  ]
 },
 {
  "key": "projectiles.motion.c06",
  "cardType": "FORMULA",
  "front": "Equation of the trajectory",
  "back": "$y = x\\tan\\alpha - \\dfrac{gx^2}{2u^2\\cos^2\\alpha} = x\\tan\\alpha - \\dfrac{gx^2}{2u^2}(1 + \\tan^2\\alpha)$, a parabola.",
  "concepts": [
   "amaths.projectiles.motion"
  ]
 },
 {
  "key": "projectiles.motion.c07",
  "cardType": "FACT",
  "front": "Angles giving equal ranges",
  "back": "$\\alpha$ and $90° - \\alpha$ (same speed, level ground), since $\\sin 2\\alpha = \\sin(180° - 2\\alpha)$.",
  "concepts": [
   "amaths.projectiles.motion"
  ]
 },
 {
  "key": "projectiles.motion.c08",
  "cardType": "CONCEPT",
  "front": "Velocity of a projectile at time t",
  "back": "Speed √(ẋ² + ẏ²); direction tan⁻¹|ẏ/ẋ| with the horizontal, above if ẏ > 0 (rising), below if ẏ < 0 (falling).",
  "concepts": [
   "amaths.projectiles.motion"
  ]
 },
 {
  "key": "projectiles.motion.c09",
  "cardType": "CONCEPT",
  "front": "Projected from a height h",
  "back": "Level-ground formulae do not apply: solve y = −h for t (positive root), then x = (u cos α)t.",
  "concepts": [
   "amaths.projectiles.motion"
  ]
 }
]
