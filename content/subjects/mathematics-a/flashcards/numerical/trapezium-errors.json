[
 {
  "key": "numerical.trapezium-errors.c01",
  "cardType": "FORMULA",
  "front": "Trapezium rule",
  "back": "$\\int_a^b y\\,\\mathrm{d}x \\approx \\frac{1}{2}h[y_0 + 2(y_1 + \\dots + y_{n-1}) + y_n]$, $h = \\frac{b - a}{n}$ (in MF19).",
  "concepts": [
   "amaths.numerical.trapezium-errors"
  ]
 },
 {
  "key": "numerical.trapezium-errors.c02",
  "cardType": "FACT",
  "front": "Strips and ordinates",
  "back": "n strips need n + 1 ordinates; only the inner ordinates are doubled.",
  "concepts": [
   "amaths.numerical.trapezium-errors"
  ]
 },
 {
  "key": "numerical.trapezium-errors.c03",
  "cardType": "FACT",
  "front": "Over- or under-estimate",
  "back": "Convex curve ($y'' > 0$): over-estimate. Concave curve ($y'' < 0$): under-estimate.",
  "concepts": [
   "amaths.numerical.trapezium-errors"
  ]
 },
 {
  "key": "numerical.trapezium-errors.c04",
  "cardType": "CONCEPT",
  "front": "Improving the estimate",
  "back": "More, narrower strips; for a smooth curve doubling n divides the error by about 4.",
  "concepts": [
   "amaths.numerical.trapezium-errors"
  ]
 },
 {
  "key": "numerical.trapezium-errors.c05",
  "cardType": "CONCEPT",
  "front": "Bounds with rectangles",
  "back": "For a decreasing function, left-hand heights give an upper bound and right-hand heights a lower bound (swap for increasing).",
  "concepts": [
   "amaths.numerical.trapezium-errors"
  ],
  "applies": [
   "zimsec/a-level/pure-mathematics"
  ]
 },
 {
  "key": "numerical.trapezium-errors.c06",
  "cardType": "DEFINITION",
  "front": "Absolute error",
  "back": "$|x - X|$, where $X$ is the true value and $x$ the approximation.",
  "concepts": [
   "amaths.numerical.trapezium-errors"
  ],
  "applies": [
   "zimsec/a-level/pure-mathematics"
  ]
 },
 {
  "key": "numerical.trapezium-errors.c07",
  "cardType": "DEFINITION",
  "front": "Relative error",
  "back": "$\\dfrac{|x - X|}{|X|}$; multiply by 100 for a percentage error.",
  "concepts": [
   "amaths.numerical.trapezium-errors"
  ],
  "applies": [
   "zimsec/a-level/pure-mathematics"
  ]
 },
 {
  "key": "numerical.trapezium-errors.c08",
  "cardType": "FACT",
  "front": "Error of a rounded measurement",
  "back": "A value to the nearest u lies within u/2 of the true value.",
  "concepts": [
   "amaths.numerical.trapezium-errors"
  ],
  "applies": [
   "zimsec/a-level/pure-mathematics"
  ]
 },
 {
  "key": "numerical.trapezium-errors.c09",
  "cardType": "CONCEPT",
  "front": "Combining errors",
  "back": "Adding or subtracting: absolute errors add. Multiplying or dividing: relative errors (approximately) add.",
  "concepts": [
   "amaths.numerical.trapezium-errors"
  ],
  "applies": [
   "zimsec/a-level/pure-mathematics"
  ]
 }
]
