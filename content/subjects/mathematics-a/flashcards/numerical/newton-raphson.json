[
 {
  "key": "numerical.newton-raphson.c01",
  "cardType": "FORMULA",
  "front": "Newton–Raphson",
  "back": "$x_{n+1} = x_n - \\dfrac{f(x_n)}{f'(x_n)}$",
  "concepts": [
   "amaths.numerical.newton-raphson"
  ]
 },
 {
  "key": "numerical.newton-raphson.c02",
  "cardType": "CONCEPT",
  "front": "Where the formula comes from",
  "back": "The tangent at $(x_n, f(x_n))$ crosses the $x$-axis at $x_{n+1}$: set $y = 0$ in $y - f(x_n) = f'(x_n)(x - x_n)$.",
  "concepts": [
   "amaths.numerical.newton-raphson"
  ]
 },
 {
  "key": "numerical.newton-raphson.c03",
  "cardType": "FACT",
  "front": "Speed of convergence",
  "back": "Near a simple root, Newton–Raphson converges very fast: correct decimal places roughly double each step.",
  "concepts": [
   "amaths.numerical.newton-raphson"
  ]
 },
 {
  "key": "numerical.newton-raphson.c04",
  "cardType": "FACT",
  "front": "Failure: stationary point",
  "back": "If $f'(x_n) = 0$ (or is very small) the tangent is (nearly) horizontal and $x_{n+1}$ is undefined or far away.",
  "concepts": [
   "amaths.numerical.newton-raphson"
  ]
 },
 {
  "key": "numerical.newton-raphson.c05",
  "cardType": "FACT",
  "front": "Failure: wrong root",
  "back": "A start between roots or near a turning point can send the iterates to a different root from the one wanted.",
  "concepts": [
   "amaths.numerical.newton-raphson"
  ]
 },
 {
  "key": "numerical.newton-raphson.c06",
  "cardType": "CONCEPT",
  "front": "Square roots by Newton–Raphson",
  "back": "For $x^2 - N = 0$: $x_{n+1} = \\frac{1}{2}\\left(x_n + \\frac{N}{x_n}\\right)$.",
  "concepts": [
   "amaths.numerical.newton-raphson"
  ]
 },
 {
  "key": "numerical.newton-raphson.c07",
  "cardType": "CONCEPT",
  "front": "Simplifying the iteration",
  "back": "Write $x - \\frac{f(x)}{f'(x)}$ as one fraction before iterating, e.g. $\\frac{2x^3 - 2}{3x^2 - 6}$.",
  "concepts": [
   "amaths.numerical.newton-raphson"
  ]
 },
 {
  "key": "numerical.newton-raphson.c08",
  "cardType": "CONCEPT",
  "front": "Justifying accuracy",
  "back": "Finish with a change of sign half a unit either side of the answer.",
  "concepts": [
   "amaths.numerical.newton-raphson"
  ]
 },
 {
  "key": "numerical.newton-raphson.c09",
  "cardType": "FACT",
  "front": "Trigonometric equations",
  "back": "Use radians: the derivatives of sin x and cos x are cos x and −sin x only in radians.",
  "concepts": [
   "amaths.numerical.newton-raphson"
  ]
 }
]
