[
 {
  "key": "series.geometric.c01",
  "cardType": "DEFINITION",
  "front": "Geometric progression",
  "back": "Each term is the previous term multiplied by the common ratio $r = \\frac{u_{n+1}}{u_n}$.",
  "concepts": [
   "amaths.series.geometric"
  ]
 },
 {
  "key": "series.geometric.c02",
  "cardType": "FORMULA",
  "front": "nth term of a GP",
  "back": "$u_n = ar^{n-1}$",
  "concepts": [
   "amaths.series.geometric"
  ]
 },
 {
  "key": "series.geometric.c03",
  "cardType": "FORMULA",
  "front": "Sum of n terms of a GP",
  "back": "$S_n = \\frac{a(1 - r^n)}{1 - r} = \\frac{a(r^n - 1)}{r - 1}$, $r \\neq 1$",
  "notes": "In MF19.",
  "concepts": [
   "amaths.series.geometric"
  ]
 },
 {
  "key": "series.geometric.c04",
  "cardType": "FORMULA",
  "front": "Sum to infinity",
  "back": "$S_\\infty = \\frac{a}{1 - r}$, only when $|r| < 1$",
  "concepts": [
   "amaths.series.geometric"
  ]
 },
 {
  "key": "series.geometric.c05",
  "cardType": "FACT",
  "front": "Three terms in GP",
  "back": "$a, b, c$ are in GP when $b^2 = ac$.",
  "concepts": [
   "amaths.series.geometric"
  ]
 },
 {
  "key": "series.geometric.c06",
  "cardType": "CONCEPT",
  "front": "Finding r from two terms",
  "back": "Divide the equations: $\\frac{ar^5}{ar^2} = r^3$.",
  "concepts": [
   "amaths.series.geometric"
  ]
 },
 {
  "key": "series.geometric.c07",
  "cardType": "CONCEPT",
  "front": "Least n with logarithms",
  "back": "Take logs of both sides; dividing by the log of a number below 1 reverses the inequality.",
  "concepts": [
   "amaths.series.geometric"
  ]
 },
 {
  "key": "series.geometric.c08",
  "cardType": "CONCEPT",
  "front": "Bouncing ball",
  "back": "Total distance = first drop + 2 × (sum of all rebound heights).",
  "concepts": [
   "amaths.series.geometric"
  ]
 },
 {
  "key": "series.geometric.c09",
  "cardType": "CONCEPT",
  "front": "Percentage change",
  "back": "Growth of $p\\%$: multiply by $1 + \\frac{p}{100}$; decay: multiply by $1 - \\frac{p}{100}$.",
  "concepts": [
   "amaths.series.geometric"
  ]
 }
]
