  "front": "Smooth light pulley",
  "back": "The tension is the same on both sides.",
  "concepts": [
   "amaths.newton.connected-particles"
  ]
 },
 {
  "key": "newton.connected-particles.c03",
  "cardType": "CONCEPT",
  "front": "Method for connected particles",
  "back": "Write F = ma for each particle in its own direction of motion; add the equations to eliminate T.",
  "concepts": [
   "amaths.newton.connected-particles"
  ]
 },
 {
  "key": "newton.connected-particles.c04",
  "cardType": "FORMULA",
  "front": "Two hanging particles",
  "back": "$a = \\dfrac{(m_1 - m_2)g}{m_1 + m_2}$, $T = \\dfrac{2m_1m_2g}{m_1 + m_2}$",
  "concepts": [
   "amaths.newton.connected-particles"
  ]
 },
 {
  "key": "newton.connected-particles.c05",
  "cardType": "CONCEPT",
  "front": "Whole-system method",
  "back": "For bodies moving in one straight line, total external force = total mass × a; internal forces cancel.",
  "concepts": [
   "amaths.newton.connected-particles"
  ]
 },
 {
  "key": "newton.connected-particles.c06",
  "cardType": "CONCEPT",
  "front": "Tension and thrust",
  "back": "A string can only pull; a rigid rod or tow-bar can pull (tension) or push (thrust).",
  "concepts": [
   "amaths.newton.connected-particles"
  ]
 },
 {
  "key": "newton.connected-particles.c07",
  "cardType": "CONCEPT",
  "front": "After a particle lands",
  "back": "The string goes slack (T = 0); the other particle moves on under gravity (and friction) alone.",
  "concepts": [
   "amaths.newton.connected-particles"
  ]
 },
 {
  "key": "newton.connected-particles.c08",
  "cardType": "FACT",
  "front": "Check that motion occurs",
  "back": "On a rough table, the system moves only if the hanging weight exceeds μR for the block.",
  "concepts": [
   "amaths.newton.connected-particles"
  ]
 },
 {
  "key": "newton.connected-particles.c09",
  "cardType": "FACT",
  "front": "Tension and hanging weight",
  "back": "A hanging particle accelerating down has T < mg; accelerating up, T > mg.",
  "concepts": [
   "amaths.newton.connected-particles"
  ]
 }
]
