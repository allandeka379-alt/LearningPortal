    "estimatedSeconds": 30,
    "stem": "What is a **frustum**?",
    "options": [
      {
        "key": "A",
        "content": "The part of a cone or pyramid left when the top is cut off parallel to the base",
        "correct": true,
        "rationale": "A bucket or a lampshade is a frustum of a cone."
      },
      {
        "key": "B",
        "content": "Half of a sphere",
        "rationale": "Half of a sphere is a hemisphere."
      },
      {
        "key": "C",
        "content": "A cylinder with a cone on top",
        "rationale": "That is a compound solid, but not a frustum."
      },
      {
        "key": "D",
        "content": "A prism with a triangular cross-section",
        "rationale": "That is a triangular prism."
      }
    ],
    "explanation": "A frustum is what remains of a cone (or pyramid) after the top has been cut off by a cut parallel to the base. Its volume is the large cone minus the small cone removed.",
