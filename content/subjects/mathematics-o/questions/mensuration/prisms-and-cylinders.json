    "difficulty": 1,
    "marks": 1,
    "estimatedSeconds": 30,
    "stem": "How is the volume of any prism calculated?",
    "options": [
      {
        "key": "A",
        "content": "Area of the cross-section $\\times$ length",
        "correct": true,
        "rationale": "Every slice of a prism is the same, so volume $=$ cross-section area $\\times$ length."
      },
      {
        "key": "B",
        "content": "Perimeter of the cross-section $\\times$ length",
        "rationale": "Perimeter $\\times$ length gives the area of the sides, not the volume."
      },
      {
        "key": "C",
        "content": "$\\frac{1}{3} \\times$ area of the base $\\times$ height",
        "rationale": "The $\\frac{1}{3}$ is used for pyramids and cones, not prisms."
      },
      {
        "key": "D",
        "content": "Total surface area $\\times$ length",
        "rationale": "Surface area is already an area of the outside; multiplying it by a length has no meaning here."
      }
    ],
    "explanation": "A prism has the same cross-section all along its length, so its volume is the area of the cross-section multiplied by the length.",
