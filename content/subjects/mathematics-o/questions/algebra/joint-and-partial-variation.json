    "difficulty": 1,
    "marks": 1,
    "estimatedSeconds": 30,
    "stem": "$z$ varies jointly as $x$ and $y$. Which equation shows this, where $k$ is a constant?",
    "options": [
      {
        "key": "A",
        "content": "$z = kxy$",
        "correct": true,
        "rationale": "Joint variation multiplies the constant by both quantities."
      },
