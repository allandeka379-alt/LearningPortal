    "stem": "This question is about adding fractions of the form $\\dfrac{1}{n(n + 1)}$.",
    "parts": [
      {
        "label": "(a)",
        "type": "SHORT_ANSWER",
        "markingMode": "MANUAL",
        "marks": 2,
        "stem": "Show that $\\dfrac{1}{x} - \\dfrac{1}{x + 1} = \\dfrac{1}{x(x + 1)}$.",
