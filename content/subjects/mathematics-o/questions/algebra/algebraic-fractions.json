      {
        "label": "(b)",
        "type": "NUMERICAL",
        "marks": 2,
        "stem": "Hence find the exact value of $\\dfrac{1}{1 \\times 2} + \\dfrac{1}{2 \\times 3} + \\dfrac{1}{3 \\times 4} + \\cdots + \\dfrac{1}{9 \\times 10}$.",
        "answerSpec": {
          "value": 0.9
