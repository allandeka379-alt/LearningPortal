    "difficulty": 1,
    "marks": 1,
    "estimatedSeconds": 30,
    "stem": "What is the highest common factor (HCF) of $8x$ and $12x^2$?",
    "options": [
      {
        "key": "A",
        "content": "$4x$",
        "correct": true,
        "rationale": "4 is the HCF of 8 and 12, and $x$ is the highest power of $x$ in both terms."
      },
      {
        "key": "B",
        "content": "$4$",
        "rationale": "$x$ is also a common factor of both terms."
      },
      {
        "key": "C",
        "content": "$2x$",
        "rationale": "2 is a common factor of 8 and 12, but not the highest: 4 is."
      },
      {
        "key": "D",
        "content": "$4x^2$",
        "rationale": "$x^2$ is not a factor of $8x$."
      }
    ],
    "explanation": "The HCF of 8 and 12 is 4. Both terms contain $x$, but only $12x^2$ contains $x^2$. So the HCF is $4x$, and $8x + 12x^2 = 4x(2 + 3x)$.",
    "hints": [
      "Find the HCF of the numbers, then the lowest power of each letter that appears in both terms."
