    "difficulty": 1,
    "marks": 1,
    "estimatedSeconds": 30,
    "stem": "In a Venn diagram of two overlapping circles $A$ and $B$ inside a rectangle $\\mathscr{E}$, which part represents $A \\cup B$?",
    "options": [
      {
        "key": "A",
        "content": "Everything inside either circle (including the overlap)",
        "correct": true,
        "rationale": "The union contains every element in A or B or both."
      },
      {
        "key": "B",
        "content": "Only the overlap of the two circles",
        "rationale": "That is the intersection $A \\cap B$."
      },
      {
        "key": "C",
        "content": "Everything outside both circles",
        "rationale": "That is $(A \\cup B)'$."
      },
      {
        "key": "D",
        "content": "Circle A without the overlap",
        "rationale": "That is $A \\cap B'$."
      }
    ],
    "explanation": "$A \\cup B$ is the set of elements in $A$ or $B$ or both, so it is the whole of both circles, overlap included.",
    "hints": [
      "Union means 'or': in A, in B, or in both."
    ],
