[
  {
    "key": "coordinate.length-midpoint.q01",
    "type": "MULTIPLE_CHOICE",
    "concepts": [
      "math.coordinate.length-and-midpoint"
    ],
    "difficulty": 1,
    "marks": 1,
    "estimatedSeconds": 30,
    "stem": "Which expression gives the midpoint of the line segment joining $(x_1, y_1)$ and $(x_2, y_2)$?",
    "options": [
      {
        "key": "A",
        "content": "$\\left(\\frac{x_1 + x_2}{2}, \\frac{y_1 + y_2}{2}\\right)$",
        "correct": true,
        "rationale": "The midpoint is the mean of the $x$-coordinates and the mean of the $y$-coordinates."
      },
      {
        "key": "B",
        "content": "$\\left(\\frac{x_2 - x_1}{2}, \\frac{y_2 - y_1}{2}\\right)$",
        "rationale": "Halving the differences gives half the horizontal and vertical changes, not a position."
      },
      {
        "key": "C",
        "content": "$\\left(\\frac{x_1 + y_1}{2}, \\frac{x_2 + y_2}{2}\\right)$",
        "rationale": "This mixes $x$- and $y$-coordinates of the same point."
      },
      {
        "key": "D",
        "content": "$(x_1 + x_2, y_1 + y_2)$",
        "rationale": "The sums must be divided by 2."
      }
    ],
    "explanation": "Halfway between two numbers is their mean, so the midpoint is $\\left(\\frac{x_1 + x_2}{2}, \\frac{y_1 + y_2}{2}\\right)$.",
    "hints": [
      "Halfway between two numbers is their average."
    ],
    "modelResponse": {
      "type": "MULTIPLE_CHOICE",
      "optionKeys": [
        "A"
      ]
    },
    "wrongResponses": [
      {
        "type": "MULTIPLE_CHOICE",
        "optionKeys": [
          "B"
        ]
      }
    ],
    "skill": "RECALL"
  },
  {
    "key": "coordinate.length-midpoint.q02",
    "type": "MULTIPLE_CHOICE",
    "concepts": [
      "math.coordinate.length-and-midpoint"
    ],
    "difficulty": 1,
    "marks": 1,
    "estimatedSeconds": 30,
    "stem": "Which expression gives the length of the line segment joining $(x_1, y_1)$ and $(x_2, y_2)$?",
    "options": [
      {
        "key": "A",
        "content": "$\\sqrt{(x_2 - x_1)^2 + (y_2 - y_1)^2}$",
        "correct": true,
        "rationale": "Pythagoras' theorem with the horizontal and vertical changes as the shorter sides."
      },
      {
        "key": "B",
        "content": "$(x_2 - x_1) + (y_2 - y_1)$",
        "rationale": "Adding the two changes gives the distance along the grid lines, not the straight-line distance."
      },
      {
        "key": "C",
        "content": "$(x_2 - x_1)^2 + (y_2 - y_1)^2$",
        "rationale": "This is the length **squared**: take the square root."
      },
      {
        "key": "D",
        "content": "$\\dfrac{y_2 - y_1}{x_2 - x_1}$",
        "rationale": "This is the gradient, not the length."
      }
    ],
    "explanation": "The horizontal and vertical changes are the two shorter sides of a right-angled triangle whose hypotenuse is the segment, so by Pythagoras the length is $\\sqrt{(x_2 - x_1)^2 + (y_2 - y_1)^2}$.",
    "hints": [
      "Think of Pythagoras' theorem."
    ],
    "modelResponse": {
      "type": "MULTIPLE_CHOICE",
      "optionKeys": [
        "A"
      ]
    },
    "wrongResponses": [
      {
        "type": "MULTIPLE_CHOICE",
