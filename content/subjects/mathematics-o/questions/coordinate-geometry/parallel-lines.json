    ],
    "difficulty": 1,
    "marks": 1,
    "estimatedSeconds": 30,
    "stem": "Two non-vertical straight lines are parallel. What must be true about them?",
    "options": [
      {
        "key": "A",
        "content": "They have equal gradients",
        "correct": true,
        "rationale": "Parallel lines rise or fall at the same rate."
      },
      {
        "key": "B",
        "content": "They have equal $y$-intercepts",
        "rationale": "Lines with equal intercepts meet on the $y$-axis (unless they are the same line)."
      },
      {
        "key": "C",
        "content": "Their gradients multiply to $-1$",
        "rationale": "That is the condition for **perpendicular** lines."
      },
      {
        "key": "D",
        "content": "Their gradients add to $0$",
        "rationale": "Gradients such as $2$ and $-2$ give lines that slope opposite ways and cross."
      }
    ],
    "explanation": "Parallel lines never meet, so they must have the same steepness and direction: equal gradients.",
    "hints": [
      "Think about the steepness of railway lines."
    ],
