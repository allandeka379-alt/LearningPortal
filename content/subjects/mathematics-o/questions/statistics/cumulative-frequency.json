  {
    "key": "statistics.cumulative.q01",
    "type": "MULTIPLE_CHOICE",
    "concepts": [
      "math.statistics.cumulative-frequency"
    ],
    "difficulty": 1,
    "marks": 1,
    "estimatedSeconds": 30,
    "stem": "When a cumulative frequency curve is drawn from a grouped frequency table, each cumulative frequency is plotted against which value?",
    "options": [
      {
        "key": "A",
        "content": "The upper boundary of the class",
        "correct": true,
        "rationale": "Cumulative frequency counts all values up to the end of each class."
      },
      {
        "key": "B",
        "content": "The midpoint of the class",
        "rationale": "Midpoints are used for estimating the mean and for frequency polygons."
      },
      {
        "key": "C",
        "content": "The lower boundary of the class",
        "rationale": "At the lower boundary, the values in that class have not yet been counted."
      },
      {
        "key": "D",
        "content": "The class width",
        "rationale": "The width is not a position on the horizontal axis."
      }
    ],
    "explanation": "A cumulative frequency is the number of values less than or equal to the **upper** boundary of a class, so it is plotted at that boundary.",
    "modelResponse": {
      "type": "MULTIPLE_CHOICE",
      "optionKeys": [
        "A"
      ]
    },
