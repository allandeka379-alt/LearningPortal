  {
    "key": "number.rates.q01",
    "type": "MULTIPLE_CHOICE",
    "concepts": [
      "math.number.rates"
    ],
    "difficulty": 1,
    "marks": 1,
    "estimatedSeconds": 30,
    "stem": "Which formula gives the **average speed** for a journey?",
    "options": [
      {
        "key": "A",
        "content": "$\\dfrac{\\text{total distance}}{\\text{total time}}$",
        "correct": true,
        "rationale": "Average speed is the total distance divided by the total time taken."
      },
      {
        "key": "B",
        "content": "$\\text{total distance} \\times \\text{total time}$",
        "rationale": "Multiplying gives a meaningless quantity: speed is distance **per** unit of time."
      },
      {
        "key": "C",
        "content": "$\\dfrac{\\text{total time}}{\\text{total distance}}$",
        "rationale": "This is upside down: it gives the time per kilometre, not the distance per hour."
      },
      {
        "key": "D",
        "content": "The mean of the speeds on each part of the journey",
        "rationale": "This is only correct when every part takes the same time."
      }
    ],
    "explanation": "Average speed $= \\dfrac{\\text{total distance}}{\\text{total time}}$. For example, 220 km in 3.5 hours is an average speed of $220 \\div 3.5 = 62.9$ km/h.",
    "hints": [
      "Speed is measured in kilometres **per** hour."
    ],
    "modelResponse": {
      "type": "MULTIPLE_CHOICE",
      "optionKeys": [
        "A"
      ]
    },
