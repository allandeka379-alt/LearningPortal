    "difficulty": 1,
    "marks": 1,
    "estimatedSeconds": 30,
    "stem": "Which graph passes through the point $(0^\\circ, 1)$?",
    "options": [
      {
        "key": "A",
        "content": "$y = \\cos x$",
        "correct": true,
        "rationale": "$\\cos 0^\\circ = 1$: the cosine curve starts at its maximum."
      },
      {
        "key": "B",
        "content": "$y = \\sin x$",
        "rationale": "$\\sin 0^\\circ = 0$: the sine curve starts at the origin."
      },
      {
        "key": "C",
        "content": "$y = \\tan x$",
        "rationale": "$\\tan 0^\\circ = 0$."
      },
      {
        "key": "D",
        "content": "None of them",
        "rationale": "The cosine curve does pass through $(0^\\circ, 1)$."
      }
    ],
    "explanation": "At $x = 0^\\circ$: $\\sin 0^\\circ = 0$, $\\cos 0^\\circ = 1$ and $\\tan 0^\\circ = 0$. Only the cosine curve passes through $(0^\\circ, 1)$.",
