    "difficulty": 1,
    "marks": 1,
    "estimatedSeconds": 30,
    "stem": "$\\theta$ is an obtuse angle. Which of its trigonometric ratios is **positive**?",
    "options": [
      {
        "key": "A",
        "content": "$\\sin\\theta$",
        "correct": true,
        "rationale": "On the unit circle the point for an obtuse angle is above the $x$-axis, so its $y$-coordinate, $\\sin\\theta$, is positive."
      },
      {
        "key": "B",
        "content": "$\\cos\\theta$",
        "rationale": "The point is to the left of the $y$-axis, so $\\cos\\theta$ is negative."
      },
      {
        "key": "C",
        "content": "$\\tan\\theta$",
        "rationale": "$\\tan\\theta = \\frac{\\sin\\theta}{\\cos\\theta}$ is positive ÷ negative, which is negative."
      },
      {
        "key": "D",
        "content": "None of them",
        "rationale": "$\\sin\\theta$ is positive for every angle between $0^\\circ$ and $180^\\circ$."
      }
    ],
    "explanation": "For $90^\\circ < \\theta < 180^\\circ$: $\\sin\\theta > 0$, $\\cos\\theta < 0$ and $\\tan\\theta < 0$.",
