[
  {
    "key": "trigonometry.sine-cosine.q01",
    "type": "MULTIPLE_CHOICE",
    "concepts": [
      "math.trigonometry.sine-and-cosine-rules"
    ],
    "difficulty": 1,
    "marks": 1,
    "estimatedSeconds": 30,
    "stem": "Which of these is the cosine rule for finding the side $a$ of triangle $ABC$?",
    "options": [
      {
        "key": "A",
        "content": "$a^2 = b^2 + c^2 - 2bc\\cos A$",
        "correct": true,
        "rationale": "This is the cosine rule."
      },
      {
        "key": "B",
        "content": "$a^2 = b^2 + c^2 + 2bc\\cos A$",
        "rationale": "The sign is wrong: the rule subtracts $2bc\\cos A$."
      },
      {
        "key": "C",
        "content": "$\\dfrac{a}{\\sin A} = \\dfrac{b}{\\sin B}$",
        "rationale": "This is the sine rule."
      },
      {
        "key": "D",
        "content": "$a^2 = b^2 + c^2$",
        "rationale": "This is Pythagoras' theorem, true only when $A = 90^\\circ$."
      }
    ],
    "explanation": "The cosine rule is $a^2 = b^2 + c^2 - 2bc\\cos A$. When $A = 90^\\circ$, $\\cos A = 0$ and it becomes Pythagoras' theorem.",
    "modelResponse": {
