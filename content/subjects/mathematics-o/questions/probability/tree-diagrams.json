    "difficulty": 5,
    "marks": 7,
    "estimatedSeconds": 540,
    "stem": "A bag contains $n$ red balls and 3 blue balls. Two balls are taken at random without replacement. The probability that both balls are red is $\\frac{5}{12}$.",
    "parts": [
      {
        "label": "(a)",
        "type": "SHORT_ANSWER",
        "markingMode": "MANUAL",
        "marks": 3,
        "stem": "Show that $7n^2 - 37n - 30 = 0$.",
        "answerSpec": {
          "markScheme": {
            "points": [
              {
                "id": "M1",
                "description": "Writes P(both red) $= \\dfrac{n}{n + 3} \\times \\dfrac{n - 1}{n + 2}$",
                "marks": 1
              },
              {
                "id": "M1b",
                "description": "Sets this equal to $\\dfrac{5}{12}$ and cross-multiplies: $12n(n - 1) = 5(n + 3)(n + 2)$",
                "marks": 1
              },
              {
                "id": "A1",
                "description": "Expands and simplifies correctly to $7n^2 - 37n - 30 = 0$",
                "marks": 1
              }
            ]
          }
        }
      },
      {
        "label": "(b)",
        "type": "NUMERICAL",
        "marks": 2,
        "stem": "Solve the equation to find $n$.",
        "payload": {
          "answerPrefix": "n ="
        },
        "answerSpec": {
          "value": 6
        }
      },
      {
        "label": "(c)",
        "type": "FILL_IN_THE_BLANK",
        "marks": 2,
        "stem": "Find the probability that both balls are blue. Give your answer as a fraction, or as a decimal correct to 3 significant figures.",
        "payload": {
          "template": "P(both blue) = {{blank:p}}",
          "blanks": [
            {
              "id": "p",
              "input": "number"
            }
          ]
        },
        "answerSpec": {
