[
  {
    "key": "probability.trees.q01",
    "type": "MULTIPLE_CHOICE",
    "concepts": [
      "math.probability.tree-diagrams"
    ],
    "difficulty": 1,
    "marks": 1,
    "estimatedSeconds": 30,
    "stem": "On a tree diagram, what do you do with the probabilities **along** a path to find the probability of that combination of outcomes?",
    "options": [
      {
        "key": "A",
        "content": "Multiply them",
        "correct": true,
        "rationale": "Along a path the events happen one after the other (\"and\"), so you multiply."
      },
      {
        "key": "B",
        "content": "Add them",
        "rationale": "You add the results of **different** paths, not the probabilities along one path."
      },
      {
        "key": "C",
        "content": "Subtract the smaller from the larger",
        "rationale": "Subtraction is not used along a path."
      },
      {
        "key": "D",
        "content": "Divide the first by the second",
        "rationale": "Division is not used along a path."
      }
    ],
    "explanation": "A path describes one outcome followed by another, so its probability is the product of the probabilities on its branches. Probabilities of different paths are then added when several paths give the required result.",
    "modelResponse": {
      "type": "MULTIPLE_CHOICE",
      "optionKeys": [
        "A"
      ]
    },
    "wrongResponses": [
      {
        "type": "MULTIPLE_CHOICE",
        "optionKeys": [
          "B"
        ]
      }
    ],
    "skill": "RECALL",
    "objectives": [
      "zimsec/o-level/mathematics:14.0.3",
      "cambridge/igcse/mathematics:8.3.1"
    ]
  },
