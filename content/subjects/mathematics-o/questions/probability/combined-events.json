[
  {
    "key": "probability.combined.q01",
    "type": "MULTIPLE_CHOICE",
    "concepts": [
      "math.probability.combined-events"
    ],
    "difficulty": 1,
    "marks": 1,
    "estimatedSeconds": 30,
    "stem": "Two ordinary dice are rolled together. How many equally likely outcomes are there in the sample space?",
    "options": [
      {
        "key": "A",
        "content": "$36$",
        "correct": true,
        "rationale": "Each of the 6 scores on the first dice can go with each of the 6 scores on the second: $6 \\times 6 = 36$."
      },
      {
        "key": "B",
        "content": "$12$",
        "rationale": "This adds the outcomes ($6 + 6$) instead of multiplying them."
      },
      {
        "key": "C",
        "content": "$11$",
        "rationale": "There are 11 possible totals (2 to 12), but they are not equally likely."
      },
      {
        "key": "D",
        "content": "$21$",
        "rationale": "This counts $(2, 3)$ and $(3, 2)$ as one outcome; they are different outcomes."
      }
    ],
    "explanation": "The sample space is a $6 \\times 6$ grid: every score on the first dice paired with every score on the second gives $36$ equally likely outcomes.",
    "modelResponse": {
      "type": "MULTIPLE_CHOICE",
      "optionKeys": [
