    "difficulty": 1,
    "marks": 1,
    "estimatedSeconds": 30,
    "stem": "Two shapes are **similar**. Which statement must be true?",
    "options": [
      {
        "key": "A",
        "content": "Their corresponding sides are equal.",
        "rationale": "Equal sides as well as equal angles would make the shapes congruent."
      },
      {
        "key": "B",
        "content": "They have the same area.",
        "rationale": "An enlargement with scale factor $k$ multiplies the area by $k^2$."
      },
