        "answerSpec": {
          "value": 31.4,
          "tolerance": {
            "kind": "absolute",
            "amount": 0.05
          }
        },
        "explanation": "$\\tan(\\text{angle } IHF) = \\frac{11}{18}$, so angle $IHF = 31.4^\\circ$."
      },
      {
        "label": "(d)",
        "type": "NUMERICAL",
        "marks": 1,
        "stem": "Find the bearing of $F$ from $H$, correct to 1 decimal place.",
