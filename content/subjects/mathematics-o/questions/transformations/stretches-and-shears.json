    ],
    "difficulty": 1,
    "marks": 1,
    "estimatedSeconds": 30,
    "stem": "A rectangle is sheared. Which of these is **always** the same for the rectangle and its image?",
    "options": [
      {
        "key": "A",
        "content": "The area",
        "correct": true,
        "rationale": "A shear keeps the base on the invariant line and keeps the height, so the area is unchanged."
      },
      {
        "key": "B",
        "content": "The size of every angle",
        "rationale": "The right angles of the rectangle become non-right angles of a parallelogram."
      },
      {
        "key": "C",
        "content": "The length of every side",
        "rationale": "The sides that are not parallel to the invariant line get longer."
      },
      {
        "key": "D",
        "content": "The perimeter",
        "rationale": "Because two sides get longer, the perimeter usually increases."
      }
    ],
    "explanation": "A shear slides points parallel to the invariant line, so a rectangle becomes a parallelogram with the same base and the same height. Its area is unchanged, but its angles, two of its side lengths and its perimeter change.",
    "modelResponse": {
      "type": "MULTIPLE_CHOICE",
      "optionKeys": [
        "A"
      ]
    },
