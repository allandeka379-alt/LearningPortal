[
  {
    "key": "number.surds.card.definition",
    "cardType": "DEFINITION",
    "front": "What is a **surd**?",
    "back": "A root that cannot be simplified to a whole number or fraction, such as $\\sqrt{2}$ or $3\\sqrt{5}$; it is irrational.",
    "notes": "Cambridge Extended.",
    "concepts": [
      "math.number.surds"
    ]
  },
  {
    "key": "number.surds.card.multiply-rule",
    "cardType": "FORMULA",
    "front": "Multiplication rule for surds",
    "back": "$\\sqrt{ab} = \\sqrt{a} \\times \\sqrt{b}$",
    "notes": "$\\sqrt{3} \\times \\sqrt{12} = \\sqrt{36} = 6$",
    "concepts": [
      "math.number.surds"
    ]
  },
  {
    "key": "number.surds.card.divide-rule",
    "cardType": "FORMULA",
    "front": "Division rule for surds",
    "back": "$\\sqrt{\\frac{a}{b}} = \\frac{\\sqrt{a}}{\\sqrt{b}}$",
    "concepts": [
      "math.number.surds"
    ]
  },
  {
    "key": "number.surds.card.no-sum-rule",
    "cardType": "CONCEPT",
    "front": "Is $\\sqrt{a} + \\sqrt{b} = \\sqrt{a + b}$?",
    "back": "No: $\\sqrt{9} + \\sqrt{16} = 7$ but $\\sqrt{25} = 5$.",
    "concepts": [
      "math.number.surds"
    ]
  },
  {
    "key": "number.surds.card.simplify",
    "cardType": "CONCEPT",
    "front": "How do you simplify a surd such as $\\sqrt{72}$?",
    "back": "Take out the largest square factor: $\\sqrt{36 \\times 2} = 6\\sqrt{2}$.",
    "concepts": [
      "math.number.surds"
    ]
  },
  {
    "key": "number.surds.card.like-surds",
    "cardType": "CONCEPT",
    "front": "How do you add $\\sqrt{12} + \\sqrt{27}$?",
    "back": "Simplify to like surds and add: $2\\sqrt{3} + 3\\sqrt{3} = 5\\sqrt{3}$.",
    "concepts": [
      "math.number.surds"
    ]
  },
  {
    "key": "number.surds.card.conjugate",
    "cardType": "FORMULA",
    "front": "$(a + \\sqrt{b})(a - \\sqrt{b}) = \\ ?$",
    "back": "$a^2 - b$ (no surd)",
    "notes": "$(3 + \\sqrt{2})(3 - \\sqrt{2}) = 7$",
    "concepts": [
      "math.number.surds"
    ]
  },
  {
    "key": "number.surds.card.rationalise-simple",
    "cardType": "CONCEPT",
    "front": "How do you rationalise $\\frac{a}{\\sqrt{b}}$?",
    "back": "Multiply the top and bottom by $\\sqrt{b}$: $\\frac{6}{\\sqrt{3}} = \\frac{6\\sqrt{3}}{3} = 2\\sqrt{3}$.",
    "concepts": [
      "math.number.surds"
    ]
  },
  {
    "key": "number.surds.card.rationalise-conjugate",
    "cardType": "CONCEPT",
    "front": "How do you rationalise $\\frac{4}{3 - \\sqrt{5}}$?",
    "back": "Multiply the top and bottom by the conjugate $3 + \\sqrt{5}$: the denominator becomes $9 - 5 = 4$, giving $3 + \\sqrt{5}$.",
    "concepts": [
      "math.number.surds"
    ]
  },
  {
    "key": "number.surds.card.square-binomial",
    "cardType": "FACT",
    "front": "Expand $(\\sqrt{5} + 1)^2$.",
    "back": "$6 + 2\\sqrt{5}$ (not $5 + 1$).",
    "concepts": [
      "math.number.surds"
    ]
  }
]
