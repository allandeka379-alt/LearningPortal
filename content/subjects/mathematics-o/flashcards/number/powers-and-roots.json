  {
    "key": "number.powers.card.sqrt-symbol",
    "cardType": "CONCEPT",
    "front": "What does the symbol $\\sqrt{x}$ mean?",
    "back": "The **positive** square root of $x$: $\\sqrt{49} = 7$.",
    "notes": "But $x^2 = 49$ has two solutions, $x = \\pm 7$.",
    "concepts": [
      "math.number.powers-and-roots"
    ]
  },
  {
    "key": "number.powers.card.negative-cube-root",
    "cardType": "CONCEPT",
    "front": "Does a negative number have a cube root?",
    "back": "Yes, a negative one: $\\sqrt[3]{-64} = -4$ because $(-4)^3 = -64$.",
    "notes": "A negative number has no square root at this level.",
    "concepts": [
      "math.number.powers-and-roots"
    ]
  },
  {
    "key": "number.powers.card.decimal-squares",
    "cardType": "CONCEPT",
    "front": "What happens to the decimal places when you square a decimal?",
    "back": "They double: $0.3^2 = 0.09$ and $0.12^2 = 0.0144$.",
    "notes": "A square root halves them: $\\sqrt{0.0016} = 0.04$.",
    "concepts": [
      "math.number.powers-and-roots"
    ]
  },
  {
    "key": "number.powers.card.fraction-roots",
    "cardType": "CONCEPT",
    "front": "How do you find $\\sqrt{\\frac{16}{81}}$?",
    "back": "Take the root of the top and the bottom separately: $\\frac{4}{9}$.",
    "concepts": [
      "math.number.powers-and-roots"
    ]
  },
  {
    "key": "number.powers.card.estimate-root",
    "cardType": "CONCEPT",
    "front": "How do you estimate a square root such as $\\sqrt{75}$?",
    "back": "Find the square numbers either side ($64 = 8^2$, $81 = 9^2$), so $8 < \\sqrt{75} < 9$.",
    "concepts": [
      "math.number.powers-and-roots"
    ]
  },
  {
    "key": "number.powers.card.index",
    "cardType": "DEFINITION",
    "front": "What does $2^5$ mean?",
    "back": "$2 \\times 2 \\times 2 \\times 2 \\times 2 = 32$; the index 5 counts the factors.",
    "notes": "The fifth root reverses it: $\\sqrt[5]{32} = 2$.",
    "concepts": [
      "math.number.powers-and-roots"
    ]
  },
  {
    "key": "number.powers.card.calculator-negative",
