[
  {
    "key": "number.percentages.card.percentage",
    "cardType": "DEFINITION",
    "front": "What does **per cent** mean?",
    "back": "Out of 100: $35\\% = \\frac{35}{100} = 0.35$.",
    "concepts": [
      "math.number.percentages"
    ]
  },
  {
    "key": "number.percentages.card.percentage-of",
    "cardType": "FORMULA",
    "front": "How do you write one quantity as a percentage of another?",
    "back": "$\\dfrac{\\text{part}}{\\text{whole}} \\times 100$, with both quantities in the same units.",
    "concepts": [
      "math.number.percentages"
    ]
  },
  {
    "key": "number.percentages.card.multiplier",
    "cardType": "DEFINITION",
    "front": "What is the **multiplier** for an increase of $r\\%$? For a decrease of $r\\%$?",
    "back": "Increase: $1 + \\frac{r}{100}$. Decrease: $1 - \\frac{r}{100}$.",
    "notes": "Increase by 12%: $\\times 1.12$; decrease by 12%: $\\times 0.88$.",
    "concepts": [
      "math.number.percentages"
    ]
  },
  {
    "key": "number.percentages.card.percentage-change",
    "cardType": "FORMULA",
    "front": "Percentage change formula",
    "back": "$\\dfrac{\\text{new} - \\text{original}}{\\text{original}} \\times 100$",
    "notes": "Always divide by the **original** value.",
    "concepts": [
      "math.number.percentages"
    ]
  },
  {
    "key": "number.percentages.card.repeated-change",
    "cardType": "CONCEPT",
    "front": "How do you apply two percentage changes one after the other?",
    "back": "Multiply by each multiplier in turn: +20% then −25% is $\\times 1.2 \\times 0.75 = \\times 0.9$, a 10% decrease.",
    "notes": "Never add the percentages.",
    "concepts": [
      "math.number.percentages"
    ]
  },
  {
    "key": "number.percentages.card.up-down-10",
    "cardType": "CONCEPT",
    "front": "A price rises by 10% and then falls by 10%. What is the overall change?",
    "back": "$1.1 \\times 0.9 = 0.99$: a 1% decrease.",
    "concepts": [
      "math.number.percentages"
    ]
  },
  {
    "key": "number.percentages.card.reverse",
    "cardType": "CONCEPT",
    "front": "How do you find the original amount after a percentage change (reverse percentage)?",
    "back": "Divide the final amount by the multiplier. After a 15% discount, US\\$68 came from $68 \\div 0.85 =$ US\\$80.",
    "notes": "Cambridge Extended.",
    "concepts": [
      "math.number.percentages"
    ]
  },
  {
    "key": "number.percentages.card.over-100",
    "cardType": "CONCEPT",
    "front": "What multiplier gives an **increase of 150%**?",
    "back": "$2.5$ (you end with $100\\% + 150\\% = 250\\%$ of the original).",
    "concepts": [
      "math.number.percentages"
    ]
  },
  {
    "key": "number.percentages.card.of-vs-increase",
    "cardType": "FACT",
    "front": "What is the difference between \"250% of 40\" and \"40 increased by 250%\"?",
    "back": "$250\\%$ of 40 $= 2.5 \\times 40 = 100$; 40 increased by 250% $= 3.5 \\times 40 = 140$.",
    "concepts": [
      "math.number.percentages"
    ]
  },
  {
    "key": "number.percentages.card.undo-increase",
    "cardType": "CONCEPT",
    "front": "After a 25% increase, by what percentage must you decrease to return to the original?",
    "back": "$20\\%$, because the decrease of 25 is taken from 125: $\\frac{25}{125} = \\frac{1}{5}$.",
    "concepts": [
      "math.number.percentages"
    ]
  }
]
