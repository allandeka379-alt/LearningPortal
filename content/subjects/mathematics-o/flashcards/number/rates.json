[
  {
    "key": "number.rates.card.rate",
    "cardType": "DEFINITION",
    "front": "What is a **rate**?",
    "back": "A quantity measured per unit of another quantity, such as km per hour, litres per minute or dollars per hour.",
    "concepts": [
      "math.number.rates"
    ]
  },
  {
    "key": "number.rates.card.speed",
    "cardType": "FORMULA",
    "front": "Speed, distance and time",
    "back": "$\\text{speed} = \\dfrac{\\text{distance}}{\\text{time}}$, $\\text{distance} = \\text{speed} \\times \\text{time}$, $\\text{time} = \\dfrac{\\text{distance}}{\\text{speed}}$",
    "concepts": [
      "math.number.rates"
    ]
  },
  {
    "key": "number.rates.card.average-speed",
    "cardType": "DEFINITION",
    "front": "How is **average speed** for a whole journey calculated?",
    "back": "Total distance ÷ total time (including stops), **not** the mean of the speeds.",
    "concepts": [
      "math.number.rates"
    ]
  },
  {
    "key": "number.rates.card.kmh-to-ms",
    "cardType": "CONCEPT",
    "front": "How do you change a speed in km/h into m/s?",
    "back": "Divide by 3.6 (because $1\\ \\text{km/h} = \\frac{1000}{3600}\\ \\text{m/s}$). Multiply by 3.6 to go back.",
    "notes": "$72\\ \\text{km/h} = 20\\ \\text{m/s}$.",
    "concepts": [
      "math.number.rates"
    ]
  },
  {
    "key": "number.rates.card.minutes-to-hours",
    "cardType": "CONCEPT",
    "front": "Write 2 hours 15 minutes in hours as a decimal.",
    "back": "$2.25$ h (divide the minutes by 60: $15 \\div 60 = 0.25$).",
    "notes": "Not $2.15$ h.",
    "concepts": [
      "math.number.rates"
    ]
  },
  {
    "key": "number.rates.card.density",
    "cardType": "FORMULA",
    "front": "Density formula",
    "back": "$\\text{density} = \\dfrac{\\text{mass}}{\\text{volume}}$, in units such as $\\text{g/cm}^3$ or $\\text{kg/m}^3$.",
    "concepts": [
      "math.number.rates"
    ]
  },
  {
    "key": "number.rates.card.pressure",
    "cardType": "FORMULA",
    "front": "Pressure formula",
    "back": "$\\text{pressure} = \\dfrac{\\text{force}}{\\text{area}}$, in $\\text{N/m}^2$ (pascals).",
    "notes": "The same force on a smaller area gives a greater pressure.",
    "concepts": [
      "math.number.rates"
    ]
  },
  {
    "key": "number.rates.card.population-density",
    "cardType": "FORMULA",
    "front": "Population density formula",
    "back": "$\\text{population density} = \\dfrac{\\text{population}}{\\text{area}}$, for example people per $\\text{km}^2$.",
    "concepts": [
      "math.number.rates"
    ]
  },
  {
    "key": "number.rates.card.fuel-consumption",
    "cardType": "CONCEPT",
    "front": "A car uses 8 litres per 100 km. How much fuel does it use for 350 km?",
    "back": "$350 \\times \\frac{8}{100} = 28$ litres.",
    "concepts": [
      "math.number.rates"
    ]
  },
  {
    "key": "number.rates.card.flow-rate",
    "cardType": "CONCEPT",
    "front": "How long does a pipe delivering 12 litres per minute take to fill an 1800-litre tank?",
    "back": "$1800 \\div 12 = 150$ minutes (2 h 30 min).",
    "notes": "Time $=$ volume $\\div$ flow rate.",
    "concepts": [
      "math.number.rates"
    ]
  }
]
