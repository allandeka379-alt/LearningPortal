[
  {
    "key": "number.indices.card.multiply",
    "cardType": "FORMULA",
    "front": "Law of indices for multiplying powers of the same base",
    "back": "$a^m \\times a^n = a^{m+n}$",
    "notes": "$3^5 \\times 3^2 = 3^7$",
    "concepts": [
      "math.number.indices"
    ]
  },
  {
    "key": "number.indices.card.divide",
    "cardType": "FORMULA",
    "front": "Law of indices for dividing powers of the same base",
    "back": "$a^m \\div a^n = a^{m-n}$",
    "notes": "$7^2 \\div 7^5 = 7^{-3}$",
    "concepts": [
      "math.number.indices"
    ]
  },
  {
    "key": "number.indices.card.power-of-power",
    "cardType": "FORMULA",
    "front": "Law of indices for a power of a power",
    "back": "$\\left(a^m\\right)^n = a^{mn}$",
    "notes": "$\\left(3^2\\right)^4 = 3^8$",
    "concepts": [
      "math.number.indices"
    ]
  },
  {
    "key": "number.indices.card.zero",
    "cardType": "FACT",
    "front": "What is $a^0$ (for $a \\neq 0$)?",
    "back": "$1$",
    "notes": "$7^0 = 1$, not 0.",
    "concepts": [
      "math.number.indices"
    ]
  },
  {
    "key": "number.indices.card.negative",
    "cardType": "FORMULA",
    "front": "What does a negative index mean?",
    "back": "$a^{-n} = \\frac{1}{a^n}$: a reciprocal, not a negative number.",
    "notes": "$2^{-3} = \\frac{1}{8}$; $\\left(\\frac{2}{3}\\right)^{-2} = \\frac{9}{4}$.",
    "concepts": [
      "math.number.indices"
    ]
  },
  {
    "key": "number.indices.card.unit-fraction",
    "cardType": "FORMULA",
    "front": "What does $a^{\\frac{1}{n}}$ mean?",
    "back": "The $n$th root of $a$: $a^{\\frac{1}{n}} = \\sqrt[n]{a}$.",
    "notes": "$36^{\\frac{1}{2}} = 6$, $8^{\\frac{1}{3}} = 2$.",
    "concepts": [
      "math.number.indices"
    ]
  },
  {
    "key": "number.indices.card.fractional",
    "cardType": "FORMULA",
    "front": "What does $a^{\\frac{m}{n}}$ mean?",
    "back": "$\\left(\\sqrt[n]{a}\\right)^m$: take the root first, then the power.",
    "notes": "$27^{\\frac{2}{3}} = 3^2 = 9$.",
    "concepts": [
      "math.number.indices"
    ]
  },
  {
    "key": "number.indices.card.method",
    "cardType": "CONCEPT",
    "front": "How do you evaluate $8^{-\\frac{2}{3}}$ without a calculator?",
    "back": "Root: $\\sqrt[3]{8} = 2$; power: $2^2 = 4$; reciprocal: $\\frac{1}{4}$.",
    "concepts": [
      "math.number.indices"
    ]
  },
  {
    "key": "number.indices.card.same-base",
    "cardType": "CONCEPT",
    "front": "How do you find an unknown index, as in $9^n = 27$?",
    "back": "Write both sides as powers of the same base: $3^{2n} = 3^3$, so $n = \\frac{3}{2}$.",
    "concepts": [
      "math.number.indices"
    ]
  },
  {
    "key": "number.indices.card.decimal-base",
    "cardType": "CONCEPT",
    "front": "How do you evaluate $0.25^{-\\frac{1}{2}}$?",
    "back": "Write the decimal as a fraction: $\\left(\\frac{1}{4}\\right)^{-\\frac{1}{2}} = 4^{\\frac{1}{2}} = 2$.",
    "concepts": [
      "math.number.indices"
    ]
  }
]
