    "concepts": [
      "math.number.sets"
    ]
  },
  {
    "key": "sets.notation.card.empty",
    "cardType": "DEFINITION",
    "front": "What is the **empty set**?",
    "back": "The set with no elements, $\\varnothing$ or $\\{\\ \\}$.",
    "notes": "$\\{0\\}$ is not empty: it contains 0.",
    "concepts": [
      "math.number.sets"
    ]
  },
  {
