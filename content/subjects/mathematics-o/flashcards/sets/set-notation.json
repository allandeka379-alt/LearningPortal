    "cardType": "CONCEPT",
    "front": "How do you read $\\{x : x \\text{ is an integer}, -2 < x \\leq 3\\}$?",
    "back": "\"The set of all $x$ such that $x$ is an integer greater than $-2$ and at most 3\" $= \\{-1, 0, 1, 2, 3\\}$.",
    "concepts": [
      "math.number.sets"
    ]
