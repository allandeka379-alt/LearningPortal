      "math.number.sets"
    ]
  },
  {
    "key": "sets.notation.card.subset",
    "cardType": "DEFINITION",
    "front": "What does $A \\subseteq B$ mean?",
    "back": "A is a subset of B: every element of A is also an element of B.",
