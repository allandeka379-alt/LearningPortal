[
  {
    "key": "algebra.logs.card.definition",
    "cardType": "DEFINITION",
    "front": "What does $\\log_a N = x$ mean?",
    "back": "$a^x = N$: the logarithm is the power to which the base $a$ must be raised to give $N$.",
    "notes": "$\\log_2 16 = 4$ because $2^4 = 16$.",
    "concepts": [
      "math.algebra.logarithms"
    ]
  },
  {
    "key": "algebra.logs.card.common",
    "cardType": "FACT",
    "front": "What base does $\\log$ (with no base written) usually mean at O-Level?",
    "back": "Base 10 (common logarithms): $\\log 1000 = 3$ because $10^3 = 1000$.",
    "concepts": [
      "math.algebra.logarithms"
    ]
  },
  {
    "key": "algebra.logs.card.base",
    "cardType": "FACT",
    "front": "What is $\\log_a a$?",
    "back": "$1$, because $a^1 = a$.",
    "notes": "$\\log 10 = 1$, $\\log_7 7 = 1$.",
    "concepts": [
      "math.algebra.logarithms"
    ]
  },
  {
    "key": "algebra.logs.card.one",
    "cardType": "FACT",
    "front": "What is $\\log_a 1$?",
    "back": "$0$, because $a^0 = 1$.",
    "concepts": [
      "math.algebra.logarithms"
    ]
  },
  {
    "key": "algebra.logs.card.product",
    "cardType": "FORMULA",
    "front": "Product law of logarithms",
    "back": "$\\log a + \\log b = \\log(ab)$",
    "notes": "$\\log 4 + \\log 25 = \\log 100 = 2$",
    "concepts": [
      "math.algebra.logarithms"
    ]
  },
  {
    "key": "algebra.logs.card.quotient",
    "cardType": "FORMULA",
    "front": "Quotient law of logarithms",
    "back": "$\\log a - \\log b = \\log \\frac{a}{b}$",
    "notes": "$\\log_2 40 - \\log_2 5 = \\log_2 8 = 3$",
    "concepts": [
      "math.algebra.logarithms"
    ]
  },
  {
    "key": "algebra.logs.card.power",
    "cardType": "FORMULA",
    "front": "Power law of logarithms",
    "back": "$\\log a^n = n\\log a$",
    "notes": "$3\\log 2 = \\log 8$",
    "concepts": [
      "math.algebra.logarithms"
    ]
  },
  {
    "key": "algebra.logs.card.misconception",
    "cardType": "FACT",
    "front": "Is $\\log(a + b) = \\log a + \\log b$?",
    "back": "No. There is no law for the log of a sum. $\\log a + \\log b = \\log(ab)$.",
    "notes": "$\\log 2 + \\log 3 = \\log 6$, not $\\log 5$.",
    "concepts": [
      "math.algebra.logarithms"
    ]
  },
  {
    "key": "algebra.logs.card.solve",
    "cardType": "CONCEPT",
    "front": "How do you solve an equation such as $\\log_5(x + 3) = 2$?",
    "back": "Change it into index form and solve: $x + 3 = 5^2 = 25$, so $x = 22$.",
    "concepts": [
      "math.algebra.logarithms"
    ]
  },
  {
    "key": "algebra.logs.card.domain",
    "cardType": "CONCEPT",
    "front": "Why must you check solutions of logarithm equations?",
    "back": "Only positive numbers have logarithms, so reject any solution that makes a logarithm’s argument zero or negative.",
    "notes": "$\\log x + \\log(x + 21) = 2$ gives $x = 4$ or $x = -25$; reject $x = -25$.",
    "concepts": [
      "math.algebra.logarithms"
    ]
  }
]
