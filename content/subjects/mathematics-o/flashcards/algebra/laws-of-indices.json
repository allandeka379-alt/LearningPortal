[
  {
    "key": "algebra.indices.card.multiply",
    "cardType": "FORMULA",
    "front": "Law of indices for multiplying: $x^m \\times x^n = ?$",
    "back": "$x^{m+n}$",
    "notes": "$2b^3 \\times 4b^5 = 8b^8$: multiply the numbers, add the indices.",
    "concepts": [
      "math.algebra.laws-of-indices"
    ]
  },
  {
    "key": "algebra.indices.card.divide",
    "cardType": "FORMULA",
    "front": "Law of indices for dividing: $x^m \\div x^n = ?$",
    "back": "$x^{m-n}$",
    "notes": "$18x^5y^2 \\div 6x^2y = 3x^3y$",
    "concepts": [
      "math.algebra.laws-of-indices"
    ]
  },
  {
    "key": "algebra.indices.card.power",
    "cardType": "FORMULA",
    "front": "Law of indices for a power of a power: $(x^m)^n = ?$",
    "back": "$x^{mn}$",
    "notes": "$(5x^2)^3 = 5^3x^6 = 125x^6$: every factor in the bracket is raised to the power.",
    "concepts": [
      "math.algebra.laws-of-indices"
    ]
  },
  {
    "key": "algebra.indices.card.zero",
    "cardType": "FACT",
    "front": "What is $x^0$, and what is $8x^0$?",
    "back": "$x^0 = 1$ (for $x \\neq 0$), so $8x^0 = 8$. But $(8x)^0 = 1$.",
    "concepts": [
      "math.algebra.laws-of-indices"
    ]
  },
  {
    "key": "algebra.indices.card.negative",
    "cardType": "FORMULA",
    "front": "What does $x^{-n}$ mean?",
    "back": "$\\frac{1}{x^n}$, the reciprocal of $x^n$.",
    "notes": "$2x^{-3} = \\frac{2}{x^3}$, but $(2x)^{-3} = \\frac{1}{8x^3}$.",
    "concepts": [
      "math.algebra.laws-of-indices"
    ]
  },
  {
    "key": "algebra.indices.card.root",
    "cardType": "FORMULA",
    "front": "What does $x^{\\frac{1}{n}}$ mean?",
    "back": "The $n$th root of $x$: $x^{\\frac{1}{n}} = \\sqrt[n]{x}$.",
    "notes": "$(27x^9)^{\\frac{1}{3}} = 3x^3$",
    "concepts": [
      "math.algebra.laws-of-indices"
    ]
  },
  {
    "key": "algebra.indices.card.fractional",
    "cardType": "FORMULA",
    "front": "What does $x^{\\frac{m}{n}}$ mean?",
    "back": "$\\left(\\sqrt[n]{x}\\right)^m$: root (denominator) first, then power (numerator).",
    "notes": "$(8x^3)^{\\frac{2}{3}} = (2x)^2 = 4x^2$",
    "concepts": [
      "math.algebra.laws-of-indices"
    ]
  },
  {
    "key": "algebra.indices.card.equation",
    "cardType": "CONCEPT",
    "front": "How do you solve an equation such as $8^x = 32$?",
    "back": "Write both sides as powers of the same base, then make the indices equal.",
    "notes": "$2^{3x} = 2^5$, so $3x = 5$ and $x = \\frac{5}{3}$.",
    "concepts": [
      "math.algebra.laws-of-indices"
    ]
  },
  {
    "key": "algebra.indices.card.same-base",
    "cardType": "FACT",
    "front": "When can the laws of indices be used to combine two powers?",
    "back": "Only when the bases are the same: $x^3 \\times x^4 = x^7$, but $x^3 \\times y^4$ cannot be combined.",
    "concepts": [
      "math.algebra.laws-of-indices"
    ]
  },
  {
    "key": "algebra.indices.card.coefficients",
    "cardType": "CONCEPT",
    "front": "In $(2x^{-3})^2$, what happens to the 2?",
    "back": "It is also raised to the power 2: $(2x^{-3})^2 = 4x^{-6} = \\frac{4}{x^6}$.",
    "concepts": [
      "math.algebra.laws-of-indices"
    ]
  }
]
