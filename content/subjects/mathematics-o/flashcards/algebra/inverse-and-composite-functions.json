  {
    "key": "algebra.inverse-composite.card.method",
    "cardType": "CONCEPT",
    "front": "How do you find $f^{-1}(x)$?",
    "back": "Write $y = f(x)$, rearrange to make $x$ the subject, then replace $y$ by $x$.",
    "notes": "$y = \\frac{5}{x - 1} \\Rightarrow x = \\frac{5}{y} + 1$, so $f^{-1}(x) = \\frac{5}{x} + 1$.",
    "concepts": [
      "math.algebra.inverse-and-composite-functions"
    ]
  },
