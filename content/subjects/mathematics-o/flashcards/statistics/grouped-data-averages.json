[
  {
    "key": "statistics.grouped.card.estimated-mean",
    "cardType": "FORMULA",
    "front": "Estimated mean of grouped data",
    "back": "$\\dfrac{\\sum fx}{\\sum f}$, where $x$ is the midpoint of each class.",
    "concepts": [
      "math.statistics.grouped-data-averages"
    ]
  },
  {
    "key": "statistics.grouped.card.midpoint",
    "cardType": "FORMULA",
    "front": "Midpoint of a class",
    "back": "$\\dfrac{\\text{lower boundary} + \\text{upper boundary}}{2}$",
    "notes": "$10 < t \\leq 20$: 15. Whole-number class 21–30: 25.5.",
    "concepts": [
      "math.statistics.grouped-data-averages"
    ]
  },
  {
    "key": "statistics.grouped.card.modal-class",
    "cardType": "DEFINITION",
    "front": "What is the **modal class**?",
    "back": "The class with the highest frequency.",
    "concepts": [
      "math.statistics.grouped-data-averages"
    ]
  },
  {
    "key": "statistics.grouped.card.median-class",
    "cardType": "CONCEPT",
    "front": "How do you find the class containing the median?",
    "back": "Find the middle position ($\\frac{n + 1}{2}$), then use running totals of the frequencies to see which class it falls in.",
    "concepts": [
      "math.statistics.grouped-data-averages"
    ]
  },
  {
    "key": "statistics.grouped.card.estimate",
    "cardType": "FACT",
    "front": "Why is the mean of grouped data only an estimate?",
    "back": "The exact values are unknown; each class is represented by its midpoint.",
    "concepts": [
      "math.statistics.grouped-data-averages"
    ]
  },
  {
    "key": "statistics.grouped.card.assumed-mean",
    "cardType": "FORMULA",
    "front": "Mean using an assumed mean $A$",
    "back": "$A + \\dfrac{\\sum fd}{\\sum f}$, where $d = x - A$",
    "notes": "Choose $A$ near the middle of the table to keep the numbers small.",
    "concepts": [
      "math.statistics.grouped-data-averages"
    ],
    "applies": [
      "zimsec"
    ]
  },
  {
    "key": "statistics.grouped.card.divide-by",
    "cardType": "FACT",
    "front": "What do you divide $\\sum fx$ by?",
    "back": "$\\sum f$, the total frequency, not the number of classes.",
    "concepts": [
      "math.statistics.grouped-data-averages"
    ]
  },
  {
    "key": "statistics.grouped.card.discrete-midpoint",
    "cardType": "CONCEPT",
    "front": "Midpoint of the whole-number class 11–20",
    "back": "$\\frac{11 + 20}{2} = 15.5$",
    "concepts": [
      "math.statistics.grouped-data-averages"
    ]
  },
  {
    "key": "statistics.grouped.card.check",
    "cardType": "CONCEPT",
    "front": "How can you check an estimated mean?",
    "back": "It must lie within the range of the data, near the classes with the highest frequencies.",
    "concepts": [
      "math.statistics.grouped-data-averages"
    ]
  },
  {
    "key": "statistics.grouped.card.upper-end",
    "cardType": "FACT",
    "front": "If the values cluster at the top of each class, is the estimated mean too high or too low?",
    "back": "Too low: the true mean is greater than the estimate.",
    "concepts": [
      "math.statistics.grouped-data-averages"
    ]
  }
