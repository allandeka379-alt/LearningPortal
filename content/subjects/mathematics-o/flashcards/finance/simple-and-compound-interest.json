  {
    "key": "finance.interest.card.simple",
    "cardType": "FORMULA",
    "front": "Simple interest formula",
    "back": "$I = \\dfrac{PRT}{100}$, with $T$ in years; amount $A = P + I$.",
    "concepts": [
      "math.number.simple-and-compound-interest"
    ]
  },
  {
    "key": "finance.interest.card.compound",
    "cardType": "FORMULA",
    "front": "Compound interest formula (interest added yearly)",
    "back": "$A = P\\left(1 + \\dfrac{R}{100}\\right)^n$; interest $= A - P$.",
    "notes": "Cambridge papers do not give this formula.",
    "concepts": [
      "math.number.simple-and-compound-interest"
    ]
  },
  {
    "key": "finance.interest.card.compound-meaning",
    "cardType": "DEFINITION",
    "front": "What is **compound interest**?",
    "back": "Interest calculated on the principal plus all the interest already added, so it grows each year.",
    "concepts": [
      "math.number.simple-and-compound-interest"
    ]
  },
  {
    "key": "finance.interest.card.months",
    "cardType": "CONCEPT",
    "front": "How do you use 8 months in $I = \\frac{PRT}{100}$?",
    "back": "Write it in years: $T = \\frac{8}{12}$.",
    "concepts": [
      "math.number.simple-and-compound-interest"
    ]
  },
  {
    "key": "finance.interest.card.rearranged",
    "cardType": "FORMULA",
    "front": "Rearrange $I = \\frac{PRT}{100}$ to find $R$ and $T$.",
    "back": "$R = \\dfrac{100I}{PT}$ and $T = \\dfrac{100I}{PR}$.",
    "concepts": [
      "math.number.simple-and-compound-interest"
    ]
  },
  {
    "key": "finance.interest.card.trial",
    "cardType": "CONCEPT",
    "front": "How do you find how many years compound interest takes to reach a target (without logarithms)?",
    "back": "Try $n = 1, 2, 3, \\ldots$ in $P \\times m^n$ until the value first passes the target.",
    "notes": "US\\$2000 at 5%: $1.05^4$ gives 2431.01, $1.05^5$ gives 2552.56, so 5 years to pass US\\$2500.",
    "concepts": [
      "math.number.simple-and-compound-interest"
    ]
  },
  {
    "key": "finance.interest.card.compare",
    "cardType": "CONCEPT",
    "front": "Which earns more after 3 years at the same rate: simple or compound interest?",
    "back": "Compound interest (it is equal after 1 year and larger after that).",
    "concepts": [
      "math.number.simple-and-compound-interest"
    ]
  },
  {
    "key": "finance.interest.card.find-principal",
    "cardType": "CONCEPT",
    "front": "An investment at 4% compound interest is worth US\\$2704 after 2 years. How do you find the principal?",
    "back": "Divide by the multiplier: $2704 \\div 1.04^2 = 2500$.",
    "concepts": [
      "math.number.simple-and-compound-interest"
    ]
  },
  {
    "key": "finance.interest.card.money-rounding",
    "cardType": "FACT",
    "front": "To what accuracy are money answers usually given?",
    "back": "To the nearest cent (2 decimal places), unless the question says otherwise. Round only at the end.",
