[
  {
    "key": "mensuration.prisms-cylinders.card.prism",
    "cardType": "DEFINITION",
    "front": "What is a **prism**?",
    "back": "A solid with the same cross-section all along its length (a cuboid is a rectangular prism).",
    "concepts": [
      "math.mensuration.prisms-and-cylinders"
    ]
  },
  {
    "key": "mensuration.prisms-cylinders.card.prism-volume",
    "cardType": "FORMULA",
    "front": "Volume of a prism",
    "back": "$V = \\text{area of cross-section} \\times \\text{length}$",
    "concepts": [
      "math.mensuration.prisms-and-cylinders"
    ]
  },
  {
    "key": "mensuration.prisms-cylinders.card.cuboid",
    "cardType": "FORMULA",
    "front": "Volume and surface area of a cuboid",
    "back": "$V = lwh$; $A = 2(lw + lh + wh)$",
    "concepts": [
      "math.mensuration.prisms-and-cylinders"
    ]
  },
  {
    "key": "mensuration.prisms-cylinders.card.cylinder-volume",
    "cardType": "FORMULA",
    "front": "Volume of a cylinder",
    "back": "$V = \\pi r^2 h$",
    "concepts": [
      "math.mensuration.prisms-and-cylinders"
    ]
  },
  {
    "key": "mensuration.prisms-cylinders.card.curved",
    "cardType": "FORMULA",
    "front": "Curved surface area of a cylinder",
    "back": "$2\\pi rh$ (it unrolls into a rectangle $2\\pi r$ by $h$).",
    "concepts": [
      "math.mensuration.prisms-and-cylinders"
    ]
  },
  {
    "key": "mensuration.prisms-cylinders.card.closed-cylinder",
    "cardType": "FORMULA",
    "front": "Total surface area of a closed cylinder",
    "back": "$2\\pi rh + 2\\pi r^2$",
    "concepts": [
      "math.mensuration.prisms-and-cylinders"
    ]
  },
  {
    "key": "mensuration.prisms-cylinders.card.open-cylinder",
    "cardType": "FORMULA",
    "front": "Surface area of an open cylinder (base, no lid)",
    "back": "$2\\pi rh + \\pi r^2$",
    "concepts": [
      "math.mensuration.prisms-and-cylinders"
    ]
  },
  {
    "key": "mensuration.prisms-cylinders.card.surface-area",
    "cardType": "DEFINITION",
    "front": "What is **surface area**?",
    "back": "The total area of all the faces and curved surfaces of a solid. A net helps you find every face.",
    "concepts": [
      "math.mensuration.prisms-and-cylinders"
    ]
  },
  {
    "key": "mensuration.prisms-cylinders.card.capacity",
    "cardType": "CONCEPT",
    "front": "How do you change a volume in $\\text{cm}^3$ or $\\text{m}^3$ into litres?",
    "back": "$\\text{cm}^3 \\div 1000 =$ litres; $\\text{m}^3 \\times 1000 =$ litres.",
    "concepts": [
      "math.mensuration.prisms-and-cylinders"
    ]
  },
  {
    "key": "mensuration.prisms-cylinders.card.double-radius",
    "cardType": "CONCEPT",
    "front": "What happens to the volume of a cylinder if the radius doubles and the height stays the same?",
    "back": "It is multiplied by 4, because $V$ depends on $r^2$.",
    "concepts": [
      "math.mensuration.prisms-and-cylinders"
    ]
  }
]
