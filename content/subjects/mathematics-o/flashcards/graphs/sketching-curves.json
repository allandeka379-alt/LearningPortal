      "math.graphs.sketching-curves"
    ]
  },
  {
    "key": "graphs.sketching.card.quadratic-shape",
    "cardType": "CONCEPT",
    "front": "How does the sign of $a$ affect $y = ax^2 + bx + c$?",
    "back": "$a > 0$: $\\cup$ (minimum); $a < 0$: $\\cap$ (maximum).",
    "concepts": [
      "math.graphs.sketching-curves"
    ]
  },
  {
    "key": "graphs.sketching.card.symmetry",
    "cardType": "CONCEPT",
    "front": "Where is a quadratic's line of symmetry, given its roots?",
    "back": "Halfway between the roots: $x = \\frac{x_1 + x_2}{2}$.",
    "concepts": [
      "math.graphs.sketching-curves"
    ]
  },
  {
    "key": "graphs.sketching.card.completed-square",
