    "notes": "$(x + 2)^2 + 3$ has turning point $(-2, 3)$.",
    "concepts": [
      "math.graphs.sketching-curves"
    ]
  },
  {
    "key": "graphs.sketching.card.cubic",
    "cardType": "CONCEPT",
    "front": "End behaviour of a cubic with positive $x^3$ term?",
    "back": "Starts at the bottom left and ends at the top right.",
    "concepts": [
      "math.graphs.sketching-curves"
    ]
  },
  {
    "key": "graphs.sketching.card.repeated",
    "cardType": "CONCEPT",
    "front": "What does a repeated factor such as $x^2$ do to a graph?",
    "back": "The graph touches the $x$-axis at that root instead of crossing it.",
    "concepts": [
      "math.graphs.sketching-curves"
    ]
  },
  {
    "key": "graphs.sketching.card.reciprocal",
    "cardType": "FACT",
    "front": "Asymptotes of $y = \\frac{a}{x}$?",
    "back": "$x = 0$ and $y = 0$ (the axes).",
    "concepts": [
      "math.graphs.sketching-curves"
    ]
  },
  {
    "key": "graphs.sketching.card.reciprocal-quadrants",
    "cardType": "FACT",
    "front": "Quadrants of $y = \\frac{a}{x}$?",
    "back": "$a > 0$: first and third; $a < 0$: second and fourth.",
    "concepts": [
      "math.graphs.sketching-curves"
    ]
  },
  {
    "key": "graphs.sketching.card.exponential",
    "cardType": "FACT",
    "front": "Key features of $y = 2^x$?",
    "back": "Passes through $(0, 1)$; asymptote $y = 0$; always positive and increasing.",
    "concepts": [
      "math.graphs.sketching-curves"
    ]
  },
  {
    "key": "graphs.sketching.card.shifted-exponential",
    "cardType": "CONCEPT",
    "front": "Asymptote and $y$-intercept of $y = 2^x + k$?",
    "back": "Asymptote $y = k$; $y$-intercept $(0, 1 + k)$.",
