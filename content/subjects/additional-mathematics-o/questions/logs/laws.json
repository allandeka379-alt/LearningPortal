 {
  "key": "logs.laws.q17",
  "type": "EXTENDED_RESPONSE",
  "concepts": [
   "amath.logs.laws"
  ],
  "difficulty": 4,
  "marks": 3,
  "estimatedSeconds": 270,
  "stem": "Prove that $\\log_a b = \\dfrac{1}{\\log_b a}$, where $a$ and $b$ are positive numbers other than 1.",
  "answerSpec": {
   "markScheme": {
    "points": [
     {
      "id": "p1",
      "description": "M1 lets $\\log_a b = c$ and writes $a^c = b$.",
      "marks": 1
     },
     {
      "id": "p2",
      "description": "M1 takes logarithms to base $b$: $c\\log_b a = \\log_b b = 1$.",
      "marks": 1
     },
     {
      "id": "p3",
      "description": "A1 divides by $\\log_b a$ to reach $c = \\frac{1}{\\log_b a}$, the given result.",
      "marks": 1
     }
    ]
   },
   "modelAnswer": "Let $\\log_a b = c$. Then\n\n$$\na^c = b\n$$\n\nTake logarithms to base $b$ of both sides:\n\n$$\n\\log_b (a^c) = \\log_b b \\Rightarrow c\\log_b a = 1\n$$\n\n$$\nc = \\frac{1}{\\log_b a}, \\quad \\text{so} \\quad \\log_a b = \\frac{1}{\\log_b a}\n$$"
  },
  "markingMode": "MANUAL",
  "explanation": "Convert to index form, then take logarithms to the other base; the power law brings the index down.",
  "hints": [
   "Start by writing the logarithm in index form."
  ],
  "skill": "ANALYSIS",
  "calculator": false
 },
