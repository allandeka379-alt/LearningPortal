  ],
  "difficulty": 1,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "You want an integer root of $x^{3} - 4x^{2} + x + 6 = 0$ by trial. Which list contains every integer worth trying?",
  "options": [
   {
    "key": "A",
    "content": "$\\pm 1, \\pm 2, \\pm 3, \\pm 6$",
    "correct": true,
    "rationale": "Correct: an integer root must divide the constant term 6."
   },
   {
    "key": "B",
    "content": "$\\pm 1, \\pm 2, \\pm 4$",
    "rationale": "The leading coefficient is 1 here; it is the constant term 6 whose divisors matter, not the coefficient 4."
   },
   {
    "key": "C",
    "content": "$1, 2, 3, 6$",
    "rationale": "Negative divisors must be tried too (in fact x = −1 is a root)."
   },
   {
    "key": "D",
    "content": "$\\pm 1, \\pm 6$",
    "rationale": "2 and 3 also divide 6 and must be tried."
   }
  ],
  "explanation": "If $x = a$ is an integer root, then $a$ divides the constant term. The divisors of 6 are $\\pm 1, \\pm 2, \\pm 3, \\pm 6$. (The roots are $-1$, $2$ and $3$.)",
