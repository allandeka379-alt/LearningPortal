  "difficulty": 1,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "What is the best first step to solve $y = x + 1$ and $x^{2} + y^{2} = 25$ simultaneously?",
  "options": [
   {
    "key": "A",
    "content": "Substitute $y = x + 1$ into $x^{2} + y^{2} = 25$.",
    "correct": true,
    "rationale": "Correct: this gives a quadratic in x alone."
   },
   {
    "key": "B",
    "content": "Square $y = x + 1$ to get $y^{2} = x^{2} + 1$.",
    "rationale": "$(x + 1)^{2} = x^{2} + 2x + 1$, so this step is wrong as well as unhelpful."
   },
   {
    "key": "C",
    "content": "Add the two equations to eliminate $y$.",
    "rationale": "Adding does not remove $y$, because one equation has $y$ and the other $y^{2}$."
   },
   {
    "key": "D",
    "content": "Take square roots: $x + y = 5$.",
    "rationale": "$\\sqrt{x^{2} + y^{2}}$ is not $x + y$."
   }
  ],
  "explanation": "With one linear equation, make one unknown the subject and substitute it into the non-linear equation.",
