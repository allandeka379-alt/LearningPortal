  ],
  "difficulty": 4,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "$X$ has pdf $f(x) = 2x$ for $0 \\leq x \\leq 1$, and $E(X) = \\frac{2}{3}$. Find $\\operatorname{Var}(X)$, as a fraction or correct to 3 significant figures.",
  "answerSpec": {
