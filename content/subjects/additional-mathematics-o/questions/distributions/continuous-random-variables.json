  ],
  "difficulty": 1,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "Which pair of conditions must a probability density function $f(x)$ satisfy?",
  "options": [
   {
    "key": "A",
    "content": "$f(x) \\geq 0$ for all $x$, and the total area under the graph is 1",
    "correct": true,
    "rationale": "Correct: densities are never negative and the total probability is 1."
   },
   {
    "key": "B",
    "content": "$0 \\leq f(x) \\leq 1$ for all $x$, and $f$ is increasing",
    "rationale": "A density can exceed 1 at some points, and it need not increase."
   },
   {
    "key": "C",
    "content": "$f(x) > 0$ for all $x$, and $f(0) = 1$",
    "rationale": "f(x) is 0 outside the range of X, and f(0) can be any non-negative value."
   },
   {
    "key": "D",
    "content": "The values of $f(x)$ add up to 1",
    "rationale": "For a continuous variable the area (an integral), not a sum of values, equals 1."
   }
  ],
  "explanation": "A pdf satisfies $f(x) \\geq 0$ and $\\int f(x)\\,dx = 1$ over the range of $X$. Probabilities are areas under its graph.",
