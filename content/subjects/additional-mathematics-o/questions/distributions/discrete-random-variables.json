  ],
  "difficulty": 2,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "$X$ is the score on one roll of a fair six-sided die. What is $E(X)$?",
  "options": [
   {
    "key": "A",
    "content": "3",
    "rationale": "3 is a possible score but not the mean of the six equally likely scores."
   },
   {
    "key": "B",
    "content": "21",
    "rationale": "21 is the sum of the scores; each must be weighted by 1/6."
   },
   {
    "key": "C",
    "content": "3.5",
    "correct": true,
    "rationale": "Correct: $\\frac{1 + 2 + 3 + 4 + 5 + 6}{6} = \\frac{21}{6}$."
   },
   {
    "key": "D",
    "content": "$\\frac{1}{6}$",
    "rationale": "This is the probability of each score, not the mean."
   }
  ],
  "explanation": "$E(X) = \\sum x \\cdot \\frac{1}{6} = \\frac{21}{6} = 3.5$.",
