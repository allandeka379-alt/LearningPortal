  ],
  "difficulty": 3,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "The random variable $X$ has $P(X = x) = \\dfrac{x + 1}{14}$ for $x = 1, 2, 3, 4$. Find $P(X > 2)$.",
  "options": [
   {
    "key": "A",
    "content": "$\\frac{12}{14}$",
    "rationale": "This is $P(X \\geq 2)$: \"more than 2\" does not include 2."
   },
   {
    "key": "B",
    "content": "$\\frac{9}{14}$",
    "correct": true,
    "rationale": "Correct: $X = 3$ or $4$, so $\\frac{4}{14} + \\frac{5}{14}$."
   },
   {
    "key": "C",
    "content": "$\\frac{5}{14}$",
    "rationale": "This is $P(X = 4)$ only; $X = 3$ is also more than 2."
   },
   {
    "key": "D",
    "content": "$\\frac{4}{14}$",
    "rationale": "This is $P(X = 3)$ only; $X = 4$ is also more than 2."
   }
  ],
