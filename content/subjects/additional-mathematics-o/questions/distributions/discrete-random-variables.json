   "type": "MULTIPLE_CHOICE",
   "optionKeys": [
    "C"
   ]
  },
  "wrongResponses": [
   {
    "type": "MULTIPLE_CHOICE",
    "optionKeys": [
     "A"
    ]
   }
  ],
  "skill": "APPLICATION",
  "calculator": false
 },
