 {
  "key": "distributions.normal-parameters.q07",
  "type": "MULTIPLE_CHOICE",
  "concepts": [
   "amath.distributions.normal-parameters"
  ],
  "difficulty": 3,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "For a normal random variable $X$, $P(X < 20) = 0.15$ and $P(X > 50) = 0.15$. What is the mean of $X$?",
  "options": [
   {
    "key": "A",
    "content": "30",
    "rationale": "30 is not half-way between 20 and 50."
   },
   {
    "key": "B",
    "content": "15",
    "rationale": "15 is the distance from each value to the mean, not the mean itself."
   },
   {
    "key": "C",
    "content": "35",
    "correct": true,
    "rationale": "Correct: equal tails mean 20 and 50 are equally far from the mean, so μ is half-way."
   },
   {
    "key": "D",
    "content": "It cannot be found without knowing σ",
    "rationale": "Symmetry alone fixes the mean here."
   }
  ],
  "explanation": "The normal curve is symmetrical about $\\mu$. Equal tail areas below 20 and above 50 put $\\mu$ midway: $\\frac{20 + 50}{2} = 35$. (Then $\\sigma = \\frac{15}{1.036} \\approx 14.5$.)",
  "hints": [
   "Use the symmetry of the normal curve."
  ],
  "modelResponse": {
   "type": "MULTIPLE_CHOICE",
   "optionKeys": [
    "C"
   ]
  },
  "wrongResponses": [
   {
    "type": "MULTIPLE_CHOICE",
    "optionKeys": [
     "A"
    ]
   }
  ],
  "skill": "ANALYSIS",
