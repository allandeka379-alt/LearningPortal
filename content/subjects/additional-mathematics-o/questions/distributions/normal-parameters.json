 {
  "key": "distributions.normal-parameters.q13",
  "type": "SHORT_ANSWER",
  "concepts": [
   "amath.distributions.normal-parameters"
  ],
  "difficulty": 3,
  "marks": 2,
  "estimatedSeconds": 180,
  "stem": "Tatenda is told that $X \\sim N(40, \\sigma^2)$ and $P(X > 34) = 0.84$. He writes $\\frac{34 - 40}{\\sigma} = 0.994$ and gets $\\sigma = -6.04$. Explain his mistake and give the correct equation.",
  "answerSpec": {
   "markScheme": {
    "points": [
     {
      "id": "p1",
      "description": "A standard deviation cannot be negative; 34 is below the mean (more than half the area is above it), so $z$ must be negative.",
      "marks": 1
     },
     {
      "id": "p2",
      "description": "Correct equation: area to the left of 34 is $1 - 0.84 = 0.16$, so $z = -0.994$ and $\\frac{34 - 40}{\\sigma} = -0.994$, giving $\\sigma = 6.04$.",
      "marks": 1
     }
    ]
   },
   "markingNotes": "Example answer: Since $P(X > 34) = 0.84 > 0.5$, the value 34 is below the mean and its $z$-value is negative. The area to the left is 0.16, so $z = -0.994$ and $\\frac{34 - 40}{\\sigma} = -0.994$, which gives $\\sigma \\approx 6.04$ (positive, as it must be)."
  },
  "markingMode": "MANUAL",
  "explanation": "A sketch of the bell curve shows which side of the mean the value lies.",
  "hints": [
   "Can a standard deviation be negative?"
  ],
  "skill": "EVALUATION",
  "calculator": false
 },
 {
  "key": "distributions.normal-parameters.q14",
  "type": "EXTENDED_RESPONSE",
  "concepts": [
   "amath.distributions.normal-parameters"
  ],
  "difficulty": 4,
  "marks": 3,
  "estimatedSeconds": 270,
  "stem": "$X \\sim N(\\mu, \\sigma^2)$, $P(X > 67) = 0.1$ and $P(X < 46) = 0.2$. Show that $\\mu + 1.282\\sigma = 67$ and $\\mu - 0.842\\sigma = 46$.",
  "answerSpec": {
   "markScheme": {
    "points": [
     {
      "id": "p1",
      "description": "B1 states $\\Phi(1.282) = 0.9$, so $\\frac{67 - \\mu}{\\sigma} = 1.282$ (area to the left of 67 is 0.9).",
      "marks": 1
     },
     {
      "id": "p2",
      "description": "B1 states $\\Phi(0.842) = 0.8$, so $\\frac{46 - \\mu}{\\sigma} = -0.842$ (46 is below the mean).",
      "marks": 1
     },
     {
      "id": "p3",
      "description": "A1 rearranges both to the given forms.",
      "marks": 1
     }
    ]
   },
   "modelAnswer": "$$\nP(X < 67) = 0.9 \\Rightarrow \\frac{67 - \\mu}{\\sigma} = 1.282 \\Rightarrow \\mu + 1.282\\sigma = 67\n$$\n\n$$\nP(X < 46) = 0.2 \\Rightarrow \\frac{46 - \\mu}{\\sigma} = -0.842 \\Rightarrow \\mu - 0.842\\sigma = 46\n$$"
  },
  "markingMode": "MANUAL",
  "explanation": "Each probability gives one equation x = μ + zσ.",
  "hints": [
   "Convert each probability to an area to the left first."
  ],
  "skill": "APPLICATION",
  "calculator": true
 },
