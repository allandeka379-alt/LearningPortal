[
 {
  "key": "calculus.chain-rule.q01",
  "type": "MULTIPLE_CHOICE",
  "concepts": [
   "amath.calculus.chain-rule"
  ],
  "difficulty": 1,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "If $y$ is a function of $u$ and $u$ is a function of $x$, which statement is the chain rule?",
  "options": [
   {
    "key": "A",
    "content": "$\\dfrac{dy}{dx} = \\dfrac{dy}{du} \\times \\dfrac{du}{dx}$",
    "correct": true,
    "rationale": "Correct: the rates along the chain multiply."
   },
   {
    "key": "B",
    "content": "$\\dfrac{dy}{dx} = \\dfrac{dy}{du} \\div \\dfrac{du}{dx}$",
    "rationale": "Dividing would give $\\frac{dy}{du} \\times \\frac{dx}{du}$, which does not \"cancel\" to $\\frac{dy}{dx}$."
   },
   {
    "key": "C",
    "content": "$\\dfrac{dy}{dx} = \\dfrac{dy}{du} + \\dfrac{du}{dx}$",
    "rationale": "Rates along a chain multiply; they do not add."
   },
   {
    "key": "D",
    "content": "$\\dfrac{dy}{dx} = \\dfrac{du}{dy} \\times \\dfrac{dx}{du}$",
    "rationale": "Both fractions are upside down; this gives $\\frac{dx}{dy}$."
   }
  ],
  "explanation": "The chain rule: $\\dfrac{dy}{dx} = \\dfrac{dy}{du} \\times \\dfrac{du}{dx}$. If $y$ changes 5 times as fast as $u$ and $u$ 3 times as fast as $x$, $y$ changes 15 times as fast as $x$.",
  "modelResponse": {
   "type": "MULTIPLE_CHOICE",
   "optionKeys": [
    "A"
   ]
  },
  "wrongResponses": [
   {
    "type": "MULTIPLE_CHOICE",
    "optionKeys": [
     "B"
    ]
   }
  ],
  "skill": "RECALL",
  "calculator": false
 },
