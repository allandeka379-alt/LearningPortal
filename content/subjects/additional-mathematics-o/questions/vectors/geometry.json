  ],
  "difficulty": 3,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "In triangle $OAB$, $N$ and $M$ are the midpoints of $OA$ and $AB$, and $\\overrightarrow{NM} = \\frac{1}{2}\\overrightarrow{OB}$. What does this show?",
  "options": [
   {
    "key": "A",
    "content": "$N$, $M$ and $B$ lie on one straight line",
    "rationale": "Collinearity needs vectors sharing a point; NM and OB share none."
   },
   {
    "key": "B",
    "content": "$NM$ is perpendicular to $OB$",
    "rationale": "A scalar multiple is parallel, never perpendicular."
   },
   {
    "key": "C",
    "content": "$NM$ is parallel to $OB$ and half its length",
    "correct": true,
    "rationale": "Correct: a scalar multiple means parallel, and the scalar ½ gives the length ratio."
   },
   {
    "key": "D",
    "content": "$NM$ is twice as long as $OB$",
    "rationale": "The scalar is ½, so NM is half as long as OB."
   }
  ],
  "explanation": "$\\overrightarrow{NM} = \\frac{1}{2}\\overrightarrow{OB}$ says the two vectors have the same direction and $NM = \\frac{1}{2}OB$: the midpoint theorem.",
  "hints": [
   "What does a scalar multiple tell you about direction and length?"
  ],
  "modelResponse": {
   "type": "MULTIPLE_CHOICE",
   "optionKeys": [
    "C"
   ]
  },
