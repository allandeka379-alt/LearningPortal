 {
  "key": "modulus.equations.q14",
  "type": "SHORT_ANSWER",
  "concepts": [
   "amath.modulus.equations"
  ],
  "difficulty": 3,
  "marks": 2,
  "estimatedSeconds": 180,
  "stem": "Explain why the solutions of $|ax + b| = cx + d$ must be checked, but the solutions of $|ax + b| = 7$ need not be.",
  "answerSpec": {
   "markScheme": {
    "points": [
     {
      "id": "p1",
      "description": "A modulus is never negative, so a valid solution needs $cx + d \\geq 0$; a case can give an $x$ where $cx + d < 0$, which must be rejected.",
      "marks": 1
     },
     {
      "id": "p2",
      "description": "When the right-hand side is the positive constant 7, both cases $ax + b = \\pm 7$ automatically give a modulus of 7, so no root is false.",
      "marks": 1
     }
    ]
   },
   "markingNotes": "Example answer: Solving $ax + b = -(cx + d)$ can give an $x$ for which $cx + d$ is negative; the modulus would then equal a negative number, which is impossible, so that root is rejected. With $|ax + b| = 7$, any $x$ with $ax + b = 7$ or $ax + b = -7$ really has $|ax + b| = 7$."
  },
  "markingMode": "MANUAL",
  "explanation": "The check is about the sign of the right-hand side.",
  "hints": [
   "Can a modulus equal a negative number?"
  ],
  "skill": "UNDERSTANDING",
  "calculator": false
 },
