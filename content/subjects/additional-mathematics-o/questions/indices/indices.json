  "difficulty": 1,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "What is the value of $7^{0}$?",
  "options": [
   {
    "key": "A",
    "content": "$1$",
    "correct": true,
    "rationale": "Correct: any non-zero number to the power 0 is 1, because $7^{n} \\div 7^{n} = 7^{0}$."
   },
   {
    "key": "B",
    "content": "$0$",
    "rationale": "The index 0 does not make the value 0; dividing a power by itself gives 1."
   },
   {
    "key": "C",
    "content": "$7$",
    "rationale": "That is $7^{1}$."
   },
   {
    "key": "D",
    "content": "$\\frac{1}{7}$",
    "rationale": "That is $7^{-1}$."
   }
  ],
  "explanation": "$a^{0} = 1$ for every $a \\neq 0$, since $a^{n} \\div a^{n} = a^{n-n} = a^{0}$ and also equals 1.",
