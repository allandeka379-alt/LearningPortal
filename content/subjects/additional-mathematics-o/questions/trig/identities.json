 {
  "key": "trig.identities.q13",
  "type": "EXTENDED_RESPONSE",
  "concepts": [
   "amath.trig.identities"
  ],
  "difficulty": 3,
  "marks": 3,
  "estimatedSeconds": 270,
  "stem": "Prove that $(1 - \\cos^2 x)(1 + \\cot^2 x) \\equiv 1$.",
  "answerSpec": {
   "markScheme": {
    "points": [
     {
      "id": "p1",
      "description": "M1 uses $1 - \\cos^2 x = \\sin^2 x$.",
      "marks": 1
     },
     {
      "id": "p2",
      "description": "M1 uses $1 + \\cot^2 x = \\operatorname{cosec}^2 x$ (or writes $\\cot^2 x = \\frac{\\cos^2 x}{\\sin^2 x}$).",
      "marks": 1
     },
     {
      "id": "p3",
      "description": "A1 obtains $\\sin^2 x \\cdot \\frac{1}{\\sin^2 x} = 1$ with no errors.",
      "marks": 1
     }
    ]
   },
   "modelAnswer": "$$\n\\text{LHS} = (1 - \\cos^2 x)(1 + \\cot^2 x)\n$$\n\n$$\n= \\sin^2 x \\cdot \\operatorname{cosec}^2 x\n$$\n\n$$\n= \\sin^2 x \\cdot \\frac{1}{\\sin^2 x} = 1 = \\text{RHS}\n$$"
  },
  "markingMode": "MANUAL",
  "explanation": "Each bracket is a Pythagorean identity in disguise.",
  "hints": [
   "Replace each bracket using a Pythagorean identity."
  ],
  "skill": "APPLICATION",
  "calculator": false
 },
 {
  "key": "trig.identities.q14",
  "type": "EXTENDED_RESPONSE",
  "concepts": [
   "amath.trig.identities"
  ],
  "difficulty": 4,
  "marks": 4,
  "estimatedSeconds": 360,
  "stem": "Prove that $\\dfrac{\\cos x}{1 - \\sin x} - \\dfrac{\\cos x}{1 + \\sin x} \\equiv 2\\tan x$.",
  "answerSpec": {
   "markScheme": {
    "points": [
     {
      "id": "p1",
      "description": "M1 combines over the common denominator $(1 - \\sin x)(1 + \\sin x)$.",
      "marks": 1
     },
     {
      "id": "p2",
      "description": "A1 simplifies the numerator to $2\\sin x\\cos x$.",
      "marks": 1
     },
     {
      "id": "p3",
      "description": "M1 uses $1 - \\sin^2 x = \\cos^2 x$ for the denominator.",
      "marks": 1
     },
     {
      "id": "p4",
      "description": "A1 cancels to $\\frac{2\\sin x}{\\cos x} = 2\\tan x$.",
      "marks": 1
     }
    ]
   },
   "modelAnswer": "$$\n\\text{LHS} = \\frac{\\cos x(1 + \\sin x) - \\cos x(1 - \\sin x)}{(1 - \\sin x)(1 + \\sin x)}\n$$\n\n$$\n= \\frac{\\cos x + \\sin x\\cos x - \\cos x + \\sin x\\cos x}{1 - \\sin^2 x}\n$$\n\n$$\n= \\frac{2\\sin x\\cos x}{\\cos^2 x}\n$$\n\n$$\n= \\frac{2\\sin x}{\\cos x} = 2\\tan x = \\text{RHS}\n$$"
  },
  "markingMode": "MANUAL",
  "explanation": "Combine the fractions, then the denominator becomes a difference of two squares and a Pythagorean identity.",
  "hints": [
   "$(1 - \\sin x)(1 + \\sin x) = 1 - \\sin^2 x$."
  ],
  "skill": "ANALYSIS",
  "calculator": false
 },
