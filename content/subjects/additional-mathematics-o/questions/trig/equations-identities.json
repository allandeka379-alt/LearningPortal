[
 {
  "key": "trig.equations-identities.q01",
  "type": "MULTIPLE_CHOICE",
  "concepts": [
   "amath.trig.equations-identities"
  ],
  "difficulty": 1,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "To solve $3\\cos^2 x + 4\\sin x - 4 = 0$, which identity should you use first?",
  "options": [
   {
    "key": "A",
    "content": "$\\cos^2 x = 1 - \\sin^2 x$",
    "correct": true,
    "rationale": "Correct: $\\sin x$ appears unsquared, so keep it and replace $\\cos^2 x$; the result is a quadratic in $\\sin x$."
   },
   {
    "key": "B",
    "content": "$\\sin x = \\sqrt{1 - \\cos^2 x}$",
    "rationale": "This introduces a square root and loses the sign of sin x; replace the squared function instead."
   },
   {
    "key": "C",
    "content": "$\\sec^2 x = 1 + \\tan^2 x$",
    "rationale": "Neither sec nor tan appears in the equation."
   },
   {
    "key": "D",
    "content": "$\\tan x = \\frac{\\sin x}{\\cos x}$",
    "rationale": "This does not reduce the equation to one function."
   }
  ],
  "explanation": "$3(1 - \\sin^2 x) + 4\\sin x - 4 = 0$ gives $3\\sin^2 x - 4\\sin x + 1 = 0$, a quadratic in $\\sin x$.",
  "modelResponse": {
   "type": "MULTIPLE_CHOICE",
   "optionKeys": [
    "A"
   ]
  },
  "wrongResponses": [
   {
    "type": "MULTIPLE_CHOICE",
    "optionKeys": [
     "B"
    ]
   }
  ],
  "skill": "UNDERSTANDING",
  "calculator": false
 },
 {
  "key": "trig.equations-identities.q02",
  "type": "MULTIPLE_CHOICE",
  "concepts": [
   "amath.trig.equations-identities"
  ],
  "difficulty": 2,
  "marks": 1,
  "estimatedSeconds": 90,
  "stem": "Which quadratic in $\\cos x$ is equivalent to $2\\sin^2 x + 3\\cos x = 0$?",
  "options": [
   {
    "key": "A",
    "content": "$2\\cos^2 x - 3\\cos x - 2 = 0$",
    "correct": true,
    "rationale": "Correct: $2(1 - \\cos^2 x) + 3\\cos x = 0$, then multiply by $-1$."
   },
   {
    "key": "B",
    "content": "$2\\cos^2 x + 3\\cos x - 2 = 0$",
    "rationale": "When multiplying $-2\\cos^2 x + 3\\cos x + 2 = 0$ by $-1$, every term changes sign, including $3\\cos x$."
   },
   {
    "key": "C",
    "content": "$2\\cos^2 x - 3\\cos x = 0$",
    "rationale": "$2\\sin^2 x = 2 - 2\\cos^2 x$: the constant 2 has been dropped."
   },
   {
    "key": "D",
    "content": "$2\\cos^2 x - 3\\cos x + 2 = 0$",
    "rationale": "The constant term should change sign along with the others."
   }
  ],
  "explanation": "$2 - 2\\cos^2 x + 3\\cos x = 0$, so $2\\cos^2 x - 3\\cos x - 2 = 0$, which factorises as $(2\\cos x + 1)(\\cos x - 2) = 0$.",
  "modelResponse": {
   "type": "MULTIPLE_CHOICE",
   "optionKeys": [
    "A"
   ]
  },
  "wrongResponses": [
   {
    "type": "MULTIPLE_CHOICE",
    "optionKeys": [
     "B"
    ]
   }
  ],
  "skill": "APPLICATION",
