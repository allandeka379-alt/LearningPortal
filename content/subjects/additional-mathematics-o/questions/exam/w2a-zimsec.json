  "difficulty": 5,
  "marks": 12,
  "estimatedSeconds": 1080,
  "stem": "The positive numbers $x$ and $y$ satisfy the simultaneous equations $\\log_3 x - \\log_9 y = 2$ and $xy = 243$.",
  "parts": [
   {
    "label": "(a)",
    "type": "EXTENDED_RESPONSE",
    "marks": 2,
    "markingMode": "MANUAL",
    "stem": "Show that $\\log_9 y = \\frac{1}{2}\\log_3 y$.",
    "answerSpec": {
     "markScheme": {
      "points": [
       {
        "id": "p1",
        "description": "M1 changes base: $\\log_9 y = \\frac{\\log_3 y}{\\log_3 9}$.",
        "marks": 1
       },
       {
        "id": "p2",
        "description": "A1 uses $\\log_3 9 = 2$ to reach the result.",
        "marks": 1
       }
      ]
     },
     "modelAnswer": "$$\n\\log_9 y = \\frac{\\log_3 y}{\\log_3 9} = \\frac{\\log_3 y}{2} = \\frac{1}{2}\\log_3 y\n$$"
    },
    "explanation": "Change of base to base 3."
   },
   {
    "label": "(b)",
    "type": "EXTENDED_RESPONSE",
    "marks": 2,
    "markingMode": "MANUAL",
    "stem": "Hence show that $x = 9\\sqrt{y}$.",
