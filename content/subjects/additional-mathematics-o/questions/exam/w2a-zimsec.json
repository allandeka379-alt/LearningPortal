    "workedSolution": "1. $x = 9\\sqrt{9} = 27$ (check: $27 \\times 9 = 243$)."
   },
   {
    "label": "(e)",
    "type": "NUMERICAL",
    "marks": 2,
    "stem": "Find the exact value of $\\log_y x$.",
    "answerSpec": {
