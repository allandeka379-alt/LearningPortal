[
 {
  "key": "series.geometric.c01",
  "cardType": "DEFINITION",
  "front": "Geometric progression",
  "back": "A sequence with a constant ratio $r = \\frac{u_{n+1}}{u_n}$ between neighbouring terms.",
  "concepts": [
   "amath.series.geometric"
  ]
 },
 {
  "key": "series.geometric.c02",
  "cardType": "FORMULA",
  "front": "nth term of a GP",
  "back": "$u_n = ar^{n-1}$",
  "concepts": [
   "amath.series.geometric"
  ]
 },
 {
  "key": "series.geometric.c03",
  "cardType": "FORMULA",
  "front": "Sum of the first n terms of a GP",
  "back": "$S_n = \\frac{a(1 - r^n)}{1 - r} = \\frac{a(r^n - 1)}{r - 1}$, $r \\neq 1$",
  "notes": "In Cambridge's List of formulas.",
  "concepts": [
   "amath.series.geometric"
  ]
 },
 {
  "key": "series.geometric.c04",
  "cardType": "CONCEPT",
  "front": "AP or GP?",
  "back": "Constant difference: arithmetic. Constant ratio: geometric.",
  "concepts": [
   "amath.series.geometric"
  ]
 },
 {
  "key": "series.geometric.c05",
  "cardType": "CONCEPT",
  "front": "Finding r from two terms",
  "back": "Divide the terms: e.g. $\\frac{ar^5}{ar^2} = r^3$.",
  "concepts": [
   "amath.series.geometric"
  ]
 },
 {
  "key": "series.geometric.c06",
  "cardType": "CONCEPT",
  "front": "Finding $n$ in $ar^{n-1} > k$",
  "back": "Take logarithms of both sides; dividing by the log of a number below 1 reverses the inequality.",
  "concepts": [
   "amath.series.geometric"
  ]
 },
 {
  "key": "series.geometric.c07",
  "cardType": "FACT",
  "front": "Growth or decay of p% per period",
  "back": "Multiply by $1 + \\frac{p}{100}$ (growth) or $1 - \\frac{p}{100}$ (decay) each period.",
  "concepts": [
   "amath.series.geometric"
  ]
 },
 {
  "key": "series.geometric.c08",
  "cardType": "FACT",
  "front": "Three numbers in GP",
  "back": "$x, y, z$ are in GP when $y^2 = xz$.",
  "concepts": [
   "amath.series.geometric"
  ]
 },
 {
  "key": "series.geometric.c09",
  "cardType": "CONCEPT",
  "front": "Proof of the GP sum",
  "back": "Write $S_n$ and $rS_n$ and subtract: $S_n(1 - r) = a(1 - r^n)$.",
  "concepts": [
   "amath.series.geometric"
  ]
 }
]
