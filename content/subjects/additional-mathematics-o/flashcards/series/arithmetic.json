[
 {
  "key": "series.arithmetic.c01",
  "cardType": "DEFINITION",
  "front": "Arithmetic progression",
  "back": "A sequence with a constant common difference $d = u_{n+1} - u_n$.",
  "concepts": [
   "amath.series.arithmetic"
  ]
 },
 {
  "key": "series.arithmetic.c02",
  "cardType": "FORMULA",
  "front": "nth term of an AP",
