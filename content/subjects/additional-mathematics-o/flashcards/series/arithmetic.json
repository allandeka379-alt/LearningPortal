  "concepts": [
   "amath.series.arithmetic"
  ]
 },
 {
  "key": "series.arithmetic.c03",
  "cardType": "FORMULA",
  "front": "Sum of an AP using the last term",
  "back": "$S_n = \\frac{n}{2}(a + l)$",
  "concepts": [
   "amath.series.arithmetic"
  ]
 },
 {
  "key": "series.arithmetic.c04",
