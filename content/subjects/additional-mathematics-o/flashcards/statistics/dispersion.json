[
 {
  "key": "statistics.dispersion.c01",
  "cardType": "FORMULA",
  "front": "Range and interquartile range",
  "back": "Range = largest − smallest; IQR $= Q_3 - Q_1$.",
  "concepts": [
   "amath.statistics.dispersion"
  ]
 },
 {
  "key": "statistics.dispersion.c02",
  "cardType": "FORMULA",
  "front": "Variance of raw data",
  "back": "$\\sigma^2 = \\dfrac{\\sum (x - \\bar{x})^2}{n} = \\dfrac{\\sum x^2}{n} - \\bar{x}^2$",
  "concepts": [
   "amath.statistics.dispersion"
  ]
 },
 {
  "key": "statistics.dispersion.c03",
  "cardType": "FORMULA",
  "front": "Variance from a frequency table",
  "back": "$\\sigma^2 = \\dfrac{\\sum fx^2}{\\sum f} - \\bar{x}^2$ (grouped data: $x$ = midpoint).",
  "concepts": [
   "amath.statistics.dispersion"
  ]
 },
 {
  "key": "statistics.dispersion.c04",
  "cardType": "DEFINITION",
  "front": "Standard deviation",
  "back": "The square root of the variance; in the same units as the data.",
  "concepts": [
   "amath.statistics.dispersion"
  ]
 },
 {
  "key": "statistics.dispersion.c05",
  "cardType": "FORMULA",
  "front": "Coefficient of variation",
  "back": "$\\text{CV} = \\dfrac{\\sigma}{\\bar{x}} \\times 100\\%$",
  "notes": "Compares spreads of data with different means or units.",
  "concepts": [
   "amath.statistics.dispersion"
  ]
 },
 {
  "key": "statistics.dispersion.c06",
  "cardType": "FACT",
  "front": "Quartiles of grouped data",
  "back": "Interpolate at positions $\\frac{n}{4}$ ($Q_1$) and $\\frac{3n}{4}$ ($Q_3$), as for the median.",
  "concepts": [
   "amath.statistics.dispersion"
  ]
 },
 {
  "key": "statistics.dispersion.c07",
  "cardType": "CONCEPT",
  "front": "Why dispersion matters",
  "back": "Equal averages can hide very different spreads; spread measures consistency and reliability.",
  "concepts": [
   "amath.statistics.dispersion"
  ]
 },
 {
  "key": "statistics.dispersion.c08",
  "cardType": "FACT",
  "front": "Effect of an outlier",
  "back": "It changes the range and standard deviation a lot, the IQR hardly at all.",
  "concepts": [
   "amath.statistics.dispersion"
  ]
 },
 {
  "key": "statistics.dispersion.c09",
  "cardType": "FACT",
  "front": "Adding a constant to every value",
  "back": "The mean changes by that constant; the standard deviation and IQR do not change.",
  "concepts": [
   "amath.statistics.dispersion"
  ]
 }
