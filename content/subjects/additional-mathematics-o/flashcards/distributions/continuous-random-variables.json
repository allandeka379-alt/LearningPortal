[
 {
  "key": "distributions.continuous-random-variables.c01",
  "cardType": "DEFINITION",
  "front": "Continuous random variable",
  "back": "A random variable that can take any value in an interval, e.g. a waiting time or a mass.",
  "concepts": [
   "amath.distributions.continuous-random-variables"
  ]
 },
 {
  "key": "distributions.continuous-random-variables.c02",
  "cardType": "DEFINITION",
  "front": "Probability density function",
  "back": "A function with $f(x) \\geq 0$ and total area 1 under its graph; probabilities are areas.",
  "concepts": [
   "amath.distributions.continuous-random-variables"
  ]
 },
 {
  "key": "distributions.continuous-random-variables.c03",
  "cardType": "FORMULA",
  "front": "Probability from a pdf",
  "back": "$P(a < X < b) = \\displaystyle\\int_a^b f(x)\\,dx$",
  "concepts": [
   "amath.distributions.continuous-random-variables"
  ]
 },
 {
  "key": "distributions.continuous-random-variables.c04",
  "cardType": "FORMULA",
  "front": "Mean of a continuous random variable",
  "back": "$E(X) = \\displaystyle\\int x f(x)\\,dx$",
  "concepts": [
   "amath.distributions.continuous-random-variables"
  ]
 },
 {
  "key": "distributions.continuous-random-variables.c05",
  "cardType": "FORMULA",
  "front": "Variance of a continuous random variable",
  "back": "$\\operatorname{Var}(X) = \\displaystyle\\int x^2 f(x)\\,dx - [E(X)]^2$",
  "concepts": [
   "amath.distributions.continuous-random-variables"
  ]
 },
 {
  "key": "distributions.continuous-random-variables.c06",
  "cardType": "FACT",
  "front": "Single values",
  "back": "For a continuous variable $P(X = a) = 0$, so $P(X < a) = P(X \\leq a)$.",
  "concepts": [
   "amath.distributions.continuous-random-variables"
  ]
 },
 {
  "key": "distributions.continuous-random-variables.c07",
  "cardType": "CONCEPT",
  "front": "Finding k in a pdf",
  "back": "Integrate $f(x)$ over its whole range and set the result equal to 1.",
  "concepts": [
   "amath.distributions.continuous-random-variables"
  ]
 },
 {
  "key": "distributions.continuous-random-variables.c08",
  "cardType": "CONCEPT",
  "front": "Symmetry and the mean",
  "back": "If the pdf is symmetrical about $x = c$, then $E(X) = c$.",
  "concepts": [
   "amath.distributions.continuous-random-variables"
  ]
 },
 {
  "key": "distributions.continuous-random-variables.c09",
  "cardType": "FACT",
  "front": "Density above 1",
  "back": "$f(x)$ can be greater than 1 at some points (e.g. $\\frac{3x^2}{8}$ at $x = 2$ is 1.5); only the total area must be 1.",
  "concepts": [
   "amath.distributions.continuous-random-variables"
  ]
 }
]
