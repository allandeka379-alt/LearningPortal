[
 {
  "key": "distributions.discrete-random-variables.c01",
  "cardType": "DEFINITION",
  "front": "Discrete random variable",
  "back": "A quantity decided by chance that takes separate (countable) values, e.g. the number of heads in three tosses.",
  "concepts": [
   "amath.distributions.discrete-random-variables"
  ]
 },
 {
  "key": "distributions.discrete-random-variables.c02",
  "cardType": "DEFINITION",
  "front": "Probability distribution",
  "back": "A list of every value $x$ of $X$ with $P(X = x)$; each probability is between 0 and 1 and $\\sum P(X = x) = 1$.",
  "concepts": [
   "amath.distributions.discrete-random-variables"
  ]
 },
 {
  "key": "distributions.discrete-random-variables.c03",
  "cardType": "FORMULA",
  "front": "Expectation of a discrete random variable",
  "back": "$E(X) = \\sum x\\,P(X = x)$",
  "concepts": [
   "amath.distributions.discrete-random-variables"
  ]
 },
 {
  "key": "distributions.discrete-random-variables.c04",
  "cardType": "FORMULA",
  "front": "Variance of a discrete random variable",
  "back": "$\\operatorname{Var}(X) = \\sum x^2P(X = x) - [E(X)]^2$",
  "notes": "Mean of the squares minus the square of the mean.",
  "concepts": [
   "amath.distributions.discrete-random-variables"
  ]
 },
 {
  "key": "distributions.discrete-random-variables.c05",
  "cardType": "CONCEPT",
  "front": "Finding an unknown probability",
  "back": "Use $\\sum P = 1$; with two unknowns, also use the given value of $E(X)$.",
  "concepts": [
   "amath.distributions.discrete-random-variables"
  ]
 },
 {
  "key": "distributions.discrete-random-variables.c06",
  "cardType": "CONCEPT",
  "front": "Meaning of E(X)",
  "back": "The long-run average value of X over many trials; it need not be a value X can take.",
  "concepts": [
   "amath.distributions.discrete-random-variables"
  ]
 },
 {
  "key": "distributions.discrete-random-variables.c07",
  "cardType": "FACT",
  "front": "Fair die",
  "back": "$E(X) = 3.5$ and $\\operatorname{Var}(X) = \\frac{35}{12}$ for the score on a fair six-sided die.",
  "concepts": [
   "amath.distributions.discrete-random-variables"
  ]
 },
 {
  "key": "distributions.discrete-random-variables.c08",
  "cardType": "CONCEPT",
  "front": "Cumulative probability words",
  "back": "At most 3: $X \\leq 3$. Fewer than 3: $X \\leq 2$. At least 3: $X \\geq 3$. More than 3: $X \\geq 4$.",
  "concepts": [
   "amath.distributions.discrete-random-variables"
  ]
 },
 {
  "key": "distributions.discrete-random-variables.c09",
  "cardType": "FORMULA",
  "front": "Complement for 'at least'",
  "back": "$P(X \\geq a) = 1 - P(X \\leq a - 1)$ for whole-number values.",
  "concepts": [
   "amath.distributions.discrete-random-variables"
  ]
 }
]
