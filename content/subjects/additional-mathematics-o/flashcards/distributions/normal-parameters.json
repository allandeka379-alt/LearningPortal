 {
  "key": "distributions.normal-parameters.c02",
  "cardType": "CONCEPT",
  "front": "Reverse normal method",
  "back": "Turn the probability into an area to the left, read z from the table (negative if the area is below 0.5), then solve (x − μ)/σ = z.",
  "concepts": [
   "amath.distributions.normal-parameters"
  ]
 },
 {
  "key": "distributions.normal-parameters.c03",
  "cardType": "CONCEPT",
  "front": "Two unknowns",
  "back": "Two probabilities give two equations μ + zσ = x; subtract them to find σ, then substitute for μ.",
  "concepts": [
   "amath.distributions.normal-parameters"
  ]
 },
 {
