   "amath.distributions.normal-parameters"
  ]
 },
 {
  "key": "distributions.normal-parameters.c05",
  "cardType": "CONCEPT",
  "front": "Sign of z",
  "back": "A value below the mean has a negative z. If σ comes out negative, a sign is wrong.",
  "concepts": [
   "amath.distributions.normal-parameters"
  ]
 },
 {
  "key": "distributions.normal-parameters.c06",
  "cardType": "CONCEPT",
  "front": "Equal tails",
  "back": "If P(X < a) = P(X > b), then the mean is half-way between a and b.",
  "concepts": [
   "amath.distributions.normal-parameters"
  ]
 },
 {
  "key": "distributions.normal-parameters.c07",
  "cardType": "CONCEPT",
  "front": "Right-hand tail given",
  "back": "For $P(X > x) = p$, look up $1 - p$ in the table.",
  "concepts": [
   "amath.distributions.normal-parameters"
  ]
 },
 {
  "key": "distributions.normal-parameters.c08",
  "cardType": "FACT",
  "front": "Filling machines",
  "back": "To keep under-filling rare, the mean must be set above the stated amount: μ = stated amount + zσ.",
