[
 {
  "key": "distributions.normal.c01",
  "cardType": "DEFINITION",
  "front": "$N(\\mu, \\sigma^2)$",
  "back": "A normal distribution with mean $\\mu$ and **variance** $\\sigma^2$; the standard deviation is $\\sigma$.",
  "concepts": [
   "amath.distributions.normal"
  ]
 },
 {
  "key": "distributions.normal.c02",
  "cardType": "FORMULA",
  "front": "Standardising",
  "back": "$Z = \\dfrac{X - \\mu}{\\sigma}$",
  "concepts": [
   "amath.distributions.normal"
  ]
 },
 {
  "key": "distributions.normal.c03",
  "cardType": "FACT",
  "front": "68–95–99.7 rule",
  "back": "About 68%, 95% and 99.7% of a normal distribution lie within 1, 2 and 3 standard deviations of the mean.",
  "concepts": [
   "amath.distributions.normal"
  ]
 },
 {
  "key": "distributions.normal.c04",
  "cardType": "FORMULA",
  "front": "Greater than",
  "back": "$P(Z > a) = 1 - \\Phi(a)$",
  "concepts": [
   "amath.distributions.normal"
  ]
 },
 {
  "key": "distributions.normal.c05",
  "cardType": "FORMULA",
  "front": "Negative z",
  "back": "$\\Phi(-a) = 1 - \\Phi(a)$",
  "concepts": [
   "amath.distributions.normal"
  ]
 },
 {
  "key": "distributions.normal.c06",
  "cardType": "FORMULA",
  "front": "Between two values",
  "back": "$P(a < Z < b) = \\Phi(b) - \\Phi(a)$",
  "concepts": [
   "amath.distributions.normal"
  ]
 },
 {
  "key": "distributions.normal.c07",
  "cardType": "CONCEPT",
  "front": "Reverse use of the tables",
  "back": "Probability → read $z$ from inside the table → $x = \\mu + z\\sigma$. If the area to the left is below 0.5, $z$ is negative.",
  "concepts": [
   "amath.distributions.normal"
  ]
 },
 {
  "key": "distributions.normal.c08",
  "cardType": "FACT",
  "front": "Useful z-values",
  "back": "$\\Phi(1.645) = 0.95$, $\\Phi(1.96) = 0.975$, $\\Phi(2.576) = 0.995$.",
  "concepts": [
   "amath.distributions.normal"
  ]
 },
 {
  "key": "distributions.normal.c09",
  "cardType": "CONCEPT",
  "front": "Properties of the normal curve",
  "back": "Bell-shaped, symmetrical about the mean; mean = median = mode; the tails never touch the axis.",
  "concepts": [
   "amath.distributions.normal"
  ]
 }
]
