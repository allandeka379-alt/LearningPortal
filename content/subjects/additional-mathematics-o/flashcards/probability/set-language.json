[
 {
  "key": "probability.set-language.c01",
  "cardType": "DEFINITION",
  "front": "Sample space",
  "back": "The set $S$ of all possible outcomes of a trial. For one roll of a die, $S = \\{1, 2, 3, 4, 5, 6\\}$.",
  "concepts": [
   "amath.probability.set-language"
  ]
 },
 {
  "key": "probability.set-language.c02",
  "cardType": "DEFINITION",
  "front": "Event",
  "back": "A set of outcomes (a subset of the sample space), e.g. \"an even score\" $= \\{2, 4, 6\\}$.",
  "concepts": [
   "amath.probability.set-language"
  ]
 },
 {
  "key": "probability.set-language.c03",
  "cardType": "FORMULA",
  "front": "Probability with equally likely outcomes",
  "back": "$P(A) = \\dfrac{n(A)}{n(S)}$",
  "notes": "Only when every outcome is equally likely.",
  "concepts": [
   "amath.probability.set-language"
  ]
 },
 {
  "key": "probability.set-language.c04",
  "cardType": "FORMULA",
  "front": "Complement rule",
  "back": "$P(A') = 1 - P(A)$",
  "concepts": [
   "amath.probability.set-language"
  ]
 },
 {
  "key": "probability.set-language.c05",
  "cardType": "CONCEPT",
  "front": "$A \\cup B$, $A \\cap B$, $A'$",
  "back": "$A \\cup B$: $A$ or $B$ or both. $A \\cap B$: both. $A'$: not $A$.",
  "concepts": [
   "amath.probability.set-language"
  ]
 },
 {
  "key": "probability.set-language.c06",
  "cardType": "FORMULA",
  "front": "Counting a union",
  "back": "$n(A \\cup B) = n(A) + n(B) - n(A \\cap B)$",
  "notes": "Subtract the overlap, which was counted twice.",
  "concepts": [
   "amath.probability.set-language"
  ]
 },
 {
  "key": "probability.set-language.c07",
  "cardType": "DEFINITION",
  "front": "Mutually exclusive events",
  "back": "Events that cannot happen together: $A \\cap B = \\varnothing$. Their circles on a Venn diagram do not overlap.",
  "concepts": [
   "amath.probability.set-language"
  ]
 },
 {
  "key": "probability.set-language.c08",
  "cardType": "FACT",
  "front": "Regions of a Venn diagram",
  "back": "Two events: 4 regions. Three events: 8 regions (including the outside).",
  "concepts": [
   "amath.probability.set-language"
  ]
 },
 {
  "key": "probability.set-language.c09",
  "cardType": "CONCEPT",
  "front": "Filling a Venn diagram",
  "back": "Start in the centre (all events), then the 'two only' regions, then each 'one only' region, then the outside.",
  "concepts": [
   "amath.probability.set-language"
  ]
 }
]
