[
 {
  "key": "estimation.confidence-intervals.c01",
  "cardType": "FORMULA",
  "front": "Confidence interval for a mean",
  "back": "$\\bar{x} \\pm z\\dfrac{\\sigma}{\\sqrt{n}}$; use $s$ for $\\sigma$ when $n$ is large and $\\sigma$ is unknown.",
  "concepts": [
   "amath.estimation.confidence-intervals"
  ]
 },
 {
  "key": "estimation.confidence-intervals.c02",
  "cardType": "FACT",
  "front": "z-values for confidence intervals",
  "back": "95%: z = 1.96. 99%: z = 2.576.",
  "concepts": [
   "amath.estimation.confidence-intervals"
  ]
 },
 {
  "key": "estimation.confidence-intervals.c03",
  "cardType": "DEFINITION",
  "front": "Margin of error",
  "back": "$z\\dfrac{\\sigma}{\\sqrt{n}}$: half the width of the interval.",
  "concepts": [
   "amath.estimation.confidence-intervals"
  ]
 },
 {
  "key": "estimation.confidence-intervals.c04",
  "cardType": "CONCEPT",
  "front": "Interpreting a 95% interval",
  "back": "About 95% of intervals made this way from random samples contain the true mean; it says nothing about individual values.",
  "concepts": [
   "amath.estimation.confidence-intervals"
  ]
 },
 {
  "key": "estimation.confidence-intervals.c05",
  "cardType": "CONCEPT",
  "front": "What affects the width",
  "back": "Higher confidence → wider. Larger σ → wider. Larger n → narrower (∝ 1/√n).",
  "concepts": [
   "amath.estimation.confidence-intervals"
  ]
 },
 {
  "key": "estimation.confidence-intervals.c06",
  "cardType": "FORMULA",
  "front": "Sample size for a given width w",
  "back": "$n \\geq \\left(\\dfrac{2z\\sigma}{w}\\right)^2$, rounded up.",
  "concepts": [
   "amath.estimation.confidence-intervals"
  ]
 },
 {
  "key": "estimation.confidence-intervals.c07",
  "cardType": "CONCEPT",
  "front": "When the formula applies",
  "back": "Normal population with known σ (any n), or any population with a large sample (central limit theorem).",
  "concepts": [
   "amath.estimation.confidence-intervals"
  ]
 },
 {
  "key": "estimation.confidence-intervals.c08",
  "cardType": "CONCEPT",
  "front": "Testing a claim with an interval",
  "back": "A claimed mean outside a 95% interval is doubtful at the 5% level; one inside is consistent with the data.",
  "concepts": [
   "amath.estimation.confidence-intervals"
  ]
 }
]
