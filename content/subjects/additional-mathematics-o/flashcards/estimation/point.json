[
 {
  "key": "estimation.point.c01",
  "cardType": "DEFINITION",
  "front": "Point estimate",
  "back": "A single value, calculated from a sample, used as an estimate of a population parameter.",
  "concepts": [
   "amath.estimation.point"
  ]
 },
 {
  "key": "estimation.point.c02",
  "cardType": "DEFINITION",
  "front": "Unbiased estimator",
  "back": "An estimator whose expected value equals the parameter it estimates: right on average.",
  "concepts": [
   "amath.estimation.point"
  ]
 },
 {
  "key": "estimation.point.c03",
  "cardType": "FORMULA",
  "front": "Unbiased estimate of the mean",
  "back": "$\\bar{x} = \\dfrac{\\sum x}{n}$",
  "concepts": [
   "amath.estimation.point"
  ]
 },
 {
  "key": "estimation.point.c04",
  "cardType": "FORMULA",
  "front": "Unbiased estimate of the variance",
  "back": "$s^2 = \\dfrac{1}{n - 1}\\left(\\sum x^2 - \\dfrac{(\\sum x)^2}{n}\\right)$",
  "concepts": [
   "amath.estimation.point"
  ]
 },
 {
  "key": "estimation.point.c05",
  "cardType": "FORMULA",
  "front": "From the sample variance to s²",
  "back": "$s^2 = \\dfrac{n}{n - 1} \\times (\\text{variance with divisor } n)$",
  "concepts": [
   "amath.estimation.point"
  ]
 },
 {
  "key": "estimation.point.c06",
  "cardType": "FORMULA",
  "front": "Standard error of the mean",
  "back": "$\\dfrac{\\sigma}{\\sqrt{n}}$, estimated by $\\dfrac{s}{\\sqrt{n}}$",
  "concepts": [
   "amath.estimation.point"
  ]
 },
 {
  "key": "estimation.point.c07",
  "cardType": "CONCEPT",
  "front": "Parameter or statistic?",
  "back": "Parameters (μ, σ²) describe the population; statistics (x̄, s²) are calculated from a sample.",
  "concepts": [
   "amath.estimation.point"
  ]
 },
 {
  "key": "estimation.point.c08",
  "cardType": "CONCEPT",
  "front": "Why n − 1?",
  "back": "Deviations from x̄ are on average smaller than from μ; dividing by n − 1 removes this bias.",
  "concepts": [
   "amath.estimation.point"
  ]
 }
]
