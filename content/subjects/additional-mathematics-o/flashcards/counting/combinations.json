[
 {
  "key": "counting.combinations.c01",
  "cardType": "DEFINITION",
  "front": "Combination",
  "back": "A selection of objects in which order does not matter (a team, committee or set of questions).",
  "concepts": [
   "amath.counting.combinations"
  ]
 },
 {
  "key": "counting.combinations.c02",
  "cardType": "FORMULA",
  "front": "Number of combinations of r from n",
  "back": "$^{n}C_{r} = \\dbinom{n}{r} = \\dfrac{n!}{r!\\,(n - r)!}$",
  "concepts": [
   "amath.counting.combinations"
  ]
 },
 {
  "key": "counting.combinations.c03",
  "cardType": "FACT",
  "front": "Symmetry of combinations",
  "back": "$^{n}C_{r} = {}^{n}C_{n-r}$, e.g. $^{11}C_{7} = {}^{11}C_{4}$.",
  "concepts": [
   "amath.counting.combinations"
  ]
 },
 {
  "key": "counting.combinations.c04",
  "cardType": "FACT",
  "front": "Special values",
  "back": "$^{n}C_{0} = {}^{n}C_{n} = 1$ and $^{n}C_{1} = n$.",
  "concepts": [
   "amath.counting.combinations"
  ]
 },
 {
  "key": "counting.combinations.c05",
  "cardType": "CONCEPT",
  "front": "Link between nPr and nCr",
  "back": "$^{n}C_{r} = \\dfrac{^{n}P_{r}}{r!}$: each selection can be arranged in $r!$ orders.",
  "concepts": [
   "amath.counting.combinations"
  ]
 },
 {
  "key": "counting.combinations.c06",
  "cardType": "CONCEPT",
  "front": "Selecting from two groups",
  "back": "Multiply the choices within a case (2 women AND 3 men); add separate cases (0 women OR 1 woman).",
  "concepts": [
   "amath.counting.combinations"
  ]
 },
 {
  "key": "counting.combinations.c07",
  "cardType": "CONCEPT",
  "front": "At least one",
  "back": "Total selections minus the selections with none.",
  "concepts": [
   "amath.counting.combinations"
  ]
 },
 {
  "key": "counting.combinations.c08",
  "cardType": "CONCEPT",
  "front": "A particular person included or excluded",
  "back": "Included: choose the other r − 1 from n − 1. Excluded: choose all r from n − 1.",
  "concepts": [
   "amath.counting.combinations"
  ]
 },
 {
  "key": "counting.combinations.c09",
