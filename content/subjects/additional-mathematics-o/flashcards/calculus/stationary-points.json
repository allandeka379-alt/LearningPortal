[
 {
  "key": "calculus.stationary-points.c01",
  "cardType": "DEFINITION",
  "front": "Stationary point",
  "back": "A point where $\\frac{dy}{dx} = 0$: the tangent is horizontal.",
  "concepts": [
   "amath.calculus.stationary-points"
  ]
 },
 {
  "key": "calculus.stationary-points.c02",
  "cardType": "FORMULA",
  "front": "Second-derivative test",
  "back": "$\\frac{d^2y}{dx^2} < 0$: maximum; $> 0$: minimum; $= 0$: inconclusive.",
  "concepts": [
   "amath.calculus.stationary-points"
  ]
 },
 {
  "key": "calculus.stationary-points.c03",
  "cardType": "CONCEPT",
  "front": "First-derivative test",
  "back": "Gradient + → 0 → −: maximum. Gradient − → 0 → +: minimum.",
  "concepts": [
   "amath.calculus.stationary-points"
  ]
 },
 {
  "key": "calculus.stationary-points.c04",
  "cardType": "CONCEPT",
  "front": "y-coordinate of a stationary point",
  "back": "Substitute x into the equation of the curve, never into dy/dx (which gives 0).",
  "concepts": [
   "amath.calculus.stationary-points"
  ]
 },
 {
  "key": "calculus.stationary-points.c05",
  "cardType": "FACT",
  "front": "When the second-derivative test fails",
  "back": "If $\\frac{d^2y}{dx^2} = 0$, use the change-of-sign test: $y = x^4$ has a minimum at the origin.",
  "concepts": [
   "amath.calculus.stationary-points"
  ]
 },
 {
  "key": "calculus.stationary-points.c06",
  "cardType": "CONCEPT",
  "front": "Full justification",
  "back": "State the sign or value of the test quantity AND the conclusion, e.g. 'd²y/dx² = −6 < 0, so maximum'.",
  "concepts": [
   "amath.calculus.stationary-points"
  ]
 },
 {
