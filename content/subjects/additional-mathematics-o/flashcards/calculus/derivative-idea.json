  "cardType": "CONCEPT",
  "front": "$f(a)$ versus $f'(a)$",
  "back": "$f(a)$ is the $y$-coordinate at $x = a$; $f'(a)$ is the gradient there.",
  "concepts": [
   "amath.calculus.derivative-idea"
  ]
 },
