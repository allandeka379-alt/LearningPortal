   "amath.calculus.derivative-idea"
  ]
 },
 {
  "key": "calculus.derivative-idea.c06",
  "cardType": "FACT",
  "front": "Sign of the derivative",
  "back": "$\\frac{dy}{dx} > 0$: increasing; $\\frac{dy}{dx} < 0$: decreasing; $\\frac{dy}{dx} = 0$: stationary point.",
  "concepts": [
   "amath.calculus.derivative-idea"
  ]
 },
 {
