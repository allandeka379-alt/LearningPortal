  "cardType": "DEFINITION",
  "front": "$\\dfrac{dy}{dx}$ or $f'(x)$",
  "back": "The derived function (derivative): the gradient of the curve at every value of x.",
  "concepts": [
   "amath.calculus.derivative-idea"
  ]
 },
 {
  "key": "calculus.derivative-idea.c05",
  "cardType": "DEFINITION",
  "front": "$\\dfrac{d^2y}{dx^2}$ or $f''(x)$",
