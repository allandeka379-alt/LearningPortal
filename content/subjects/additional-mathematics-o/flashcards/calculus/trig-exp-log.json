  "front": "$\\dfrac{d}{dx}\\mathrm{e}^{f(x)}$",
  "back": "$f'(x)\\mathrm{e}^{f(x)}$, e.g. $\\frac{d}{dx}\\mathrm{e}^{3x - 1} = 3\\mathrm{e}^{3x - 1}$",
  "concepts": [
   "amath.calculus.trig-exp-log"
  ]
 },
