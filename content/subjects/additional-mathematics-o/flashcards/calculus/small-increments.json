  ]
 },
 {
  "key": "calculus.small-increments.c02",
  "cardType": "DEFINITION",
  "front": "$\\delta x$",
  "back": "A small change in $x$ (new value minus old value); one symbol, not $\\delta \\times x$.",
  "concepts": [
   "amath.calculus.small-increments"
  ]
 },
 {
  "key": "calculus.small-increments.c03",
  "cardType": "CONCEPT",
  "front": "Where to evaluate dy/dx",
  "back": "At the ORIGINAL value of x, the known point.",
  "concepts": [
   "amath.calculus.small-increments"
  ]
 },
 {
  "key": "calculus.small-increments.c04",
  "cardType": "FORMULA",
  "front": "Approximate value",
  "back": "$f(a + \\delta x) \\approx f(a) + f'(a)\\,\\delta x$",
  "concepts": [
   "amath.calculus.small-increments"
  ]
 },
 {
  "key": "calculus.small-increments.c05",
  "cardType": "FORMULA",
  "front": "Percentage change",
  "back": "$\\dfrac{\\delta y}{y} \\times 100\\%$; with a $k\\%$ change in $x$, use $\\delta x = \\frac{k}{100}x$.",
  "concepts": [
   "amath.calculus.small-increments"
  ]
 },
 {
  "key": "calculus.small-increments.c06",
  "cardType": "FACT",
  "front": "Power rule for percentages",
  "back": "If $y = kx^n$, a small $p\\%$ change in $x$ gives about an $np\\%$ change in $y$.",
  "concepts": [
   "amath.calculus.small-increments"
  ]
 },
 {
  "key": "calculus.small-increments.c07",
  "cardType": "CONCEPT",
  "front": "Change versus new value",
  "back": "$\\delta y$ is the change; the new value is $y + \\delta y$.",
  "concepts": [
   "amath.calculus.small-increments"
  ]
 },
 {
  "key": "calculus.small-increments.c08",
  "cardType": "FACT",
  "front": "Accuracy of the estimate",
  "back": "It improves as $\\delta x$ gets smaller, because the chord approaches the tangent.",
  "concepts": [
   "amath.calculus.small-increments"
  ]
 }
]
