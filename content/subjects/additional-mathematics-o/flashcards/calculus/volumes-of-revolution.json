[
 {
  "key": "calculus.volumes-of-revolution.c01",
  "cardType": "FORMULA",
  "front": "Volume of revolution about the x-axis",
  "back": "$V = \\pi\\int_a^b y^2\\,dx$",
  "notes": "ZIMSEC only; rotation through 360°.",
  "concepts": [
   "amath.calculus.volumes-of-revolution"
  ]
 },
 {
  "key": "calculus.volumes-of-revolution.c02",
  "cardType": "CONCEPT",
  "front": "Why πy²?",
  "back": "Each thin slice is a disc of radius y and thickness δx, volume πy²δx; summing the slices gives the integral.",
  "concepts": [
   "amath.calculus.volumes-of-revolution"
  ]
 },
 {
  "key": "calculus.volumes-of-revolution.c03",
  "cardType": "FACT",
  "front": "Expand y² first",
  "back": "$(x^2 + 1)^2 = x^4 + 2x^2 + 1$, not $x^4 + 1$.",
  "concepts": [
   "amath.calculus.volumes-of-revolution"
  ]
 },
 {
  "key": "calculus.volumes-of-revolution.c04",
  "cardType": "FACT",
  "front": "Squaring an exponential",
  "back": "$(e^{ax})^2 = e^{2ax}$",
  "concepts": [
   "amath.calculus.volumes-of-revolution"
  ]
 },
 {
  "key": "calculus.volumes-of-revolution.c05",
  "cardType": "FACT",
  "front": "Regions below the x-axis",
  "back": "Volumes are never negative: $y^2 \\geq 0$.",
  "concepts": [
   "amath.calculus.volumes-of-revolution"
  ]
 },
 {
  "key": "calculus.volumes-of-revolution.c06",
  "cardType": "CONCEPT",
  "front": "Checking with a cone",
  "back": "Rotating $y = \\frac{r}{h}x$ from 0 to $h$ gives $\\frac{1}{3}\\pi r^2h$, the cone formula.",
  "concepts": [
   "amath.calculus.volumes-of-revolution"
  ]
 },
 {
  "key": "calculus.volumes-of-revolution.c07",
  "cardType": "CONCEPT",
  "front": "Checking with a sphere",
  "back": "Rotating $y = \\sqrt{r^2 - x^2}$ from $-r$ to $r$ gives $\\frac{4}{3}\\pi r^3$.",
  "concepts": [
   "amath.calculus.volumes-of-revolution"
  ]
 },
 {
  "key": "calculus.volumes-of-revolution.c08",
  "cardType": "FACT",
  "front": "Exact answers",
  "back": "\"In terms of $\\pi$\": keep $\\pi$ outside the integral and write e.g. $\\frac{206\\pi}{15}$.",
  "concepts": [
   "amath.calculus.volumes-of-revolution"
  ]
 }
]
