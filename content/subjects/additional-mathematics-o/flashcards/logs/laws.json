[
 {
  "key": "logs.laws.c01",
  "cardType": "DEFINITION",
  "front": "$\\log_a b = c$ means …",
  "back": "$a^c = b$ (with $a > 0$, $a \\neq 1$, $b > 0$).",
  "concepts": [
   "amath.logs.laws"
  ]
 },
 {
  "key": "logs.laws.c02",
  "cardType": "FORMULA",
  "front": "Product law",
  "back": "$\\log_a (xy) = \\log_a x + \\log_a y$",
  "concepts": [
   "amath.logs.laws"
  ]
 },
 {
  "key": "logs.laws.c03",
  "cardType": "FORMULA",
  "front": "Quotient law",
  "back": "$\\log_a \\left(\\frac{x}{y}\\right) = \\log_a x - \\log_a y$",
  "concepts": [
   "amath.logs.laws"
  ]
 },
 {
  "key": "logs.laws.c04",
  "cardType": "FORMULA",
  "front": "Power law",
  "back": "$\\log_a (x^n) = n\\log_a x$",
  "concepts": [
   "amath.logs.laws"
  ]
 },
 {
  "key": "logs.laws.c05",
  "cardType": "FACT",
  "front": "$\\log_a a$ and $\\log_a 1$",
  "back": "$\\log_a a = 1$ and $\\log_a 1 = 0$.",
  "concepts": [
   "amath.logs.laws"
  ]
 },
 {
  "key": "logs.laws.c06",
  "cardType": "FORMULA",
  "front": "Change of base",
  "back": "$\\log_a b = \\dfrac{\\log_c b}{\\log_c a}$; in particular $\\log_a b = \\dfrac{1}{\\log_b a}$.",
  "notes": "Not in Cambridge's List of formulas.",
  "concepts": [
   "amath.logs.laws"
  ]
 },
 {
  "key": "logs.laws.c07",
  "cardType": "DEFINITION",
  "front": "$\\lg x$ and $\\ln x$",
  "back": "$\\lg x = \\log_{10} x$ (ZIMSEC writes $\\log x$); $\\ln x = \\log_{\\mathrm{e}} x$.",
  "concepts": [
   "amath.logs.laws"
  ]
 },
 {
  "key": "logs.laws.c08",
  "cardType": "CONCEPT",
  "front": "Logarithm of a sum",
  "back": "$\\log_a (x + y)$ cannot be split. Only products, quotients and powers can.",
  "concepts": [
   "amath.logs.laws"
  ]
 },
 {
  "key": "logs.laws.c09",
  "cardType": "FACT",
  "front": "$\\log_{a^k} x$",
  "back": "$\\dfrac{1}{k}\\log_a x$, e.g. $\\log_9 x = \\frac{1}{2}\\log_3 x$.",
  "concepts": [
   "amath.logs.laws"
  ]
 }
]
