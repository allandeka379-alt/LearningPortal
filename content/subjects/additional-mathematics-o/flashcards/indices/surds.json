 {
  "key": "indices.surds.c01",
  "cardType": "DEFINITION",
  "front": "Surd",
  "back": "An irrational root of a positive integer, such as $\\sqrt{3}$ or $2\\sqrt{7}$. $\\sqrt{16} = 4$ is not a surd.",
  "concepts": [
   "amath.indices.surds"
  ]
 },
 {
  "key": "indices.surds.c02",
  "cardType": "DEFINITION",
  "front": "Irrational number",
  "back": "A real number that cannot be written as a fraction of two integers; its decimal never ends and never repeats.",
  "concepts": [
   "amath.indices.surds"
  ]
 },
 {
  "key": "indices.surds.c03",
  "cardType": "FORMULA",
  "front": "Multiplying and dividing roots",
  "back": "$\\sqrt{ab} = \\sqrt{a}\\sqrt{b}$, $\\sqrt{\\dfrac{a}{b}} = \\dfrac{\\sqrt{a}}{\\sqrt{b}}$, $\\sqrt{a} \\times \\sqrt{a} = a$.",
  "concepts": [
   "amath.indices.surds"
  ]
 },
 {
  "key": "indices.surds.c04",
  "cardType": "CONCEPT",
  "front": "How do you simplify a surd?",
  "back": "Split the number using its largest square factor: $\\sqrt{63} = \\sqrt{9 \\times 7} = 3\\sqrt{7}$.",
  "concepts": [
   "amath.indices.surds"
  ]
 },
 {
  "key": "indices.surds.c05",
  "cardType": "FACT",
  "front": "Is $\\sqrt{a + b} = \\sqrt{a} + \\sqrt{b}$?",
  "back": "No. For example $\\sqrt{36 + 64} = 10$ but $\\sqrt{36} + \\sqrt{64} = 14$.",
  "concepts": [
   "amath.indices.surds"
  ]
 },
 {
  "key": "indices.surds.c06",
  "cardType": "CONCEPT",
  "front": "Rationalise $\\dfrac{k}{\\sqrt{b}}$",
  "back": "Multiply top and bottom by $\\sqrt{b}$: $\\dfrac{k\\sqrt{b}}{b}$.",
  "concepts": [
   "amath.indices.surds"
  ]
 },
 {
  "key": "indices.surds.c07",
  "cardType": "CONCEPT",
  "front": "Rationalise $\\dfrac{k}{a + \\sqrt{b}}$",
  "back": "Multiply top and bottom by the conjugate $a - \\sqrt{b}$; the denominator becomes $a^{2} - b$.",
  "concepts": [
   "amath.indices.surds"
  ]
 },
 {
  "key": "indices.surds.c08",
  "cardType": "FORMULA",
  "front": "Product of conjugates",
  "back": "$\\left(a + \\sqrt{b}\\right)\\left(a - \\sqrt{b}\\right) = a^{2} - b$, a rational number.",
  "concepts": [
   "amath.indices.surds"
  ]
 },
 {
  "key": "indices.surds.c09",
  "cardType": "FACT",
  "front": "Like surds",
  "back": "Only multiples of the same surd can be added: $4\\sqrt{6} - \\sqrt{6} = 3\\sqrt{6}$, but $\\sqrt{2} + \\sqrt{3}$ does not simplify.",
  "concepts": [
   "amath.indices.surds"
  ]
 }
]
