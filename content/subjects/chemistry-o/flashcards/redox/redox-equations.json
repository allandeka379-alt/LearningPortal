[
  {
    "key": "redox.card.eq-half-equation",
    "cardType": "DEFINITION",
    "front": "What is a **half-equation**?",
    "back": "An equation showing only the oxidation or only the reduction part of a redox reaction, with electrons written in.",
    "notes": "Cambridge Supplement; ZIMSEC Form 4.",
    "concepts": [
      "chem.redox.redox-equations"
    ]
  },
  {
    "key": "redox.card.eq-three-steps",
    "cardType": "CONCEPT",
    "front": "Three steps to write a half-equation",
    "back": "1. Write the particle and what it becomes. 2. Balance the atoms. 3. Add electrons to the more positive side to balance the charge.",
    "concepts": [
      "chem.redox.redox-equations"
    ]
  },
  {
    "key": "redox.card.eq-electron-side",
    "cardType": "CONCEPT",
    "front": "Electrons on the left or right of a half-equation?",
    "back": "Left (gained): reduction. Right (lost): oxidation.",
    "concepts": [
      "chem.redox.redox-equations"
    ]
  },
  {
    "key": "redox.card.eq-combine",
    "cardType": "CONCEPT",
    "front": "How do you combine two half-equations?",
    "back": "Multiply them so the electrons lost equal the electrons gained, add them, and cancel the electrons.",
    "concepts": [
      "chem.redox.redox-equations"
    ]
  },
  {
    "key": "redox.card.eq-check",
    "cardType": "FACT",
    "front": "What must balance in an ionic equation?",
    "back": "The atoms of each element AND the total charge on each side.",
    "concepts": [
      "chem.redox.redox-equations"
    ]
  },
  {
    "key": "redox.card.eq-spectator",
    "cardType": "DEFINITION",
    "front": "What is a **spectator ion**?",
    "back": "An ion that is present but does not take part in the reaction; it is left out of the ionic equation.",
    "concepts": [
      "chem.redox.redox-equations"
    ]
  },
