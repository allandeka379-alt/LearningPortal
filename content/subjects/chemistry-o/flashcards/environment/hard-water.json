[
  {
    "key": "environment.card.hard-water-hard",
    "cardType": "DEFINITION",
    "front": "What is hard water?",
    "back": "Water containing dissolved calcium and/or magnesium ions; it does not lather easily with soap.",
    "concepts": [
      "chem.environment.hard-water"
    ]
  },
  {
    "key": "environment.card.hard-water-temporary",
    "cardType": "DEFINITION",
    "front": "What is temporary hardness?",
    "back": "Hardness removed by boiling; caused by dissolved calcium (or magnesium) hydrogencarbonate.",
    "concepts": [
      "chem.environment.hard-water"
    ]
  },
  {
    "key": "environment.card.hard-water-permanent",
    "cardType": "DEFINITION",
    "front": "What is permanent hardness?",
    "back": "Hardness not removed by boiling; caused by dissolved calcium or magnesium sulfate (or chloride).",
    "concepts": [
      "chem.environment.hard-water"
    ]
  },
  {
    "key": "environment.card.hard-water-formation",
    "cardType": "FORMULA",
    "front": "How does limestone make water hard?",
    "back": "$\\ce{CaCO3 + H2O + CO2 -> Ca(HCO3)2}$",
    "notes": "Calcium hydrogencarbonate is soluble.",
    "concepts": [
      "chem.environment.hard-water"
    ]
  },
  {
    "key": "environment.card.hard-water-scale",
    "cardType": "FORMULA",
    "front": "How does scale form on boiling?",
    "back": "$\\ce{Ca(HCO3)2 -> CaCO3 + H2O + CO2}$",
    "notes": "Scale is calcium carbonate.",
    "concepts": [
      "chem.environment.hard-water"
    ]
  },
  {
    "key": "environment.card.hard-water-effects",
    "cardType": "FACT",
    "front": "Effects of hard water",
    "back": "Scale in kettles, geysers, boilers and pipes (wastes energy, blocks pipes); scum with soap (wastes soap).",
    "concepts": [
      "chem.environment.hard-water"
    ]
  },
  {
    "key": "environment.card.hard-water-soap-test",
    "cardType": "CONCEPT",
    "front": "How do you compare hardness with soap?",
    "back": "Add soap solution to a fixed volume of water, shaking, until a lasting lather forms; more soap = harder water.",
    "concepts": [
      "chem.environment.hard-water"
    ]
  },
  {
    "key": "environment.card.hard-water-softening",
    "cardType": "FACT",
    "front": "Ways of softening water",
    "back": "Boiling (temporary only); washing soda, ion exchange and distillation (both types).",
    "concepts": [
      "chem.environment.hard-water"
    ]
  },
  {
    "key": "environment.card.hard-water-descaling",
    "cardType": "FORMULA",
    "front": "Removing scale with vinegar",
    "back": "$\\ce{CaCO3 + 2CH3COOH -> (CH3COO)2Ca + H2O + CO2}$",
    "notes": "Lemon juice (citric acid) also works.",
    "concepts": [
      "chem.environment.hard-water"
    ]
  },
  {
    "key": "environment.card.hard-water-advantage",
    "cardType": "FACT",
    "front": "An advantage of hard water",
    "back": "It contains calcium, good for teeth and bones (and many prefer its taste).",
    "concepts": [
      "chem.environment.hard-water"
    ]
  }
]
