[
 {
  "key": "disease.antibiotics.c01",
  "cardType": "DEFINITION",
  "front": "What is an **antibiotic**?",
  "back": "A substance that kills or inhibits bacteria without harming human cells.",
  "concepts": [
   "abio.disease.antibiotics"
  ],
  "applies": [
   "cambridge/a-level/biology"
  ]
 },
 {
  "key": "disease.antibiotics.c02",
  "cardType": "CONCEPT",
  "front": "How does penicillin kill bacteria?",
  "back": "Inhibits transpeptidases that cross-link peptidoglycan; growing wall weakens; water enters by osmosis; cell bursts.",
  "concepts": [
   "abio.disease.antibiotics"
  ],
  "applies": [
   "cambridge/a-level/biology"
  ]
 },
 {
  "key": "disease.antibiotics.c03",
  "cardType": "CONCEPT",
  "front": "Why do antibiotics not affect viruses?",
  "back": "Viruses have no cell wall, ribosomes or metabolism of their own.",
  "concepts": [
   "abio.disease.antibiotics"
  ],
  "applies": [
   "cambridge/a-level/biology"
  ]
 },
 {
  "key": "disease.antibiotics.c04",
  "cardType": "FACT",
  "front": "Why is penicillin selective?",
  "back": "It targets bacterial cell walls; human cells have no wall.",
  "concepts": [
   "abio.disease.antibiotics"
  ],
  "applies": [
   "cambridge/a-level/biology"
  ]
 },
 {
  "key": "disease.antibiotics.c05",
  "cardType": "DEFINITION",
  "front": "What is **penicillinase** (β-lactamase)?",
  "back": "A bacterial enzyme that breaks down penicillin, giving resistance.",
  "concepts": [
   "abio.disease.antibiotics"
  ],
  "applies": [
   "cambridge/a-level/biology"
  ]
 },
 {
