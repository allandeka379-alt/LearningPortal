  "front": "Role of FSH",
  "back": "Stimulates follicle growth and oestrogen secretion.",
  "concepts": [
   "abio.reproduction.menstrual-cycle"
  ],
  "applies": [
   "zimsec"
  ]
 },
 {
  "key": "reproduction.menstrual-cycle.c03",
  "cardType": "FACT",
  "front": "Role of LH",
  "back": "Surge triggers ovulation; forms and maintains the corpus luteum.",
  "concepts": [
   "abio.reproduction.menstrual-cycle"
  ],
  "applies": [
   "zimsec"
  ]
 },
 {
  "key": "reproduction.menstrual-cycle.c04",
  "cardType": "FACT",
  "front": "Role of oestrogen",
  "back": "Repairs and thickens the endometrium; moderate levels inhibit FSH and LH; high levels trigger the LH surge.",
  "concepts": [
   "abio.reproduction.menstrual-cycle"
  ],
  "applies": [
   "zimsec"
  ]
 },
 {
  "key": "reproduction.menstrual-cycle.c05",
  "cardType": "FACT",
  "front": "Role of progesterone",
  "back": "Maintains the endometrium; inhibits FSH and LH.",
  "concepts": [
   "abio.reproduction.menstrual-cycle"
  ],
  "applies": [
   "zimsec"
  ]
 },
 {
  "key": "reproduction.menstrual-cycle.c06",
  "cardType": "CONCEPT",
  "front": "Positive feedback in the cycle",
  "back": "High sustained oestrogen stimulates the LH surge, causing ovulation.",
  "concepts": [
   "abio.reproduction.menstrual-cycle"
  ],
  "applies": [
   "zimsec"
  ]
 },
 {
  "key": "reproduction.menstrual-cycle.c07",
  "cardType": "CONCEPT",
  "front": "What causes menstruation?",
  "back": "Corpus luteum degenerates; progesterone falls; endometrium breaks down.",
  "concepts": [
   "abio.reproduction.menstrual-cycle"
  ],
  "applies": [
   "zimsec"
  ]
 },
 {
  "key": "reproduction.menstrual-cycle.c08",
  "cardType": "CONCEPT",
  "front": "Hormone changes at the menopause",
  "back": "Oestrogen and progesterone fall; FSH and LH rise (no negative feedback).",
  "concepts": [
   "abio.reproduction.menstrual-cycle"
  ],
  "applies": [
   "zimsec"
  ]
 },
 {
