[
 {
  "key": "skills.descriptive-statistics.c01",
  "cardType": "FORMULA",
  "front": "Sample standard deviation",
  "back": "s = √( Σ(x − x̄)² / (n − 1) ); same unit as the data.",
  "concepts": [
   "abio.skills.descriptive-statistics"
  ]
 },
 {
  "key": "skills.descriptive-statistics.c02",
  "cardType": "FORMULA",
  "front": "Standard error of the mean",
  "back": "SE = s / √n.",
  "concepts": [
   "abio.skills.descriptive-statistics"
  ]
 },
 {
  "key": "skills.descriptive-statistics.c03",
  "cardType": "FORMULA",
  "front": "95% confidence interval",
  "back": "x̄ ± 2SE.",
  "concepts": [
   "abio.skills.descriptive-statistics"
  ]
 },
 {
  "key": "skills.descriptive-statistics.c04",
  "cardType": "CONCEPT",
  "front": "SD versus SE",
  "back": "SD: spread of individual values. SE: precision of the mean; smaller for larger samples.",
