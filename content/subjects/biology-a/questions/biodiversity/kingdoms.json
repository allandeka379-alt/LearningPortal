  "difficulty": 4,
  "marks": 3,
  "estimatedSeconds": 240,
  "stem": "Suggest why some biologists think the kingdom Protoctista should be divided into several kingdoms.",
  "answerSpec": {
   "markScheme": {
    "points": [
     {
      "id": "p1",
