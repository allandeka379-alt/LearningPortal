  "difficulty": 2,
  "marks": 1,
  "estimatedSeconds": 80,
  "stem": "In a logic circuit, input A and input B go into an OR gate. Input C goes into a NOT gate. The outputs of these two gates go into an AND gate, whose output is X. Which expression describes the circuit?",
  "options": [
   {
    "key": "A",
    "content": "X = (A OR B) AND (NOT C)",
    "correct": true,
    "rationale": "Correct: the OR gate and the NOT gate feed the AND gate."
   },
   {
    "key": "B",
    "content": "X = (A AND B) OR (NOT C)",
    "rationale": "This swaps the OR and AND gates."
   },
   {
    "key": "C",
    "content": "X = NOT ((A OR B) AND C)",
    "rationale": "The NOT gate acts only on C, not on the whole expression."
   },
   {
    "key": "D",
    "content": "X = (A OR B) OR (NOT C)",
    "rationale": "The final gate is AND, not OR."
   }
  ],
