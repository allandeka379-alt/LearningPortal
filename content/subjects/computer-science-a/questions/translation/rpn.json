  "estimatedSeconds": 80,
  "stem": "What is the postfix form of the infix expression 7 + 3 × 4 - 2?",
  "options": [
   {
    "key": "A",
    "content": "7 3 4 * + 2 -",
    "correct": true,
    "rationale": "Correct: 3 4 * is done first, then added to 7, then 2 is subtracted."
   },
   {
    "key": "B",
    "content": "7 3 + 4 * 2 -",
    "rationale": "That would give (7 + 3) × 4 - 2."
   },
   {
    "key": "C",
    "content": "7 3 4 + * 2 -",
    "rationale": "That would give 7 × (3 + 4) - 2."
   },
   {
    "key": "D",
    "content": "7 3 4 * 2 - +",
    "rationale": "That would give 7 + (3 × 4 - 2)."
   }
  ],
  "explanation": "The multiplication has higher precedence, so it comes first in the postfix.",
  "hints": [
   "Which operator is applied first?"
