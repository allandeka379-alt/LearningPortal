  "stem": "In Reverse Polish Notation, where is the operator written?",
  "options": [
   {
    "key": "A",
    "content": "After its operands",
    "correct": true,
    "rationale": "Correct: for example 3 4 + means 3 + 4."
   },
   {
    "key": "B",
    "content": "Before its operands",
    "rationale": "That is prefix (Polish) notation."
   },
   {
    "key": "C",
    "content": "Between its operands",
    "rationale": "That is infix notation."
   },
   {
    "key": "D",
    "content": "At the end of the line only",
    "rationale": "Each operator follows its own operands."
   }
  ],
  "explanation": "Postfix places each operator after its operands.",
