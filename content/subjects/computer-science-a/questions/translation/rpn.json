  "difficulty": 2,
  "marks": 1,
  "estimatedSeconds": 80,
  "stem": "What is an advantage of Reverse Polish Notation for a compiler?",
  "options": [
   {
    "key": "A",
    "content": "The expressions are shorter than in infix because every operator is removed",
    "rationale": "The same operators are used."
   },
   {
