 {
  "key": "algo.complexity-big-o.c03",
  "cardType": "CONCEPT",
  "front": "Big O rules",
  "back": "Keep only the fastest-growing term and drop constants: 3n + 5 is O(n); n² + n is O(n²).",
  "concepts": [
   "acs.algo.complexity-big-o"
  ],
  "applies": [
   "cambridge/a-level/computer-science"
  ]
 },
 {
  "key": "algo.complexity-big-o.c04",
  "cardType": "FACT",
  "front": "Order of growth",
  "back": "O(1) < O(log n) < O(n) < O(n log n) < O(n²) < O(2ⁿ).",
  "concepts": [
   "acs.algo.complexity-big-o"
  ],
  "applies": [
   "cambridge/a-level/computer-science"
  ]
 },
 {
  "key": "algo.complexity-big-o.c05",
  "cardType": "FACT",
  "front": "Examples of orders",
  "back": "O(1) array access; O(log n) binary search; O(n) linear search; O(n²) bubble sort; O(2ⁿ) naive Fibonacci.",
  "concepts": [
   "acs.algo.complexity-big-o"
  ],
  "applies": [
   "cambridge/a-level/computer-science"
  ]
 },
 {
  "key": "algo.complexity-big-o.c06",
  "cardType": "CONCEPT",
  "front": "Identifying the order",
  "back": "One loop over n: O(n). Nested loops each over n: O(n²). A loop that halves n: O(log n).",
  "concepts": [
   "acs.algo.complexity-big-o"
  ],
  "applies": [
   "cambridge/a-level/computer-science"
  ]
 },
 {
  "key": "algo.complexity-big-o.c07",
  "cardType": "CONCEPT",
  "front": "Best, average and worst case",
  "back": "The same algorithm can take different amounts of work for different inputs of the same size; the worst case is the safe guide.",
  "concepts": [
   "acs.algo.complexity-big-o"
  ],
  "applies": [
   "cambridge/a-level/computer-science"
  ]
 },
 {
  "key": "algo.complexity-big-o.c08",
  "cardType": "FACT",
  "front": "Effect of doubling n",
  "back": "O(n): twice the work. O(n²): four times. O(log n): one more step.",
  "concepts": [
   "acs.algo.complexity-big-o"
  ],
  "applies": [
   "cambridge/a-level/computer-science"
  ]
 },
 {
  "key": "algo.complexity-big-o.c09",
  "cardType": "CONCEPT",
  "front": "Constants and small n",
  "back": "A lower order does not win for small n if its constant is large; the order decides for large n.",
  "concepts": [
   "acs.algo.complexity-big-o"
  ],
  "applies": [
   "cambridge/a-level/computer-science"
  ]
 }
]
