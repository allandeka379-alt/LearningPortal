    "estimatedSeconds": 30,
    "stem": "Which formula is used to calculate magnification?",
    "options": [
      {
        "key": "A",
        "content": "magnification = actual size ÷ image size",
        "rationale": "This is upside down: an enlarged image would give a magnification smaller than 1."
      },
      {
        "key": "B",
        "content": "magnification = image size ÷ actual size",
        "correct": true,
        "rationale": "Magnification is how many times bigger the image is than the real object."
      },
      {
        "key": "C",
        "content": "magnification = image size × actual size",
        "rationale": "Multiplying the two lengths gives an area-like number with units, not a magnification."
      },
      {
        "key": "D",
        "content": "magnification = image size − actual size",
        "rationale": "A difference in length is not a magnification."
      }
