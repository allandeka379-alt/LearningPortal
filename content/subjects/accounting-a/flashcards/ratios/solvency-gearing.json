[
 {
  "key": "ratios.solvency-gearing.c01",
  "cardType": "FORMULA",
  "front": "Gearing",
  "back": "Non-current liabilities ÷ (issued ordinary shares + all reserves + non-current liabilities) × 100.",
  "concepts": [
   "aacc.ratios.solvency-gearing"
  ]
 },
 {
  "key": "ratios.solvency-gearing.c02",
  "cardType": "FORMULA",
  "front": "Interest cover",
  "back": "Profit from operations ÷ interest payable, in times.",
  "concepts": [
   "aacc.ratios.solvency-gearing"
  ]
 },
 {
  "key": "ratios.solvency-gearing.c03",
  "cardType": "FORMULA",
  "front": "Working capital cycle",
  "back": "Inventory days + trade receivables days - trade payables days.",
  "concepts": [
   "aacc.ratios.solvency-gearing"
  ]
 },
 {
  "key": "ratios.solvency-gearing.c04",
  "cardType": "FORMULA",
  "front": "Net working assets to revenue",
  "back": "(Inventory + trade receivables - trade payables) ÷ revenue × 100.",
  "concepts": [
   "aacc.ratios.solvency-gearing"
  ]
 },
 {
  "key": "ratios.solvency-gearing.c05",
  "cardType": "FORMULA",
  "front": "Debt to equity",
  "back": "Debt ÷ equity; the question defines the debt.",
  "concepts": [
   "aacc.ratios.solvency-gearing"
  ],
  "applies": [
   "zimsec"
  ]
 },
 {
  "key": "ratios.solvency-gearing.c06",
  "cardType": "CONCEPT",
  "front": "Why does gearing magnify results?",
  "back": "Interest is fixed, so in a good year extra profit goes to the shareholders, and in a poor year the interest still has to be paid.",
  "concepts": [
   "aacc.ratios.solvency-gearing"
  ]
 },
 {
  "key": "ratios.solvency-gearing.c07",
  "cardType": "FACT",
  "front": "How to reduce gearing",
  "back": "Issue shares, retain profit, repay loan notes or convert loan notes to shares.",
  "concepts": [
   "aacc.ratios.solvency-gearing"
  ]
 },
 {
  "key": "ratios.solvency-gearing.c08",
  "cardType": "CONCEPT",
  "front": "Judging gearing",
  "back": "Read gearing with interest cover and the stability of profit; a steady business can carry more debt than one with swings in profit.",
  "concepts": [
   "aacc.ratios.solvency-gearing"
  ]
 },
 {
  "key": "ratios.solvency-gearing.c09",
  "cardType": "FACT",
  "front": "Which profit for interest cover?",
  "back": "Profit from operations (before interest). Using profit after interest deducts the interest twice.",
  "concepts": [
   "aacc.ratios.solvency-gearing"
  ]
 }
]
