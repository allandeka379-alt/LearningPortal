   "aacc.ratios.efficiency"
  ]
 },
 {
  "key": "ratios.efficiency.c06",
  "cardType": "FACT",
  "front": "Which base for which ratio?",
  "back": "Inventory: cost of sales. Receivables: credit sales. Payables: credit purchases. Use year-end figures unless the question says average.",
  "concepts": [
   "aacc.ratios.efficiency"
  ]
 },
 {
  "key": "ratios.efficiency.c07",
  "cardType": "CONCEPT",
  "front": "Why are rising receivables days a concern?",
  "back": "Customers pay more slowly, so cash is tied up; it may mean weak credit control or looser terms.",
  "concepts": [
   "aacc.ratios.efficiency"
  ]
 },
 {
  "key": "ratios.efficiency.c08",
  "cardType": "CONCEPT",
  "front": "Why can longer payables days help and hurt?",
  "back": "It keeps cash in the business, but suppliers may withdraw credit or discounts.",
  "concepts": [
   "aacc.ratios.efficiency"
  ]
 },
 {
  "key": "ratios.efficiency.c09",
  "cardType": "FORMULA",
  "front": "ZIMSEC turnovers",
  "back": "Total assets turnover = revenue ÷ total assets; current assets turnover = revenue ÷ current assets; capital employed turnover = revenue ÷ capital employed.",
  "concepts": [
   "aacc.ratios.efficiency"
  ],
  "applies": [
   "zimsec"
  ]
 }
