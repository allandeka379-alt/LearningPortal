  ]
 },
 {
  "key": "verification.correcting-errors.c03",
  "cardType": "FACT",
  "front": "Correcting an error of commission",
  "back": "Debit/credit the correct account and reverse the wrong one; the other side (e.g. bank) is not touched.",
  "concepts": [
   "acc.verification.correcting-errors"
  ]
 },
 {
  "key": "verification.correcting-errors.c04",
  "cardType": "FACT",
  "front": "Correcting an error of principle",
  "back": "Move the amount from the wrong class of account to the right one, e.g. debit equipment, credit repairs.",
  "concepts": [
   "acc.verification.correcting-errors"
  ]
 },
 {
  "key": "verification.correcting-errors.c05",
  "cardType": "FACT",
  "front": "Correcting an error of original entry",
  "back": "Adjust both accounts by the difference between the correct and recorded amounts.",
