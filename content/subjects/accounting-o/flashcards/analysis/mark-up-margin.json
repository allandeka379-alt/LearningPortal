   "acc.analysis.mark-up-margin"
  ]
 },
 {
  "key": "analysis.mark-up-margin.c04",
  "cardType": "FORMULA",
  "front": "Mark-up from margin",
  "back": "Mark-up = margin ÷ (100 − margin) × 100.",
  "concepts": [
   "acc.analysis.mark-up-margin"
  ]
 },
 {
