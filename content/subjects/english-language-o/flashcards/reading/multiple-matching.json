 {
  "key": "reading.multiple-matching.c02",
  "cardType": "DEFINITION",
  "front": "Distractor",
  "back": "A detail in the wrong text that shares a word or topic with a statement but not its exact idea.",
  "concepts": [
   "eng.reading.multiple-matching"
  ],
  "applies": [
   "cambridge/igcse/english-second-language"
  ]
 },
 {
  "key": "reading.multiple-matching.c03",
  "cardType": "CONCEPT",
  "front": "Match ideas, not words",
  "back": "Statements paraphrase the texts. Look for the same meaning in different words.",
  "notes": "'nervous beforehand' = 'my stomach was in knots the night before'",
  "concepts": [
   "eng.reading.multiple-matching"
  ],
  "applies": [
   "cambridge/igcse/english-second-language"
  ]
 },
 {
  "key": "reading.multiple-matching.c04",
  "cardType": "CONCEPT",
  "front": "Matching method",
  "back": "Skim all texts → underline the key idea in each statement → find the paraphrase → check for distractors.",
  "concepts": [
   "eng.reading.multiple-matching"
  ],
  "applies": [
   "cambridge/igcse/english-second-language"
  ]
 },
 {
  "key": "reading.multiple-matching.c05",
  "cardType": "CONCEPT",
  "front": "Watch for opposites and negatives",
  "back": "'I wasn't nervous at all' does not match 'was nervous'.",
  "concepts": [
   "eng.reading.multiple-matching"
  ],
  "applies": [
   "cambridge/igcse/english-second-language"
  ]
 },
 {
  "key": "reading.multiple-matching.c06",
  "cardType": "CONCEPT",
  "front": "Watch time and roles",
  "back": "Earns now ≠ hopes to earn; 'I helped my cousin' ≠ 'received help from a relative'.",
  "concepts": [
   "eng.reading.multiple-matching"
  ],
  "applies": [
   "cambridge/igcse/english-second-language"
  ]
 },
 {
  "key": "reading.multiple-matching.c07",
  "cardType": "FACT",
  "front": "Texts can repeat",
  "back": "One text may answer several statements; another may answer only one.",
  "concepts": [
   "eng.reading.multiple-matching"
  ],
  "applies": [
   "cambridge/igcse/english-second-language"
  ]
 },
 {
