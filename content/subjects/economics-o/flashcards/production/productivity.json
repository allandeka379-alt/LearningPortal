[
 {
  "key": "production.productivity.c01",
  "cardType": "DEFINITION",
  "front": "Production",
  "back": "The total output of goods and services in a period.",
  "concepts": [
   "econ.production.productivity"
  ]
 },
 {
  "key": "production.productivity.c02",
  "cardType": "DEFINITION",
  "front": "Productivity",
  "back": "Output per unit of input in a period; labour productivity = output per worker or per worker-hour.",
  "concepts": [
   "econ.production.productivity"
  ]
 },
 {
  "key": "production.productivity.c03",
  "cardType": "FORMULA",
  "front": "Labour productivity",
  "back": "Total output ÷ number of workers (or worker-hours).",
  "concepts": [
   "econ.production.productivity"
  ]
 },
 {
  "key": "production.productivity.c04",
  "cardType": "FORMULA",
  "front": "Average product (AP)",
  "back": "Total product ÷ number of workers.",
  "concepts": [
   "econ.production.productivity"
  ],
  "applies": [
   "zimsec"
  ]
 },
 {
  "key": "production.productivity.c05",
  "cardType": "FORMULA",
  "front": "Marginal product (MP)",
  "back": "TP with n workers − TP with (n − 1) workers.",
  "concepts": [
   "econ.production.productivity"
  ],
  "applies": [
   "zimsec"
  ]
 },
 {
  "key": "production.productivity.c06",
  "cardType": "CONCEPT",
  "front": "Diminishing returns",
  "back": "When more workers are added to a fixed factor, each extra worker eventually adds less output than the one before.",
  "concepts": [
   "econ.production.productivity"
  ],
  "applies": [
   "zimsec"
  ]
 },
 {
  "key": "production.productivity.c07",
  "cardType": "CONCEPT",
  "front": "Influences on productivity",
  "back": "Capital, skills and training, motivation, technology, management, health, quality of land and infrastructure.",
  "concepts": [
   "econ.production.productivity"
  ]
 },
 {
  "key": "production.productivity.c08",
  "cardType": "FACT",
  "front": "How does investment affect productivity?",
  "back": "It gives workers more and better capital, so output per worker rises; it also raises productive capacity.",
  "concepts": [
   "econ.production.productivity"
  ]
 },
 {
  "key": "production.productivity.c09",
  "cardType": "CONCEPT",
  "front": "Why does productivity matter?",
  "back": "Lower unit costs and higher profits for firms, scope for higher wages, competitive exports, and higher living standards.",
  "concepts": [
   "econ.production.productivity"
  ]
 }
]
