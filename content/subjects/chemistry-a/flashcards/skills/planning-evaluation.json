  "cardType": "FACT",
  "front": "Standard practice in plans",
  "back": "Weigh by difference; volumetric flask; concordant titres; heat to constant mass; water bath; more readings near rapid change.",
  "concepts": [
   "achem.skills.planning-evaluation"
  ]
 },
 {
  "key": "skills.planning-evaluation.c07",
  "cardType": "CONCEPT",
  "front": "Good safety statements",
  "back": "Name the hazard of a named substance and the precaution: e.g. ethanol is flammable, heat with a water bath.",
  "concepts": [
   "achem.skills.planning-evaluation"
  ]
 },
 {
  "key": "skills.planning-evaluation.c08",
  "cardType": "CONCEPT",
  "front": "Anomalous results",
  "back": "Identify, suggest a specific cause, exclude from means and lines of best fit, repeat if possible.",
