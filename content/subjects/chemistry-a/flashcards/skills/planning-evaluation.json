  "front": "Order from a log graph",
  "back": "lg(rate) = n lg[X] + lg k: gradient n, intercept lg k.",
  "concepts": [
   "achem.skills.planning-evaluation"
  ]
 },
 {
  "key": "skills.planning-evaluation.c05",
  "cardType": "CONCEPT",
  "front": "Random vs systematic error",
  "back": "Random: scatter, reduced by repeats. Systematic: all results shifted one way; change the method or calibrate.",
  "concepts": [
   "achem.skills.planning-evaluation"
  ]
 },
 {
