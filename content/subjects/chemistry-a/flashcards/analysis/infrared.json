 {
  "key": "analysis.infrared.c02",
  "cardType": "CONCEPT",
  "front": "Why bonds absorb IR",
  "back": "A bond absorbs at its natural vibration frequency if the vibration changes the dipole moment.",
  "concepts": [
   "achem.analysis.infrared"
  ],
  "applies": [
   "cambridge/a-level/chemistry"
  ]
 },
 {
  "key": "analysis.infrared.c03",
  "cardType": "FACT",
  "front": "O–H absorptions",
  "back": "Alcohol: 3200-3600 cm⁻¹, broad. Carboxylic acid: 2500-3000 cm⁻¹, very broad.",
  "concepts": [
   "achem.analysis.infrared"
  ],
  "applies": [
   "cambridge/a-level/chemistry"
  ]
 },
 {
  "key": "analysis.infrared.c04",
  "cardType": "FACT",
  "front": "C=O absorptions",
  "back": "Amide 1640-1690; aldehyde, ketone, acid 1670-1740; ester 1710-1750 cm⁻¹. Strong and sharp.",
  "concepts": [
   "achem.analysis.infrared"
  ],
  "applies": [
   "cambridge/a-level/chemistry"
  ]
 },
 {
  "key": "analysis.infrared.c05",
  "cardType": "FACT",
  "front": "Other key ranges",
  "back": "C≡N 2200-2250; N–H 3300-3500; C–H 2850-2950; C=C 1500-1680; C–O 1040-1300 cm⁻¹.",
  "concepts": [
   "achem.analysis.infrared"
  ],
  "applies": [
   "cambridge/a-level/chemistry"
  ]
 },
 {
  "key": "analysis.infrared.c06",
  "cardType": "DEFINITION",
  "front": "Fingerprint region",
  "back": "Below about 1500 cm⁻¹: a pattern unique to each compound; compare with a database to identify it or check purity.",
  "concepts": [
   "achem.analysis.infrared"
  ],
  "applies": [
   "cambridge/a-level/chemistry"
  ]
 },
 {
  "key": "analysis.infrared.c07",
  "cardType": "CONCEPT",
  "front": "IR evidence for oxidation of an alcohol",
  "back": "Broad O–H at 3200-3600 disappears; C=O near 1700 appears (acid: very broad 2500-3000 too).",
  "concepts": [
   "achem.analysis.infrared"
  ],
  "applies": [
   "cambridge/a-level/chemistry"
  ]
 },
 {
  "key": "analysis.infrared.c08",
  "cardType": "CONCEPT",
  "front": "Greenhouse gases and IR",
  "back": "CO₂, H₂O and CH₄ absorb IR because their vibrations change the dipole; N₂ and O₂ cannot.",
  "concepts": [
   "achem.analysis.infrared"
  ],
  "applies": [
   "cambridge/a-level/chemistry"
  ]
 },
 {
  "key": "analysis.infrared.c09",
  "cardType": "CONCEPT",
  "front": "Limits of IR",
  "back": "Identifies bonds and functional groups, not the full structure; isomers with the same groups need the fingerprint region or NMR.",
  "concepts": [
   "achem.analysis.infrared"
  ],
  "applies": [
   "cambridge/a-level/chemistry"
  ]
 }
