  "cardType": "CONCEPT",
  "front": "pH after mixing",
  "back": "Find moles of H⁺ and OH⁻, subtract, divide the excess by the TOTAL volume, then find pH.",
  "concepts": [
   "achem.acids.ph-kw"
  ]
 },
