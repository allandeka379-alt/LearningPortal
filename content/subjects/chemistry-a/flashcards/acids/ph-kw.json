  ]
 },
 {
  "key": "acids.ph-kw.c03",
  "cardType": "FORMULA",
  "front": "pH, pOH and pKw",
  "back": "pH + pOH = pKw = 14.00 at 298 K (pOH = −log[OH⁻]).",
  "concepts": [
   "achem.acids.ph-kw"
  ]
 },
 {
  "key": "acids.ph-kw.c04",
  "cardType": "FORMULA",
  "front": "pH of a strong alkali",
  "back": "[H⁺] = Kw/[OH⁻], then pH = −log[H⁺] (or pH = 14.00 − pOH at 298 K).",
  "concepts": [
   "achem.acids.ph-kw"
  ]
 },
 {
