  "stem": "Why can **+128** not be stored in 8-bit two's complement?",
  "options": [
   {
    "key": "A",
    "content": "Two's complement cannot store numbers above 100",
    "rationale": "The limit is 127, set by the 7 bits below the MSB."
   },
   {
    "key": "B",
    "content": "It would need the MSB, which is reserved for −128",
    "correct": true,
    "rationale": "Correct: positive numbers need MSB 0, so the largest is 01111111 = 127."
   },
   {
    "key": "C",
    "content": "128 is not a power of 2",
    "rationale": "128 is $2^7$; the issue is the negative MSB."
   },
   {
    "key": "D",
    "content": "Only negative numbers can be stored in two's complement",
    "rationale": "Positive numbers from 0 to 127 are stored too."
   }
  ],
  "explanation": "Positive values use only the seven bits worth 64 to 1, giving at most 127. 10000000 already means −128.",
