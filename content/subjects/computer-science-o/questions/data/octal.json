  "options": [
   {
    "key": "A",
    "content": "Hexadecimal values take up less memory than octal values",
    "rationale": "Both are display formats; the computer stores binary either way."
   },
   {
    "key": "B",
    "content": "A byte divides exactly into two hex digits but not into octal digits",
    "correct": true,
    "rationale": "Correct: 8 bits = 2 × 4 bits, but 8 is not a multiple of 3."
   },
   {
    "key": "C",
    "content": "Octal cannot represent numbers larger than 511",
    "rationale": "Octal can represent any whole number by adding more digits."
   },
