 {
  "key": "data.binary-denary.q08",
  "type": "MULTIPLE_CHOICE",
  "concepts": [
   "comp.data.binary-denary"
  ],
  "difficulty": 1,
  "marks": 1,
  "estimatedSeconds": 60,
  "stem": "When converting denary to binary by repeated division by 2, how are the remainders read?",
  "options": [
   {
    "key": "A",
    "content": "From the first remainder to the last",
    "rationale": "That writes the number backwards: the first remainder is the least significant bit."
   },
   {
    "key": "B",
    "content": "Only the remainders that are 1 are written",
    "rationale": "Every remainder, 0 or 1, is one bit of the answer."
   },
   {
    "key": "C",
    "content": "From the last remainder to the first",
    "correct": true,
    "rationale": "Correct: the last remainder is the most significant bit, so read from the bottom up."
   },
   {
    "key": "D",
    "content": "The quotients are read instead of the remainders",
    "rationale": "The quotients are what you divide next; the bits are the remainders."
   }
  ],
  "explanation": "The first division gives the 1s bit (LSB); the last gives the MSB. Reading the remainders bottom-up gives the bits from left to right.",
  "modelResponse": {
   "type": "MULTIPLE_CHOICE",
   "optionKeys": [
    "C"
   ]
  },
  "wrongResponses": [
   {
    "type": "MULTIPLE_CHOICE",
    "optionKeys": [
     "A"
    ]
   }
  ],
  "skill": "RECALL"
 },
