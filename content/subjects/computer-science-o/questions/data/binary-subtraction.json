  ],
  "difficulty": 2,
  "marks": 1,
  "estimatedSeconds": 60,
  "stem": "When you borrow 1 from the next column in binary subtraction, how much is it worth in the column that receives it?",
  "options": [
   {
    "key": "A",
    "content": "2",
    "correct": true,
    "rationale": "Correct: each binary place value is double the one to its right."
   },
   {
    "key": "B",
    "content": "10",
    "rationale": "In denary a borrow is worth ten; binary uses base 2."
   },
   {
    "key": "C",
    "content": "1",
    "rationale": "It is worth 1 of the left column, which is 2 of the column to its right."
   },
   {
    "key": "D",
    "content": "16",
    "rationale": "16 is a place value in binary, not the value of a borrow."
   }
  ],
  "explanation": "Place values double from right to left, so 1 in the left column equals 2 in the column to its right.",
