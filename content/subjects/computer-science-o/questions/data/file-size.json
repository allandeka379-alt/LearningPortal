  ],
  "difficulty": 2,
  "marks": 1,
  "estimatedSeconds": 60,
  "stem": "A file size has been calculated in **bits**. What is the next step to give it in **KiB**?",
  "options": [
   {
    "key": "A",
    "content": "Divide by 1024 only",
    "rationale": "That skips the bits → bytes step and is 8 times too big."
   },
   {
    "key": "B",
