  ],
  "difficulty": 1,
  "marks": 1,
  "estimatedSeconds": 60,
  "stem": "Which calculation gives the file size of a bitmap image **in bits**?",
  "options": [
   {
    "key": "A",
    "content": "width × height × colour depth",
    "correct": true,
    "rationale": "Correct: number of pixels × bits per pixel."
   },
   {
    "key": "B",
    "content": "width × height × number of colours",
    "rationale": "Use the colour depth (bits), not the number of colours."
   },
   {
    "key": "C",
    "content": "width × height ÷ colour depth",
    "rationale": "Each pixel uses colour-depth bits, so multiply."
   },
   {
    "key": "D",
    "content": "width + height + colour depth",
    "rationale": "The pixels form a grid, so the dimensions are multiplied."
   }
  ],
  "explanation": "Pixels = width × height; each pixel needs colour-depth bits.",
  "modelResponse": {
   "type": "MULTIPLE_CHOICE",
   "optionKeys": [
    "A"
   ]
  },
