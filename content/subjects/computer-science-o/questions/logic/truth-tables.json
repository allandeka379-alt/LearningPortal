  ],
  "difficulty": 1,
  "marks": 1,
  "estimatedSeconds": 60,
  "stem": "How many rows does a truth table need for a circuit with three inputs?",
  "options": [
   {
    "key": "A",
    "content": "6",
    "rationale": "Three inputs give 2 × 2 × 2 combinations, not 2 × 3."
   },
   {
    "key": "B",
    "content": "8",
    "correct": true,
    "rationale": "Correct: $2^3 = 8$ combinations, 000 to 111."
   },
   {
    "key": "C",
    "content": "9",
    "rationale": "Each input has 2 values, not 3: use $2^3$, not $3^2$."
   },
   {
    "key": "D",
    "content": "4",
    "rationale": "Four rows are needed for two inputs."
   }
  ],
  "explanation": "Each input can be 0 or 1, so the number of combinations is $2^n$; for three inputs $2^3 = 8$.",
