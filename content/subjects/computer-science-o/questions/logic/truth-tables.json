  ],
  "difficulty": 2,
  "marks": 1,
  "estimatedSeconds": 60,
  "stem": "What is the output of `X = (A XOR B) AND C` when A = 1, B = 1 and C = 1?",
  "options": [
   {
    "key": "A",
    "content": "0",
    "correct": true,
    "rationale": "Correct: 1 XOR 1 = 0, and 0 AND 1 = 0."
   },
   {
    "key": "B",
    "content": "1",
    "rationale": "This treats 1 XOR 1 as 1, as if XOR were OR."
   },
   {
    "key": "C",
    "content": "It cannot be worked out without the circuit",
    "rationale": "The expression gives all the information needed."
   },
   {
    "key": "D",
    "content": "It depends on the order of A and B",
    "rationale": "XOR gives the same result whichever input is first."
   }
  ],
  "explanation": "Work inside the bracket first: 1 XOR 1 = 0 (the inputs are the same). Then 0 AND 1 = 0.",
