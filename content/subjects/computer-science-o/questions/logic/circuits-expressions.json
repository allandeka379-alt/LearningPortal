  ],
  "difficulty": 2,
  "marks": 1,
  "estimatedSeconds": 60,
  "stem": "A car's warning lamp X comes on when the engine is **not** running and the headlights are on. A = 1 when the engine is running; B = 1 when the headlights are on. Which expression is correct?",
  "options": [
   {
    "key": "A",
    "content": "`X = (NOT A) AND B`",
    "correct": true,
    "rationale": "Correct: engine not running is NOT A, and the lights must also be on."
   },
   {
    "key": "B",
    "content": "`X = A AND B`",
    "rationale": "This lights the lamp while the engine is running."
   },
   {
    "key": "C",
    "content": "`X = NOT (A AND B)`",
    "rationale": "This is NAND: the lamp would be on in three of the four situations."
   },
   {
    "key": "D",
    "content": "`X = (NOT A) OR B`",
    "rationale": "OR would light the lamp whenever the lights are on, even while driving."
   }
  ],
  "explanation": "\"Engine not running\" is NOT A; \"and the headlights are on\" joins B with AND: X = (NOT A) AND B (output 0100).",
  "modelResponse": {
   "type": "MULTIPLE_CHOICE",
   "optionKeys": [
    "A"
   ]
  },
  "wrongResponses": [
   {
    "type": "MULTIPLE_CHOICE",
    "optionKeys": [
     "B"
    ]
   }
  ],
  "skill": "APPLICATION",
  "dailyEligible": true
 },
 {
  "key": "logic.circuits-expressions.q02",
