 {
  "key": "logic.circuits-expressions.q03",
  "type": "MULTIPLE_CHOICE",
  "concepts": [
   "comp.logic.circuits-expressions"
  ],
  "difficulty": 3,
  "marks": 1,
  "estimatedSeconds": 60,
  "stem": "A circuit is described as follows. Inputs A and B go into an OR gate. Input C goes into a NOT gate. The outputs of the OR gate and the NOT gate go into a NAND gate, whose output is X. Which expression represents the circuit?",
  "options": [
   {
    "key": "A",
    "content": "`X = NOT ((A OR B) AND C)`",
    "rationale": "This applies NOT after the AND; in the circuit NOT acts on C before the NAND."
   },
   {
    "key": "B",
    "content": "`X = (A OR B) NAND (NOT C)`",
    "correct": true,
    "rationale": "Correct: the two gate outputs are the inputs of the final NAND gate."
   },
   {
    "key": "C",
    "content": "`X = (A OR B) AND (NOT C)`",
    "rationale": "The final gate is NAND, not AND."
   },
   {
    "key": "D",
    "content": "`X = (A NOR B) NAND C`",
    "rationale": "The first gate is OR, and C passes through a NOT gate first."
   }
  ],
  "explanation": "OR gate: (A OR B). NOT gate: (NOT C). Final NAND: X = (A OR B) NAND (NOT C).",
  "hints": [
   "Write each gate's output in brackets, then join them with the last gate."
  ],
  "modelResponse": {
   "type": "MULTIPLE_CHOICE",
   "optionKeys": [
    "B"
   ]
  },
  "wrongResponses": [
   {
    "type": "MULTIPLE_CHOICE",
    "optionKeys": [
     "A"
    ]
   }
  ],
  "skill": "APPLICATION"
 },
 {
  "key": "logic.circuits-expressions.q04",
  "type": "MULTIPLE_CHOICE",
  "concepts": [
   "comp.logic.circuits-expressions"
  ],
  "difficulty": 4,
  "marks": 1,
  "estimatedSeconds": 60,
  "stem": "A truth table has X = 1 only in the rows A = 0, B = 0, C = 0 and A = 1, B = 0, C = 1. Which expression produces this table?",
  "options": [
   {
    "key": "A",
    "content": "`X = (NOT A AND NOT B AND NOT C) OR (A AND NOT B AND C)`",
    "correct": true,
    "rationale": "Correct: each AND term is 1 in exactly one of the two rows (column 10000100)."
   },
   {
    "key": "B",
    "content": "`X = (A AND B AND C) OR (NOT A AND B AND NOT C)`",
    "rationale": "This builds the terms with the 0s and 1s swapped; it is 1 in rows 111 and 010."
   },
   {
    "key": "C",
    "content": "`X = (NOT A OR NOT B OR NOT C) AND (A OR NOT B OR C)`",
    "rationale": "This mixes the operators; it is 1 in several other rows as well."
   },
   {
    "key": "D",
    "content": "`X = (NOT A AND NOT B AND C) OR (A AND NOT B AND NOT C)`",
    "rationale": "These terms match rows 001 and 100, not 000 and 101."
   }
  ],
  "explanation": "Row 000 gives (NOT A AND NOT B AND NOT C); row 101 gives (A AND NOT B AND C). OR the two terms together.",
  "hints": [
   "Use only the rows where X = 1.",
   "An input that is 0 in a row appears with NOT in that row's term."
  ],
  "modelResponse": {
   "type": "MULTIPLE_CHOICE",
   "optionKeys": [
    "A"
   ]
  },
  "wrongResponses": [
   {
    "type": "MULTIPLE_CHOICE",
    "optionKeys": [
     "B"
    ]
   }
  ],
  "skill": "ANALYSIS"
 },
