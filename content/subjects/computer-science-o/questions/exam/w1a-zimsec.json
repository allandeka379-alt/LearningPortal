      "lowercase",
      "remove_whitespace"
     ]
    },
    "explanation": "01011101 + 00110110 = 10010011 ($93 + 54 = 147$)."
   },
   {
    "label": "(b)",
    "type": "SHORT_ANSWER",
    "marks": 2,
    "stem": "Work out 10010011 − 00101110 in binary. Give an 8-bit answer.",
