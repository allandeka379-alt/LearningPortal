 {
  "key": "exam.w1a-zimsec.q01",
  "type": "STRUCTURED",
  "concepts": [
   "comp.data.number-systems",
   "comp.data.binary-denary",
   "comp.data.octal",
   "comp.data.hexadecimal"
  ],
  "difficulty": 4,
  "marks": 10,
  "estimatedSeconds": 900,
  "stem": "A stock-control program at a hardware shop in Gweru stores the number of items in each bin as a binary number. One bin holds **163** items.",
  "parts": [
   {
    "label": "(a)",
    "type": "SHORT_ANSWER",
    "marks": 2,
    "markingMode": "MANUAL",
    "stem": "Explain why the computer stores the number in binary.",
    "answerSpec": {
     "markScheme": {
      "points": [
       {
        "id": "p1",
        "description": "The computer's circuits/switches/transistors (or logic gates, memory cells) have only two states, on and off.",
        "marks": 1
       },
       {
        "id": "p2",
        "description": "The two states represent the binary digits 1 and 0, so all data must be converted to binary to be stored and processed.",
        "marks": 1
       }
      ]
     },
     "markingNotes": "Example answer: A computer is built from electronic switches that can only be on or off. These two states stand for 1 and 0, so every number has to be held in binary."
    }
   },
   {
    "label": "(b)",
    "type": "SHORT_ANSWER",
    "marks": 2,
    "stem": "Convert 163 to an 8-bit binary number.",
    "payload": {
     "maxLength": 64
    },
    "answerSpec": {
     "accepted": [
      {
       "value": "10100011"
      }
     ],
     "normalise": [
      "trim",
      "lowercase",
      "remove_whitespace"
     ]
    },
    "explanation": "$128 + 32 + 2 + 1 = 163$ → 10100011."
   },
   {
    "label": "(c)",
    "type": "SHORT_ANSWER",
    "marks": 2,
    "stem": "Convert 163 to octal.",
    "payload": {
     "maxLength": 64
    },
    "answerSpec": {
     "accepted": [
      {
       "value": "243"
      }
     ],
     "normalise": [
      "trim",
      "lowercase",
      "remove_whitespace"
     ]
    },
    "explanation": "163 ÷ 8 = 20 r 3; 20 ÷ 8 = 2 r 4; 2 ÷ 8 = 0 r 2 → 243. (Or group 10100011 in threes from the right: 010 100 011.)"
   },
   {
    "label": "(d)",
    "type": "SHORT_ANSWER",
    "marks": 1,
    "stem": "Convert 163 to hexadecimal.",
    "payload": {
     "maxLength": 64
    },
    "answerSpec": {
     "accepted": [
      {
       "value": "A3"
      }
     ],
     "normalise": [
      "trim",
      "lowercase",
      "remove_whitespace"
     ]
    },
    "explanation": "163 ÷ 16 = 10 r 3 → A3 (or 1010 0011 → A3)."
   },
   {
    "label": "(e)",
    "type": "CALCULATION",
    "marks": 1,
    "stem": "Another bin's count is shown on a technician's screen in hexadecimal as 7D. Convert it to denary.",
    "answerSpec": {
     "value": 125
    },
    "explanation": "$7 \\times 16 + 13 = 125$.",
    "workedSolution": "1. $7 \\times 16 + 13 = 125$."
   },
   {
    "label": "(f)",
    "type": "SHORT_ANSWER",
    "marks": 2,
    "markingMode": "MANUAL",
    "stem": "Give two reasons why the technician's screen shows values in hexadecimal rather than binary.",
    "answerSpec": {
     "markScheme": {
      "points": [
       {
        "id": "p1",
        "description": "Hexadecimal is shorter (one hex digit represents 4 bits), so it takes less space on screen.",
        "marks": 1
       },
       {
        "id": "p2",
        "description": "It is easier for people to read/remember/copy, so fewer errors are made; it converts easily to and from binary.",
        "marks": 1
       }
      ]
     },
     "markingNotes": "Example answer: A hex value is a quarter of the length of the binary, so it is quicker to read. It is also easier to remember and copy without mistakes, and each digit converts straight to four bits."
    }
   }
  ],
  "explanation": "163 = 10100011 (binary) = 243 (octal) = A3 (hex). 7D = 125.",
  "hints": [
   "Use place values 128 to 1 for binary.",
   "Divide by 8 for octal and by 16 for hexadecimal; read remainders from the bottom up."
  ],
  "modelResponse": {
   "type": "STRUCTURED",
