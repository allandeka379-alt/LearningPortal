    "workedSolution": "1. 01100101 = $64 + 32 + 4 + 1 = 101$."
   },
   {
    "label": "(d)",
    "type": "SHORT_ANSWER",
    "marks": 2,
    "stem": "Give the 8-bit binary ASCII code for the letter R.",
