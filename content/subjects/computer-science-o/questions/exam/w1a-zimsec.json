      {
       "value": "01010010"
      }
     ],
     "normalise": [
      "trim",
      "lowercase",
      "remove_whitespace"
     ]
    },
    "explanation": "R is 17 letters after A: $65 + 17 = 82$ → 01010010."
   },
   {
