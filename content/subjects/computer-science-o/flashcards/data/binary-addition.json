   "comp.data.binary-addition"
  ]
 },
 {
  "key": "data.binary-addition.c03",
  "cardType": "CONCEPT",
  "front": "Why does overflow happen?",
  "back": "Registers have a **fixed size**; the carry out of the most significant bit has nowhere to go, so it is lost and the stored value is wrong.",
  "concepts": [
   "comp.data.binary-addition"
  ]
 },
 {
