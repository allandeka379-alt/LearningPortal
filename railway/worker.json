{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.railway",
    "watchPatterns": ["src/**", "prisma/**", "scripts/**", "package.json", "package-lock.json", "Dockerfile.railway"]
  },
  "deploy": {
    "startCommand": "node --enable-source-maps worker/index.mjs",
    "drainingSeconds": 45,
    "restartPolicyType": "ALWAYS"
  }
}
