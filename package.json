{
  "name": "dzidza",
  "version": "0.1.0",
  "private": true,
  "description": "Digital study platform for ZIMSEC and Cambridge O-Level & A-Level students",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/next-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-local.ps1 start",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-local.ps1 stop",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:db:prepare": "tsx --conditions=react-server scripts/prepare-test-db.ts",
    "worker": "tsx --conditions=react-server src/worker/index.ts",
    "db:seed:demo": "tsx --conditions=react-server prisma/seed.ts --demo",
    "db:grants": "tsx scripts/apply-db-grants.ts",
    "content:validate": "tsx --conditions=react-server scripts/content/validate.ts",
    "content:check": "tsx --conditions=react-server scripts/content/check.ts",
    "content:import": "tsx --conditions=react-server scripts/content/import.ts",
    "content:publish": "tsx --conditions=react-server scripts/content/publish.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "clsx": "^2.1.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "read-excel-file": "^9.3.10",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "unified": "^11.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/hast": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^18.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
